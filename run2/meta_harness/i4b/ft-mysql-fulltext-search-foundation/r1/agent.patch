@@ -0,0 +1,14 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = Current.user.accessible_cards
+      .search(@query)
+      .includes(:rich_text_description, comments: :rich_text_body)
+
+    @matching_comments_by_card = @cards.each_with_object({}) do |card, matching_comments_by_card|
+      matching_comments_by_card[card.id] = card.comments.select do |comment|
+        comment.body.to_plain_text.match?(Regexp.new(Regexp.escape(@query), Regexp::IGNORECASE))
+      end
+    end
+  end
+end
