diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..732a614
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,39 @@
+module Card::Search
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(term) do
+      if term.present?
+        pattern = "%#{sanitize_sql_like(term, "!")}%"
+
+        where(<<~SQL.squish, pattern:)
+          cards.status = 'published'
+          AND (
+            LOWER(cards.title) LIKE LOWER(:pattern) ESCAPE '!'
+            OR EXISTS (
+              SELECT 1
+              FROM action_text_rich_texts AS search_descriptions
+              WHERE search_descriptions.record_type = 'Card'
+                AND search_descriptions.record_id = cards.id
+                AND search_descriptions.name = 'description'
+                AND LOWER(search_descriptions.body) LIKE LOWER(:pattern) ESCAPE '!'
+            )
+            OR EXISTS (
+              SELECT 1
+              FROM comments AS search_comments
+              INNER JOIN action_text_rich_texts AS search_comment_bodies
+                ON search_comment_bodies.record_id = search_comments.id
+                AND search_comment_bodies.record_type = 'Comment'
+                AND search_comment_bodies.name = 'body'
+              WHERE search_comments.card_id = cards.id
+                AND LOWER(search_comment_bodies.body) LIKE LOWER(:pattern) ESCAPE '!'
+            )
+          )
+        SQL
+        .reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..be4a27b
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,39 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search</h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <div class="flex align-center gap">
+      <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+      <%= form.search_field :q, value: @query, autofocus: true %>
+      <%= form.submit "Search", class: "btn" %>
+    </div>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="search-results margin pad" aria-label="Search results">
+    <% if @cards.any? %>
+      <% @cards.each do |card| %>
+        <article class="search-result" id="<%= dom_id(card, :search_result) %>">
+          <h2 class="search-result__title">
+            <%= link_to highlight(card.title, @query, sanitize: true), card_path(card) %>
+          </h2>
+
+          <% unless card.description.blank? %>
+            <p class="search-result__description"><%= highlight(card.description.to_plain_text, @query, sanitize: true) %></p>
+          <% end %>
+
+          <% @matching_comments_by_card[card.id].each do |comment| %>
+            <p class="search-result__comment"><%= highlight(comment.body.to_plain_text, @query, sanitize: true) %></p>
+          <% end %>
+        </article>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards found</p>
+    <% end %>
+  </section>
+<% end %>
