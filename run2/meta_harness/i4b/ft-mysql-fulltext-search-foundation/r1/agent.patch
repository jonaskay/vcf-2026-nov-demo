diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..68d6f1c
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "search page is available at the search URL and keeps the query in its form" do
+    get search_path, params: { q: "findme" }
+
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select "input[name=q][value=findme]"
+  end
+
+  test "does not show results without a query" do
+    create_card(title: "empty query should not match everything")
+
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds a card by title and marks the matching text" do
+    card = create_card(title: "Title contains findmetitle")
+
+    get search_path, params: { q: "findmetitle" }
+
+    assert_response :success
+    assert_select ".search-result__title a[href=?] mark", card_path(card), text: "findmetitle"
+  end
+
+  test "finds a card by description and marks the matching text" do
+    card = create_card(title: "Description result")
+    card.update!(description: "The description contains findmedescription")
+
+    get search_path, params: { q: "findmedescription" }
+
+    assert_response :success
+    assert_select ".search-result__description mark", text: "findmedescription"
+  end
+
+  test "finds a card by a comment body and marks the matching text" do
+    card = create_card(title: "Comment result")
+    card.comments.create!(creator: users(:kevin), body: "A comment contains findmecomment")
+
+    get search_path, params: { q: "findmecomment" }
+
+    assert_response :success
+    assert_select ".search-result__comment mark", text: "findmecomment"
+  end
+
+  test "shows matching cards newest first by card creation time" do
+    travel_to(Time.zone.local(2025, 1, 1, 12)) { create_card(title: "findmeorder older") }
+    travel_to(Time.zone.local(2025, 1, 2, 12)) { create_card(title: "findmeorder newer") }
+
+    get search_path, params: { q: "findmeorder" }
+
+    assert_response :success
+    titles = css_select(".search-result__title").map { |title| title.text.squish }
+    assert_equal [ "findmeorder newer", "findmeorder older" ], titles
+  end
+
+  test "only returns cards on boards the user currently has access to" do
+    board = Board.create!(
+      name: "Private search board", account: accounts("37s"), creator: users(:david), all_access: false)
+
+    with_current_user(users(:kevin)) do
+      board.cards.create!(creator: users(:kevin), title: "findmeprivate", status: :published)
+    end
+
+    get search_path, params: { q: "findmeprivate" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    board.accesses.grant_to(users(:kevin))
+    get search_path, params: { q: "findmeprivate" }
+    assert_response :success
+    assert_select ".search-result__title mark", text: "findmeprivate"
+
+    board.accesses.destroy_by(user: users(:kevin))
+    get search_path, params: { q: "findmeprivate" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "draft cards and comments on draft cards do not appear in results" do
+    draft_by_title = create_card(title: "findmedrafttitle")
+    draft_by_title.update!(status: :drafted)
+
+    draft_by_comment = create_card(title: "Draft comment card")
+    draft_by_comment.comments.create!(creator: users(:kevin), body: "findmedraftcomment")
+    draft_by_comment.update!(status: :drafted)
+
+    get search_path, params: { q: "findmedrafttitle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "findmedraftcomment" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search result content escapes markup around highlighted text" do
+    create_card(title: "<script>findmesafe</script>")
+
+    get search_path, params: { q: "findmesafe" }
+
+    assert_response :success
+    assert_no_match "<script>findmesafe</script>", response.body
+    assert_select ".search-result__title mark", text: "findmesafe"
+  end
+
+  private
+    def create_card(title:)
+      with_current_user(users(:kevin)) do
+        boards(:writebook).cards.create!(creator: users(:kevin), title: title, status: :published)
+      end
+    end
+end
