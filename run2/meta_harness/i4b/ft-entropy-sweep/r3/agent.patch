@@ -2,13 +2,7 @@ module Card::Entropic
   extend ActiveSupport::Concern
 
   included do
-    scope :due_to_be_postponed, -> do
-      active
-        .joins(board: :account)
-        .left_outer_joins(board: :entropy)
-        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
-    end
+    scope :due_to_be_postponed, -> { due_to_be_postponed_scope(Time.current) }
 
     scope :postponing_soon, -> do
       now = Time.now
@@ -25,10 +19,61 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      system_users = User.where(role: :system).index_by(&:account_id)
+
+      due_to_be_postponed_scopes(Time.current).each do |cards|
+        cards.preload(:account, :closure, :not_now, :activity_spike, :column, :board).find_each do |card|
+          user = system_users[card.account_id] || card.account.system_user
+          card.auto_postpone(user: user)
+        end
       end
+
+      nil
     end
+
+    def due_to_be_postponed_scope(now)
+      due_card_scopes = due_to_be_postponed_scopes(now)
+
+      if due_card_scopes.any?
+        due_card_ids = due_card_scopes.map { |cards| cards.select(:id).to_sql }.join(" UNION ALL ")
+        where("cards.id IN (#{due_card_ids})")
+      else
+        none
+      end
+    end
+
+    private
+      def due_to_be_postponed_scopes(now)
+        # SQLite's prior datetime() cutoff discarded fractional seconds.
+        now = now.change(usec: 0) if Card.connection.adapter_name == "SQLite"
+
+        board_entropies = Entropy.where(container_type: "Board")
+        account_entropies = Entropy.where(container_type: "Account").where("entropies.container_id = entropies.account_id")
+
+        board_scopes = board_entropies.distinct.pluck(:auto_postpone_period).map do |period|
+          board_settings = board_entropies.where(auto_postpone_period: period)
+          board_ids = board_settings.select(:container_id)
+          board_account_ids = Board.where(id: board_ids).select(:account_id)
+          cutoff = now - period.seconds
+
+          active
+            .where(account_id: board_account_ids, board_id: board_ids)
+            .where(last_active_at: ..cutoff)
+        end
+
+        account_scopes = account_entropies.distinct.pluck(:auto_postpone_period).map do |period|
+          account_settings = account_entropies.where(auto_postpone_period: period)
+          account_ids = account_settings.select(:container_id)
+          cutoff = now - period.seconds
+
+          active
+            .where(account_id: account_ids)
+            .where.not(board_id: board_entropies.select(:container_id))
+            .where(last_active_at: ..cutoff)
+        end
+
+        board_scopes + account_scopes
+      end
   end
 
   def entropy
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..5bfc077 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,84 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due scope honors the board override and inclusive cutoff" do
+    freeze_time
+
+    cards(:logo).update! last_active_at: 90.days.ago
+    cards(:text).update! last_active_at: 90.days.ago - 1.second
+    cards(:layout).update! last_active_at: 90.days.ago + 1.second
+    cards(:shipping).update! last_active_at: 30.days.ago
+
+    due_cards = Card.due_to_be_postponed
+
+    assert_kind_of ActiveRecord::Relation, due_cards
+
+    assert_includes due_cards, cards(:logo)
+    assert_includes due_cards, cards(:text)
+    assert_not_includes due_cards, cards(:layout)
+    assert_not_includes due_cards, cards(:shipping)
+  end
+
+  test "due scope falls back to the account period when a board has no override" do
+    freeze_time
+    entropies(:writebook_board).destroy
+
+    cards(:logo).update! last_active_at: 30.days.ago
+    cards(:layout).update! last_active_at: 30.days.ago + 1.second
+
+    due_cards = Card.due_to_be_postponed
+
+    assert_includes due_cards, cards(:logo)
+    assert_not_includes due_cards, cards(:layout)
+  end
+
+  test "due scope honors different account defaults without board overrides" do
+    freeze_time
+    entropies(:miltons_wish_list_board).destroy
+    entropies("initech_account").update! auto_postpone_period: 7.days
+
+    cards(:radio).update! last_active_at: 7.days.ago
+    cards(:paycheck).update! last_active_at: 7.days.ago + 1.second
+
+    due_cards = Card.due_to_be_postponed
+
+    assert_includes due_cards, cards(:radio)
+    assert_not_includes due_cards, cards(:paycheck)
+  end
+
+  test "auto postpone all due processes more than one batch" do
+    freeze_time
+    entropies(:writebook_board).destroy
+
+    now = Time.current
+    account = accounts("37s")
+    board = boards("writebook")
+    creator = users("david")
+    due_ids = []
+    rows = (0..1_000).map do |index|
+      id = SecureRandom.uuid
+      due_ids << id
+      {
+        id: id,
+        account_id: account.id,
+        board_id: board.id,
+        creator_id: creator.id,
+        number: 10_000 + index,
+        status: "published",
+        title: "Due card #{index}",
+        last_active_at: now - 31.days,
+        created_at: now - 32.days,
+        updated_at: now - 32.days
+      }
+    end
+    not_due_id = SecureRandom.uuid
+    rows << rows.first.merge(id: not_due_id, number: 20_000, title: "Not due", last_active_at: now - 29.days)
+    Card.insert_all!(rows)
+
+    Card.auto_postpone_all_due
+
+    assert_equal due_ids.size, Card.where(id: due_ids).postponed.count
+    assert_not Card.find(not_due_id).postponed?
+  end
 end
