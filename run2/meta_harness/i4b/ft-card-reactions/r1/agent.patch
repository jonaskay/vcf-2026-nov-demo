diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..82ed741
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail offers a way to add a reaction to the card itself" do
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :reacting)} a[href=?]", new_card_reaction_path(@card)
+    assert_select ".reaction span", text: "👍"
+
+    get new_card_reaction_path(@card)
+
+    assert_response :success
+    assert_select "input[name='reaction[content]']"
+  end
+
+  test "create a card reaction with turbo stream" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "destroy own card reaction with turbo stream" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "a user cannot destroy another user's card reaction" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+
+      assert_response :forbidden
+    end
+  end
+
+  test "card reactions are available as JSON" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body.first["id"]
+
+    post card_reactions_path(@card), params: { reaction: { content: "Nice!" } }, as: :json
+
+    assert_response :created
+    assert_equal "Nice!", @response.parsed_body["content"]
+
+    created_reaction = @card.reactions.order(:created_at).last
+    delete card_reaction_path(@card, created_reaction), as: :json
+
+    assert_response :no_content
+  end
+
+  test "create a card reaction with flat JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { content: "👍" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+  end
+
+  test "card JSON advertises its reactions endpoint" do
+    get card_path(@card), as: :json
+
+    assert_response :success
+    assert_equal card_reactions_url(@card), @response.parsed_body["reactions_url"]
+  end
+end
diff --git a/test/models/card_reactions_test.rb b/test/models/card_reactions_test.rb
new file mode 100644
index 0000000..655e36d
--- /dev/null
+++ b/test/models/card_reactions_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class CardReactionsTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "creating a card reaction updates card activity and belongs to that card" do
+    card = cards(:logo)
+    reaction = nil
+
+    travel_to 1.minute.from_now do
+      assert_changes -> { card.reload.last_active_at } do
+        reaction = card.reactions.create!(content: "👍")
+      end
+    end
+
+    assert_equal card, reaction.card
+    assert_includes card.reactions, reaction
+    assert_empty comments(:logo_agreement_jz).reactions
+  end
+end
