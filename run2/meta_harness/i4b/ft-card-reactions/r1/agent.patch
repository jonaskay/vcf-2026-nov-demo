@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Boards::ColumnCardReactionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @column = @card.column
+  end
+
+  test "column card previews show a non-zero boost count and omit a zero count" do
+    get board_column_path(@column.board, @column)
+
+    assert_response :success
+    assert_no_match "card__boosts", response.body
+
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    get board_column_path(@column.board, @column)
+
+    assert_response :success
+    assert_select ".card__boosts strong", text: "1"
+
+    @card.reactions.create!(content: "👏", reacter: users(:kevin))
+
+    get board_column_path(@column.board, @column)
+
+    assert_response :success
+    assert_select ".card__boosts strong", text: "2"
+
+    @card.reactions.destroy_all
+
+    get board_column_path(@column.board, @column)
+
+    assert_response :success
+    assert_no_match "card__boosts", response.body
+  end
+end
