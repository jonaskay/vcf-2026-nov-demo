diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..7706506
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.#renderTime()
+    this.timestampObserver = new MutationObserver(() => this.#renderTime())
+    this.timestampObserver.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    this.timestampObserver?.disconnect()
+  }
+
+  #renderTime() {
+    this.element.textContent = formatLocalTime(this.element.dateTime, this.formatValue)
+  }
+}
