diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..c6388ab
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,109 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+const SHORT_DATE_OPTIONS = { month: "short", day: "numeric" }
+
+export function formatLocalTime(timestamp, format) {
+  const date = parseTimestamp(timestamp)
+
+  if (Number.isNaN(date.getTime())) return timestamp
+
+  const now = new Date()
+
+  switch (format) {
+    case "comment":
+      return formatCommentTime(date, now)
+    case "relative":
+      return formatRelativeTime(date, now)
+    case "auto-close":
+      return formatAutoCloseDate(date, now)
+    case "clock":
+      return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+    case "date-long":
+      return new Intl.DateTimeFormat("en-US", { month: "short", day: "2-digit", year: "numeric" }).format(date)
+    case "date-time":
+      return new Intl.DateTimeFormat("en-US", { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }).format(date)
+    case "day-heading":
+      return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+    default:
+      return new Intl.DateTimeFormat("en-US", SHORT_DATE_OPTIONS).format(date)
+  }
+}
+
+function parseTimestamp(timestamp) {
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(timestamp)
+
+  if (dateOnly) {
+    return new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+  }
+
+  return new Date(timestamp)
+}
+
+function formatCommentTime(date, now) {
+  const daysAgo = differenceInLocalDays(date, now)
+
+  if (daysAgo === 0) {
+    return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+  } else if (daysAgo === 1) {
+    return "yesterday"
+  } else if (daysAgo > 1 && daysAgo < 7) {
+    return `${daysAgo} days ago`
+  } else {
+    return new Intl.DateTimeFormat("en-US", SHORT_DATE_OPTIONS).format(date)
+  }
+}
+
+function formatAutoCloseDate(date, now) {
+  const daysUntil = differenceInLocalDays(now, date)
+
+  if (daysUntil === 0) {
+    return "today"
+  } else if (daysUntil === 1) {
+    return "tomorrow"
+  } else if (daysUntil > 1) {
+    return `in ${daysUntil} days`
+  } else if (daysUntil === -1) {
+    return "yesterday"
+  } else {
+    return `${Math.abs(daysUntil)} days ago`
+  }
+}
+
+function formatRelativeTime(date, now) {
+  const difference = date.getTime() - now.getTime()
+  const distance = Math.abs(difference)
+
+  if (distance < 60 * 1000) {
+    return difference > 0 ? "in less than a minute" : "less than a minute ago"
+  }
+
+  let unit, unitLength
+
+  if (distance < 60 * 60 * 1000) {
+    unit = "minute"
+    unitLength = 60 * 1000
+  } else if (distance < DAY_IN_MILLISECONDS) {
+    unit = "hour"
+    unitLength = 60 * 60 * 1000
+  } else if (distance < 30 * DAY_IN_MILLISECONDS) {
+    unit = "day"
+    unitLength = DAY_IN_MILLISECONDS
+  } else if (distance < 365 * DAY_IN_MILLISECONDS) {
+    unit = "month"
+    unitLength = 30 * DAY_IN_MILLISECONDS
+  } else {
+    unit = "year"
+    unitLength = 365 * DAY_IN_MILLISECONDS
+  }
+
+  const amount = Math.round(distance / unitLength)
+  const signedAmount = difference < 0 ? -amount : amount
+
+  return new Intl.RelativeTimeFormat("en", { numeric: "always" }).format(signedAmount, unit)
+}
+
+function differenceInLocalDays(from, to) {
+  return signedDifferenceInDays(from, to)
+}
+
