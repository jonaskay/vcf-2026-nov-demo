@@ -0,0 +1,111 @@
+require "test_helper"
+
+class LocalTimeRenderingRequestTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "comment HTML carries a raw UTC timestamp for browser localization" do
+    timestamp = Time.utc(2025, 9, 17, 20, 42)
+    comment = comments(:logo_agreement_kevin)
+    comment.update_column :created_at, timestamp
+
+    get card_path(comment.card)
+
+    assert_response :success
+    assert_select "##{ActionView::RecordIdentifier.dom_id(comment)} a.comment__permalink-title time" do |times|
+      assert_equal timestamp.iso8601(6), times.first["datetime"]
+      assert_equal timestamp.iso8601(6), times.first.text
+      assert_equal "comment", times.first["data-local-time-format-value"]
+    end
+  end
+
+  test "card metadata and auto-close HTML carry raw UTC timestamps" do
+    travel_to Time.utc(2025, 9, 17, 22, 42)
+    card = cards(:logo)
+    created_at = Time.utc(2025, 9, 10, 12, 0)
+    card.update_column :created_at, created_at
+    auto_closes_at = Time.current + 1.day
+    card.update_column :last_active_at, auto_closes_at - card.auto_postpone_period
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select ".card__meta time[data-local-time-format-value='relative']" do |times|
+      assert_includes times.map { |time| time["datetime"] }, created_at.iso8601(6)
+    end
+    assert_select ".card-perma__closure-message time[data-local-time-format-value='auto-close']" do |times|
+      assert_equal auto_closes_at.iso8601(6), times.first["datetime"]
+      assert_equal auto_closes_at.iso8601(6), times.first.text
+    end
+  end
+
+  test "comment JSON keeps the timestamp as a raw UTC value" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.created_at.utc.iso8601(3), @response.parsed_body["created_at"]
+  end
+
+  test "cached comment timestamp markup is the same for different server timezones" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_column :created_at, Time.utc(2025, 9, 17, 20, 42)
+    selector = "##{ActionView::RecordIdentifier.dom_id(comment)} a.comment__permalink-title time"
+
+    rendered_markup = with_actionview_partial_caching do
+      [ "Asia/Tokyo", "America/Los_Angeles" ].map do |timezone|
+        cookies[:timezone] = timezone
+        get card_path(comment.card)
+        assert_response :success
+        assert_select "meta[name='timezone']", count: 0
+        css_select(selector).first.to_html
+      end
+    end
+
+    assert_equal rendered_markup.first, rendered_markup.last
+  end
+
+  test "activity timeline exposes event times as raw timestamps" do
+    travel_to Time.utc(2025, 9, 17, 22, 42)
+    event = events(:layout_assignment_jz)
+    timestamp = Time.current.beginning_of_day + 13.hours + 42.minutes
+    event.update_column :created_at, timestamp
+
+    get events_path
+
+    assert_response :success
+    assert_select ".event__timestamp time" do |times|
+      assert_includes times.map { |time| time["datetime"] }, timestamp.iso8601(6)
+      assert times.all? { |time| time["data-controller"] == "local-time" }
+    end
+  end
+
+  test "card previews expose timestamps for browser localization" do
+    get cards_previews_path(format: :turbo_stream)
+
+    assert_response :success
+    assert_select ".card__meta time[data-local-time-format-value='relative'][datetime]"
+  end
+
+  test "public card pages expose timestamps for browser localization" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_card_path(board.publication.key, cards(:logo))
+
+    assert_response :success
+    assert_select ".card__meta time[data-local-time-format-value='relative'][datetime]"
+  end
+
+  test "card JSON keeps timestamps as raw UTC values" do
+    card = cards(:logo)
+
+    get card_path(card, format: :json)
+
+    assert_response :success
+    assert_equal card.created_at.utc.iso8601(3), @response.parsed_body["created_at"]
+    assert_equal card.last_active_at.utc.iso8601(3), @response.parsed_body["last_active_at"]
+  end
+end
diff --git a/test/system/local_time_rendering_test.rb b/test/system/local_time_rendering_test.rb
