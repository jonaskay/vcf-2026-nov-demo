index 0000000..745c2aa
--- /dev/null
+++ b/test/system/local_time_rendering_test.rb
@@ -0,0 +1,82 @@
+require "application_system_test_case"
+
+class LocalTimeRenderingSystemTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @now = Time.utc(2025, 9, 17, 22, 42)
+    travel_to @now
+    sign_in_as users(:kevin)
+    set_viewer_timezone
+  end
+
+  test "comments use the viewer's local time and calendar-day boundaries" do
+    card = cards(:logo)
+    comment_times = {
+      "two hours ago" => @now - 2.hours,
+      "last night" => Time.utc(2025, 9, 17, 6, 59),
+      "two days ago" => Time.utc(2025, 9, 15, 20, 42),
+      "five days ago" => Time.utc(2025, 9, 12, 20, 42),
+      "six days ago" => Time.utc(2025, 9, 11, 20, 42),
+      "seven days ago" => Time.utc(2025, 9, 10, 20, 42),
+      "tomorrow" => Time.utc(2025, 9, 18, 20, 42)
+    }
+
+    comments = comment_times.map do |body, created_at|
+      comment = card.comments.create!(creator: users(:kevin), body: body)
+      comment.update_column :created_at, created_at
+      [ body, comment ]
+    end.to_h
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(comments.fetch('two hours ago'))} a.comment__permalink-title time", text: "1:42 PM"
+    assert_selector "##{dom_id(comments.fetch('last night'))} a.comment__permalink-title time", text: "yesterday"
+    assert_selector "##{dom_id(comments.fetch('two days ago'))} a.comment__permalink-title time", text: "2 days ago"
+    assert_selector "##{dom_id(comments.fetch('five days ago'))} a.comment__permalink-title time", text: "5 days ago"
+    assert_selector "##{dom_id(comments.fetch('six days ago'))} a.comment__permalink-title time", text: "6 days ago"
+    assert_selector "##{dom_id(comments.fetch('seven days ago'))} a.comment__permalink-title time", text: "Sep 10"
+    assert_selector "##{dom_id(comments.fetch('tomorrow'))} a.comment__permalink-title time", text: "Sep 18"
+  end
+
+  test "auto-close text uses the viewer's local calendar day" do
+    card = cards(:logo)
+    auto_close_dates = [
+      [ Time.utc(2025, 9, 18, 2, 0), "today" ],
+      [ Time.utc(2025, 9, 18, 7, 30), "tomorrow" ],
+      [ @now + 2.days, "in 2 days" ],
+      [ @now + 3.days, "in 3 days" ]
+    ]
+
+    auto_close_dates.each_with_index do |(auto_closes_at, expected_text), index|
+      card.update_columns(
+        last_active_at: auto_closes_at - card.auto_postpone_period,
+        updated_at: @now + (index + 1).seconds
+      )
+
+      visit card_url(card)
+      assert_selector ".card-perma__closure-message time", text: expected_text
+    end
+  end
+
+  private
+    def set_viewer_timezone
+      browser = page.driver.browser
+      browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+      browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JAVASCRIPT)
+        const NativeDate = Date
+        const fixedNow = Date.parse("#{@now.iso8601}")
+        class FrozenDate extends NativeDate {
+          constructor(...args) {
+            super(...(args.length ? args : [ fixedNow ]))
+          }
+
+          static now() {
+            return fixedNow
+          }
+        }
+        window.Date = FrozenDate
+      JAVASCRIPT
+      browser.manage.add_cookie(name: "timezone", value: "Asia/Tokyo")
+    end
+end
