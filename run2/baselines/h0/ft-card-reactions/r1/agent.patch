@@ -0,0 +1,25 @@
+require "application_system_test_case"
+
+class CardReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "reacting to a card from its detail view" do
+    sign_in_as users(:david)
+    card = cards(:logo)
+
+    visit card_url(card)
+
+    within "turbo-frame##{dom_id(card, :reacting)}" do
+      find(".reactions__trigger").click
+    end
+
+    within "turbo-frame##{dom_id(card, :new_reaction)}" do
+      find("input[name=\"reaction[content]\"]").set("🎉")
+      click_button "Submit"
+    end
+
+    within "turbo-frame##{dom_id(card, :reacting)}" do
+      assert_text "🎉"
+    end
+  end
+end
