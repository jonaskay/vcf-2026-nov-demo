diff --git a/db/migrate/20260716120000_make_reactions_polymorphic.rb b/db/migrate/20260716120000_make_reactions_polymorphic.rb
new file mode 100644
index 0000000..96ab2ad
--- /dev/null
+++ b/db/migrate/20260716120000_make_reactions_polymorphic.rb
@@ -0,0 +1,22 @@
+class MakeReactionsPolymorphic < ActiveRecord::Migration[8.2]
+  def up
+    add_column :reactions, :reactionable_type, :string, null: false, default: "Comment"
+    remove_index :reactions, name: "index_reactions_on_comment_id"
+    rename_column :reactions, :comment_id, :reactionable_id
+    change_column_default :reactions, :reactionable_type, from: "Comment", to: nil
+    add_index :reactions, [ :reactionable_type, :reactionable_id ]
+  end
+
+  def down
+    card_reactions_exist = select_value("SELECT COUNT(*) FROM reactions WHERE reactionable_type != 'Comment'").to_i.positive?
+
+    if card_reactions_exist
+      raise ActiveRecord::IrreversibleMigration, "Cannot revert card reactions to comment-only reactions"
+    end
+
+    remove_index :reactions, name: "index_reactions_on_reactionable_type_and_reactionable_id"
+    rename_column :reactions, :reactionable_id, :comment_id
+    remove_column :reactions, :reactionable_type
+    add_index :reactions, :comment_id
+  end
+end
