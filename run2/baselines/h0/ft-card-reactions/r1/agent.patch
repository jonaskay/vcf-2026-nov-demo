diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..6c0929f
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,33 @@
+module ReactionsHelper
+  def reactions_path_for(reactionable)
+    if reactionable.is_a?(Comment)
+      card_comment_reactions_path(reactionable.card, reactionable)
+    else
+      card_reactions_path(reactionable)
+    end
+  end
+
+  def new_reaction_path_for(reactionable)
+    if reactionable.is_a?(Comment)
+      new_card_comment_reaction_path(reactionable.card, reactionable)
+    else
+      new_card_reaction_path(reactionable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    if reaction.reactionable.is_a?(Comment)
+      card_comment_reaction_path(reaction.reactionable.card, reaction.reactionable, reaction)
+    else
+      card_reaction_path(reaction.reactionable, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    if reaction.reactionable.is_a?(Comment)
+      card_comment_reaction_url(reaction.reactionable.card, reaction.reactionable, reaction)
+    else
+      card_reaction_url(reaction.reactionable, reaction)
+    end
+  end
+end
