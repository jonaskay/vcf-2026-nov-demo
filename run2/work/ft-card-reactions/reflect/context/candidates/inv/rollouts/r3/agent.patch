diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..cde7c8f
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+
+    assert_response :success
+  end
+
+  test "new reaction form" do
+    get new_card_reaction_path(@card)
+
+    assert_response :success
+    assert_select "form[action=?]", card_reactions_path(@card)
+    assert_select "form[data-turbo-frame=?]", dom_id(@card, :reacting)
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "create on a draft card is forbidden" do
+    draft = boards(:writebook).cards.create!(status: :drafted, creator: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      post card_reactions_path(draft), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "reaction cannot be destroyed through another card" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    other_card = cards(:layout)
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(other_card, reaction), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "index as JSON" do
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { content: "🚀" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🚀", @response.parsed_body["content"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, Reaction.last), @response.parsed_body["url"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "card detail includes reactions" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "a.reactions__trigger[href=?]", new_card_reaction_path(@card)
+  end
+
+  test "column card preview shows the boost count only when non-zero" do
+    get board_column_path(@card.board, @card.column)
+
+    assert_response :success
+    assert_select ".card__boosts", false
+
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+    @card.reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    get board_column_path(@card.board, @card.column)
+
+    assert_response :success
+    assert_select ".card__boosts strong", text: "2"
+  end
+end
