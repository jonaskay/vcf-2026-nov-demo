diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
index 7f1dd39..5d91f1c 100644
--- a/test/models/reaction_test.rb
+++ b/test/models/reaction_test.rb
@@ -10,4 +10,32 @@ class ReactionTest < ActiveSupport::TestCase
       comments(:logo_1).reactions.create!(content: "Nice!")
     end
   end
+
+  test "creating a card reaction touches the card activity" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.last_active_at } do
+      card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "a reaction must belong to exactly one card or comment" do
+    reaction = Reaction.new(content: "Nice!", card: cards(:logo), comment: comments(:logo_1))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:base], "must belong to either a comment or a card"
+  end
+
+  test "card reactions belong to the card, not its comments" do
+    card = cards(:logo)
+    comments(:logo_1).reactions.create!(content: "👍")
+
+    assert_equal 0, card.reactions.count
+
+    reaction = card.reactions.create!(content: "🚀")
+    assert_equal 1, card.reactions.count
+
+    reaction.destroy
+    assert_equal 0, card.reactions.count
+  end
 end
