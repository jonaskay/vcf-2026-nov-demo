+require "test_helper"
+
+class Boards::CardBoostsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "column card previews show a boost count when the card has reactions" do
+    card = cards(:logo)
+    card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get board_column_path(card.board, card.column)
+
+    assert_response :success
+    assert_select "article##{dom_id(card, :article)} .card__boosts strong", text: "1"
+  end
+
+  test "column card previews hide the boost count when the card has no reactions" do
+    card = cards(:logo)
+
+    get board_column_path(card.board, card.column)
+
+    assert_response :success
+    assert_select "article##{dom_id(card, :article)} .card__boosts", count: 0
+  end
+end
