-      comment.card.touch_last_active_at
+      (comment&.card || card).touch_last_active_at
+    end
+
+    def belongs_to_one_reactable
+      has_comment = comment.present? || comment_id.present?
+      has_card = card.present? || card_id.present?
+
+      if has_comment == has_card
+        errors.add(:base, "must belong to either a comment or a card")
+      elsif comment_id.present? && comment.nil?
+        errors.add(:comment, :required)
+      elsif card_id.present? && card.nil?
+        errors.add(:card, :required)
+      end
     end
 end
