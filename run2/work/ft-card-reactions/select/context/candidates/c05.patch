   end
+
+  test "creating a card reaction touches the card activity" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.last_active_at } do
+      card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "a reaction must belong to exactly one card or comment" do
+    reaction_without_parent = Reaction.new(content: "👍")
+    assert_not reaction_without_parent.valid?
+    assert_includes reaction_without_parent.errors[:base], "must belong to either a card or a comment"
+
+    reaction_with_two_parents = Reaction.new(content: "👍", card: cards(:logo), comment: comments(:logo_1))
+    assert_not reaction_with_two_parents.valid?
+    assert_includes reaction_with_two_parents.errors[:base], "must belong to either a card or a comment"
+  end
 end
