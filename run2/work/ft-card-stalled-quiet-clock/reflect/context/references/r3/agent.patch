     transaction do
       create_system_comment_for(event)
-      touch_last_active_at unless was_just_published?
+      unless was_just_published? && event.action.card_published?
+        touch_last_active_at(burst: event.action.card_reopened?)
+      end
     end
   end
 
-  def touch_last_active_at
+  def touch_last_active_at(burst: false)
     # Not using touch so that we can detect attribute change on callbacks
-    update!(last_active_at: Time.current)
+    activity_at = Time.current
+    attributes = { last_active_at: activity_at }
+    attributes[:last_burst_at] = activity_at if burst
+    update!(attributes)
   end
 
   private
