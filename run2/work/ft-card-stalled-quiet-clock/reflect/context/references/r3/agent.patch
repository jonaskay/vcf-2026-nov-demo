diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..dcec662
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from at least two people within a third of the auto-close period trigger a burst" do
+    freeze_time do
+      card = create_card
+      comment_window = card.auto_postpone_period / 3
+
+      card.comments.create!(creator: users(:david), body: "First", created_at: Time.current - comment_window)
+      card.comments.create!(creator: users(:jz), body: "Second", created_at: Time.current - 1.second)
+      assert_nil card.reload.last_burst_at
+
+      card.comments.create!(creator: users(:david), body: "Third", created_at: Time.current)
+
+      assert_equal Time.current, card.reload.last_burst_at
+    end
+  end
+
+  test "comment burst window follows the board's auto-close period" do
+    freeze_time do
+      boards(:writebook).update!(auto_postpone_period: 3.days.to_i)
+      card = create_card
+      comment_window = card.auto_postpone_period / 3
+
+      card.comments.create!(creator: users(:david), body: "First", created_at: Time.current - comment_window)
+      card.comments.create!(creator: users(:jz), body: "Second", created_at: Time.current - 1.second)
+      card.comments.create!(creator: users(:david), body: "Third", created_at: Time.current)
+
+      assert_equal Time.current, card.reload.last_burst_at
+    end
+  end
+
+  test "comments from one person do not trigger a burst" do
+    freeze_time do
+      card = create_card
+
+      3.times do |i|
+        card.comments.create!(creator: users(:david), body: "Comment #{i}", created_at: Time.current - i.seconds)
+      end
+
+      assert_nil card.reload.last_burst_at
+    end
+  end
+
+  test "comments outside the comment window do not trigger a burst" do
+    freeze_time do
+      card = create_card
+      comment_window = card.auto_postpone_period / 3
+
+      card.comments.create!(creator: users(:david), body: "First", created_at: Time.current - comment_window - 1.second)
+      card.comments.create!(creator: users(:jz), body: "Second", created_at: Time.current - 1.second)
+      card.comments.create!(creator: users(:david), body: "Third", created_at: Time.current)
+
+      assert_nil card.reload.last_burst_at
+    end
+  end
+
+  test "system comments do not count as comments from people" do
+    freeze_time do
+      card = create_card
+
+      card.comments.create!(creator: users(:system), body: "System comment 1", created_at: Time.current - 2.seconds)
+      card.comments.create!(creator: users(:system), body: "System comment 2", created_at: Time.current - 1.second)
+      card.comments.create!(creator: users(:david), body: "Human comment", created_at: Time.current)
+
+      assert_nil card.reload.last_burst_at
+    end
+  end
+
+  test "assigning someone or reopening a card triggers a burst" do
+    freeze_time do
+      card = create_card
+
+      card.assignments.create!(assignee: users(:jz), assigner: users(:david))
+      assert_equal Time.current, card.reload.last_burst_at
+
+      reopened_card = create_card
+      reopened_card.close
+      assert_nil reopened_card.reload.last_burst_at
+
+      reopened_card.reopen
+      assert_equal Time.current, reopened_card.reload.last_burst_at
+    end
+  end
+
+  test "a burst card is stalled after two weeks without activity" do
+    freeze_time do
+      card = create_card
+      card.update!(last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+      assert card.stalled?
+      assert_includes Card.stalled, card
+
+      card.update!(last_active_at: 2.weeks.ago + 1.second)
+      assert_not card.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "closed cards can become stalled after two weeks without activity" do
+    freeze_time do
+      card = create_card
+      card.close
+      card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "any new activity resets the stalled period" do
+    freeze_time do
+      card = create_card
+      card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+      assert card.stalled?
+
+      card.comments.create!(creator: users(:jz), body: "It's alive")
+
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "stalled index only returns burst cards that have been inactive for two weeks" do
+    freeze_time do
+      stalled_card = create_card
+      stalled_card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+      non_burst_card = create_card
+      non_burst_card.update!(last_active_at: 3.weeks.ago)
+
+      recent_card = create_card
+      recent_card.update!(last_burst_at: 3.weeks.ago, last_active_at: 1.week.ago)
+
+      closed_card = create_card
+      closed_card.close
+      closed_card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+      postponed_card = create_card
+      postponed_card.postpone
+      postponed_card.update!(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+      filter = users(:david).filters.new(indexed_by: "stalled", board_ids: [ boards(:writebook).id ])
+      assert_equal [ stalled_card, closed_card, postponed_card ].sort_by(&:number), filter.cards.to_a.sort_by(&:number)
+    end
+  end
+
+  private
+    def create_card
+      boards(:writebook).cards.create!(title: "Burst test card", creator: users(:david), status: "published")
+    end
+end
