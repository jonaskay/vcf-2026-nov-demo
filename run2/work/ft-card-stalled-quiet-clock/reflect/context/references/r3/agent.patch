diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..89c9f2f
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,26 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  COMMENT_BURST_COUNT = 3
+  COMMENT_BURST_WINDOW_DIVISOR = 3
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      where.not(last_burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    last_burst_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def comment_burst?(comment)
+    window = auto_postpone_period / COMMENT_BURST_WINDOW_DIVISOR
+    comment_count, commenter_count = comments.by_user
+      .where(created_at: (comment.created_at - window)..comment.created_at)
+      .pick(Arel.sql("COUNT(comments.id)"), Arel.sql("COUNT(DISTINCT comments.creator_id)"))
+
+    comment_count >= COMMENT_BURST_COUNT && commenter_count >= 2
+  end
+end
