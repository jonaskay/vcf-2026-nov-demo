diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..8bb227b
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments by two people within a third of the board's auto-close period create a burst" do
+    card = cards(:buy_domain)
+    card.board.update!(auto_postpone_period_in_days: 90)
+    now = Time.current
+
+    card.comments.create!(creator: users(:david), body: "First", created_at: now - 30.days)
+    card.comments.create!(creator: users(:jz), body: "Second", created_at: now - 15.days)
+    card.comments.create!(creator: users(:david), body: "Third", created_at: now)
+
+    assert card.reload.last_burst_at
+  end
+
+  test "comments by one person do not create a burst" do
+    card = cards(:buy_domain)
+    card.board.update!(auto_postpone_period_in_days: 30)
+    now = Time.current
+
+    3.times do |n|
+      card.comments.create!(creator: users(:david), body: "Comment #{n}", created_at: now - n.days)
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "system comments do not count as people in a burst" do
+    card = cards(:buy_domain)
+    card.board.update!(auto_postpone_period_in_days: 30)
+    now = Time.current
+
+    card.comments.create!(creator: users(:david), body: "Human", created_at: now - 1.day)
+    2.times do |n|
+      card.comments.create!(creator: users(:system), body: "System #{n}", created_at: now - n.hours)
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments outside one third of the auto-close period do not create a burst" do
+    card = cards(:buy_domain)
+    card.board.update!(auto_postpone_period_in_days: 30)
+    now = Time.current
+
+    card.comments.create!(creator: users(:david), body: "First", created_at: now - 10.days - 1.second)
+    card.comments.create!(creator: users(:jz), body: "Second", created_at: now - 5.days)
+    card.comments.create!(creator: users(:david), body: "Third", created_at: now)
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "an assignment or reopening creates a burst" do
+    assigned_card = cards(:buy_domain)
+    assigned_card.toggle_assignment(users(:jz))
+    assert assigned_card.reload.last_burst_at
+
+    reopened_card = cards(:shipping)
+    reopened_card.reopen
+    assert reopened_card.reload.last_burst_at
+  end
+
+  test "assigning a just-published card counts as activity" do
+    old_time = 3.weeks.ago
+    card = boards(:writebook).cards.create!(
+      creator: users(:david),
+      status: "published",
+      created_at: old_time,
+      last_active_at: old_time
+    )
+
+    card.toggle_assignment(users(:jz))
+
+    assert_operator card.reload.last_active_at, :>, old_time
+    assert_not_predicate card, :stalled?
+  end
+
+  test "stalled cards require a burst and two weeks without activity" do
+    card = cards(:buy_domain)
+    now = Time.current
+    card.update_columns(last_burst_at: now - 2.weeks, last_active_at: now - 2.weeks)
+
+    assert_predicate card, :stalled?
+    assert_includes Card.stalled(now), card
+
+    card.update_columns(last_active_at: now - 2.weeks + 1.second)
+    assert_not card.reload.stalled?
+
+    card.update_columns(last_burst_at: nil, last_active_at: now - 3.weeks)
+    assert_not card.reload.stalled?
+  end
+
+  test "activity resets the stalled period" do
+    card = cards(:buy_domain)
+    card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert_predicate card, :stalled?
+
+    card.comments.create!(creator: users(:jz), body: "A new comment")
+    assert_not card.reload.stalled?
+  end
+end
