diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..7445b62
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,40 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      where.not(last_burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    last_burst_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def record_comment_burst(comment)
+    return if comment.creator.system?
+
+    if comments.by_user
+        .where(created_at: comment_window_for(comment))
+        .group(:card_id)
+        .having("COUNT(*) >= ? AND COUNT(DISTINCT comments.creator_id) >= ?", BURST_COMMENT_COUNT, BURST_COMMENTER_COUNT)
+        .exists?
+      record_burst_at(comment.created_at)
+    end
+  end
+
+  def record_burst_at(time)
+    if last_burst_at.nil? || time > last_burst_at
+      update_column(:last_burst_at, time)
+    end
+  end
+
+  private
+    def comment_window_for(comment)
+      (comment.created_at - auto_postpone_period / 3.0)..comment.created_at
+    end
+end
