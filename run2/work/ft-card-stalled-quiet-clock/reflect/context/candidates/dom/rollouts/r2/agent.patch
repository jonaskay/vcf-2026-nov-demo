diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..8e9766d
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "stalled scope and predicate agree at the two week boundary and with a nil burst" do
+    freeze_time
+
+    cards(:logo).update!(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago - 1.second)
+    cards(:layout).update!(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    cards(:text).update!(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago + 1.second)
+    cards(:buy_domain).update!(burst_at: nil, last_active_at: 3.weeks.ago)
+
+    {
+      logo: true,
+      layout: true,
+      text: false,
+      buy_domain: false
+    }.each do |fixture, expected|
+      card = cards(fixture)
+
+      assert_equal expected, card.stalled?, "#{fixture} predicate"
+      assert_equal expected, Card.stalled.where(id: card.id).exists?, "#{fixture} scope"
+      assert_equal expected, Card.indexed_by("stalled").where(id: card.id).exists?, "#{fixture} index"
+    end
+  end
+
+  test "a comment burst requires three comments from at least two people" do
+    freeze_time
+    card = build_published_card
+    now = Time.current
+
+    create_comment(card, users(:david), created_at: now - 1.day)
+    create_comment(card, users(:jz), created_at: now - 12.hours)
+    assert_nil card.burst_at
+
+    create_comment(card, users(:kevin), created_at: now)
+
+    assert_equal now, card.burst_at
+    assert_equal now, card.last_active_at
+  end
+
+  test "two comments from different people are not enough for a burst" do
+    freeze_time
+    card = build_published_card
+    now = Time.current
+
+    create_comment(card, users(:david), created_at: now - 1.day)
+    create_comment(card, users(:jz), created_at: now)
+
+    assert_nil card.burst_at
+  end
+
+  test "a burst is detected when a newly added backdated comment completes the burst" do
+    freeze_time
+    card = build_published_card
+    now = Time.current
+
+    create_comment(card, users(:david), created_at: now - 1.day)
+    create_comment(card, users(:jz), created_at: now)
+    create_comment(card, users(:kevin), created_at: now - 2.days)
+
+    assert_equal now, card.burst_at
+  end
+
+  test "comments by one person and system comments do not make a burst" do
+    freeze_time
+    card = build_published_card
+    now = Time.current
+
+    create_comment(card, users(:david), created_at: now - 2.days)
+    create_comment(card, users(:david), created_at: now - 1.day)
+    create_comment(card, users(:david), created_at: now)
+    create_comment(card, users(:system), created_at: now)
+
+    assert_nil card.burst_at
+  end
+
+  test "comment burst uses the board period divided by three, inclusive at the boundary" do
+    freeze_time
+    now = Time.current
+    exact_boundary_card = build_published_card
+    outside_window_card = build_published_card
+
+    [ users(:david), users(:jz), users(:kevin) ].zip([ 30.days.ago, 15.days.ago, now ]).each do |creator, created_at|
+      create_comment(exact_boundary_card, creator, created_at: created_at)
+    end
+
+    [ users(:david), users(:jz), users(:kevin) ].zip([ 30.days.ago - 1.second, 15.days.ago, now ]).each do |creator, created_at|
+      create_comment(outside_window_card, creator, created_at: created_at)
+    end
+
+    assert_equal now, exact_boundary_card.burst_at
+    assert_nil outside_window_card.burst_at
+  end
+
+  test "assigning and reopening a card create a burst" do
+    freeze_time
+    card = build_published_card
+
+    card.toggle_assignment(users(:kevin))
+    assert_equal Time.current, card.burst_at
+
+    travel 2.weeks do
+      assert card.stalled?
+      card.toggle_assignment(users(:kevin))
+      assert_equal Time.current, card.last_active_at
+      assert_not card.stalled?
+    end
+
+    closed_card = cards(:shipping)
+    closed_card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    closed_card.reopen
+
+    assert_equal Time.current, closed_card.burst_at
+    assert_not closed_card.stalled?
+  end
+
+  test "later activity restarts the stalled timer after a burst" do
+    freeze_time
+    card = build_published_card
+    card.toggle_assignment(users(:kevin))
+    burst_at = card.burst_at
+
+    travel_to burst_at + 2.weeks do
+      assert card.stalled?
+      card.update!(title: "Still in progress")
+      assert_equal burst_at, card.burst_at
+      assert_not card.stalled?
+    end
+
+    travel_to burst_at + 4.weeks do
+      assert card.stalled?
+    end
+  end
+
+  test "a non-burst card event, comment, or reaction resets the stalled timer" do
+    freeze_time
+    card = build_published_card
+
+    burst_at = 3.weeks.ago
+    card.update!(burst_at: burst_at, last_active_at: burst_at)
+    assert card.stalled?
+    card.update!(title: "A changed title")
+    assert_equal burst_at, card.burst_at
+    assert_not card.stalled?
+
+    card.update!(burst_at: burst_at, last_active_at: burst_at)
+    create_comment(card, users(:david), created_at: Time.current)
+    assert_equal burst_at, card.burst_at
+    assert_not card.stalled?
+
+    card.update!(burst_at: burst_at, last_active_at: burst_at)
+    card.reactions.create!(content: "🎉")
+    assert_equal burst_at, card.burst_at
+    assert_not card.stalled?
+
+    comment = create_comment(card, users(:kevin), created_at: Time.current)
+    card.update!(burst_at: burst_at, last_active_at: burst_at)
+    comment.reactions.create!(content: "👏")
+    assert_equal burst_at, card.burst_at
+    assert_not card.stalled?
+  end
+
+  test "a stalled filter excludes closed and Not Now cards" do
+    freeze_time
+    cards(:shipping).update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    cards(:text).postpone
+    cards(:text).update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    cards(:logo).update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_equal [ cards(:logo) ], filter.cards.to_a
+    assert_includes Filter::INDEXES, "stalled"
+  end
+
+  private
+    def build_published_card
+      boards(:writebook).cards.create!(creator: users(:david), title: "Stalled card test", status: :published)
+    end
+
+    def create_comment(card, creator, created_at:)
+      card.comments.create!(creator: creator, body: "A comment", created_at: created_at)
+    end
+end
