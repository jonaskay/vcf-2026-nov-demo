@@ -35,4 +51,33 @@ module Card::Eventable
     def create_system_comment_for(event)
       SystemCommenter.new(self, event).comment
     end
+
+    def comment_burst?(comment)
+      comment_window = auto_postpone_period.seconds / 3
+      comments_in_window = comments.by_user
+        .where(created_at: (comment.created_at - comment_window)..(comment.created_at + comment_window))
+        .pluck(:created_at, :creator_id)
+        .sort_by(&:first)
+      creator_counts = Hash.new(0)
+      first_comment_index = 0
+
+      comments_in_window.each_with_index do |(created_at, creator_id), last_comment_index|
+        creator_counts[creator_id] += 1
+
+        while comments_in_window[first_comment_index].first < created_at - comment_window
+          first_creator_id = comments_in_window[first_comment_index].last
+          creator_counts[first_creator_id] -= 1
+          creator_counts.delete(first_creator_id) if creator_counts[first_creator_id].zero?
+          first_comment_index += 1
+        end
+
+        if comments_in_window[first_comment_index].first <= comment.created_at &&
+            comment.created_at <= created_at &&
+            last_comment_index - first_comment_index + 1 >= 3 && creator_counts.size >= 2
+          return true
+        end
+      end
+
+      false
+    end
 end
diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..5b09c93
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,18 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  # Keep the last burst as history; last_active_at is the inactivity timer.
+  included do
+    scope :stalled, -> do
+      cutoff = 2.weeks.ago
+      where.not(burst_at: nil)
+        .where("cards.burst_at <= cards.last_active_at")
+        .where(last_active_at: ..cutoff)
+    end
+  end
+
+  def stalled?
+    cutoff = 2.weeks.ago
+    burst_at.present? && last_active_at.present? && burst_at <= last_active_at && last_active_at <= cutoff
+  end
+end
