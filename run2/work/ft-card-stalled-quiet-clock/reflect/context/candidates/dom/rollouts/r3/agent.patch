diff --git a/app/controllers/application_controller.rb b/app/controllers/application_controller.rb
index 87c3ab8..d6bef8b 100644
--- a/app/controllers/application_controller.rb
+++ b/app/controllers/application_controller.rb
@@ -8,6 +8,27 @@ class ApplicationController < ActionController::Base
   include RoutingHeaders
 
   etag { "v1" }
+  etag { paginated_stalled_state_etag }
   stale_when_importmap_changes
   allow_browser versions: :modern
+
+  private
+    def paginated_stalled_state_etag
+      if @page.respond_to?(:records) && (records = @page.records).respond_to?(:klass)
+        case records.klass.name
+        when "Card"
+          records.map { |card| [ card.id, card.stalled? ] }
+        when "Notification"
+          records.preload(:card).map { |notification| [ notification.id, notification.card.stalled? ] }
+        when "Event"
+          records.map { |event| [ event.id, event.card.stalled? ] }
+        when "Search::Record"
+          records.map { |result| [ result.card_id, result.card.stalled? ] }
+        end
+      elsif @cards.respond_to?(:klass) && @cards.klass.name == "Card"
+        @cards.map { |card| [ card.id, card.stalled? ] }
+      elsif @cards.is_a?(Array) && @cards.all? { |card| card.is_a?(Card) }
+        @cards.map { |card| [ card.id, card.stalled? ] }
+      end
+    end
 end
