diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..421ff5a
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "scope and predicate agree on both sides of the inactivity boundary without a column" do
+    freeze_time do
+      card = cards(:buy_domain)
+      assert_nil card.column
+
+      card.update_columns(
+        last_burst_at: 1.month.ago,
+        last_active_at: 2.weeks.ago + 1.second
+      )
+
+      assert_not card.stalled?
+      assert_not_includes Card.stalled, card
+
+      card.update_columns(last_active_at: 2.weeks.ago)
+
+      assert card.stalled?
+      assert_includes Card.stalled, card
+
+      card.update_columns(last_burst_at: nil)
+
+      assert_not card.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "three human comments by at least two people within a third of the board period record a burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      now = Time.current
+      assert_equal 90.days, card.auto_postpone_period.seconds
+
+      card.comments.create!(creator: users(:david), body: "One", created_at: now - 30.days)
+      card.comments.create!(creator: users(:david), body: "Two", created_at: now - 15.days)
+      card.comments.create!(creator: users(:system), body: "System comment", created_at: now - 1.day)
+
+      assert_nil card.last_burst_at, "two comments by one person and a system comment are not a burst"
+
+      burst_comment = card.comments.create!(creator: users(:jz), body: "Three", created_at: now)
+
+      assert_equal burst_comment.created_at, card.last_burst_at
+      assert_equal now, card.last_active_at
+    end
+  end
+
+  test "comments from only one person do not record a burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      now = Time.current
+
+      [ 3.days.ago, 2.days.ago, 1.day.ago ].each do |created_at|
+        card.comments.create!(creator: users(:david), body: "Still here", created_at: created_at)
+      end
+
+      assert_nil card.last_burst_at
+    end
+  end
+
+  test "comments outside the third-period window do not record a burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      now = Time.current
+
+      card.comments.create!(creator: users(:david), body: "One", created_at: now - 31.days)
+      card.comments.create!(creator: users(:jz), body: "Two", created_at: now - 31.days + 1.second)
+      card.comments.create!(creator: users(:david), body: "Three", created_at: now)
+
+      assert_nil card.last_burst_at
+    end
+  end
+
+  test "assignment and reopening both record bursts and update activity on the same card instance" do
+    freeze_time do
+      assigned_card = cards(:buy_domain)
+      assigned_card.toggle_assignment(users(:kevin))
+
+      assert_equal Time.current, assigned_card.last_burst_at
+      assert_equal Time.current, assigned_card.last_active_at
+
+      reopened_card = cards(:shipping)
+      reopened_card.reopen
+
+      assert_equal Time.current, reopened_card.last_burst_at
+      assert_equal Time.current, reopened_card.last_active_at
+    end
+  end
+
+  test "activity on a card after publication records assignment and updates the same instance" do
+    freeze_time do
+      card = boards(:writebook).cards.create!(
+        title: "Published card",
+        creator: users(:david),
+        status: :published
+      )
+
+      card.toggle_assignment(users(:kevin))
+
+      assert_equal Time.current, card.last_burst_at
+      assert_equal Time.current, card.last_active_at
+    end
+  end
+
+  test "ordinary card events reset the inactivity clock without erasing the burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      burst_at = 1.month.ago
+      card.update_columns(last_burst_at: burst_at, last_active_at: 3.weeks.ago)
+      assert card.stalled?
+
+      card.close
+
+      assert_equal burst_at, card.last_burst_at
+      assert_equal Time.current, card.last_active_at
+      assert_not card.stalled?
+    end
+  end
+
+  test "a user comment resets the inactivity clock without erasing the burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      burst_at = 1.month.ago
+      card.update_columns(last_burst_at: burst_at, last_active_at: 3.weeks.ago)
+      assert card.stalled?
+
+      card.comments.create!(creator: users(:david), body: "Still working on this")
+
+      assert_equal burst_at, card.last_burst_at
+      assert_equal Time.current, card.last_active_at
+      assert_not card.stalled?
+    end
+  end
+
+  test "card and comment reactions reset the inactivity clock without erasing the burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      burst_at = 1.month.ago
+      card.update_columns(last_burst_at: burst_at, last_active_at: 3.weeks.ago)
+      card.reactions.create!(content: "🎉")
+
+      assert_equal burst_at, card.last_burst_at
+      assert_equal Time.current, card.last_active_at
+      assert_not card.stalled?
+
+      comment = card.comments.create!(creator: users(:david), body: "A comment")
+      card.update_columns(last_active_at: 3.weeks.ago)
+      comment.reactions.create!(content: "👍")
+
+      assert_equal burst_at, card.last_burst_at
+      assert_equal Time.current, card.last_active_at
+      assert_not card.stalled?
+    end
+  end
+
+  test "notification and event cache versions change when their card becomes stalled" do
+    card = cards(:logo)
+    card.update_columns(last_burst_at: 1.month.ago, last_active_at: 13.days.ago)
+    notification = notifications(:logo_assignment_kevin)
+    event = events(:logo_assignment_jz)
+    notification_version = notification.cache_version
+    event_version = event.cache_version
+
+    travel 2.days do
+      assert_not_equal notification_version, notification.cache_version
+      assert_not_equal event_version, event.cache_version
+    end
+  end
+
+  test "the card cache version changes when the card becomes stalled without a database update" do
+    card = cards(:logo)
+    card.update_columns(last_burst_at: 1.month.ago, last_active_at: 13.days.ago)
+    cache_version = card.cache_version
+
+    travel 2.days do
+      assert card.stalled?
+      assert_not_equal cache_version, card.cache_version
+    end
+  end
+end
