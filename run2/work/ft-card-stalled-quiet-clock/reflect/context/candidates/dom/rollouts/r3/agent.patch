diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..e80ced1
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,66 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of: Time.current) do
+      where.not(last_burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    last_burst_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def record_burst_at(time)
+    update!(last_burst_at: time) if last_burst_at.nil? || time > last_burst_at
+  end
+
+  def record_comment_activity(comment)
+    record_burst_at(comment.created_at) if burst_comment?(comment)
+    touch_last_active_at
+  end
+
+  def cache_version
+    "#{super}-#{stalled? ? 'stalled' : 'not-stalled'}"
+  end
+
+  private
+    def burst_comment?(comment)
+      window = auto_postpone_period.seconds / 3
+      window_comments = comments.by_user
+        .where(created_at: (comment.created_at - window)..(comment.created_at + window))
+        .order(:created_at, :id)
+        .pluck(:id, :creator_id, :created_at)
+      comment_index = window_comments.index { |id, _creator_id, _created_at| id == comment.id }
+
+      if comment_index
+        comment_window_has_burst?(window_comments, comment_index, window)
+      else
+        false
+      end
+    end
+
+    def comment_window_has_burst?(window_comments, comment_index, window)
+      creator_counts = Hash.new(0)
+      first_index = 0
+
+      window_comments.each_with_index do |(_id, creator_id, created_at), last_index|
+        creator_counts[creator_id] += 1
+
+        while created_at - window_comments[first_index][2] > window
+          first_creator_id = window_comments[first_index][1]
+          creator_counts[first_creator_id] -= 1
+          creator_counts.delete(first_creator_id) if creator_counts[first_creator_id].zero?
+          first_index += 1
+        end
+
+        if last_index - first_index + 1 >= 3 && creator_counts.size >= 2 && comment_index >= first_index && comment_index <= last_index
+          return true
+        end
+      end
+
+      false
+    end
+end
