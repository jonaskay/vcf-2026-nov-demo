@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Account::DataTransfer::CardRecordSetTest < ActiveSupport::TestCase
+  test "checking older card exports without burst_at is supported" do
+    record_id = "test_card_id_12345678901234"
+    data = Card.column_names.index_with { nil }.except("burst_at").merge(
+      "id" => record_id,
+      "account_id" => "nonexistent_account_id_1234567",
+      "board_id" => "nonexistent_board_id_12345678",
+      "creator_id" => "nonexistent_user_id_123456789",
+      "created_at" => Time.current.iso8601,
+      "last_active_at" => Time.current.iso8601,
+      "number" => 1,
+      "status" => "published",
+      "updated_at" => Time.current.iso8601
+    )
+
+    record_set = Account::DataTransfer::CardRecordSet.new(accounts(:"37s"))
+
+    assert_nothing_raised do
+      record_set.check(from: build_reader(dir: "cards", data: data))
+    end
+  end
+
+  private
+    def build_reader(dir:, data:)
+      tempfile = Tempfile.new([ "card_record_set_test", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file("data/#{dir}/#{data['id']}.json", data.to_json)
+      writer.close
+      tempfile.rewind
+
+      @tempfiles ||= []
+      @tempfiles << tempfile
+
+      ZipFile::Reader.new(tempfile)
+    end
+
+    def teardown
+      @tempfiles&.each { |file| file.close; file.unlink }
+    end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..32645f0
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+  end
+
+  test "three comments from at least two people in a third of the auto-close period create a burst" do
+    freeze_time do
+      card = cards(:buy_domain)
+      create_comment(card, users(:david))
+      create_comment(card, users(:kevin))
+      create_comment(card, users(:david))
+
+      assert_equal Time.current, card.reload.burst_at
+    end
+  end
+
+  test "comments exactly one third of the auto-close period apart count" do
+    card = cards(:buy_domain)
+    timestamp = Time.current
+
+    create_comment(card, users(:david), at: timestamp)
+    create_comment(card, users(:kevin), at: timestamp + 1.day)
+    create_comment(card, users(:david), at: timestamp + 1.day)
+
+    assert_predicate card.reload, :burst_at
+  end
+
+  test "comments from only one person do not create a burst" do
+    card = cards(:buy_domain)
+
+    3.times { create_comment(card, users(:david)) }
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments outside a third of the auto-close period do not create a burst" do
+    card = cards(:buy_domain)
+
+    travel_to 1.day.ago - 1.second do
+      create_comment(card, users(:david))
+      create_comment(card, users(:kevin))
+    end
+    create_comment(card, users(:david))
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "system comments do not count toward a comment burst" do
+    card = cards(:buy_domain)
+
+    create_comment(card, users(:system))
+    create_comment(card, users(:david))
+    create_comment(card, users(:david))
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "an assignment creates a burst and card activity resets the stalled timer" do
+    freeze_time do
+      card = cards(:buy_domain)
+      card.toggle_assignment(users(:kevin))
+
+      assert_equal Time.current, card.reload.burst_at
+    end
+
+    travel 15.days
+    assert_predicate cards(:buy_domain).reload, :stalled?
+
+    cards(:buy_domain).comments.create!(creator: users(:david), body: "Still working on this")
+    assert_not_predicate cards(:buy_domain).reload, :stalled?
+
+    travel 14.days
+    assert_predicate cards(:buy_domain).reload, :stalled?
+  end
+
+  test "publishing an assigned draft resets the stalled timer" do
+    draft = boards(:writebook).cards.create!(creator: users(:david), status: :drafted)
+    draft.toggle_assignment(users(:kevin))
+
+    travel 15.days
+    assert_not_predicate draft.reload, :stalled?
+
+    draft.publish
+    assert_not_predicate draft.reload, :stalled?
+  end
+
+  test "updating a checklist item resets the stalled timer" do
+    card = cards(:buy_domain)
+    card.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert_predicate card.reload, :stalled?
+
+    card.steps.create!(content: "A new step")
+    assert_not_predicate card, :stalled?
+  end
+
+  test "reopening a card creates a burst but closing it does not" do
+    freeze_time do
+      card = cards(:buy_domain)
+      card.close
+
+      assert_nil card.reload.burst_at
+
+      card.reopen
+      assert_equal Time.current, card.reload.burst_at
+    end
+  end
+
+  test "a burst is stalled after two weeks without activity" do
+    card = cards(:buy_domain)
+    card.toggle_assignment(users(:kevin))
+    card.update_column(:last_active_at, 2.weeks.ago)
+
+    assert_predicate card.reload, :stalled?
+
+    card.update_column(:last_active_at, 2.weeks.ago + 1.second)
+    assert_not_predicate card.reload, :stalled?
+  end
+
+  test "stalled index only includes cards that had a burst and have been inactive for two weeks" do
+    stalled_card = cards(:buy_domain)
+    stalled_card.toggle_assignment(users(:kevin))
+    stalled_card.update_column(:last_active_at, 3.weeks.ago)
+
+    active_card = cards(:text)
+    active_card.toggle_assignment(users(:kevin))
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, stalled_card
+    assert_not_includes filter.cards, active_card
+    assert_includes Filter::INDEXES, "stalled"
+  end
+
+  private
+    def create_comment(card, creator, at: Time.current)
+      card.comments.create!(creator: creator, body: "A comment", created_at: at)
+    end
+end
