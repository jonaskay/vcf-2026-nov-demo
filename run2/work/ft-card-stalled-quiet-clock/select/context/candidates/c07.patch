diff --git a/db/migrate/20261117190458_add_burst_at_to_cards.rb b/db/migrate/20261117190458_add_burst_at_to_cards.rb
new file mode 100644
index 0000000..f6232ac
--- /dev/null
+++ b/db/migrate/20261117190458_add_burst_at_to_cards.rb
@@ -0,0 +1,91 @@
+class AddBurstAtToCards < ActiveRecord::Migration[8.2]
+  def up
+    add_column :cards, :burst_at, :datetime
+    add_index :comments, [ :card_id, :created_at, :creator_id ]
+
+    backfill_bursts_from_events
+    backfill_bursts_from_assignments
+    backfill_bursts_from_comments
+  end
+
+  def down
+    remove_index :comments, [ :card_id, :created_at, :creator_id ]
+    remove_column :cards, :burst_at
+  end
+
+  private
+    def backfill_bursts_from_events
+      execute <<~SQL
+        UPDATE cards
+        SET burst_at = (
+          SELECT MIN(events.created_at)
+          FROM events
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND events.action IN ('card_assigned', 'card_reopened')
+        )
+        WHERE EXISTS (
+          SELECT 1
+          FROM events
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND events.action IN ('card_assigned', 'card_reopened')
+        )
+      SQL
+    end
+
+    def backfill_bursts_from_assignments
+      execute <<~SQL
+        UPDATE cards
+        SET burst_at = (
+          SELECT MIN(assignments.created_at)
+          FROM assignments
+          WHERE assignments.card_id = cards.id
+        )
+        WHERE burst_at IS NULL
+          AND EXISTS (SELECT 1 FROM assignments WHERE assignments.card_id = cards.id)
+      SQL
+    end
+
+    def backfill_bursts_from_comments
+      period = "COALESCE(board_entropy.auto_postpone_period, account_entropy.auto_postpone_period, #{30.days.to_i})"
+      burst_window_start = connection.date_subtract("burst_comment.created_at", "(#{period} / 3)")
+
+      execute <<~SQL
+        UPDATE cards
+        SET burst_at = (
+          SELECT MIN(burst_comment.created_at)
+          FROM comments AS burst_comment
+          INNER JOIN users AS burst_creator ON burst_creator.id = burst_comment.creator_id
+          INNER JOIN boards AS burst_board ON burst_board.id = cards.board_id
+          LEFT OUTER JOIN entropies AS board_entropy
+            ON board_entropy.container_type = 'Board'
+            AND board_entropy.container_id = burst_board.id
+          LEFT OUTER JOIN entropies AS account_entropy
+            ON account_entropy.container_type = 'Account'
+            AND account_entropy.container_id = cards.account_id
+          WHERE burst_comment.card_id = cards.id
+            AND burst_creator.role <> 'system'
+            AND (
+              SELECT COUNT(*)
+              FROM comments AS recent_comment
+              INNER JOIN users AS recent_creator ON recent_creator.id = recent_comment.creator_id
+              WHERE recent_comment.card_id = cards.id
+                AND recent_creator.role <> 'system'
+                AND recent_comment.created_at >= #{burst_window_start}
+                AND recent_comment.created_at <= burst_comment.created_at
+            ) >= 3
+            AND (
+              SELECT COUNT(DISTINCT recent_comment.creator_id)
+              FROM comments AS recent_comment
+              INNER JOIN users AS recent_creator ON recent_creator.id = recent_comment.creator_id
+              WHERE recent_comment.card_id = cards.id
+                AND recent_creator.role <> 'system'
+                AND recent_comment.created_at >= #{burst_window_start}
+                AND recent_comment.created_at <= burst_comment.created_at
+            ) >= 2
+        )
+        WHERE burst_at IS NULL
+      SQL
+    end
+end
