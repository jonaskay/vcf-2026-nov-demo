diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..18a82f9
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,34 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_EVENT_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      open.published.where.not(burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    published? && open? && burst_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def mark_burst_at(time)
+    if burst_at.nil?
+      update_column(:burst_at, time)
+    end
+  end
+
+  def record_burst_from_comment(comment)
+    return if comment.creator.system?
+
+    window = auto_postpone_period / 3
+    recent_comments = comments.by_user.where(created_at: (comment.created_at - window)..comment.created_at)
+    qualifying_comments = recent_comments
+      .group(:card_id)
+      .having("COUNT(*) >= 3 AND COUNT(DISTINCT comments.creator_id) >= 2")
+
+    mark_burst_at(comment.created_at) if qualifying_comments.exists?
+  end
+end
