diff --git a/test/controllers/cards_stalled_test.rb b/test/controllers/cards_stalled_test.rb
new file mode 100644
index 0000000..37d5e75
--- /dev/null
+++ b/test/controllers/cards_stalled_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class CardsStalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "the stalled index returns stalled cards as JSON" do
+    card = cards(:logo)
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_equal [ card.number ], @response.parsed_body.pluck("number")
+    assert_equal [ true ], @response.parsed_body.pluck("stalled")
+  end
+
+  test "stalled cards display a badge on the card index and detail page" do
+    card = cards(:logo)
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    get cards_path(indexed_by: "stalled")
+
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+
+  test "cached card previews update when the stalled threshold is crossed" do
+    card = cards(:logo)
+    card.update_columns burst_at: nil, last_active_at: Time.current
+
+    with_actionview_partial_caching do
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..de0bba9
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "assigning a card records a burst" do
+    card = cards(:buy_domain)
+
+    freeze_time do
+      card.toggle_assignment(users(:kevin))
+
+      assert_equal Time.current, card.reload.burst_at
+      assert_not card.stalled?
+    end
+  end
+
+  test "reopening a card records a burst" do
+    card = cards(:shipping)
+
+    freeze_time do
+      card.reopen
+
+      assert_equal Time.current, card.reload.burst_at
+    end
+  end
+
+  test "unassigning a card does not create a burst" do
+    card = cards(:logo)
+
+    card.toggle_assignment(users(:jz))
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "the stalled index includes closed cards with a burst" do
+    card = cards(:shipping)
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    filter = users(:kevin).filters.new(creator: users(:kevin), indexed_by: "stalled")
+
+    assert_includes filter.cards, card
+  end
+
+  test "three comments from two people within one third of the board period record a burst" do
+    card = cards(:buy_domain)
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days.to_i)
+
+    freeze_time do
+      card.comments.create!(creator: users(:david), body: "First", created_at: 23.hours.ago)
+      card.comments.create!(creator: users(:kevin), body: "Second", created_at: 12.hours.ago)
+      card.comments.create!(creator: users(:david), body: "Third", created_at: Time.current)
+
+      assert_equal Time.current, card.reload.burst_at
+    end
+  end
+
+  test "comment bursts require multiple people and fit inside the board period window" do
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days.to_i)
+
+    same_author_card = cards(:buy_domain)
+    3.times do |index|
+      same_author_card.comments.create!(creator: users(:david), body: "Comment #{index}")
+    end
+    assert_nil same_author_card.reload.burst_at
+
+    out_of_window_card = boards(:writebook).cards.create!(
+      creator: users(:david), title: "Outside the comment window", status: :published
+    )
+    out_of_window_card.comments.create!(creator: users(:david), body: "Old", created_at: 1.day.ago - 1.second)
+    out_of_window_card.comments.create!(creator: users(:david), body: "Recent")
+    out_of_window_card.comments.create!(creator: users(:kevin), body: "Recent too")
+    assert_nil out_of_window_card.reload.burst_at
+  end
+
+  test "system comments do not count toward a comment burst" do
+    card = cards(:buy_domain)
+
+    card.comments.create!(creator: users(:david), body: "First")
+    card.comments.create!(creator: users(:kevin), body: "Second")
+    card.comments.create!(creator: card.account.system_user, body: "System comment")
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "a burst becomes stalled after two weeks without activity and activity resets the timer" do
+    card = cards(:buy_domain)
+
+    freeze_time do
+      card.toggle_assignment(users(:kevin))
+      card.update_column :last_active_at, 14.days.ago
+
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+
+      card.comments.create!(creator: users(:david), body: "Back to work")
+
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "cards without bursts are not stalled even if inactive for weeks" do
+    card = cards(:layout)
+    card.update_column :last_active_at, 3.weeks.ago
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "the stalled index is available in card filters" do
+    stalled_card = cards(:buy_domain)
+    stalled_card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    filter = users(:kevin).filters.new(creator: users(:kevin), indexed_by: "stalled")
+
+    assert_equal [ stalled_card ], filter.cards.to_a
+  end
+end
