diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..481d35b
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,35 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      where.not(burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    end
+  end
+
+  def stalled?(as_of = Time.current)
+    burst_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def record_burst(at: Time.current)
+    update_column(:burst_at, at) unless burst_at
+  end
+
+  def record_comment_burst(comment)
+    return if burst_at.present? || comment.creator.system?
+
+    window = board.auto_postpone_period / 3.0
+    comments_by_author = comments
+      .joins(:creator)
+      .where.not(users: { role: :system })
+      .where(created_at: (comment.created_at - window)..comment.created_at)
+      .group(:creator_id)
+      .count
+
+    if comments_by_author.size >= 2 && comments_by_author.values.sum >= 3
+      record_burst(at: comment.created_at)
+    end
+  end
+end
