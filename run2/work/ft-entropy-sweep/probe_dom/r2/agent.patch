+        # Every configured period is at least the minimum, so this conservative
+        # cutoff keeps the sweep within a range of the last_active_at index.
+        .where("last_active_at <= #{connection.date_subtract('?', minimum_period.to_s)}", now)
     end
 
     scope :postponing_soon, -> do
