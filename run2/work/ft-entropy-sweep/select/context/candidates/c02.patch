@@ -59,6 +59,31 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "due scope respects the board period, account fallback, and cutoff boundary" do
+    freeze_time
+
+    now = Time.now.change(usec: 0)
+    account_entropy = entropies("37s_account")
+    board_entropy = entropies(:writebook_board)
+    account_entropy.update!(auto_postpone_period: 30.days)
+    board_entropy.update!(auto_postpone_period: 7.days)
+
+    due_card = cards(:logo)
+    not_yet_due_card = cards(:shipping)
+    due_card.update!(last_active_at: now - 7.days)
+    not_yet_due_card.update!(last_active_at: now - 7.days + 1.second)
+
+    assert_includes Card.due_to_be_postponed, due_card
+    assert_not_includes Card.due_to_be_postponed, not_yet_due_card
+
+    board_entropy.destroy
+    due_card.update!(last_active_at: now - 30.days)
+    not_yet_due_card.update!(last_active_at: now - 30.days + 1.second)
+
+    assert_includes Card.due_to_be_postponed, due_card
+    assert_not_includes Card.due_to_be_postponed, not_yet_due_card
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
