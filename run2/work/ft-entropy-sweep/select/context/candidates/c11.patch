--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,14 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due cards are searched by status and last active time on SQLite" do
+    skip "SQLite-specific query plan" unless Fizzy.db_adapter.sqlite?
+
+    relation = Card.due_to_be_postponed.order("cards.id ASC").limit(1_000)
+    plan = Card.connection.execute("EXPLAIN QUERY PLAN #{relation.to_sql}")
+    details = plan.map { |step| step["detail"] }
+
+    assert_includes details, "SEARCH cards USING INDEX index_cards_on_status_and_last_active_at (status=? AND last_active_at<?)"
+  end
 end
