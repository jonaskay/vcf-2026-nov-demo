diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..d1a3116 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -47,6 +47,25 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone due cards with entropy periods below the allowed minimum" do
+    entropies(:writebook_board).update_column(:auto_postpone_period, 1.hour)
+    cards(:logo).update!(last_active_at: 2.hours.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+  end
+
+  test "due-card lookup uses the entropy sweep index on SQLite" do
+    if ActiveRecord::Base.connection.adapter_name == "SQLite"
+      relation = Card.due_to_be_postponed.order(:last_active_at, :id).limit(1)
+      plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{relation.to_sql}")
+      cards_step = plan.find { |step| step["detail"].include?("cards") }
+
+      assert_match(/SEARCH cards USING INDEX index_cards_on_status_and_last_active_at_and_id/, cards_step["detail"])
+    end
+  end
+
   test "auto postpone all due using entropy defined at the board level" do
     cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
     cards(:shipping).update!(last_active_at: 1.day.from_now - entropies(:writebook_board).auto_postpone_period)
