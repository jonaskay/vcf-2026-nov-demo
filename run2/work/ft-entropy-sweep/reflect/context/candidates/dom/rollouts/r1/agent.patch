index ebaad78..cb4d8b3 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,13 +1,20 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  AUTO_POSTPONE_BATCH_SIZE = 1000
+
   included do
     scope :due_to_be_postponed, -> do
+      now = Time.now
+
       active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
+        # Every validated entropy period is at least this long. This redundant
+        # constant cutoff makes the global sweep eligible for a range scan.
+        .where("cards.last_active_at <= ?", now - Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.min.seconds)
     end
 
     scope :postponing_soon, -> do
@@ -25,8 +32,25 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      due_cards = due_to_be_postponed
+      cursor = nil
+
+      loop do
+        batch = due_cards
+        if cursor
+          batch = batch.where("(cards.last_active_at, cards.id) > (?, ?)", *cursor)
+        end
+
+        batch = batch.reorder(last_active_at: :asc, id: :asc).limit(AUTO_POSTPONE_BATCH_SIZE).to_a
+        break if batch.empty?
+
+        # Capture the cursor before auto_postpone updates last_active_at. The
+        # processed cards also leave the due scope, so they cannot reappear.
+        cursor = [ batch.last.last_active_at, batch.last.id ]
+
+        batch.each do |card|
+          card.auto_postpone(user: card.account.system_user)
+        end
       end
     end
   end
