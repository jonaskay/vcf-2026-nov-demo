+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -25,8 +27,39 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+
+      system_users = {}
+
+      Board.preload(:entropy, account: :entropy).find_each do |board|
+        period = board.entropy&.auto_postpone_period
+
+        if period
+          due_cards = board.cards.active
+            .where("cards.last_active_at <= #{connection.date_subtract('?', '?')}", now, period)
+          cursor = nil
+
+          loop do
+            relation = due_cards
+            relation = relation.where("(cards.last_active_at, cards.id) > (?, ?)", *cursor) if cursor
+
+            batch = relation
+              .order(last_active_at: :asc, id: :asc)
+              .limit(AUTO_POSTPONE_BATCH_SIZE)
+              .preload(:account)
+              .to_a
+
+            break if batch.empty?
+
+            # Capture the cursor before auto_postpone updates last_active_at.
+            cursor = [ batch.last.last_active_at, batch.last.id ]
+
+            batch.each do |card|
+              system_user = system_users[card.account_id] ||= card.account.system_user
+              card.auto_postpone(user: system_user)
+            end
+          end
+        end
       end
     end
   end
