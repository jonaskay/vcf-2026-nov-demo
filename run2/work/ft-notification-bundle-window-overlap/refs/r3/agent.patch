@@ -0,0 +1,11 @@
+class Notification::EmailBundleJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  include SmtpDeliveryErrorHandling
+
+  def perform(bundle)
+    bundle.deliver
+  rescue Net::SMTPSyntaxError, Net::SMTPFatalError
+    bundle.discard
+    raise
+  end
+end
