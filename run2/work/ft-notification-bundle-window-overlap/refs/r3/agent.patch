diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..902d132
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @settings = @user.settings
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "first notification opens a window and later notifications join it" do
+    travel_to Time.zone.parse("2026-03-04 12:00:00") do
+      first_notification = create_notification(events(:layout_published))
+      bundle = Notification::EmailBundle.find_by!(user: @user)
+
+      assert_equal Time.current, bundle.started_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_equal [ first_notification ], bundle.notifications.to_a
+
+      job_count = enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleJob }
+      second_notification = create_notification(events(:buy_domain_sent_back_to_triage))
+
+      assert_equal bundle, Notification::EmailBundle.find_by!(user: @user)
+      assert_equal [ first_notification.id, second_notification.id ].sort, bundle.reload.notifications.ids.sort
+      assert_equal job_count, enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleJob }
+    end
+  end
+
+  test "late notifications join the window that is still waiting to be delivered" do
+    travel_to Time.zone.parse("2026-03-04 12:00:00") do
+      @first_notification = create_notification(events(:layout_published))
+      @bundle = Notification::EmailBundle.find_by!(user: @user)
+    end
+
+    travel_to @bundle.ends_at + 30.minutes do
+      late_notification = create_notification(events(:buy_domain_sent_back_to_triage))
+
+      assert_equal [ @first_notification.id, late_notification.id ].sort, @bundle.reload.notifications.ids.sort
+      assert_equal 1, Notification::EmailBundle.where(user: @user).count
+      assert_equal @bundle.ends_at, @bundle.reload.ends_at
+    end
+  end
+
+  test "delivery sends one digest and only then allows a new window" do
+    travel_to Time.zone.parse("2026-03-04 12:00:00") do
+      @first_notification = create_notification(events(:layout_published))
+      @bundle = Notification::EmailBundle.find_by!(user: @user)
+    end
+
+    travel_to @bundle.ends_at + 30.minutes do
+      late_notification = create_notification(events(:buy_domain_sent_back_to_triage))
+
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        Notification::EmailBundleJob.perform_now(@bundle)
+      end
+
+      assert_not Notification::EmailBundle.exists?(@bundle.id)
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        Notification::EmailBundleJob.perform_now(@bundle)
+      end
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_match @first_notification.card.title, email.body.encoded
+      assert_match late_notification.card.title, email.body.encoded
+
+      next_notification = create_notification(events(:text_published))
+      next_bundle = Notification::EmailBundle.find_by!(user: @user)
+      assert_equal Time.current, next_bundle.started_at
+      assert_equal [ next_notification ], next_bundle.notifications.to_a
+    end
+  end
+
+  test "running the delivery job early leaves the open window in place" do
+    create_notification(events(:layout_published))
+    bundle = Notification::EmailBundle.find_by!(user: @user)
+    job_count = enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleJob }
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      Notification::EmailBundleJob.perform_now(bundle)
+    end
+
+    assert Notification::EmailBundle.exists?(bundle.id)
+    assert_equal job_count + 1, enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleJob }
+  end
+
+  test "permanent email errors discard the pending window" do
+    create_notification(events(:layout_published))
+    bundle = Notification::EmailBundle.find_by!(user: @user)
+    travel_to bundle.ends_at + 1.second do
+      delivery = stub
+      delivery.expects(:deliver_now).raises(Net::SMTPFatalError, Net::SMTP::Response.parse("550 5.1.1 Recipient not found"))
+      NotificationMailer.expects(:email_bundle).with(bundle).returns(delivery)
+
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        Notification::EmailBundleJob.perform_now(bundle)
+      end
+
+      assert_not Notification::EmailBundle.exists?(bundle.id)
+    end
+  end
+
+  test "frequency determines the window length" do
+    assert_equal 4.hours, User::Settings::BUNDLE_EMAIL_INTERVALS["every_few_hours"]
+    assert_equal 1.day, User::Settings::BUNDLE_EMAIL_INTERVALS["daily"]
+    assert_equal 1.week, User::Settings::BUNDLE_EMAIL_INTERVALS["weekly"]
+  end
+
+  test "never does not open a window" do
+    @settings.update!(bundle_email_frequency: "never")
+
+    create_notification(events(:layout_published))
+
+    assert_not Notification::EmailBundle.exists?(user: @user)
+  end
+
+  test "disabling email digests discards the pending window" do
+    create_notification(events(:layout_published))
+
+    assert_difference -> { Notification::EmailBundle.count }, -1 do
+      @settings.update!(bundle_email_frequency: "never")
+    end
+  end
+
+  test "frequency must be supported" do
+    @settings.bundle_email_frequency = "hourly"
