diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..c81e79a
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,80 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::EmailBundleItem", foreign_key: :notification_email_bundle_id, dependent: :destroy
+  has_many :notifications, through: :items
+
+  class << self
+    def add_notification(notification)
+      return if notification.creator.system? || !notification.user.active? || !notification.account.active?
+
+      settings = User::Settings.find_by(user_id: notification.user_id)
+      if settings
+        settings.with_lock do
+          if settings.bundle_email_frequency != "never"
+            bundle = find_by(user_id: notification.user_id)
+            if bundle
+              bundle.items.create_or_find_by!(notification: notification)
+            else
+              create_bundle(notification, settings)
+            end
+          end
+        end
+      end
+    end
+
+    private
+      def create_bundle(notification, settings)
+        started_at = Time.current
+        bundle = notification.user.create_notification_email_bundle!(
+          account: notification.account,
+          started_at: started_at,
+          ends_at: started_at + settings.bundle_email_interval
+        )
+        bundle.items.create!(notification: notification)
+
+        Current.with_account(notification.account) do
+          Notification::EmailBundleJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+        end
+      end
+  end
+
+  def discard
+    if settings = User::Settings.find_by(user_id: user_id)
+      settings.with_lock do
+        destroy if self.class.exists?(id: id, user_id: user_id)
+      end
+    else
+      destroy
+    end
+  end
+
+  def deliver
+    if settings = User::Settings.find_by(user_id: user_id)
+      settings.with_lock do
+        if self.class.exists?(id: id, user_id: user_id)
+          deliver_now(settings)
+        end
+      end
+    else
+      destroy
+    end
+  end
+
+  private
+    def deliver_now(settings)
+      if ends_at > Time.current
+        Notification::EmailBundleJob.set(wait_until: ends_at).perform_later(self)
+      elsif settings.bundle_email_frequency == "never" || !deliverable? || !notifications.exists?
+        destroy!
+      else
+        NotificationMailer.email_bundle(self).deliver_now
+        destroy!
+      end
+    end
+
+    def deliverable?
+      user.active? && account.active? && user.identity.present?
+    end
+end
