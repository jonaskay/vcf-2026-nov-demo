diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..ea566f6
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,72 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_and_belongs_to_many :notifications,
+    join_table: :notification_email_bundles_notifications,
+    foreign_key: :notification_email_bundle_id,
+    association_foreign_key: :notification_id
+
+  after_create_commit :send_later
+
+  class << self
+    def add_notification(notification, at: nil)
+      settings = notification.user.settings
+      return unless settings
+      return if notification.creator.system?
+
+      bundle = nil
+
+      # Locking settings serializes arrivals and delivery for this user.
+      settings.with_lock do
+        now = Time.current
+
+        if duration = settings.bundle_email_frequency_duration
+          bundle = find_or_initialize_by(user: notification.user)
+
+          if bundle.new_record?
+            bundle.account = notification.account
+            bundle.opened_at = [ at || now, now ].max
+            bundle.send_at = bundle.opened_at + duration
+            bundle.save!
+          end
+
+          bundle.notifications << notification unless bundle.notifications.exists?(id: notification.id)
+        end
+      end
+
+      bundle
+    end
+  end
+
+  def deliver
+    settings = user.settings
+
+    # Late arrivals either join this bundle or open the next one after delivery.
+    settings.with_lock do
+      if pending_bundle = self.class.find_by(id: id)
+        if pending_bundle.send_at > Time.current
+          pending_bundle.send_later
+        elsif should_deliver?(pending_bundle, settings)
+          NotificationMailer.email_bundle(pending_bundle).deliver_now
+          pending_bundle.destroy!
+        else
+          pending_bundle.destroy!
+        end
+      end
+    end
+  end
+
+  def send_later
+    Notification::EmailBundleJob.set(wait_until: send_at).perform_later(self)
+  end
+
+  private
+    def should_deliver?(bundle, settings)
+      settings.bundle_email_frequency_duration.present? &&
+        bundle.notifications.exists? &&
+        bundle.user.active? &&
+        bundle.user.identity.present? &&
+        bundle.account.active?
+    end
+end
