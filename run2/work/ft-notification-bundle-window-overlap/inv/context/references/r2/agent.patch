@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Account::DataTransfer::UserSettingsRecordSetTest < ActiveSupport::TestCase
+  test "defaults the email frequency when importing an older settings record" do
+    account = Account.create!(name: "Importing Account")
+    user = account.users.create!(name: "Sam")
+    settings = user.settings
+    data = settings.attributes.except("bundle_email_frequency").merge("account_id" => "unimported_account_id", "user_id" => "unimported_user_id")
+    settings.destroy!
+
+    tempfile = Tempfile.new([ "user_settings", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("data/user_settings/#{settings.id}.json", data.to_json)
+    writer.close
+    tempfile.rewind
+
+    record_set = Account::DataTransfer::UserSettingsRecordSet.new(account)
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert_nothing_raised { record_set.check(from: reader) }
+    record_set.import(from: reader)
+
+    assert_equal "never", User::Settings.find(settings.id).bundle_email_frequency
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+    account&.destroy
+  end
+end
diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..0f780fa
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "the first notification opens a four hour email window" do
+    first_notification = notifications(:layout_commented_kevin)
+    opened_at = Time.utc(2026, 1, 1, 9)
+    bundle = nil
+
+    assert_enqueued_with job: Notification::EmailBundleJob, at: opened_at + 4.hours do
+      bundle = travel_to(opened_at) do
+        Notification::EmailBundle.add_notification(first_notification)
+      end
+    end
+
+    assert_equal opened_at, bundle.opened_at
+    assert_equal opened_at + 4.hours, bundle.send_at
+    assert_equal [ first_notification ], bundle.notifications.to_a
+  end
+
+  test "notifications arriving late join the already opened window" do
+    first_notification = notifications(:layout_commented_kevin)
+    second_notification = notifications(:logo_assignment_kevin)
+    opened_at = Time.utc(2026, 1, 1, 9)
+
+    bundle = travel_to(opened_at) do
+      Notification::EmailBundle.add_notification(first_notification)
+    end
+
+    travel_to(bundle.send_at + 2.hours) do
+      assert_equal bundle.id, Notification::EmailBundle.add_notification(second_notification).id
+    end
+
+    assert_equal opened_at, bundle.reload.opened_at
+    assert_equal opened_at + 4.hours, bundle.send_at
+    assert_equal [ first_notification, second_notification ].sort_by(&:id), bundle.notifications.sort_by(&:id)
+    assert_equal 1, enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleJob }
+  end
+
+  test "delivers all notifications in one email for the window" do
+    first_notification = notifications(:layout_commented_kevin)
+    second_notification = notifications(:logo_assignment_kevin)
+    bundle = Notification::EmailBundle.add_notification(first_notification)
+    Notification::EmailBundle.add_notification(second_notification)
+
+    travel_to(bundle.send_at + 1.second) do
+      assert_emails 1 do
+        Notification::EmailBundleJob.perform_now(bundle)
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match "Layout is broken", email.body.encoded
+    assert_match "The logo isn't big enough", email.body.encoded
+    assert_not Notification::EmailBundle.exists?(bundle.id)
+  end
+
+  test "a new window opens after the previous one has been delivered" do
+    first_notification = notifications(:layout_commented_kevin)
+    second_notification = notifications(:logo_assignment_kevin)
+    bundle = travel_to(Time.utc(2026, 1, 1, 9)) do
+      Notification::EmailBundle.add_notification(first_notification)
+    end
+
+    travel_to(bundle.send_at) do
+      assert_emails 1 do
+        Notification::EmailBundleJob.perform_now(bundle)
+        Notification::EmailBundleJob.perform_now(bundle)
+      end
+    end
+
+    next_opened_at = bundle.send_at
+    next_bundle = travel_to(next_opened_at) do
+      Notification::EmailBundle.add_notification(second_notification)
+    end
+
+    assert_not_equal bundle.id, next_bundle.id
+    assert_operator next_bundle.opened_at, :>=, bundle.send_at
+    assert_equal next_opened_at, next_bundle.opened_at
+    assert_equal [ second_notification ], next_bundle.notifications.to_a
+    assert_equal 1, Notification::EmailBundle.where(user: @user).count
+  end
+
+  test "a change in notification source type opens a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+    notification = notifications(:layout_commented_kevin)
+    mention = Mention.create!(
+      id: notification.source_id,
+      source: comments(:layout_overflowing_david),
+      mentioner: users(:david),
+      mentionee: @user
+    )
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    notification.update!(source: mention)
+
+    assert Notification::EmailBundle.where(user: @user).exists?
+  end
+
+  test "daily and weekly preferences set the matching window length" do
+    [ [ :daily, 24.hours ], [ :weekly, 168.hours ] ].each do |frequency, duration|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      bundle = Notification::EmailBundle.add_notification(notifications(:layout_commented_kevin))
+
+      assert_equal bundle.opened_at + duration, bundle.send_at
+      bundle.destroy!
+    end
+  end
+
+  test "duplicate arrivals add a notification only once" do
+    notification = notifications(:layout_commented_kevin)
+    bundle = Notification::EmailBundle.add_notification(notification)
+
+    assert_equal bundle.id, Notification::EmailBundle.add_notification(notification).id
+    assert_equal [ notification ], bundle.notifications.to_a
+    assert_equal 1, enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleJob }
+  end
+
+  test "destroying a notification removes its pending bundle membership" do
+    notification = notifications(:layout_commented_kevin)
+    bundle = Notification::EmailBundle.add_notification(notification)
+
+    assert_difference -> { ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM notification_email_bundles_notifications").to_i }, -1 do
+      notification.destroy!
+    end
+
+    assert_empty bundle.reload.notifications
+  end
+
+  test "database permits only one pending window per user" do
+    bundle = Notification::EmailBundle.add_notification(notifications(:layout_commented_kevin))
+    overlapping_bundle = Notification::EmailBundle.new(
+      account: @user.account,
+      user: @user,
+      opened_at: bundle.opened_at + 1.hour,
+      send_at: bundle.send_at + 1.hour
+    )
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      overlapping_bundle.save!(validate: false)
+    end
+  end
+
+  test "a new window cannot start before the previous window closes" do
+    first_notification = notifications(:layout_commented_kevin)
+    second_notification = notifications(:logo_assignment_kevin)
+    bundle = travel_to(Time.utc(2026, 1, 1, 9)) do
+      Notification::EmailBundle.add_notification(first_notification)
+    end
+
+    opened_after_delivery = bundle.send_at + 1.hour
+    travel_to(opened_after_delivery) do
+      Notification::EmailBundleJob.perform_now(bundle)
+    end
+
+    next_bundle = travel_to(opened_after_delivery) do
+      Notification::EmailBundle.add_notification(second_notification, at: bundle.send_at - 1.second)
+    end
+
+    assert_operator next_bundle.opened_at, :>=, bundle.send_at
+    assert_equal opened_after_delivery, next_bundle.opened_at
+  end
+
+  test "does not open a window when email bundles are off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::EmailBundle.count } do
+      assert_nil Notification::EmailBundle.add_notification(notifications(:layout_commented_kevin))
+    end
+  end
+
+  test "turning email bundles off discards a pending window" do
+    Notification::EmailBundle.add_notification(notifications(:layout_commented_kevin))
+
+    assert_difference -> { Notification::EmailBundle.count }, -1 do
+      @user.settings.update!(bundle_email_frequency: :never)
+    end
+  end
+
+  test "rejects unsupported frequencies" do
+    assert_raises ArgumentError do
+      @user.settings.update!(bundle_email_frequency: :hourly)
+    end
+  end
+
+  test "notification creation opens a window using the user's setting" do
+    assert_difference -> { Notification::EmailBundle.count }, 1 do
+      Notification.create!(
+        user: @user,
+        source: events(:shipping_closed),
+        creator: users(:david)
+      )
+    end
+  end
+end
