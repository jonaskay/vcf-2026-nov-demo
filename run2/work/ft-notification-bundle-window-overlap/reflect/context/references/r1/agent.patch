diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..add54fe
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,125 @@
+class Notification::EmailBundle < ApplicationRecord
+  FREQUENCY_DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::EmailBundle::Item", foreign_key: :notification_email_bundle_id, dependent: :destroy
+  has_many :notifications, through: :items
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add_notification(notification, at: nil)
+      user = notification.user
+      settings = user.settings
+
+      if settings && notification.email_bundleable?
+        settings.with_lock do
+          at ||= Time.current
+
+          if settings.bundle_email_frequency_never?
+            active_for(user)&.cancel(at: at)
+          else
+            bundle = active_for(user)
+
+            if bundle
+              bundle.add_notification(notification)
+            else
+              bundle = create!(
+                account: user.account,
+                user: user,
+                active_user_id: user.id,
+                opened_at: at,
+                deliver_at: at + FREQUENCY_DURATIONS.fetch(settings.bundle_email_frequency)
+              )
+              bundle.add_notification(notification)
+            end
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotUnique
+      raise unless user && active_for(user)
+
+      retry
+    end
+
+    def cancel_active_for(user, at: nil)
+      settings = user.settings
+
+      if settings
+        settings.with_lock do
+          at ||= Time.current
+          active_for(user)&.cancel(at: at) if settings.bundle_email_frequency_never?
+        end
+      end
+    end
+
+    private
+      def active_for(user)
+        find_by(active_user_id: user.id)
+      end
+  end
+
+  def add_notification(notification)
+    raise ArgumentError, "Notification belongs to another user" unless notification.user_id == user_id
+
+    items.create_or_find_by!(notification: notification)
+  end
+
+  def deliver_later
+    Notification::EmailBundle::DeliveryJob.set(wait_until: deliver_at).perform_later(self)
+  end
+
+  def deliver_now(at: nil)
+    email = nil
+    settings = user.settings
+
+    if settings
+      settings.with_lock do
+        at ||= Time.current
+        reload
+
+        if active?
+          if deliver_at > at
+            deliver_later
+          else
+            delivery_user = user.reload
+            notification_payloads = notifications.preloaded.map { |notification| notification.payload.to_h }
+
+            if delivery_allowed?(delivery_user, settings) && notification_payloads.any?
+              update!(active_user_id: nil, sent_at: at)
+              email = [ delivery_user, notification_payloads ]
+            else
+              cancel(at: at)
+            end
+          end
+        end
+      end
+    else
+      cancel(at: at || Time.current)
+    end
+
+    if email
+      NotificationMailer.bundle(email.last, user: email.first).deliver_later
+    end
+  end
+
+  def active?
+    active_user_id.present?
+  end
+
+  def cancel(at: Time.current)
+    update!(active_user_id: nil, cancelled_at: at) if active?
+  end
+
+  private
+    def delivery_allowed?(delivery_user, settings)
+      delivery_user.active? && delivery_user.identity.present? &&
+        delivery_user.account.active? && !settings.bundle_email_frequency_never?
+    end
+end
