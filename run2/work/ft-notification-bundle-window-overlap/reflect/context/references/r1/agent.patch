+module Notification::EmailBundling
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :add_to_email_bundle, if: :email_bundleable?
+
+    has_many :email_bundle_items, class_name: "Notification::EmailBundle::Item", foreign_key: :notification_email_bundle_id, dependent: :destroy
+    has_many :email_bundles, through: :email_bundle_items, source: :notification_email_bundle
+  end
+
+  def email_bundleable?
+    source_id_previously_changed? && !creator.system? && user.active? && user.identity.present? && account.active?
+  end
+
+  private
+    def add_to_email_bundle
+      Notification::EmailBundle.add_notification(self)
+    end
+end
