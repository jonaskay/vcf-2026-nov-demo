diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..cb52aa0
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,170 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @settings = @user.settings
+    Notification::EmailBundle::Item.where(notification_email_bundle_id: Notification::EmailBundle.where(user_id: @user.id).select(:id)).delete_all
+    Notification::EmailBundle.where(user_id: @user.id).delete_all
+    @user.notifications.delete_all
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "email bundling is off by default" do
+    assert_equal "never", @settings.bundle_email_frequency
+
+    assert_no_difference -> { Notification::EmailBundle.count } do
+      create_notification(events(:layout_assignment_jz))
+    end
+  end
+
+  test "the first notification opens a frequency-length window" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    opened_at = Time.zone.parse("2026-01-01 12:00:00")
+
+    travel_to opened_at do
+      notification = create_notification(events(:layout_assignment_jz))
+      bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+
+      assert_equal opened_at, bundle.opened_at
+      assert_equal opened_at + 4.hours, bundle.deliver_at
+      assert_equal [ notification ], bundle.notifications.to_a
+      assert_enqueued_with job: Notification::EmailBundle::DeliveryJob, args: [ bundle ], at: bundle.deliver_at
+    end
+  end
+
+  test "later and late notifications join the open window without moving its deadline" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    opened_at = Time.zone.parse("2026-01-01 12:00:00")
+
+    travel_to opened_at do
+      first = create_notification(events(:layout_assignment_jz))
+      bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+      deadline = bundle.deliver_at
+
+      travel_to opened_at + 1.hour
+      second = create_notification(events(:logo_assignment_jz))
+      assert_equal deadline, bundle.reload.deliver_at
+      assert_equal [ first, second ].sort_by(&:id), bundle.notifications.order(:id).to_a
+
+      # If delivery is delayed, arrivals still belong to the opened window.
+      travel_to opened_at + 5.hours
+      late = create_notification(events(:buy_domain_sent_back_to_triage))
+      assert_equal 1, @user.notification_email_bundles.where(active_user_id: @user.id).count
+      assert_equal deadline, bundle.reload.deliver_at
+      assert_includes bundle.notifications, late
+    end
+  end
+
+  test "daily frequency opens a window that lasts one day" do
+    assert_frequency_window :daily, 1.day
+  end
+
+  test "weekly frequency opens a window that lasts one week" do
+    assert_frequency_window :weekly, 1.week
+  end
+
+  test "delivering a window allows the next notification to open a non-overlapping window" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    opened_at = Time.zone.parse("2026-01-01 12:00:00")
+
+    travel_to opened_at do
+      create_notification(events(:layout_assignment_jz))
+      first_bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+
+      travel_to opened_at + 4.hours
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        first_bundle.deliver_now
+      end
+      assert first_bundle.reload.sent_at
+      assert_equal 1, ActionMailer::Base.deliveries.size
+
+      travel_to opened_at + 4.hours + 1.minute
+      create_notification(events(:logo_assignment_jz))
+      second_bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+
+      assert_not_equal first_bundle, second_bundle
+      assert_operator second_bundle.opened_at, :>=, first_bundle.sent_at
+      assert_equal second_bundle.opened_at + 4.hours, second_bundle.deliver_at
+      assert_equal 1, @user.notification_email_bundles.where(active_user_id: @user.id).count
+    end
+  end
+
+  test "turning email off cancels an open window" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    create_notification(events(:layout_assignment_jz))
+    bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_not bundle.reload.active?
+    assert bundle.cancelled_at
+    bundle.deliver_now(at: bundle.deliver_at)
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  test "one email contains all notifications in the bundle" do
+    @settings.update!(bundle_email_frequency: :daily)
+    first = create_notification(events(:layout_assignment_jz))
+    second = create_notification(events(:buy_domain_sent_back_to_triage))
+    bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+
+    assert_equal [ first, second ].sort_by(&:id), bundle.notifications.order(:id).to_a
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      bundle.deliver_now(at: bundle.deliver_at)
+    end
+    mail = ActionMailer::Base.deliveries.last
+
+    assert_equal @user.identity.email_address, mail.to.first
+    assert_includes mail.subject, "2 new notifications"
+    assert_includes mail.text_part.body.decoded, "Layout is broken"
+    assert_includes mail.text_part.body.decoded, "Buy domain"
+  end
+
+  test "a mention notification can be rendered in an email bundle" do
+    @settings.update!(bundle_email_frequency: :daily)
+    @user.notifications.create!(source: mentions(:logo_comment_david_mention_by_jz), creator: users(:jz))
+    bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      bundle.deliver_now(at: bundle.deliver_at)
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_includes ActionMailer::Base.deliveries.last.text_part.body.decoded, "mentioned you"
+  end
+
+  test "the unique active user index prevents overlapping windows" do
+    opened_at = Time.current
+    attributes = {
+      account: @user.account,
+      user: @user,
+      active_user_id: @user.id,
+      opened_at: opened_at,
+      deliver_at: opened_at + 4.hours
+    }
+
+    Notification::EmailBundle.create!(attributes)
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Notification::EmailBundle.create!(attributes)
+    end
+  end
+
+  private
+    def create_notification(source)
+      @user.notifications.create!(source: source, creator: users(:jason))
+    end
+
+    def assert_frequency_window(frequency, duration)
+      @settings.update!(bundle_email_frequency: frequency)
+      opened_at = Time.zone.parse("2026-01-01 12:00:00")
+
+      travel_to opened_at do
+        create_notification(events(:layout_assignment_jz))
+        bundle = Notification::EmailBundle.find_by!(active_user_id: @user.id)
+        assert_equal opened_at + duration, bundle.deliver_at
+      end
+    end
+end
