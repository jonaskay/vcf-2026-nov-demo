diff --git a/app/models/notification/digest_window.rb b/app/models/notification/digest_window.rb
new file mode 100644
index 0000000..b1c51ac
--- /dev/null
+++ b/app/models/notification/digest_window.rb
@@ -0,0 +1,45 @@
+class Notification::DigestWindow < ApplicationRecord
+  FREQUENCY_DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, foreign_key: :digest_window_id, dependent: :nullify
+
+  scope :pending, -> { where.not(open_user_id: nil) }
+
+  after_create_commit :deliver_later
+
+  def send_now
+    settings = user.settings
+
+    settings.with_lock do
+      reload
+
+      if open?
+        if ends_at <= Time.current
+          digest_notifications = notifications.preloaded.order(:created_at).to_a
+          update!(open_user_id: nil, sent_at: Time.current)
+
+          if settings.bundle_email_frequency != "never" && digest_notifications.any? && user.active? && account.active? && user.identity.present?
+            NotificationDigestMailer.digest(self, digest_notifications).deliver_now
+          end
+        else
+          deliver_later
+        end
+      end
+    end
+  end
+
+  def open?
+    open_user_id.present?
+  end
+
+  private
+    def deliver_later
+      Notification::DigestWindow::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
diff --git a/app/models/notification/digestible.rb b/app/models/notification/digestible.rb
new file mode 100644
index 0000000..9cdcb0a
--- /dev/null
+++ b/app/models/notification/digestible.rb
@@ -0,0 +1,38 @@
+module Notification::Digestible
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :digest_window, class_name: "Notification::DigestWindow", optional: true
+
+    before_save :add_to_digest, if: :source_changed?
+  end
+
+  private
+    def source_changed?
+      will_save_change_to_source_id? || will_save_change_to_source_type?
+    end
+
+    def add_to_digest
+      if settings = user.settings
+        settings.with_lock do
+          if duration = Notification::DigestWindow::FREQUENCY_DURATIONS[settings.bundle_email_frequency]
+            window = user.notification_digest_windows.pending.lock.first
+
+            if window.nil?
+              started_at = Time.current.change(usec: 0)
+              window = user.notification_digest_windows.create!(
+                account: account,
+                open_user_id: user_id,
+                started_at: started_at,
+                ends_at: started_at + duration
+              )
+            end
+
+            self.digest_window = window
+          else
+            self.digest_window = nil
+          end
+        end
+      end
+    end
+end
