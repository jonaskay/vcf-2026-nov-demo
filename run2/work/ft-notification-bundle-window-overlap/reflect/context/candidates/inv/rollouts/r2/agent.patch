diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..7b85d76
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,42 @@
+class Notification::EmailBundle < ApplicationRecord
+  FREQUENCY_INTERVALS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::EmailBundleItem", dependent: :destroy
+  has_many :notifications, through: :items
+
+  scope :open, -> { where(delivered_at: nil) }
+
+  class << self
+    def add_notification(notification, at: Time.current)
+      user = notification.user
+      bundle = nil
+      user.with_lock do
+        settings = user.settings
+
+        if settings && (interval = FREQUENCY_INTERVALS[settings.bundle_email_frequency])
+          bundle = user.notification_email_bundles.open.order(:opened_at).first
+
+          unless bundle
+            opened_at = [ at, user.notification_email_bundles.maximum(:closes_at) ].compact.max
+            bundle = user.notification_email_bundles.create!(
+              opened_at: opened_at,
+              closes_at: opened_at + interval
+            )
+            Notification::EmailBundle::DeliveryJob.set(wait_until: bundle.closes_at).perform_later(bundle)
+          end
+
+          bundle.items.create_or_find_by!(notification: notification)
+        end
+      end
+
+      bundle
+    end
+  end
+end
