diff --git a/test/jobs/notification/email_bundle/delivery_job_test.rb b/test/jobs/notification/email_bundle/delivery_job_test.rb
new file mode 100644
index 0000000..cfac8a3
--- /dev/null
+++ b/test/jobs/notification/email_bundle/delivery_job_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Notification::EmailBundle::DeliveryJobTest < ActiveJob::TestCase
+  test "waits until the window closes, then sends only one email" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+    notification = notifications(:layout_commented_kevin)
+    opened_at = Time.zone.parse("2026-01-01 10:00")
+
+    bundle = travel_to(opened_at) do
+      Notification::EmailBundle.add_notification(notification)
+    end
+
+    deliveries_before = ActionMailer::Base.deliveries.size
+    travel_to(bundle.closes_at - 1.minute) do
+      Notification::EmailBundle::DeliveryJob.perform_now(bundle)
+
+      assert_nil bundle.reload.delivered_at
+      assert_equal deliveries_before, ActionMailer::Base.deliveries.size
+    end
+
+    travel_to(bundle.closes_at) do
+      Notification::EmailBundle::DeliveryJob.perform_now(bundle)
+      Notification::EmailBundle::DeliveryJob.perform_now(bundle)
+    end
+
+    assert_equal deliveries_before + 1, ActionMailer::Base.deliveries.size
+    assert_equal bundle.closes_at, bundle.reload.delivered_at
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notifications", email.subject
+    assert_includes email.text_part.body.to_s, notification.card.title
+  end
+end
diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..7e87fa8
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  test "a new notification is automatically added to an email window" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    notifications(:layout_commented_kevin).destroy
+
+    Notification.create!(
+      user: user,
+      source: events(:layout_commented),
+      creator: users(:david)
+    )
+
+    bundle = user.notification_email_bundles.sole
+    assert_equal 1.day, bundle.closes_at - bundle.opened_at
+    assert_equal 1, bundle.notifications.count
+  end
+
+  test "first notification opens a window for the selected frequency" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+    notification = notifications(:layout_commented_kevin)
+    opened_at = Time.zone.parse("2026-01-01 10:00")
+
+    travel_to opened_at do
+      bundle = Notification::EmailBundle.add_notification(notification)
+
+      assert_equal opened_at, bundle.opened_at
+      assert_equal opened_at + 4.hours, bundle.closes_at
+      assert_equal [ notification ], bundle.notifications.to_a
+    end
+  end
+
+  test "late notifications join the already-open window without opening an overlapping one" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    first_notification = notifications(:layout_commented_kevin)
+    late_notification = notifications(:logo_assignment_kevin)
+    opened_at = Time.zone.parse("2026-01-01 10:00")
+
+    bundle = travel_to(opened_at) do
+      Notification::EmailBundle.add_notification(first_notification)
+    end
+
+    travel_to(opened_at + 2.days) do
+      assert_equal bundle, Notification::EmailBundle.add_notification(late_notification)
+    end
+
+    assert_equal 1, user.notification_email_bundles.count
+    assert_equal [ first_notification, late_notification ].sort_by(&:id), bundle.notifications.order(:id).to_a
+  end
+
+  test "closed windows do not overlap with later windows" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    first_notification = notifications(:layout_commented_kevin)
+    next_notification = notifications(:logo_assignment_kevin)
+    opened_at = Time.zone.parse("2026-01-01 10:00")
+
+    first_bundle = travel_to(opened_at) do
+      Notification::EmailBundle.add_notification(first_notification)
+    end
+    first_bundle.update!(delivered_at: first_bundle.closes_at)
+
+    next_bundle = Notification::EmailBundle.add_notification(next_notification, at: opened_at + 2.days)
+
+    assert_equal opened_at + 2.days, next_bundle.opened_at
+    assert_operator first_bundle.closes_at, :<=, next_bundle.opened_at
+    assert_equal 2, user.notification_email_bundles.count
+  end
+
+  test "weekly windows last a week" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "weekly")
+
+    bundle = Notification::EmailBundle.add_notification(
+      notifications(:layout_commented_kevin),
+      at: Time.zone.parse("2026-01-01 10:00")
+    )
+
+    assert_equal 1.week, bundle.closes_at - bundle.opened_at
+  end
+
+  test "new activity after delivery opens a subsequent window" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:layout_commented_kevin)
+    first_bundle = Notification::EmailBundle.add_notification(notification)
+    first_bundle.update!(delivered_at: first_bundle.closes_at)
+
+    notification.update!(source: events(:layout_published))
+
+    next_bundle = user.notification_email_bundles.open.sole
+    assert_equal [ notification ], next_bundle.notifications.to_a
+    assert_operator first_bundle.closes_at, :<=, next_bundle.opened_at
+  end
+
+  test "never does not open a window" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "never")
+
+    assert_nil Notification::EmailBundle.add_notification(notifications(:layout_commented_kevin))
+    assert_empty user.notification_email_bundles
+  end
+end
