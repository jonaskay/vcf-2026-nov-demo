@@ -0,0 +1,22 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequency defaults to never" do
+    user = User.create!(account: accounts("37s"), name: "New user")
+
+    assert_equal "never", user.settings.bundle_email_frequency
+  end
+
+  test "bundle email frequency must be supported" do
+    settings = users(:kevin).settings
+
+    %w[never every_few_hours daily weekly].each do |frequency|
+      settings.bundle_email_frequency = frequency
+      assert settings.valid?, "Expected #{frequency} to be valid"
+    end
+
