index 0000000..0efeaa0
--- /dev/null
+++ b/app/jobs/notification/email_bundle/delivery_job.rb
@@ -0,0 +1,19 @@
+class Notification::EmailBundle::DeliveryJob < ApplicationJob
+  def perform(bundle)
+    user = bundle.user
+
+    user.with_lock do
+      bundle.with_lock do
+        unless bundle.delivered_at? || Time.current < bundle.closes_at
+          settings = user.settings
+
+          if settings && settings.bundle_email_frequency != "never" && user.identity&.email_address.present? && bundle.notifications.exists?
+            NotificationMailer.email_bundle(bundle).deliver_now
+          end
+
+          bundle.update!(delivered_at: Time.current)
+        end
+      end
+    end
+  end
+end
