diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..e87ba7e
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,73 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", dependent: :nullify
+
+  enum :frequency, %w[ every_few_hours daily weekly ].index_by(&:itself)
+
+  after_create_commit :deliver_later
+
+  def self.include_notification(notification)
+    user = notification.user
+
+    user.with_lock do
+      settings = user.settings
+      settings&.reload
+
+      if user.active? && user.account.active? && user.identity.present? && (interval = settings&.bundle_email_interval)
+        if (bundle = find_by(open_for_user_id: user.id))
+          bundle.notifications << notification unless notification.email_bundle_id == bundle.id
+        else
+          now = Time.current
+          bundle = create!(
+            account: user.account,
+            user: user,
+            open_for_user_id: user.id,
+            frequency: settings.bundle_email_frequency,
+            started_at: now,
+            deliver_at: now + interval
+          )
+          bundle.notifications << notification
+        end
+      end
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  def pending?
+    sent_at.nil? && open_for_user_id == user_id
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if pending?
+        if deliver_at <= Time.current
+          Current.with_account(account) do
+            NotificationMailer.email_bundle(self).deliver_now if deliverable?
+          end
+
+          update!(sent_at: Time.current, open_for_user_id: nil)
+        else
+          deliver_later
+        end
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      settings = user.settings
+      user.active? && account.active? && user.identity.present? && settings&.bundle_email_interval.present? && notifications.exists?
+    end
+
+    def deliver_later
+      Notification::EmailBundleDeliveryJob.set(wait_until: deliver_at).perform_later(self)
+    end
+end
