+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequency defaults to never" do
+    assert_equal "never", users(:david).settings.bundle_email_frequency
+  end
+
+  test "bundle email frequency maps to the selected window duration" do
+    settings = users(:david).settings
+
+    {
+      never: nil,
+      every_few_hours: 4.hours,
+      daily: 1.day,
+      weekly: 1.week
+    }.each do |frequency, interval|
+      settings.update!(bundle_email_frequency: frequency)
+
+      interval ? assert_equal(interval, settings.bundle_email_interval) : assert_nil(settings.bundle_email_interval)
+    end
+  end
+
+  test "rejects unsupported bundle email frequencies" do
+    settings = users(:david).settings
+
+    assert_not settings.update(bundle_email_frequency: "hourly")
+    assert_equal "never", settings.reload.bundle_email_frequency
+  end
+end
