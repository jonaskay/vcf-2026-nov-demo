diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..831b10f
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jz)
+    @settings = @user.settings
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "never does not open an email window" do
+    assert_no_enqueued_jobs only: Notification::EmailBundleDeliveryJob do
+      notification = create_notification(events(:logo_published))
+
+      assert_nil notification.reload.email_bundle
+    end
+  end
+
+  test "starts a window at the first notification and batches late notifications into it" do
+    started_at = Time.zone.parse("2026-11-16 12:00:00")
+    bundle = nil
+
+    travel_to started_at do
+      @settings.update!(bundle_email_frequency: :every_few_hours)
+      assert_enqueued_jobs 1, only: Notification::EmailBundleDeliveryJob do
+        notification = create_notification(events(:logo_published))
+        bundle = notification.reload.email_bundle
+      end
+
+      assert_equal started_at, bundle.started_at
+      assert_equal started_at + 4.hours, bundle.deliver_at
+    end
+
+    travel_to started_at + 5.hours do
+      @settings.update!(bundle_email_frequency: :daily)
+      assert_no_enqueued_jobs only: Notification::EmailBundleDeliveryJob do
+        notification = create_notification(events(:layout_commented))
+
+        assert_equal bundle, notification.reload.email_bundle
+        assert_equal started_at + 4.hours, bundle.reload.deliver_at
+        assert_equal 1, Notification::EmailBundle.where(open_for_user_id: @user.id).count
+      end
+
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        Notification::EmailBundleDeliveryJob.perform_now(bundle)
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.body.encoded, cards(:logo).title
+    assert_includes email.body.encoded, cards(:layout).title
+  end
+
+  test "uses daily and weekly windows" do
+    started_at = Time.zone.parse("2026-11-16 12:00:00")
+
+    { daily: [ 1.day, events(:logo_published) ], weekly: [ 1.week, events(:layout_commented) ] }.each do |frequency, (interval, event)|
+      travel_to started_at do
+        @settings.update!(bundle_email_frequency: frequency)
+        notification = create_notification(event)
+
+        assert_equal started_at + interval, notification.reload.email_bundle.deliver_at
+      end
+
+      bundle = Notification::EmailBundle.find_by!(open_for_user_id: @user.id)
+      travel_to bundle.deliver_at do
+        Notification::EmailBundleDeliveryJob.perform_now(bundle)
+      end
+    end
+  end
+
+  test "sends one digest per window and opens a new window after delivery" do
+    started_at = Time.zone.parse("2026-11-16 12:00:00")
+    bundle = nil
+
+    travel_to started_at do
+      @settings.update!(bundle_email_frequency: :every_few_hours)
+      first_notification = create_notification(events(:logo_published))
+      bundle = first_notification.reload.email_bundle
+      create_notification(events(:layout_commented))
+    end
+
+    travel_to bundle.deliver_at do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        Notification::EmailBundleDeliveryJob.perform_now(bundle)
+      end
+    end
+
+    assert bundle.reload.sent?
+    assert_nil bundle.open_for_user_id
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.subject, "notification"
+    assert_includes email.body.encoded, cards(:logo).title
+    assert_includes email.body.encoded, cards(:layout).title
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      Notification::EmailBundleDeliveryJob.perform_now(bundle)
+    end
+
+    travel_to bundle.deliver_at + 1.second do
+      notification = create_notification(events(:buy_domain_sent_back_to_triage))
+      next_bundle = notification.reload.email_bundle
+
+      assert_not_equal bundle, next_bundle
+      assert_equal @user.id, next_bundle.open_for_user_id
+      assert_equal 1, Notification::EmailBundle.where(open_for_user_id: @user.id).count
+    end
+  end
+
+  test "switching the frequency off cancels the open window" do
+    @settings.update!(bundle_email_frequency: :daily)
+    notification = create_notification(events(:logo_published))
+    bundle = notification.reload.email_bundle
+
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_not Notification::EmailBundle.exists?(bundle.id)
+    assert_nil notification.reload.email_bundle
+  end
+
+  test "the database prevents two open windows for the same user" do
+    @settings.update!(bundle_email_frequency: :daily)
+    create_notification(events(:logo_published))
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Notification::EmailBundle.create!(
+        account: @user.account,
+        user: @user,
+        open_for_user_id: @user.id,
+        frequency: :daily,
+        started_at: Time.current,
+        deliver_at: 1.day.from_now
+      )
+    end
+  end
+
+  test "an early delivery job leaves the window open and reschedules itself" do
+    @settings.update!(bundle_email_frequency: :daily)
+    notification = create_notification(events(:logo_published))
+    bundle = notification.reload.email_bundle
+
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      assert_enqueued_jobs 1, only: Notification::EmailBundleDeliveryJob do
+        Notification::EmailBundleDeliveryJob.perform_now(bundle)
+      end
+    end
+
+    assert bundle.reload.pending?
+    assert_equal @user.id, bundle.open_for_user_id
+  end
+
+  private
+    def create_notification(source)
+      @user.notifications.create!(source: source, creator: users(:david), unread_count: 1)
+    end
+end
