new file mode 100644
index 0000000..7d8bcb6
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String, timestamp: String }
+
+  connect() {
+    this.render()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  timestampValueChanged() {
+    this.render()
+  }
+
+  render() {
+    this.element.textContent = formatLocalTime(this.timestampValue, this.formatValue)
+  }
+}
