diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8734909
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time tags send a stable UTC timestamp with the requested format" do
+    timestamp = Time.utc(2025, 9, 12, 17, 42)
+
+    html = Time.use_zone("America/Los_Angeles") do
+      local_time_tag timestamp, format: :smart
+    end
+
+    assert_select Nokogiri::HTML::DocumentFragment.parse(html), "time[datetime='2025-09-12T17:42:00Z'][data-controller='local-time'][data-local-time-format-value='smart']", text: "2025-09-12T17:42:00Z"
+  end
+
+  test "local time tags do not vary with the server timezone" do
+    timestamp = Time.utc(2025, 9, 12, 17, 42)
+
+    los_angeles = Time.use_zone("America/Los_Angeles") { local_time_tag(timestamp, format: :time).to_s }
+    tokyo = Time.use_zone("Asia/Tokyo") { local_time_tag(timestamp, format: :time).to_s }
+
+    assert_equal los_angeles, tokyo
+  end
+end
diff --git a/test/system/local_time_rendering_test.rb b/test/system/local_time_rendering_test.rb
new file mode 100644
index 0000000..ecfd00c
--- /dev/null
+++ b/test/system/local_time_rendering_test.rb
@@ -0,0 +1,58 @@
+require "application_system_test_case"
+
+class LocalTimeRenderingTest < ApplicationSystemTestCase
+  test "renders recent and future timestamps in the browser timezone" do
+    sign_in_as(users(:david))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    visit root_path
+    assert_equal "America/Los_Angeles", page.evaluate_script("Intl.DateTimeFormat().resolvedOptions().timeZone")
+
+    expected = page.execute_script(<<~JS)
+      const now = new Date()
+      const localDate = (offset) => new Date(now.getFullYear(), now.getMonth(), now.getDate() + offset, 12)
+      const twoHoursAgo = new Date(now.getTime() - 2 * 60 * 60 * 1000)
+      const samples = [
+        [ "smart", twoHoursAgo ],
+        [ "smart", localDate(-1) ],
+        [ "smart", localDate(-5) ],
+        [ "smart", localDate(-8) ],
+        [ "calendar-relative", localDate(1) ],
+        [ "calendar-relative", localDate(3) ]
+      ]
+      const relative = new Intl.RelativeTimeFormat(document.documentElement.lang, { numeric: "auto" })
+      const dayNumber = (date) => Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / 86400000
+      const dateFormat = new Intl.DateTimeFormat(document.documentElement.lang, { month: "short", day: "numeric" })
+      const timeFormat = new Intl.DateTimeFormat(document.documentElement.lang, { hour: "numeric", minute: "2-digit" })
+      const smartDate = (date) => {
+        const days = dayNumber(date) - dayNumber(now)
+        return days === 0 ? timeFormat.format(date) : days >= -6 ? relative.format(days, "day") : dateFormat.format(date)
+      }
+
+      const container = document.createElement("div")
+      container.id = "local-time-test"
+      samples.forEach(([format, date], index) => {
+        const time = document.createElement("time")
+        time.id = `local-time-test-${index}`
+        time.dateTime = date.toISOString()
+        time.dataset.controller = "local-time"
+        time.dataset.localTimeFormatValue = format
+        time.dataset.localTimeTimestampValue = time.dateTime
+        container.append(time)
+      })
+      document.body.append(container)
+
+      return [
+        smartDate(twoHoursAgo),
+        relative.format(-1, "day"),
+        relative.format(-5, "day"),
+        dateFormat.format(localDate(-8)),
+        relative.format(1, "day"),
+        relative.format(3, "day")
+      ]
+    JS
+
+    expected.each_with_index do |text, index|
+      assert_selector "#local-time-test-#{index}", text: text, wait: 5
+    end
+  end
+end
