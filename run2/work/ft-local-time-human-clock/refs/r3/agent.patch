diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..b487f7b 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,16 @@
 module TimeHelper
+  def local_time_tag(time, format:, **options)
+    timestamp = if time.respond_to?(:utc)
+      time.utc.iso8601
+    else
+      time.iso8601
+    end
+
+    data = (options.delete(:data) || {}).dup
+    data[:local_time_format_value] = format.to_s
+    data[:local_time_timestamp_value] = timestamp
+    data[:controller] = [ data[:controller], "local-time" ].compact_blank.join(" ")
+
+    tag.time timestamp, datetime: timestamp, data: data, **options
+  end
 end
