diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..166999e
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,75 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+  test "comment timestamps are emitted as raw UTC timestamps" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as(users(:kevin))
+    page.driver.browser.manage.delete_cookie("timezone")
+    visit card_url(cards(:logo))
+
+    comment = comments(:logo_agreement_kevin)
+    timestamp = find("#comment_#{comment.id} time")
+
+    assert_equal comment.created_at.utc.iso8601(6), timestamp["datetime"]
+    expected_local_time = comment.created_at.in_time_zone("America/Los_Angeles").strftime("%-l:%M %p")
+    assert_equal expected_local_time, timestamp.text
+  end
+
+  test "formats comments and auto-close dates in the browser timezone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as(users(:kevin))
+    visit card_url(cards(:logo))
+
+    page.driver.browser.execute_script(<<~JAVASCRIPT)
+      const NativeDate = Date
+      const fixedNow = NativeDate.parse("2025-09-17T02:00:00Z")
+
+      class FixedDate extends NativeDate {
+        constructor(...args) {
+          super(...args.length ? args : [ fixedNow ])
+        }
+
+        static now() {
+          return fixedNow
+        }
+      }
+
+      window.Date = FixedDate
+
+      const samples = {
+        today: [ "comment", "2025-09-16T20:42:00Z" ],
+        yesterday: [ "comment", "2025-09-16T06:42:00Z" ],
+        earlierThisWeek: [ "comment", "2025-09-11T20:42:00Z" ],
+        older: [ "comment", "2025-09-08T20:42:00Z" ],
+        tomorrow: [ "until", "2025-09-17T08:00:00Z" ],
+        inThreeDays: [ "until", "2025-09-19T08:00:00Z" ],
+        dateOnly: [ "weekday-date", "2025-09-12" ]
+      }
+
+      const container = document.createElement("div")
+      container.id = "local-time-test-fixtures"
+
+      for (const [ name, [ format, datetime ] ] of Object.entries(samples)) {
+        const time = document.createElement("time")
+        time.dataset.controller = "local-time"
+        time.dataset.localTimeFormatValue = format
+        time.dataset.testTime = name
+        time.dateTime = datetime
+        container.append(time)
+      }
+
+      document.body.append(container)
+    JAVASCRIPT
+
+    assert_selector 'time[data-test-time="today"]', text: "1:42 PM"
+    page.driver.browser.execute_script(%(document.querySelector('[data-test-time="today"]').dateTime = "2025-09-16T21:42:00Z"))
+    assert_selector 'time[data-test-time="today"]', text: "2:42 PM"
+    assert_selector 'time[data-test-time="yesterday"]', text: "yesterday"
+    assert_selector 'time[data-test-time="earlierThisWeek"]', text: "5 days ago"
+    assert_selector 'time[data-test-time="older"]', text: "Sep 8"
+    assert_selector 'time[data-test-time="tomorrow"]', text: "tomorrow"
+    assert_selector 'time[data-test-time="inThreeDays"]', text: "in 3 days"
+    assert_selector 'time[data-test-time="dateOnly"]', text: "Friday, September 12"
+  end
+end
