diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..29cc783
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalDateTime } from "helpers/time_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+
+    this.datetimeObserver = new MutationObserver(() => this.render())
+    this.datetimeObserver.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-format-value" ]
+    })
+  }
+
+  disconnect() {
+    this.datetimeObserver.disconnect()
+  }
+
+  render() {
+    this.element.textContent = formatLocalDateTime(this.element.dateTime, this.formatValue)
+  }
+}
