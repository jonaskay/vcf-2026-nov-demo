diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..2610e56
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,141 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const DAY_IN_SECONDS = 24 * 60 * 60
+const SECONDS_PER_UNIT = {
+  second: 1,
+  minute: 60,
+  hour: 60 * 60,
+  day: DAY_IN_SECONDS,
+  week: 7 * DAY_IN_SECONDS,
+  month: 30 * DAY_IN_SECONDS,
+  year: 365 * DAY_IN_SECONDS
+}
+const relativeTimeFormatters = new Map()
+const dateTimeFormatters = new Map()
+
+export function formatLocalDateTime(value, format) {
+  const date = parseLocalDateTime(value)
+
+  if (!Number.isFinite(date.getTime())) return ""
+
+  switch (format) {
+    case "time":
+      return dateFormatter({ hour: "numeric", minute: "2-digit" }).format(date)
+    case "comment":
+      return formatCommentDate(date)
+    case "relative":
+      return formatRelativeTime(date)
+    case "until":
+      return formatUntilDate(date)
+    case "date":
+      return dateFormatter({ month: "short", day: "2-digit", year: "numeric" }).format(date)
+    case "short-date":
+      return dateFormatter({ month: "short", day: "numeric" }).format(date)
+    case "weekday-date":
+      return dateFormatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+    case "datetime":
+      return dateFormatter({
+        month: "numeric",
+        day: "numeric",
+        year: "2-digit",
+        hour: "numeric",
+        minute: "2-digit"
+      }).format(date)
+    default:
+      return ""
+  }
+}
+
+function formatCommentDate(date) {
+  const daysAgo = signedDifferenceInDays(date, new Date())
+
+  if (daysAgo === 0) {
+    return dateFormatter({ hour: "numeric", minute: "2-digit" }).format(date)
+  } else if (daysAgo === 1) {
+    return "yesterday"
+  } else if (daysAgo > 1 && daysAgo < 7) {
+    return relativeTimeFormatter("always").format(-daysAgo, "day")
+  } else {
+    return dateFormatter({ month: "short", day: "numeric" }).format(date)
+  }
+}
+
+function formatRelativeTime(date) {
+  const differenceInSeconds = (date.getTime() - Date.now()) / 1000
+  const absoluteDifferenceInSeconds = Math.abs(differenceInSeconds)
+  let unit
+
+  if (absoluteDifferenceInSeconds < 60) {
+    unit = "second"
+  } else if (absoluteDifferenceInSeconds < 60 * 60) {
+    unit = "minute"
+  } else if (absoluteDifferenceInSeconds < DAY_IN_SECONDS) {
+    unit = "hour"
+  } else if (absoluteDifferenceInSeconds < 7 * DAY_IN_SECONDS) {
+    unit = "day"
+  } else if (absoluteDifferenceInSeconds < 30 * DAY_IN_SECONDS) {
+    unit = "week"
+  } else if (absoluteDifferenceInSeconds < 365 * DAY_IN_SECONDS) {
+    unit = "month"
+  } else {
+    unit = "year"
+  }
+
+  const value = Math.round(differenceInSeconds / SECONDS_PER_UNIT[unit])
+
+  if (value === 0) {
+    return "just now"
+  } else {
+    return relativeTimeFormatter("always").format(value, unit)
+  }
+}
+
+function formatUntilDate(date) {
+  const daysUntil = signedDifferenceInDays(new Date(), date)
+
+  if (daysUntil === 0) {
+    return "today"
+  } else if (daysUntil === 1) {
+    return "tomorrow"
+  } else {
+    return relativeTimeFormatter("always").format(daysUntil, "day")
+  }
+}
+
+function parseLocalDateTime(value) {
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+
+  if (dateOnly) {
+    return new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+  } else {
+    return new Date(value)
+  }
+}
+
+function dateFormatter(options) {
+  const locale = document.documentElement.lang || undefined
+  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  const cacheKey = `${locale}:${timezone}:${JSON.stringify(options)}`
+
+  if (!dateTimeFormatters.has(cacheKey)) {
+    dateTimeFormatters.set(cacheKey, new Intl.DateTimeFormat(locale, { ...options, timeZone: timezone }))
+  }
+
+  return dateTimeFormatters.get(cacheKey)
+}
+
+function relativeTimeFormatter(numeric) {
+  const locale = document.documentElement.lang || undefined
+
+  if (!relativeTimeFormatters.has(locale)) {
+    relativeTimeFormatters.set(locale, new Map())
+  }
+
+  const formattersForLocale = relativeTimeFormatters.get(locale)
+
+  if (!formattersForLocale.has(numeric)) {
+    formattersForLocale.set(numeric, new Intl.RelativeTimeFormat(locale, { numeric }))
+  }
+
+  return formattersForLocale.get(numeric)
+}
