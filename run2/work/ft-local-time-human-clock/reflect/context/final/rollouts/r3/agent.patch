diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..c74ea47
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,21 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  connect() {
+    this.observer = new MutationObserver(this.render.bind(this))
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime", "data-local-time-format" ] })
+
+    this.render()
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  render() {
+    const formatted = formatLocalTime(this.element.dateTime, this.element.dataset.localTimeFormat)
+
+    if (this.element.textContent !== formatted) this.element.textContent = formatted
+  }
+}
