diff --git a/test/helpers/bridge_helper_test.rb b/test/helpers/bridge_helper_test.rb
new file mode 100644
index 0000000..1ef53fd
--- /dev/null
+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card share descriptions keep timestamps raw and timezone-independent" do
+    card = cards(:logo)
+
+    new_york_description = Time.use_zone("America/New_York") do
+      JSON.parse(bridge_share_card_description(card))
+    end
+    los_angeles_description = Time.use_zone("America/Los_Angeles") do
+      JSON.parse(bridge_share_card_description(card))
+    end
+
+    assert_equal new_york_description, los_angeles_description
+    assert_equal "local-time-description", new_york_description.fetch("type")
+    assert_equal card.created_at.utc.iso8601(6), new_york_description.dig("parts", 1, "timestamp")
+    assert_equal "short_date", new_york_description.dig("parts", 1, "format")
+    assert_equal card.last_active_at.utc.iso8601(6), new_york_description.dig("parts", 3, "timestamp")
+    assert_equal "short_date", new_york_description.dig("parts", 3, "format")
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..fcbcb22
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag emits a timezone-independent UTC timestamp and raw fallback" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42, 15, 123456)
+
+    new_york_html = Time.use_zone("America/New_York") do
+      local_time_tag(timestamp.in_time_zone(Time.zone), format: "relative").to_s
+    end
+    los_angeles_html = Time.use_zone("America/Los_Angeles") do
+      local_time_tag(timestamp.in_time_zone(Time.zone), format: "relative").to_s
+    end
+
+    assert_equal new_york_html, los_angeles_html
+
+    time = Nokogiri::HTML.fragment(new_york_html).at_css("time")
+    assert_equal timestamp.utc.iso8601(6), time["datetime"]
+    assert_equal timestamp.utc.iso8601(6), time.text
+    assert_equal "relative", time["data-local-time-format"]
+    assert_equal "local-time", time["data-controller"]
+  end
+
+  test "local_date_tag emits a calendar date rather than a timestamp" do
+    html = local_date_tag(Date.new(2025, 9, 12), format: "weekday_date")
+    time = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "2025-09-12", time["datetime"]
+    assert_equal "2025-09-12", time.text
+    assert_equal "weekday_date", time["data-local-time-format"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..870f812
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "timestamps are rendered in the browser timezone using local calendar days" do
+    sign_in_as(users(:david))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    visit card_url(cards(:logo))
+
+    comment_time_selector = ".comment__permalink-title time[data-local-time-format='relative']"
+    assert_selector comment_time_selector, minimum: 1
+    assert_no_selector comment_time_selector, text: /T\d{2}:\d{2}/
+    assert all(comment_time_selector).all? { |time| time["datetime"] != time.text }
+
+    page.execute_script <<~JS
+      const appendTime = (id, timestamp, format = "relative") => {
+        const time = document.createElement("time")
+        time.id = id
+        time.dateTime = timestamp
+        time.dataset.controller = "local-time"
+        time.dataset.localTimeFormat = format
+        time.textContent = timestamp
+        document.body.append(time)
+      }
+
+      const localDateAt = (offset, hour = 13, minute = 42) => {
+        const date = new Date()
+        date.setDate(date.getDate() + offset)
+        date.setHours(hour, minute, 0, 0)
+        return date.toISOString()
+      }
+
+      appendTime("local-time-today", localDateAt(0))
+      appendTime("local-time-yesterday", localDateAt(-1))
+      appendTime("local-time-five-days-ago", localDateAt(-5))
+      appendTime("local-time-eight-days-ago", localDateAt(-8))
+      appendTime("local-time-tomorrow", localDateAt(1, 0, 15))
+      appendTime("local-time-three-days-from-now", localDateAt(3))
+      appendTime("local-time-calendar-day", "2024-01-01", "weekday_date")
+      const priorYear = new Date().getFullYear() - 1
+      appendTime("local-time-prior-year", new Date(priorYear, 0, 1, 12).toISOString())
+    JS
+
+    assert_selector "time#local-time-today", text: "1:42 PM"
+    assert_selector "time#local-time-yesterday", text: "yesterday"
+    assert_selector "time#local-time-five-days-ago", text: "5 days ago"
+    assert_selector "time#local-time-eight-days-ago", text: /[A-Z][a-z]{2} \d{1,2}/
+    assert_selector "time#local-time-tomorrow", text: "tomorrow"
+    assert_selector "time#local-time-three-days-from-now", text: "in 3 days"
+    assert_selector "time#local-time-calendar-day", text: "Monday, January 1"
+    prior_year = page.evaluate_script("new Date().getFullYear() - 1")
+    assert_selector "time#local-time-prior-year", text: "Jan 1, #{prior_year}"
+  end
+end
