diff --git a/app/javascript/controllers/time_display_controller.js b/app/javascript/controllers/time_display_controller.js
new file mode 100644
index 0000000..6f206e3
--- /dev/null
+++ b/app/javascript/controllers/time_display_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.#render()
+    this.observer = new MutationObserver(() => this.#render())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  formatValueChanged() {
+    this.#render()
+  }
+
+  #render() {
+    this.element.textContent = formatTimestamp(this.element.dateTime, this.formatValue)
+  }
+}
