diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..fb68f13 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,36 @@
 module TimeHelper
+  def time_display_tag(timestamp, format: "relative", **html_options)
+    serialized_timestamp = utc_iso8601(timestamp)
+    data = (html_options.delete(:data) || {}).merge(time_display_data(format))
+
+    tag.time(serialized_timestamp, datetime: serialized_timestamp, data:, **html_options)
+  end
+
+  def date_display_tag(date, format: "calendar-date", **html_options)
+    serialized_date = date.to_date.iso8601
+    data = (html_options.delete(:data) || {}).merge(time_display_data(format))
+
+    tag.time(serialized_date, datetime: serialized_date, data:, **html_options)
+  end
+
+  def time_display_placeholder(timestamp, format: "relative")
+    "{{time:#{format}:#{utc_iso8601(timestamp)}}}"
+  end
+
+  private
+    def time_display_data(format)
+      { controller: "time-display", time_display_format_value: format }
+    end
+
+    def utc_iso8601(timestamp)
+      timestamp = timestamp.to_time.utc
+      precision = if timestamp.nsec.zero?
+        0
+      elsif timestamp.nsec % 1_000 == 0
+        6
+      else
+        9
+      end
+      timestamp.iso8601(precision)
+    end
 end
