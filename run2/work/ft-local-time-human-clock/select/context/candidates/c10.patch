diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..7e673ba
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  include BridgeHelper
+
+  test "time display tags are identical in every server timezone" do
+    timestamp = Time.utc(2025, 9, 12, 20, 42)
+
+    rendered = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { time_display_tag(timestamp.in_time_zone(timezone)) }
+    end
+
+    assert_equal rendered.first, rendered.last
+    assert_includes rendered.first, 'datetime="2025-09-12T20:42:00Z"'
+    assert_includes rendered.first, 'data-time-display-format-value="relative"'
+    assert_includes rendered.first, ">2025-09-12T20:42:00Z</time>"
+  end
+
+  test "calendar dates are emitted as date-only values" do
+    rendered = date_display_tag(Date.new(2025, 9, 12))
+
+    assert_includes rendered, 'datetime="2025-09-12"'
+    assert_includes rendered, 'data-time-display-format-value="calendar-date"'
+    assert_includes rendered, ">2025-09-12</time>"
+  end
+
+  test "bridge placeholders contain the same UTC timestamp as display tags" do
+    timestamp = Time.utc(2025, 9, 12, 20, 42)
+
+    rendered = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { time_display_placeholder(timestamp, format: "date") }
+    end
+
+    assert_equal "{{time:date:2025-09-12T20:42:00Z}}", rendered.first
+    assert_equal rendered.first, rendered.last
+  end
+
+  test "bridge share descriptions defer timestamp formatting to the browser" do
+    card = cards(:logo)
+    card.stubs(:assignees).returns([])
+
+    rendered = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { bridge_share_card_description(card) }
+    end
+
+    assert_equal rendered.first, rendered.last
+    assert_includes rendered.first, time_display_placeholder(card.created_at, format: "date")
+    assert_includes rendered.first, time_display_placeholder(card.last_active_at, format: "date")
+  end
+end
diff --git a/test/system/time_display_test.rb b/test/system/time_display_test.rb
new file mode 100644
index 0000000..4ccc761
--- /dev/null
+++ b/test/system/time_display_test.rb
@@ -0,0 +1,99 @@
+require "application_system_test_case"
+
+class TimeDisplayTest < ApplicationSystemTestCase
+  test "formats timestamps in the viewer timezone and by local calendar day" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+
+    comment = comments(:logo_agreement_kevin)
+    timestamp = Time.use_zone("America/Los_Angeles") do
+      Time.current.change(hour: 13, min: 42, sec: 0, usec: 0)
+    end
+    comment.update_columns(created_at: timestamp, updated_at: timestamp)
+
+    sign_in_as(users(:david))
+    visit card_url(comment.card)
+
+    assert_no_selector 'meta[name="timezone"]'
+    assert_selector "a.comment__permalink-title time[datetime='#{timestamp.utc.iso8601}']", text: "1:42 PM"
+
+    page.execute_script(<<~JAVASCRIPT)
+      const today = new Date()
+      const sample = (id, daysFromToday, format = "relative") => {
+        const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() + daysFromToday, 13, 42)
+        const element = document.createElement("time")
+        element.id = `time-sample-${id}`
+        element.dateTime = date.toISOString()
+        element.dataset.controller = "time-display"
+        element.dataset.timeDisplayFormatValue = format
+        element.textContent = element.dateTime
+        document.body.append(element)
+      }
+
+      sample("today", 0)
+      sample("yesterday", -1)
+      sample("tomorrow", 1)
+      sample("five-days-ago", -5)
+      sample("three-days-from-now", 3)
+      sample("older", -7)
+
+      const previousYear = new Date(today.getFullYear() - 1, 5, 12, 13, 42)
+      const olderYear = document.createElement("time")
+      olderYear.id = "time-sample-older-year"
+      olderYear.dateTime = previousYear.toISOString()
+      olderYear.dataset.controller = "time-display"
+      olderYear.dataset.timeDisplayFormatValue = "relative"
+      olderYear.textContent = olderYear.dateTime
+      document.body.append(olderYear)
+
+      const calendarDate = document.createElement("time")
+      calendarDate.id = "calendar-date-sample"
+      calendarDate.dateTime = "2025-09-12"
+      calendarDate.dataset.controller = "time-display"
+      calendarDate.dataset.timeDisplayFormatValue = "calendar-date"
+      calendarDate.textContent = calendarDate.dateTime
+      document.body.append(calendarDate)
+    JAVASCRIPT
+
+    assert_selector "#time-sample-today", text: "1:42 PM"
+    assert_selector "#time-sample-yesterday", text: "yesterday"
+    assert_selector "#time-sample-tomorrow", text: "tomorrow"
+    assert_selector "#time-sample-five-days-ago", text: "5 days ago"
+    assert_selector "#time-sample-three-days-from-now", text: "in 3 days"
+    assert_selector "#calendar-date-sample", text: "Friday, September 12"
+
+    older_year_text = page.find("#time-sample-older-year").text
+    expected_year = page.evaluate_script("new Date().getFullYear() - 1").to_s
+    assert_includes older_year_text, expected_year
+
+    older_date = page.find("#time-sample-older").text
+    expected_older_date = page.evaluate_script(<<~JAVASCRIPT)
+      (() => {
+        const date = new Date()
+        date.setDate(date.getDate() - 7)
+        const options = date.getFullYear() === new Date().getFullYear()
+          ? { month: "short", day: "numeric" }
+          : { month: "short", day: "numeric", year: "numeric" }
+        return new Intl.DateTimeFormat("en-US", options).format(date)
+      })()
+    JAVASCRIPT
+    assert_equal expected_older_date, older_date
+  end
+
+  test "formats card stamp dates in the browser and shares raw timestamps with the bridge" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:shipping))
+
+    time = page.find(".card__closed-date time")
+    stamp = page.find(".card__closed[data-controller~='bridge--stamp']")
+    datetime = time["datetime"]
+    expected_description = "{{time:date:#{datetime}}}"
+    expected_date = page.evaluate_script(
+      %(new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(new Date("#{datetime}")))
+    )
+
+    assert_equal expected_description, stamp["data-bridge-description"]
+    assert_equal expected_date, time.text
+  end
+end
