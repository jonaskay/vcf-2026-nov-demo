diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8c5736b
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time_tag emits the raw UTC timestamp for browser formatting" do
+    timestamp = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_select parse(local_time_tag(timestamp, format: :friendly)), "time[datetime='2025-09-12T13:42:00Z'][data-controller='local-time'][data-local-time-format-value='friendly']", text: "2025-09-12T13:42:00Z"
+  end
+
+  test "local_date_tag emits an unshifted calendar date" do
+    date = Date.new(2025, 9, 12)
+
+    assert_select parse(local_date_tag(date, format: :weekday)), "time[datetime='2025-09-12'][data-local-time-date-value='2025-09-12'][data-local-time-format-value='weekday']", text: "2025-09-12"
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..aaa6821
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,83 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders timestamps using the browser's local calendar" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+    assert_selector ".card__meta-text--added time[data-controller=local-time]", text: /ago/i
+
+    page.execute_script <<~JS
+      (() => {
+        const createTime = (id, date, format) => {
+          const element = document.createElement("time")
+          element.id = id
+          element.dateTime = date.toISOString()
+          element.dataset.controller = "local-time"
+          element.dataset.localTimeFormatValue = format
+          document.body.append(element)
+        }
+        const now = new Date()
+        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 13, 42)
+        const yesterday = new Date(today)
+        yesterday.setDate(yesterday.getDate() - 1)
+        const fiveDaysAgo = new Date(today)
+        fiveDaysAgo.setDate(fiveDaysAgo.getDate() - 5)
+        const older = new Date(today)
+        older.setDate(older.getDate() - 8)
+        const tomorrow = new Date(today)
+        tomorrow.setDate(tomorrow.getDate() + 1)
+        const threeDaysFromNow = new Date(today)
+        threeDaysFromNow.setDate(threeDaysFromNow.getDate() + 3)
+
+        const dateOnlyValue = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`
+        const dateOnly = document.createElement("time")
+        dateOnly.id = "local-date-only"
+        dateOnly.dateTime = dateOnlyValue
+        dateOnly.dataset.controller = "local-time"
+        dateOnly.dataset.localTimeDateValue = dateOnlyValue
+        dateOnly.dataset.localTimeFormatValue = "weekday"
+        document.body.append(dateOnly)
+
+        const timezoneCheck = document.createElement("time")
+        timezoneCheck.id = "local-timezone-check"
+        timezoneCheck.dateTime = "2025-09-12T20:42:00Z"
+        timezoneCheck.dataset.controller = "local-time"
+        timezoneCheck.dataset.localTimeFormatValue = "clock"
+        document.body.append(timezoneCheck)
+
+        createTime("local-clock", today, "friendly")
+        createTime("local-relative", new Date(Date.now() - 2 * 60 * 60 * 1000), "relative")
+        createTime("local-yesterday", yesterday, "friendly")
+        createTime("local-five-days-ago", fiveDaysAgo, "friendly")
+        createTime("local-older", older, "friendly")
+        createTime("local-tomorrow", tomorrow, "future")
+        createTime("local-three-days-from-now", threeDaysFromNow, "future")
+      })()
+    JS
+    expected_clock = page.evaluate_script <<~JS
+      (() => {
+        const now = new Date()
+        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 13, 42)
+        return new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit" }).format(today)
+      })()
+    JS
+
+    assert_selector "time#local-timezone-check", text: "1:42 PM"
+    expected_date = page.evaluate_script <<~JS
+      (() => {
+        const now = new Date()
+        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
+        return new Intl.DateTimeFormat("en", { weekday: "long", month: "long", day: "numeric" }).format(today)
+      })()
+    JS
+    assert_selector "time#local-date-only", text: expected_date
+    assert_selector "time#local-clock", text: expected_clock
+    assert_selector "time#local-relative", text: /2 hours ago/
+    assert_selector "time#local-yesterday", text: "yesterday"
+    assert_selector "time#local-five-days-ago", text: "5 days ago"
+    assert_selector "time#local-older", text: /[A-Z][a-z]{2} \d{1,2}/
+    assert_selector "time#local-tomorrow", text: "tomorrow"
+    assert_selector "time#local-three-days-from-now", text: "in 3 days"
+  end
+end
