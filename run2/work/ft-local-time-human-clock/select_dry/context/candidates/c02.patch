diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..fd70ae8
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,128 @@
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+const dateTimeFormatters = new Map()
+const relativeTimeFormatters = new Map()
+
+export function formatLocalTime(value, format = "date", now = new Date()) {
+  const date = value instanceof Date ? value : new Date(value)
+
+  if (Number.isNaN(date.getTime())) return ""
+
+  switch (format) {
+    case "clock":
+      return dateTimeFormatter({ hour: "numeric", minute: "2-digit" }).format(date)
+    case "date-time":
+      return dateTimeFormatter({ month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }).format(date)
+    case "long-date":
+      return calendarDate(date, now, { month: "short", year: "numeric" })
+    case "weekday":
+      return calendarDate(date, now, { weekday: "long", month: "long" })
+    case "month-day":
+      return calendarDate(date, now, { month: "short" })
+    case "friendly":
+      return friendlyDate(date, now)
+    case "future":
+      return futureDate(date, now)
+    case "relative":
+      return relativeDate(date, now)
+    case "date":
+    default:
+      return calendarDate(date, now, { month: "short" })
+  }
+}
+
+export function formatLocalDate(value, format = "date", now = new Date()) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+
+  if (!match) return ""
+
+  const [, year, month, day] = match
+  return formatLocalTime(new Date(Number(year), Number(month) - 1, Number(day)), format, now)
+}
+
+function friendlyDate(date, now) {
+  const daysFromNow = calendarDayDifference(date, now)
+
+  if (daysFromNow === 0) {
+    return formatLocalTime(date, "clock", now)
+  } else if (Math.abs(daysFromNow) <= 6) {
+    return relativeTimeFormatter().format(daysFromNow, "day")
+  } else {
+    return calendarDate(date, now, { month: "short" })
+  }
+}
+
+function futureDate(date, now) {
+  const daysFromNow = calendarDayDifference(date, now)
+
+  if (daysFromNow === 0) {
+    return "today"
+  } else {
+    return relativeTimeFormatter().format(daysFromNow, "day")
+  }
+}
+
+function relativeDate(date, now) {
+  const differenceInSeconds = (date.getTime() - now.getTime()) / 1000
+  const absoluteDifference = Math.abs(differenceInSeconds)
+  const direction = differenceInSeconds > 0 ? 1 : -1
+  let value, unit
+
+  if (absoluteDifference < 60) {
+    return direction > 0 ? "in less than a minute" : "less than a minute ago"
+  } else if (absoluteDifference < 45 * 60) {
+    value = Math.round(absoluteDifference / 60)
+    unit = "minute"
+  } else if (absoluteDifference < 24 * 60 * 60) {
+    value = Math.round(absoluteDifference / (60 * 60))
+    unit = "hour"
+  } else if (absoluteDifference < 30 * DAY_IN_MILLISECONDS / 1000) {
+    value = Math.round(absoluteDifference / (DAY_IN_MILLISECONDS / 1000))
+    unit = "day"
+  } else if (absoluteDifference < 365 * DAY_IN_MILLISECONDS / 1000) {
+    value = Math.round(absoluteDifference / (30 * DAY_IN_MILLISECONDS / 1000))
+    unit = "month"
+  } else {
+    value = Math.round(absoluteDifference / (365 * DAY_IN_MILLISECONDS / 1000))
+    unit = "year"
+  }
+
+  return relativeTimeFormatter().format(direction * value, unit)
+}
+
+function calendarDate(date, now, options) {
+  const dateOptions = { ...options, day: "numeric" }
+
+  if (options.year === undefined && date.getFullYear() !== now.getFullYear()) {
+    dateOptions.year = "numeric"
+  }
+
+  return dateTimeFormatter(dateOptions).format(date)
+}
+
+function calendarDayDifference(date, now) {
+  const dateDay = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+  const nowDay = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())
+
+  return Math.round((dateDay - nowDay) / DAY_IN_MILLISECONDS)
+}
+
+function dateTimeFormatter(options) {
+  const language = document.documentElement.lang || "en"
+  const key = JSON.stringify([ language, options ])
+
+  if (!dateTimeFormatters.has(key)) {
+    dateTimeFormatters.set(key, new Intl.DateTimeFormat(language, options))
+  }
+
+  return dateTimeFormatters.get(key)
+}
+
+function relativeTimeFormatter() {
+  const language = document.documentElement.lang || "en"
+
+  if (!relativeTimeFormatters.has(language)) {
+    relativeTimeFormatters.set(language, new Intl.RelativeTimeFormat(language, { numeric: "auto" }))
+  }
+
+  return relativeTimeFormatters.get(language)
+}
