diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..e46ee3e
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalDate, formatLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { date: String, format: String }
+
+  connect() {
+    this.update()
+    this.observer = new MutationObserver(() => this.update())
+    this.observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-date-value", "data-local-time-format-value" ],
+      childList: true,
+      characterData: true
+    })
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  update() {
+    const text = this.hasDateValue
+      ? formatLocalDate(this.dateValue, this.formatValue)
+      : formatLocalTime(this.element.dateTime, this.formatValue)
+
+    if (this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+  }
+}
