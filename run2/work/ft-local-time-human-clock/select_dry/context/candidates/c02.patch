diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..b5cd8ad 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,24 @@
 module TimeHelper
+  def local_time_tag(time, format: :relative, **options)
+    timestamp = time.utc.iso8601
+    data = local_time_data(options.delete(:data), format)
+
+    time_tag time.utc, timestamp, **options, data: data
+  end
+
+  def local_date_tag(date, format: :date, **options)
+    date = date.to_date
+    value = date.iso8601
+    data = local_time_data(options.delete(:data), format).merge(local_time_date_value: value)
+
+    tag.time value, datetime: value, **options, data: data
+  end
+
+  private
+    def local_time_data(data, format)
+      data = (data || {}).dup
+      data[:controller] = (Array(data[:controller]) + [ "local-time" ]).compact.uniq.join(" ")
+      data[:local_time_format_value] = format.to_s
+      data
+    end
 end
