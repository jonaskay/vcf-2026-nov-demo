diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..26e8492
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,52 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap-half" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input full-width", placeholder: "Search cards…", autofocus: @query.blank? %>
+    <%= form.button "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="panel panel--wide center margin-block-start" aria-label="Search results">
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <div class="flex flex-column gap">
+          <% @page.records.each do |card| %>
+            <article class="search-result" id="<%= dom_id(card, :search_result) %>">
+              <h2 class="txt-medium margin-none">
+                <%= link_to highlight(card.title, @search_terms), card_path(card), class: "search-result__title" %>
+              </h2>
+
+              <p class="txt-small txt-subtle margin-none-block-start">
+                <%= link_to card.board.name, board_path(card.board) %>
+              </p>
+
+              <% if description_excerpt = search_result_excerpt(card.description, @search_terms) %>
+                <p class="search-result__excerpt txt-align-start margin-none-block-start"><%= highlight(description_excerpt, @search_terms) %></p>
+              <% end %>
+
+              <% matching_search_comments(card, @search_terms).each do |comment, comment_excerpt| %>
+                <p class="search-result__comment txt-align-start txt-small margin-none-block-start">
+                  <span class="txt-subtle">Comment:</span>
+                  <%= highlight(comment_excerpt, @search_terms) %>
+                </p>
+              <% end %>
+            </article>
+          <% end %>
+        </div>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”</p>
+    <% end %>
+  </section>
+<% end %>
