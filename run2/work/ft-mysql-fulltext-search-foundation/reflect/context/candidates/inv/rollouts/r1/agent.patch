+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @search_terms = @query.split(/[[:space:]]+/)
+
+    if @search_terms.any?
+      cards = Current.user.accessible_cards.published
+        .matching_search_terms(@search_terms)
+        .reverse_chronologically
+        .includes(:board, :rich_text_description)
+
+      set_page_and_extract_portion_from cards
+    end
+  end
+end
