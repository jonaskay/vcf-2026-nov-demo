@@ -0,0 +1,32 @@
+module SearchesHelper
+  def search_result_excerpt(content, terms)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    search_terms = Array(terms).reject(&:blank?)
+    return if text.blank? || search_terms.empty?
+
+    pattern = Regexp.new(search_terms.map { |term| Regexp.escape(term) }.join("|"), Regexp::IGNORECASE)
+    match = text.match(pattern)
+    excerpt(text, match[0], radius: 100) if match
+  end
+
+  def matching_search_comments(card, terms)
+    search_terms = Array(terms).reject(&:blank?)
+    return [] if search_terms.empty?
+
+    patterns = search_terms.map do |term|
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+    end
+    conditions = Array.new(patterns.length, "action_text_rich_texts.body LIKE ? ESCAPE '!'").join(" OR ")
+
+    card.comments
+      .joins(:rich_text_body)
+      .where(conditions, *patterns)
+      .preload(:rich_text_body)
+      .order(created_at: :desc, id: :desc)
+      .limit(3)
+      .filter_map do |comment|
+        comment_excerpt = search_result_excerpt(comment.body, search_terms)
+        [ comment, comment_excerpt ] if comment_excerpt
+      end
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..535b903 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,34 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :matching_search_terms, ->(terms) do
+    Array(terms).reject(&:blank?).reduce(all) do |cards, term|
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+
+      cards.where(<<~SQL.squish, pattern: pattern)
+        cards.title LIKE :pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts AS card_descriptions
+          WHERE card_descriptions.record_type = 'Card'
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.name = 'description'
+            AND card_descriptions.body LIKE :pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comment_bodies.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+    end
+  end
+
   def card
     self
   end
