diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..5631cb4
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comments and highlights matches" do
+    title_card, description_card, comment_card = with_current_user(:kevin) do
+      title_card = create_search_card(title: "The NeedLe is in the title")
+      description_card = create_search_card(title: "Description result", description: "Look for needle in this description")
+      comment_card = create_search_card(title: "Comment result")
+      comment_card.comments.create!(body: "A comment mentions the needle")
+      [ title_card, description_card, comment_card ]
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    [ title_card, description_card, comment_card ].each do |card|
+      assert_select "a[href=?]", card_path(card)
+    end
+    assert_select "mark", text: "NeedLe"
+    assert_select "mark", text: "needle"
+    assert_select ".search-result__comment mark", text: "needle"
+  end
+
+  test "search terms can match across card fields and are highlighted" do
+    card = with_current_user(:kevin) do
+      create_search_card(title: "Amber title", description: "Cobalt in the description")
+    end
+
+    get search_path, params: { q: "amber cobalt" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "Amber"
+    assert_select ".search-result__excerpt mark", text: "Cobalt"
+    assert_select "a[href=?]", card_path(card)
+  end
+
+  test "search page without a query shows the search form" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?] input[name=q]", search_path
+  end
+
+  test "search results are newest first" do
+    older, newer = with_current_user(:kevin) do
+      older = create_search_card(title: "sortneedle older", created_at: 2.days.ago)
+      newer = create_search_card(title: "sortneedle newer", created_at: 1.day.ago)
+      [ older, newer ]
+    end
+
+    get search_path, params: { q: "sortneedle" }
+
+    assert_response :success
+    result_links = css_select(".search-result__title").map { |link| link["href"] }
+    assert_equal [ card_path(newer), card_path(older) ], result_links
+  end
+
+  test "search hides cards on boards the user no longer has access to" do
+    card = with_current_user(:kevin) do
+      create_search_card(title: "invisibleaccessneedle")
+    end
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "invisibleaccessneedle" }
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(card), count: 0
+  end
+
+  test "search does not return draft cards or comments on drafts" do
+    draft = with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "drafttitleneedle")
+      comment = Comment.new(card: draft, creator: users(:kevin), account: draft.account)
+      comment.save!(validate: false)
+      ActionText::RichText.create!(account: draft.account, record: comment, name: "body", body: "draftcommentneedle")
+      draft
+    end
+
+    get search_path, params: { q: "drafttitleneedle" }
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft), count: 0
+
+    get search_path, params: { q: "draftcommentneedle" }
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft), count: 0
+  end
+
+  test "search treats wildcard characters literally" do
+    card = with_current_user(:kevin) do
+      create_search_card(title: "100%_match")
+    end
+
+    get search_path, params: { q: "%_" }
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(card)
+    assert_select "mark", text: "%_"
+  end
+
+  private
+    def create_search_card(title:, description: nil, created_at: Time.current)
+      boards(:writebook).cards.create!(
+        title: title,
+        description: description,
+        status: :published,
+        created_at: created_at,
+        last_active_at: created_at,
+        creator: users(:kevin)
+      )
+    end
+end
