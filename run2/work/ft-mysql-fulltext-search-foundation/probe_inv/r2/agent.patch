diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..43e56f8
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,47 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search-results center pad-inline txt-align-start" style="max-inline-size: 70ch;">
+  <%= form_with url: search_path, method: :get, class: "flex align-end gap margin-block-end" do |form| %>
+    <div class="flex flex-column gap-half flex-item-grow">
+      <%= form.label :q, "Search card titles, descriptions, and comments" %>
+      <%= form.search_field :q, value: @query, class: "input full-width", autofocus: true %>
+    </div>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <div class="search-results__list">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <% @page.records.each do |card| %>
+            <% description = card.description.to_plain_text %>
+            <% matching_comment = @matching_comments_by_card_id[card.id] %>
+
+            <article class="search-result border-top pad-block">
+              <h2 class="search-result__title txt-large margin-none">
+                <%= link_to highlight_search_matches(card.title, @query), card_path(card) %>
+              </h2>
+              <p class="txt-small margin-block-half">
+                <%= link_to card.board.name, card.board %> · Card <%= card.number %>
+              </p>
+              <% if search_term_matches?(description, @query) %>
+                <p class="search-result__description margin-none"><%= search_excerpt(description, @query) %></p>
+              <% end %>
+              <% if matching_comment && search_term_matches?(matching_comment.body.to_plain_text, @query) %>
+                <p class="search-result__comment margin-none"><%= search_excerpt(matching_comment.body.to_plain_text, @query) %></p>
+              <% end %>
+            </article>
+          <% end %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards matched “<%= @query %>”.</p>
+    <% end %>
+  <% else %>
+    <p>Search for words in the title, description, or comments on cards you can access.</p>
+  <% end %>
+</section>
