new file mode 100644
index 0000000..37904da
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,19 @@
+module SearchHelper
+  def highlight_search_matches(text, query)
+    escaped_text = ERB::Util.html_escape(text.to_s)
+    escaped_terms = query.to_s.split.map { ERB::Util.html_escape(it) }
+
+    highlight(escaped_text, escaped_terms, sanitize: false)
+  end
+
+  def search_excerpt(text, query)
+    content = text.to_s
+    snippet = excerpt(content, query, radius: 120) || content.truncate(240)
+
+    highlight_search_matches(snippet, query)
+  end
+
+  def search_term_matches?(text, query)
+    text.to_s.downcase.include?(query.to_s.downcase)
+  end
+end
