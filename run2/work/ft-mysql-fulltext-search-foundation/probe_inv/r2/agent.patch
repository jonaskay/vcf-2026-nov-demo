@@ -0,0 +1,30 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.published
+      .containing_search_term(@query)
+      .reverse_chronologically
+      .includes(:board)
+      .with_rich_text_description
+
+    set_page_and_extract_portion_from(cards)
+    @matching_comments_by_card_id = matching_comments_for(@page.records)
+  end
+
+  private
+    def matching_comments_for(cards)
+      if cards.any? && @query.present?
+        pattern = "%#{Comment.sanitize_sql_like(@query, "!")}%"
+
+        Comment.joins(:rich_text_body)
+          .where(card_id: cards.map(&:id))
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", pattern)
+          .includes(:rich_text_body)
+          .order(created_at: :desc, id: :desc)
+          .group_by(&:card_id)
+          .transform_values(&:first)
+      else
+        {}
+      end
+    end
+end
