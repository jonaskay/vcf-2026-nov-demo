diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..1fa70b5
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions, and comments and highlights matches" do
+    with_current_user(:kevin) do
+      cards(:logo).update! title: "Needle in the title"
+      cards(:layout).update! description: "Needle in the description"
+      cards(:text).comments.create! body: "Needle in a comment"
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title a[href=?]", card_path(cards(:logo)) do
+      assert_select "mark", text: "Needle"
+    end
+    assert_select ".search-result__description mark", text: "Needle"
+    assert_select ".search-result__comment mark", text: "Needle"
+  end
+
+  test "orders results newest first" do
+    with_current_user(:kevin) do
+      cards(:logo).update_column :created_at, 2.days.ago
+      cards(:layout).update_column :created_at, 1.day.ago
+      cards(:logo).update! title: "Search order match"
+      cards(:layout).update! title: "Search order match"
+    end
+
+    get search_path, params: { q: "Search order match" }
+
+    assert_response :success
+    assert_equal [ card_path(cards(:layout)), card_path(cards(:logo)) ],
+      css_select(".search-result__title a").map { |link| link["href"] }
+  end
+
+  test "does not return drafts or their comments" do
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(title: "Hidden draft phrase", status: :drafted)
+      draft_comment = Comment.new(card: draft, creator: users(:kevin), account: accounts("37s"), body: "Hidden draft phrase")
+      draft_comment.rich_text_body.account = accounts("37s")
+      draft_comment.save!(validate: false)
+    end
+
+    get search_path, params: { q: "Hidden draft phrase" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search results disappear when board access is revoked" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Private search phrase", status: :published)
+      boards(:private).accesses.grant_to(users(:jz))
+    end
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "Private search phrase" }
+    assert_response :success
+    assert_select ".search-result", count: 1
+
+    boards(:private).accesses.revoke_from(users(:jz))
+    get search_path, params: { q: "Private search phrase" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "blank searches do not list every card" do
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search treats SQL wildcard characters literally" do
+    with_current_user(:kevin) do
+      cards(:logo).update! title: "A 100% complete result"
+    end
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_equal [ card_path(cards(:logo)) ], css_select(".search-result__title a").map { |link| link["href"] }
+    assert_select ".search-result__title mark", text: "%"
+  end
+
+  test "matched card text is safely escaped" do
+    with_current_user(:kevin) do
+      cards(:logo).update! title: "Needle <img src=x onerror=alert(1)>"
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "Needle"
+    assert_select ".search-result__title img", count: 0
+  end
+end
