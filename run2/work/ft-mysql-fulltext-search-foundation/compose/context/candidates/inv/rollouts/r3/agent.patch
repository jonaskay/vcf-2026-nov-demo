diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..877c616
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions, and comment bodies, highlighting matches newest first" do
+    with_current_user(:kevin) do
+      cards(:logo).update_column :title, "Needle in the title"
+      cards(:layout).update!(description: "Needle in the description")
+      cards(:shipping).comments.create!(body: "Needle in a comment")
+    end
+
+    cards(:logo).update_column :created_at, 1.day.ago
+    cards(:layout).update_column :created_at, 2.hours.ago
+    cards(:shipping).update_column :created_at, 1.hour.ago
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result h2 a" do |links|
+      assert_equal [ cards(:shipping), cards(:layout), cards(:logo) ].map { card_path(_1) }, links.map { _1["href"] }
+    end
+    assert_select "mark", text: "Needle", count: 3
+    assert_select ".search-result__excerpt mark", text: "Needle", count: 2
+  end
+
+  test "highlights each word of a multi-word query" do
+    cards(:logo).update_column :title, "Needle phrase"
+
+    get search_path, params: { q: "needle phrase" }
+
+    assert_response :success
+    assert_select ".search-result h2 a mark", text: "Needle"
+    assert_select ".search-result h2 a mark", text: "phrase"
+  end
+
+  test "does not show cards from boards the user no longer has access to" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "never returns drafted cards or comments on drafted cards" do
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Hidden needle")
+      comment = draft.comments.build(creator: users(:kevin), account: accounts("37s"), body: "Hidden needle comment")
+      comment.rich_text_body.account = accounts("37s")
+      comment.save!(validate: false)
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_not_includes response.body, "Hidden needle"
+  end
+
+  test "treats SQL wildcard characters in the query literally" do
+    cards(:logo).update_column :title, "Budget is 100% complete"
+    cards(:layout).update_column :title, "Budget is 100x complete"
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result h2 a[href=?]", card_path(cards(:logo))
+    assert_select ".search-result h2 a[href=?]", card_path(cards(:layout)), count: 0
+    assert_select "mark", text: "%"
+  end
+
+  test "renders a search form without exposing results for an empty query" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?] input[name=q]", search_path
+    assert_select ".search-result", count: 0
+  end
+end
