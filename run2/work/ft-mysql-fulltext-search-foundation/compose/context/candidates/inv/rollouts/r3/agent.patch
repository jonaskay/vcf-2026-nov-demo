@@ -0,0 +1,32 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from search_results
+    @comments_by_card = matching_comments
+  end
+
+  private
+    def search_results
+      if @query.present?
+        Current.user.accessible_cards.published
+          .matching_text(@query)
+          .reverse_chronologically
+          .includes(:board)
+          .with_rich_text_description
+      else
+        Card.none
+      end
+    end
+
+    def matching_comments
+      if @query.present? && @page.records.any?
+        Comment.matching_text(@query)
+          .where(card_id: @page.records.map(&:id))
+          .includes(:creator, :rich_text_body)
+          .chronologically
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..92d3cee
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,11 @@
+module SearchHelper
+  def search_highlight(text)
+    highlight(text, @query.split(/\s+/))
+  end
+
+  def search_excerpt(content)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    snippet = excerpt(text, @query, radius: 100, omission: "…")
+    search_highlight(snippet) if snippet
+  end
+end
