diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..b00592e
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, class: "flex align-center justify-center gap margin-block-start" do %>
+  <%= label_tag :q, "Search cards", class: "visually-hidden" %>
+  <%= search_field_tag :q, @query, placeholder: "Search cards…", class: "input", autofocus: true %>
+  <%= submit_tag "Search", class: "btn" %>
+<% end %>
+
+<% if @query.present? %>
+  <% if @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page, class: "search-results margin-block-start" do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result panel borderless pad margin-block txt-align-start" data-card-id="<%= card.id %>">
+          <h2 class="txt-medium">
+            <%= link_to highlight(card.title, @query), card_path(card) %>
+          </h2>
+
+          <p class="txt-small margin-block-half">
+            <%= link_to card.board.name, board_path(card.board) %>
+          </p>
+
+          <% description = card.description.to_plain_text %>
+          <% if description.match?(/#{Regexp.escape(@query)}/i) %>
+            <p class="search-result__description"><%= highlight(excerpt(description, @query, radius: 120), @query) %></p>
+          <% end %>
+
+          <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+            <p class="search-result__comment"><%= highlight(excerpt(comment.body.to_plain_text, @query, radius: 120), @query) %></p>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p class="blank-slate margin-block-start">No cards match “<%= @query %>”</p>
+  <% end %>
+<% else %>
+  <p class="blank-slate margin-block-start">Search card titles, descriptions, and comments</p>
+<% end %>
