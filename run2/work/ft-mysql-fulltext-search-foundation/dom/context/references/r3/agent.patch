@@ -0,0 +1,42 @@
+class SearchController < ApplicationController
+  MATCHING_COMMENTS_PER_CARD = 3
+
+  def index
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.published
+      .searching(@query)
+      .reverse_chronologically
+      .with_rich_text_description
+      .preload(:board)
+    set_page_and_extract_portion_from cards
+    @matching_comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def matching_comments_by_card
+      if @query.present? && @page.records.any?
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(@query, "!")}%"
+        matching_comments = Comment
+          .joins(:rich_text_body)
+          .where(account_id: Current.account.id, card_id: @page.records.map(&:id))
+          .where(action_text_rich_texts: { account_id: Current.account.id })
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", pattern)
+          .select(<<~SQL.squish)
+            comments.*,
+            ROW_NUMBER() OVER (
+              PARTITION BY comments.card_id
+              ORDER BY comments.created_at DESC, comments.id DESC
+            ) AS search_rank
+          SQL
+
+        Comment
+          .from(matching_comments, :comments)
+          .where("search_rank <= ?", MATCHING_COMMENTS_PER_CARD)
+          .preload(:rich_text_body)
+          .order(Arel.sql("search_rank ASC"))
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..f1d9004 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,39 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :searching, ->(query) do
+    if query.present?
+      pattern = "%#{Card.sanitize_sql_like(query, "!")}%"
+
+      where(<<~SQL.squish, pattern, pattern, pattern)
+        cards.title LIKE ? ESCAPE '!'
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts AS card_descriptions
+          WHERE card_descriptions.record_type = 'Card'
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.name = 'description'
+            AND card_descriptions.account_id = cards.account_id
+            AND card_descriptions.body LIKE ? ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+            AND comment_bodies.account_id = comments.account_id
+          WHERE comments.card_id = cards.id
+            AND comments.account_id = cards.account_id
+            AND comment_bodies.body LIKE ? ESCAPE '!'
+        )
+      SQL
+    else
+      none
+    end
+  end
+
   def card
     self
   end
