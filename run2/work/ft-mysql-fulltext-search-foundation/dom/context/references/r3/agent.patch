diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..7678290
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.account = accounts(:"37s")
+  end
+
+  test "search finds cards by title, description, and comment body newest first" do
+    title_card = create_published_card(title: "Searchable title", created_at: 3.minutes.ago)
+    description_card = create_published_card(
+      title: "A description match",
+      description: "<p>Searchable description</p>",
+      created_at: 2.minutes.ago
+    )
+    comment_card = create_published_card(title: "A comment match", created_at: 1.minute.ago)
+    comment_card.comments.create!(body: "<p>Searchable comment</p>", creator: users(:kevin))
+    4.times do |index|
+      comment_card.comments.create!(body: "<p>Searchable comment #{index}</p>", creator: users(:kevin))
+    end
+
+    get search_path, params: { q: "Searchable" }
+
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ comment_card.id, description_card.id, title_card.id ],
+        results.map { |result| result["data-card-id"] }
+    end
+
+    assert_select ".search-result a[href=?] mark", card_path(title_card), text: "Searchable"
+    assert_select ".search-result[data-card-id=?] .search-result__description mark", description_card.id, text: "Searchable"
+    assert_select ".search-result[data-card-id=?] .search-result__comment mark", comment_card.id, text: "Searchable"
+    assert_select ".search-result[data-card-id=?] .search-result__comment", comment_card.id, count: 3
+  end
+
+  test "search only returns cards on boards the user currently has access to and never returns drafts" do
+    inaccessible_board = Board.create!(
+      name: "Not accessible",
+      creator: users(:jz),
+      account: accounts(:"37s"),
+      all_access: false
+    )
+    inaccessible_card = create_published_card(
+      board: inaccessible_board,
+      title: "Secretneedle title",
+      creator: users(:jz)
+    )
+    accessible_private_card = create_published_card(board: boards(:private), title: "Private needle card")
+
+    draft = boards(:writebook).cards.create!(
+      title: "Draftneedle title",
+      status: :drafted,
+      creator: users(:kevin)
+    )
+    draft_comment = draft.comments.build(account: accounts(:"37s"), creator: users(:kevin), body: "Draftneedle comment")
+    draft_comment.rich_text_body.account = accounts(:"37s")
+    draft_comment.save!(validate: false)
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id=?]", accessible_private_card.id
+    assert_select ".search-result[data-card-id=?]", inaccessible_card.id, count: 0
+    assert_select ".search-result[data-card-id=?]", draft.id, count: 0
+    assert_not_includes response.body, inaccessible_card.title
+    assert_not_includes response.body, draft.title
+    assert_not_includes response.body, "Draftneedle comment"
+
+    Access.where(board: boards(:private), user: users(:kevin)).delete_all
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id=?]", accessible_private_card.id, count: 0
+  end
+
+  test "search treats wildcard characters literally and blank queries return no results" do
+    percent_card = create_published_card(title: "100% ready")
+    another_card = create_published_card(title: "100 percent ready")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id=?]", percent_card.id
+    assert_select ".search-result[data-card-id=?]", another_card.id, count: 0
+
+    get search_path, params: { q: "  " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search highlights matches without rendering card markup as HTML" do
+    card = create_published_card(title: "<script>alert('xss')</script> Searchable")
+
+    get search_path, params: { q: "Searchable" }
+
+    assert_response :success
+    assert_select ".search-result h2 script", count: 0
+    assert_select ".search-result[data-card-id=?] h2 mark", card.id, text: "Searchable"
+  end
+
+  private
+    def create_published_card(board: boards(:writebook), creator: users(:kevin), **attributes)
+      card = board.cards.create!(attributes.merge(status: :drafted, creator: creator))
+      card.update_column :status, "published"
+      card
+    end
+end
