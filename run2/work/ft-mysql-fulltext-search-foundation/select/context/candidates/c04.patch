diff --git a/app/views/search/_result.html.erb b/app/views/search/_result.html.erb
new file mode 100644
index 0000000..87ff23e
--- /dev/null
+++ b/app/views/search/_result.html.erb
@@ -0,0 +1,20 @@
+<article class="search-result flex flex-column gap-half border-radius pad fill-white">
+  <header class="flex flex-column gap-half">
+    <h2 class="txt-medium margin-none">
+      <%= link_to highlight(card.title, terms), card_path(card), class: "search-result__title" %>
+    </h2>
+    <p class="txt-small margin-none">
+      <%= link_to card.board.name, board_path(card.board) %> · #<%= card.number %>
+    </p>
+  </header>
+
+  <% if description_excerpt = search_excerpt(card.description, terms) %>
+    <p class="search-result__description margin-none"><strong>Description:</strong> <%= highlight(description_excerpt, terms) %></p>
+  <% end %>
+
+  <% comments.each do |comment| %>
+    <% if comment_excerpt = search_excerpt(comment.body, terms) %>
+      <p class="search-result__comment margin-none"><strong>Comment:</strong> <%= highlight(comment_excerpt, terms) %></p>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..8729fb5
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,25 @@
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards, descriptions, and comments…", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @search_terms.any? %>
+    <% if @page.records.any? %>
+      <div class="flex flex-column gap">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <% @page.records.each do |card| %>
+            <%= render "search/result", card: card, comments: @comments_by_card_id.fetch(card.id, []), terms: @search_terms %>
+          <% end %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards match this search.</p>
+    <% end %>
+  <% end %>
+</section>
