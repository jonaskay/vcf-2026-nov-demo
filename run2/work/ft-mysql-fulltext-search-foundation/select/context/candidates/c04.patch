new file mode 100644
index 0000000..12773e2
--- /dev/null
+++ b/app/controllers/search_controller.rb
@@ -0,0 +1,68 @@
+class SearchController < ApplicationController
+  SEARCH_CONDITION = <<~SQL.squish
+    cards.title LIKE ? ESCAPE '!'
+    OR EXISTS (
+      SELECT 1
+      FROM action_text_rich_texts AS card_descriptions
+      WHERE card_descriptions.record_type = 'Card'
+        AND card_descriptions.record_id = cards.id
+        AND card_descriptions.name = 'description'
+        AND card_descriptions.body LIKE ? ESCAPE '!'
+    )
+    OR EXISTS (
+      SELECT 1
+      FROM comments
+      INNER JOIN action_text_rich_texts AS comment_bodies
+        ON comment_bodies.record_type = 'Comment'
+        AND comment_bodies.record_id = comments.id
+        AND comment_bodies.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND comment_bodies.body LIKE ? ESCAPE '!'
+    )
+  SQL
+
+  def index
+    @query = params[:q].to_s
+    @search_terms = @query.split.uniq
+    @page_title = "Search"
+
+    set_page_and_extract_portion_from search_results
+    @comments_by_card_id = matching_comments.group_by(&:card_id)
+  end
+
+  private
+    def search_results
+      cards = Current.user.accessible_cards.published
+
+      if @search_terms.empty?
+        cards = cards.none
+      else
+        @search_terms.each do |term|
+          pattern = search_pattern(term)
+          cards = cards.where(SEARCH_CONDITION, pattern, pattern, pattern)
+        end
+      end
+
+      cards.reverse_chronologically.preload(:board, :rich_text_description)
+    end
+
+    def matching_comments
+      if @search_terms.any? && @page.records.any?
+        conditions = Array.new(@search_terms.size, "action_text_rich_texts.body LIKE ? ESCAPE '!' ").join("OR ")
+
+        Current.user.accessible_comments
+          .where(card_id: @page.records.map(&:id))
+          .joins(:rich_text_body)
+          .where("(#{conditions})", *@search_terms.map { |term| search_pattern(term) })
+          .preload(:rich_text_body)
+          .order("comments.created_at DESC, comments.id DESC")
+          .to_a
+      else
+        []
+      end
+    end
+
+    def search_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..817dd16
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,30 @@
+module SearchHelper
+  def search_excerpt(content, terms, radius: 80)
+    return if content.blank?
+
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    text = text.gsub(/\s+/, " ").strip
+    matches = terms.filter_map do |term|
+      if match = Regexp.new(Regexp.escape(term), Regexp::IGNORECASE).match(text)
+        [ match.begin(0), match.end(0) ]
+      end
+    end
+    return if matches.empty?
+
+    ranges = matches.map do |start, finish|
+      [ [ start - radius, 0 ].max, [ finish + radius, text.length ].min ]
+    end.sort.each_with_object([]) do |range, excerpts|
+      if excerpts.last && range.first <= excerpts.last.last
+        excerpts.last[1] = [ excerpts.last[1], range.last ].max
+      else
+        excerpts << range
+      end
+    end
+
+    ranges.map do |start, finish|
+      prefix = "…" if start.positive?
+      suffix = "…" if finish < text.length
+      "#{prefix}#{text[start...finish]}#{suffix}"
+    end.join(" … ")
+  end
+end
