diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..7d8e1d8
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "matches all words in any order across title and comments" do
+    [ "logo big", "big logo" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select ".search-result__title[href=?]", card_path(cards(:logo))
+      assert_select ".search-result__title mark", text: "logo"
+    end
+
+    get search_path, params: { q: "agree logo" }
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(cards(:logo))
+    assert_select ".search-result__comment mark", text: "agree"
+  end
+
+  test "requires every query word to match" do
+    get search_path, params: { q: "logo missingword" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds descriptions and comment-only matches and highlights plain text" do
+    cards(:text).update!(description: "<p>Jellyfish logistics details</p>")
+
+    get search_path, params: { q: "jellyfish logistics" }
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(cards(:text))
+    assert_select ".search-result__description" do |elements|
+      assert_includes elements.first.text, "Jellyfish logistics details"
+    end
+    assert_select ".search-result__description mark", text: "Jellyfish"
+    assert_select ".search-result__description mark", text: "logistics"
+
+    get search_path, params: { q: "overflowing container" }
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(cards(:layout))
+    assert_select ".search-result__comment mark", text: "overflowing"
+    assert_select ".search-result__comment mark", text: "container"
+  end
+
+  test "lists results newest first" do
+    older = create_published_card("searchorderingneedle older", created_at: 5.minutes.ago)
+    newer = create_published_card("searchorderingneedle newer", created_at: 1.minute.ago)
+
+    get search_path, params: { q: "searchorderingneedle" }
+
+    assert_response :success
+    assert_equal [ card_path(newer), card_path(older) ], css_select(".search-result__title").map { |link| link["href"] }
+  end
+
+  test "does not return drafts or comments on draft cards" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted)
+    draft.update!(title: "drafttitleneedle", description: "draftdescriptionneedle")
+    draft_comment = Comment.new(card: draft, creator: users(:kevin), account: accounts("37s"))
+    draft_comment.save!(validate: false)
+    ActionText::RichText.create!(account: accounts("37s"), record: draft_comment, name: "body", body: "draftcommentneedle")
+
+    get search_path, params: { q: "drafttitleneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftdescriptionneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftcommentneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search results stop appearing immediately when board access is revoked" do
+    card = create_published_card("revokedaccessneedle", board: boards(:private))
+
+    get search_path, params: { q: "revokedaccessneedle" }
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(card)
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "revokedaccessneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "treats percent and underscore in queries as literal characters" do
+    percent = create_published_card("percent%literalneedle")
+    underscore = create_published_card("under_scoreliteralneedle")
+
+    get search_path, params: { q: "%" }
+    assert_response :success
+    assert_equal [ card_path(percent) ], css_select(".search-result__title").map { |link| link["href"] }
+
+    get search_path, params: { q: "_" }
+    assert_response :success
+    assert_equal [ card_path(underscore) ], css_select(".search-result__title").map { |link| link["href"] }
+  end
+
+  test "escapes titles before highlighting" do
+    card = cards(:buy_domain)
+    card.update_column(:title, "<script>SearchXSSNeedle</script>")
+
+    get search_path, params: { q: "searchxssneedle" }
+
+    assert_response :success
+    assert_select ".search-result__title script", count: 0
+    assert_select ".search-result__title mark", text: "SearchXSSNeedle"
+  end
+
+  test "blank queries return no cards" do
+    get search_path, params: { q: "  \n  " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_published_card(title, board: boards(:writebook), created_at: Time.current)
+      with_kevin_as_model_user do
+        board.cards.create!(
+          creator: users(:kevin),
+          title: title,
+          status: :published,
+          created_at: created_at,
+          last_active_at: created_at
+        )
+      end
+    end
+
+    def with_kevin_as_model_user(&block)
+      Current.with(account: accounts("37s")) do
+        with_current_user(:kevin, &block)
+      end
+    end
+end
