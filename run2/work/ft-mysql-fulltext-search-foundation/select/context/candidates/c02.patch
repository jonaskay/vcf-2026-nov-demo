@@ -0,0 +1,31 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from search_results
+    @matching_comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards.published
+        .matching_search_term(@query)
+        .reverse_chronologically
+        .with_rich_text_description
+        .includes(:board)
+    end
+
+    def matching_comments_by_card
+      if @query.present? && @page.records.any?
+        pattern = "%#{Card.sanitize_sql_like(@query, "!")}%"
+
+        Comment.joins(:rich_text_body)
+          .where(card_id: @page.records.map(&:id))
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", pattern)
+          .preload(:rich_text_body)
+          .order(created_at: :desc)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..386227a
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,8 @@
+module SearchHelper
+  def highlighted_search_excerpt(content, query, radius: 12)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    matching_excerpt = excerpt(text, query, radius: radius, separator: " ")
+
+    highlight(matching_excerpt, query) if matching_excerpt
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..bfce248 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -20,6 +20,33 @@ class Card < ApplicationRecord
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
+  scope :matching_search_term, ->(term) do
+    if term.present?
+      term_pattern = "%#{sanitize_sql_like(term, "!")}%"
+
+      where(<<~SQL.squish, term_pattern:)
+        cards.title LIKE :term_pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts AS description_texts
+          WHERE description_texts.record_type = 'Card'
+            AND description_texts.record_id = cards.id
+            AND description_texts.name = 'description'
+            AND description_texts.body LIKE :term_pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts AS comment_texts
+            ON comment_texts.record_type = 'Comment'
+            AND comment_texts.record_id = comments.id
+            AND comment_texts.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comment_texts.body LIKE :term_pattern ESCAPE '!'
+        )
+      SQL
+    else
+      none
+    end
+  end
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
