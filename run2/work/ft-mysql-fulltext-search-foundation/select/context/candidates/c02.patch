diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..a824762
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions, and comment bodies in newest-first order with highlighted matches" do
+    freeze_time do
+      title_card, description_card, comment_card = with_current_user(:kevin) do
+        title_card = create_card("quasar in the title", created_at: 3.days.ago)
+        description_card = create_card("Description result", description: "A quasar in the description", created_at: 2.days.ago)
+        comment_card = create_card("Comment result", created_at: 1.day.ago)
+        comment_card.comments.create!(creator: users(:kevin), account: accounts("37s"), body: "A quasar in the comment")
+        [ title_card, description_card, comment_card ]
+      end
+
+      get search_path, params: { q: "quasar" }
+
+      assert_response :success
+      assert_select ".search-result", count: 3
+
+      result_numbers = css_select(".search-result").map { |result| result["data-card-number"].to_i }
+      assert_equal [ comment_card.number, description_card.number, title_card.number ], result_numbers
+
+      assert_select ".search-result[data-card-number='#{title_card.number}'] h2 mark", text: "quasar"
+      assert_select ".search-result[data-card-number='#{description_card.number}'] .search-result__match mark", text: "quasar"
+      assert_select ".search-result[data-card-number='#{comment_card.number}'] .search-result__comment mark", text: "quasar"
+    end
+  end
+
+  test "only searches published cards from boards the user currently has access to" do
+    private_card, accessible_card, draft = with_current_user(:kevin) do
+      private_card = boards(:private).cards.create!(
+        creator: users(:kevin), status: :published, title: "accessneedle private result"
+      )
+      accessible_card = boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :published, title: "accessneedle accessible result"
+      )
+      draft = boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :drafted, title: "accessneedle draft result"
+      )
+      create_draft_comment(draft, "accessneedle draft comment")
+      [ private_card, accessible_card, draft ]
+    end
+
+    get search_path, params: { q: "accessneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 2
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "accessneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result[data-card-number='#{private_card.number}']", count: 0
+    assert_select ".search-result[data-card-number='#{accessible_card.number}']", count: 1
+    assert_select ".search-result[data-card-number='#{draft.number}']", count: 0
+  end
+
+  test "does not return cards matched only by a comment on a draft" do
+    draft = with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Unpublished")
+      create_draft_comment(draft, "draftonlyneedle")
+      draft
+    end
+
+    get search_path, params: { q: "draftonlyneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "treats SQL wildcard characters in the query literally" do
+    exact_match = with_current_user(:kevin) { create_card("literal%token") }
+    with_current_user(:kevin) { create_card("literalXtoken") }
+
+    get search_path, params: { q: "literal%" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result[data-card-number='#{exact_match.number}']", count: 1
+  end
+
+  test "empty queries show no results" do
+    get search_path, params: { q: "  " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_draft_comment(card, body)
+      comment = card.comments.build(creator: users(:kevin), account: accounts("37s"))
+      comment.save!(validate: false)
+      ActionText::RichText.create!(account: accounts("37s"), record: comment, name: "body", body:)
+    end
+
+    def create_card(title, description: nil, created_at: Time.current)
+      boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :published, title:, description:, created_at:
+      )
+    end
+end
