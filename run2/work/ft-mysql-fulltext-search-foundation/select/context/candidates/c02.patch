diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..ffa32da
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,48 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center justify-center gap", role: "search" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @query, placeholder: "Search cards…", class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="margin" aria-label="Search results">
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <article class="search-result panel pad margin-block-half" data-card-number="<%= card.number %>">
+            <h2 class="txt-large margin-block-end-half">
+              <%= link_to highlight(card.title, @query), card_path(card) %>
+            </h2>
+
+            <p class="txt-x-small margin-block-end-half">
+              <%= link_to card.board.name, card.board %>
+            </p>
+
+            <% if description_excerpt = highlighted_search_excerpt(card.description, @query) %>
+              <p class="search-result__match margin-block-end-half"><%= description_excerpt %></p>
+            <% end %>
+
+            <% @matching_comments_by_card.fetch(card.id, []).first(3).each do |comment| %>
+              <% if comment_excerpt = highlighted_search_excerpt(comment.body, @query) %>
+                <p class="search-result__comment margin-block-end-half">
+                  <%= link_to comment_excerpt, card_path(card, anchor: dom_id(comment)) %>
+                </p>
+              <% end %>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards found for <strong><%= @query %></strong></p>
+    <% end %>
+  </section>
+<% end %>
