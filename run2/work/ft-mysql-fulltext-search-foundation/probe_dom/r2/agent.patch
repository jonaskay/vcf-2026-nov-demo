+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,88 @@
+class SearchesController < ApplicationController
+  CARD_CONTENT_MATCH_SQL = <<~SQL.squish
+    (
+      cards.title LIKE :pattern ESCAPE '!'
+      OR EXISTS (
+        SELECT 1
+        FROM action_text_rich_texts descriptions
+        WHERE descriptions.record_type = 'Card'
+          AND descriptions.record_id = cards.id
+          AND descriptions.name = 'description'
+          AND descriptions.body LIKE :pattern ESCAPE '!'
+      )
+      OR EXISTS (
+        SELECT 1
+        FROM comments
+        INNER JOIN action_text_rich_texts comment_bodies
+          ON comment_bodies.record_type = 'Comment'
+          AND comment_bodies.record_id = comments.id
+          AND comment_bodies.name = 'body'
+        WHERE comments.card_id = cards.id
+          AND comment_bodies.body LIKE :pattern ESCAPE '!'
+      )
+    )
+  SQL
+
+  def show
+    @query = params[:q].to_s
+    @words = @query.split.uniq
+
+    set_page_and_extract_portion_from(search_cards)
+    @comment_texts_by_card_id = matching_comment_texts_by_card_id
+  end
+
+  private
+    def search_cards
+      cards = Current.user.accessible_cards.published
+
+      if @words.any?
+        @words.each do |word|
+          cards = cards.where(CARD_CONTENT_MATCH_SQL, pattern: like_pattern(word))
+        end
+
+        cards = cards.reverse_chronologically
+      else
+        cards = cards.none.reverse_chronologically
+      end
+
+      cards.preload(:board, :rich_text_description)
+    end
+
+    def matching_comment_texts_by_card_id
+      if @words.any? && @page.records.any?
+        Current.user.accessible_cards.published
+          .where(id: @page.records.map(&:id))
+          .joins(:comments)
+          .joins(<<~SQL.squish)
+            INNER JOIN action_text_rich_texts search_comment_bodies
+              ON search_comment_bodies.record_type = 'Comment'
+              AND search_comment_bodies.record_id = comments.id
+              AND search_comment_bodies.name = 'body'
+          SQL
+          .where(comment_match_sql, **comment_match_patterns)
+          .order("comments.created_at DESC, comments.id DESC")
+          .pluck("cards.id", "search_comment_bodies.body")
+          .each_with_object({}) do |(card_id, body), comments_by_card_id|
+            (comments_by_card_id[card_id] ||= []) << ActionText::Content.new(body).to_plain_text
+          end
+      else
+        {}
+      end
+    end
+
+    def comment_match_sql
+      @words.each_index.map do |index|
+        "search_comment_bodies.body LIKE :pattern_#{index} ESCAPE '!'"
+      end.join(" OR ").then { |conditions| "(#{conditions})" }
+    end
+
+    def comment_match_patterns
+      @words.each_with_index.to_h do |word, index|
+        [ "pattern_#{index}".to_sym, like_pattern(word) ]
+      end
+    end
+
+    def like_pattern(word)
+      "%#{ActiveRecord::Base.sanitize_sql_like(word, "!")}%"
+    end
+end
