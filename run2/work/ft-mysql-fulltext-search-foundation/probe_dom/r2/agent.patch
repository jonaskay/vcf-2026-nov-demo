+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def search_text_matches?(text, words)
+    words.any? do |word|
+      text.match?(Regexp.new(Regexp.escape(word), Regexp::IGNORECASE))
+    end
+  end
+
+  def highlighted_search_excerpt(text, words, radius: 120)
+    matched_words = words.select do |word|
+      text.match?(Regexp.new(Regexp.escape(word), Regexp::IGNORECASE))
+    end
+
+    excerpts = if matched_words.any?
+      matched_words.map { |word| excerpt(text, word, radius:, omission: "…") }.compact.uniq
+    else
+      [ truncate(text, length: radius * 2) ]
+    end
+
+    highlight(excerpts.join(" … "), words)
+  end
+end
