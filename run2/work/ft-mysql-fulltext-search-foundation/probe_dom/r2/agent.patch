index 0000000..6930837
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,54 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input full-width", placeholder: "Search card titles, descriptions, and comments…", autofocus: true %>
+    <%= form.button type: :submit, class: "btn btn--link" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+</section>
+
+<section class="search-results margin-block-start" aria-label="Search results">
+  <% if @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <div class="flex flex-column gap-half">
+        <% @page.records.each do |card| %>
+          <article class="panel panel--wide shadow center search-result" data-search-result-card-id="<%= card.id %>">
+            <h2 class="txt-large margin-none">
+              <%= link_to highlight(card.title, @words), card_path(card), class: "search-result__title" %>
+            </h2>
+            <p class="txt-small margin-block-half">
+              <%= link_to card.board.name, board_path(card.board) %>
+            </p>
+
+            <% description = card.description.to_plain_text %>
+            <% if description.present? && search_text_matches?(description, @words) %>
+              <p class="search-result__description margin-none-block-end"><%= highlighted_search_excerpt(description, @words) %></p>
+            <% end %>
+
+            <% @comment_texts_by_card_id.fetch(card.id, []).each do |comment_text| %>
+              <% if search_text_matches?(comment_text, @words) %>
+                <p class="search-result__comment txt-small margin-block-half"><%= highlighted_search_excerpt(comment_text, @words) %></p>
+              <% end %>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    <% end %>
+  <% elsif @words.any? %>
+    <p class="blank-slate">No cards match “<%= @query %>”</p>
+  <% else %>
+    <p class="blank-slate">Search card titles, descriptions, and comments</p>
+  <% end %>
+</section>
