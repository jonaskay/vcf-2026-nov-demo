diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e2f99ae
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches by all words across card fields and highlights matches" do
+    card = cards(:shipping)
+    card.update! description: "<p>The launch <strong>pipeline</strong> is ready</p>"
+
+    get search_path, params: { q: "pipeline ship" }
+
+    assert_response :success
+    assert_select "[data-search-result-card-id='#{card.id}']"
+    assert_select ".search-result__title mark", text: "ship"
+    assert_select ".search-result__description mark", text: "pipeline"
+    assert_no_match "<strong>", response.body
+  end
+
+  test "searches by title words in any order" do
+    [ "logo big", "big logo" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "[data-search-result-card-id='#{cards(:logo).id}']"
+    end
+  end
+
+  test "searches comments and displays a highlighted plain text snippet" do
+    get search_path, params: { q: "overflowing container" }
+
+    assert_response :success
+    assert_select "[data-search-result-card-id='#{cards(:layout).id}']"
+    assert_select ".search-result__comment mark", text: "overflowing"
+    assert_select ".search-result__comment mark", text: "container"
+  end
+
+  test "matches query words across separate comments" do
+    get search_path, params: { q: "agree same" }
+
+    assert_response :success
+    assert_select "[data-search-result-card-id='#{cards(:logo).id}']"
+    assert_select ".search-result__comment mark", text: "agree"
+    assert_select ".search-result__comment mark", text: "Same"
+  end
+
+  test "blank queries return no results" do
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select "form[action$='/search'] input[name='q']"
+    assert_select "[data-search-result-card-id]", count: 0
+  end
+
+  test "search results are newest first" do
+    older = create_card(title: "sortmarker older", created_at: 2.days.ago)
+    newer = create_card(title: "sortmarker newer", created_at: 1.day.ago)
+
+    get search_path, params: { q: "sortmarker" }
+
+    assert_response :success
+    assert_equal [ newer.id, older.id ], css_select("[data-search-result-card-id]").map { |result| result["data-search-result-card-id"] }
+  end
+
+  test "revoked board access immediately removes its cards from search" do
+    private_card = create_card(board: boards(:private), title: "secrettoken card")
+
+    get search_path, params: { q: "secrettoken" }
+    assert_response :success
+    assert_select "[data-search-result-card-id='#{private_card.id}']"
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "secrettoken" }
+    assert_response :success
+    assert_select "[data-search-result-card-id]", count: 0
+  end
+
+  test "draft cards and their comments never appear" do
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(title: "draftneedle card", status: :drafted)
+      comment = draft.comments.build(creator: users(:kevin), account: accounts("37s"), body: "draftcommentneedle")
+      comment.rich_text_body.account = accounts("37s")
+      comment.save!(validate: false)
+    end
+
+    get search_path, params: { q: "draftneedle draftcommentneedle" }
+
+    assert_response :success
+    assert_select "[data-search-result-card-id]", count: 0
+    assert_select ".search-result__comment", count: 0
+  end
+
+  test "like wildcards are treated as literal search text" do
+    matching = create_card(title: "100% ready")
+    create_card(title: "100 percent ready")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select "[data-search-result-card-id='#{matching.id}']"
+    assert_equal [ matching.id ], css_select("[data-search-result-card-id]").map { |result| result["data-search-result-card-id"] }
+
+    underscored = create_card(title: "file_name result")
+    create_card(title: "fileXname result")
+
+    get search_path, params: { q: "file_name" }
+
+    assert_response :success
+    assert_equal [ underscored.id ], css_select("[data-search-result-card-id]").map { |result| result["data-search-result-card-id"] }
+  end
+
+  test "highlighted card titles escape html" do
+    card = create_card(title: "<script>alert(1)</script> safequery")
+
+    get search_path, params: { q: "safequery" }
+
+    assert_response :success
+    assert_select "[data-search-result-card-id='#{card.id}'] .search-result__title mark", text: "safequery"
+    assert_no_match "<script>", response.body
+  end
+
+  private
+    def create_card(board: boards(:writebook), title:, created_at: Time.current)
+      with_current_user(:kevin) do
+        board.cards.create!(title:, status: :published, created_at:)
+      end
+    end
+end
