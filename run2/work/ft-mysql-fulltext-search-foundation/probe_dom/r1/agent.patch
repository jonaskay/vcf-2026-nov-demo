+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,87 @@
+class SearchesController < ApplicationController
+  CARD_MATCH_SQL = <<~SQL.squish
+    (
+      cards.title LIKE ? ESCAPE '!'
+      OR EXISTS (
+        SELECT 1
+        FROM action_text_rich_texts AS descriptions
+        WHERE descriptions.record_type = 'Card'
+          AND descriptions.record_id = cards.id
+          AND descriptions.name = 'description'
+          AND descriptions.account_id = cards.account_id
+          AND descriptions.body LIKE ? ESCAPE '!'
+      )
+      OR EXISTS (
+        SELECT 1
+        FROM comments
+        INNER JOIN action_text_rich_texts AS comment_bodies
+          ON comment_bodies.record_type = 'Comment'
+          AND comment_bodies.record_id = comments.id
+          AND comment_bodies.name = 'body'
+          AND comment_bodies.account_id = comments.account_id
+        WHERE comments.card_id = cards.id
+          AND comments.account_id = cards.account_id
+          AND comment_bodies.body LIKE ? ESCAPE '!'
+      )
+    )
+  SQL
+
+  COMMENT_MATCH_SQL = <<~SQL.squish
+    INNER JOIN comments
+      ON comments.card_id = cards.id
+      AND comments.account_id = cards.account_id
+    INNER JOIN action_text_rich_texts AS comment_bodies
+      ON comment_bodies.record_type = 'Comment'
+      AND comment_bodies.record_id = comments.id
+      AND comment_bodies.name = 'body'
+      AND comment_bodies.account_id = comments.account_id
+  SQL
+
+  def show
+    @query = params[:q].to_s
+    @words = @query.split.uniq
+    @page_records = set_page_and_extract_portion_from(search_results)
+    @matching_comments_by_card = matching_comments_for(@page_records)
+  end
+
+  private
+    def search_results
+      cards = Current.user.accessible_cards.published
+
+      if @words.any?
+        @words.each do |word|
+          pattern = search_pattern(word)
+          cards = cards.where(CARD_MATCH_SQL, pattern, pattern, pattern)
+        end
+      else
+        cards = cards.none
+      end
+
+      cards.preload(:board, :rich_text_description).reverse_chronologically
+    end
+
+    def matching_comments_for(cards)
+      if @words.any? && cards.any?
+        comment_conditions = @words.map { "comment_bodies.body LIKE ? ESCAPE '!'" }.join(" OR ")
+        patterns = @words.map { |word| search_pattern(word) }
+
+        matching_comment_ids = Current.user.accessible_cards.published
+          .where(id: cards.map(&:id))
+          .joins(COMMENT_MATCH_SQL)
+          .where("(#{comment_conditions})", *patterns)
+          .distinct
+          .pluck("comments.id")
+
+        Comment.where(account_id: Current.account.id, id: matching_comment_ids)
+          .with_rich_text_body
+          .order(:created_at, :id)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+
+    def search_pattern(word)
+      "%#{ActiveRecord::Base.sanitize_sql_like(word, "!")}%"
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
