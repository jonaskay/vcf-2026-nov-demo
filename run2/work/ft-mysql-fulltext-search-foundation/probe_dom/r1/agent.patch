diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..90674ed
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,49 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search cards</h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @query,
+          class: "input input--transparent full-width",
+          placeholder: "Search titles, descriptions, and comments…",
+          autocorrect: "off",
+          autocomplete: "off" %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @words.empty? %>
+  <p class="blank-slate">Enter one or more words to search cards</p>
+<% elsif @page_records.empty? %>
+  <p class="blank-slate">No cards match this search</p>
+<% else %>
+  <%= with_automatic_pagination :search_results, @page do %>
+    <ol class="search__results" aria-label="Search results">
+      <% @page_records.each do |card| %>
+        <li class="panel margin-block-end pad" data-search-result="<%= card.number %>">
+          <article>
+            <h2 class="txt-normal">
+              <%= link_to highlight(card.title, @words), card_path(card) %>
+            </h2>
+
+            <p class="txt-small">In <%= link_to card.board.name, board_path(card.board) %></p>
+
+            <% if description = highlighted_search_excerpt(card.description, @words) %>
+              <p data-search-result-match="description"><%= description %></p>
+            <% end %>
+
+            <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+              <% if comment_excerpt = highlighted_search_excerpt(comment.body, @words) %>
+                <blockquote data-search-result-match="comment"><%= comment_excerpt %></blockquote>
+              <% end %>
+            <% end %>
+          </article>
+        </li>
+      <% end %>
+    </ol>
+  <% end %>
+<% end %>
