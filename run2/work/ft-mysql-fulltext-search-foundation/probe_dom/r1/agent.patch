+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,12 @@
+module SearchHelper
+  def highlighted_search_excerpt(content, words, length: 240)
+    if content.present?
+      text = format_excerpt(content, length: content.to_plain_text.length)
+      matching_word = words.find { |word| text.match?(Regexp.new(Regexp.escape(word), Regexp::IGNORECASE)) }
+
+      if matching_word
+        highlight(excerpt(text, matching_word, radius: length / 2, omission: "…"), words)
+      end
+    end
+  end
+end
