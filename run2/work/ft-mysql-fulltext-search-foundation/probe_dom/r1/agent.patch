diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b2962cf
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches title words in any order and highlights matches" do
+    [ "logo big", "big logo", "logo logo big" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "[data-search-result='#{cards(:logo).number}'] h2 mark", text: /logo/i
+      assert_select "[data-search-result='#{cards(:logo).number}'] h2 mark", text: /big/i
+    end
+  end
+
+  test "searches descriptions as plain text and highlights the match" do
+    card = cards(:shipping)
+    card.update! description: "<p>Deliver via a <strong>scenic</strong> route.</p>"
+
+    get search_path, params: { q: "scenic route" }
+
+    assert_response :success
+    assert_select "[data-search-result='#{card.number}'] [data-search-result-match='description']" do |snippets|
+      assert_equal [ "scenic", "route" ], snippets.first.css("mark").map(&:text)
+      assert_no_match /<strong>/, snippets.first.inner_html
+    end
+  end
+
+  test "searches comment bodies, including when different words match different fields" do
+    card = cards(:layout)
+
+    get search_path, params: { q: "overflowing" }
+
+    assert_response :success
+    assert_select "[data-search-result='#{card.number}'] [data-search-result-match='comment'] mark", text: "overflowing"
+
+    get search_path, params: { q: "Layout overflowing" }
+
+    assert_response :success
+    assert_select "[data-search-result='#{card.number}'] h2 mark", text: "Layout"
+    assert_select "[data-search-result='#{card.number}'] [data-search-result-match='comment'] mark", text: "overflowing"
+  end
+
+  test "blank queries do not return cards" do
+    get search_path, params: { q: " \n\t " }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "does not search draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :drafted, title: "drafttitleuniquetoken"
+    )
+    comment = draft.comments.build(creator: users(:kevin), account: accounts("37s"), body: "draftcommentuniquetoken")
+    comment.rich_text_body.account = accounts("37s")
+    comment.save!(validate: false)
+
+    [ "drafttitleuniquetoken", "draftcommentuniquetoken" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "[data-search-result]", count: 0
+    end
+  end
+
+  test "treats percent and underscore in queries as literal characters" do
+    board = boards(:writebook)
+    percent_match = create_published_card(board: board, title: "budget at 100%")
+    create_published_card(board: board, title: "budget at 1000")
+    underscore_match = create_published_card(board: board, title: "release_candidate")
+    create_published_card(board: board, title: "releaseXcandidate")
+
+    get search_path, params: { q: "100%" }
+
+    assert_response :success
+    assert_equal [ percent_match.number.to_s ], result_numbers
+
+    get search_path, params: { q: "release_candidate" }
+
+    assert_response :success
+    assert_equal [ underscore_match.number.to_s ], result_numbers
+  end
+
+  test "uses current board access when returning results" do
+    card = create_published_card(board: boards(:private), title: "currentpermissionuniquetoken")
+
+    get search_path, params: { q: "currentpermissionuniquetoken" }
+
+    assert_response :success
+    assert_includes result_numbers, card.number.to_s
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "currentpermissionuniquetoken" }
+
+    assert_response :success
+    assert_select "[data-search-result='#{card.number}']", count: 0
+  end
+
+  test "returns the newest matching cards first" do
+    board = boards(:writebook)
+    older = create_published_card(
+      board: board, title: "uniqueorderword older", created_at: 2.days.ago
+    )
+    newer = create_published_card(
+      board: board, title: "uniqueorderword newer", created_at: 1.day.ago
+    )
+    older.update_column :last_active_at, Time.current
+
+    get search_path, params: { q: "uniqueorderword" }
+
+    assert_response :success
+    assert_equal [ newer.number.to_s, older.number.to_s ], result_numbers
+  end
+
+  test "highlights title matches without rendering unsafe HTML" do
+    card = cards(:shipping)
+    card.update_column :title, "<script>unsafe()</script> visible-title-token"
+
+    get search_path, params: { q: "visible-title-token" }
+
+    assert_response :success
+    assert_select "[data-search-result='#{card.number}'] h2" do |headings|
+      assert_no_match /<script>/, headings.first.inner_html
+      assert_select "mark", text: "visible-title-token"
+    end
+  end
+
+  private
+    def create_published_card(board:, **attributes)
+      with_current_user(:kevin) do
+        board.cards.create!(creator: users(:kevin), status: :published, **attributes)
+      end
+    end
+
+    def result_numbers
+      css_select("[data-search-result]").map { |result| result["data-search-result"] }
+    end
+end
