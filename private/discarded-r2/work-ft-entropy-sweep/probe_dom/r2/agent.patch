diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..f0484ac 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,90 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due scope and sweep honor board overrides, account periods, and the inclusive boundary" do
+    freeze_time
+
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+    entropies("37s_account").update!(auto_postpone_period: 30.days)
+    entropies(:miltons_wish_list_board).destroy
+    entropies(:initech_account).update_column(:auto_postpone_period, 999.days.to_i)
+
+    Card.update_all(last_active_at: Time.current)
+    cards(:logo).update!(last_active_at: 90.days.ago)
+    cards(:layout).update!(last_active_at: 45.days.ago)
+    cards(:text).update!(last_active_at: 90.days.ago + 1.second)
+    cards(:radio).update!(last_active_at: 999.days.ago)
+    cards(:paycheck).update!(last_active_at: 999.days.ago + 1.second)
+    cards(:shipping).update!(last_active_at: 90.days.ago)
+    cards(:unfinished_thoughts).update!(last_active_at: 1_000.days.ago)
+    cards(:buy_domain).update!(last_active_at: 100.days.ago)
+    cards(:buy_domain).create_not_now!(user: users(:david))
+    cards(:buy_domain).update_column(:last_active_at, 100.days.ago)
+
+    due_before_sweep = Card.due_to_be_postponed.pluck(:id).to_set
+    previously_postponed = Card.postponed.pluck(:id).to_set
+
+    assert_equal cards(:logo, :radio).map(&:id).to_set, due_before_sweep
+    assert_not_includes Card.postponing_soon, cards(:logo)
+    assert_not_includes Card.postponing_soon, cards(:radio)
+    assert_includes Card.postponing_soon, cards(:text)
+
+    Card.auto_postpone_all_due
+
+    newly_postponed = Card.postponed.pluck(:id).to_set - previously_postponed
+    assert_equal due_before_sweep, newly_postponed
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert_equal accounts("initech").system_user, cards(:radio).postponed_by
+    assert_not cards(:layout).reload.postponed?
+    assert_not cards(:text).reload.postponed?
+    assert_not cards(:paycheck).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert cards(:buy_domain).reload.postponed?
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "due cursor batches tolerate the activity timestamp moving forward" do
+    freeze_time
+
+    board = boards(:writebook)
+    cards(:logo).update!(last_active_at: 93.days.ago)
+    cards(:layout).update!(last_active_at: 92.days.ago)
+    cards(:text).update!(last_active_at: 91.days.ago)
+    postponed_ids = []
+
+    Card.due_to_be_postponed(board, Time.now).find_each(batch_size: 1, cursor: [ :last_active_at, :id ], order: [ :asc, :asc ]) do |card|
+      postponed_ids << card.id
+      card.auto_postpone(user: board.account.system_user)
+    end
+
+    assert_equal cards(:logo, :layout, :text).map(&:id).to_set, postponed_ids.to_set
+    assert cards(:logo, :layout, :text).all?(&:postponed?)
+  end
+
+  test "due sweep batch queries use the board activity index on SQLite" do
+    if ActiveRecord::Base.connection.adapter_name == "SQLite"
+      board = boards(:writebook)
+      now = Time.now
+      relation = Card.due_to_be_postponed(board, now)
+      cursor = cards(:logo)
+      cursor_time = now - board.auto_postpone_period - 1.second
+      batch_queries = [
+        relation.reorder(last_active_at: :asc, id: :asc).limit(1000),
+        relation
+          .where("cards.last_active_at > ? OR (cards.last_active_at = ? AND cards.id > ?)", cursor_time, cursor_time, cursor.id)
+          .reorder(last_active_at: :asc, id: :asc)
+          .limit(1000)
+      ]
+
+      batch_queries.each do |query|
+        plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{query.to_sql}")
+          .map { |row| row["detail"] }
+          .join("\n")
+
+        assert_includes plan, "SEARCH cards USING INDEX index_cards_on_board_status_last_active_id"
+        assert_no_match(/SCAN cards/, plan)
+      end
+    end
+  end
 end
