+    scope :due_to_be_postponed, ->(board = nil, now = Time.now) do
+      if board
+        relation = active.where(board_id: board.id)
+        period = board.entropy&.auto_postpone_period
+
+        if period
+          relation.where("cards.last_active_at <= #{connection.date_subtract('?', '?')}", now, period)
+        else
+          relation.none
+        end
+      else
+        board_periods = Board.joins(:account)
+          .left_outer_joins(:entropy)
+          .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+          .select("boards.id AS board_id, COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) AS auto_postpone_period")
+
+        active
+          .from("(#{board_periods.to_sql}) AS board_periods CROSS JOIN cards")
+          .where("cards.board_id = board_periods.board_id")
+          .where("cards.last_active_at <= #{connection.date_subtract('?', 'board_periods.auto_postpone_period')}", now)
+      end
     end
 
     scope :postponing_soon, -> do
@@ -25,8 +40,15 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      system_users = {}
+      now = Time.now
+
+      Board.includes(:entropy, account: :entropy).find_each do |board|
+        # Postponing updates last_active_at and removes a card from this due scope.
+        due_to_be_postponed(board, now).find_each(cursor: [ :last_active_at, :id ], order: [ :asc, :asc ]) do |card|
+          system_user = system_users[card.account_id] ||= card.account.system_user
+          card.auto_postpone(user: system_user)
+        end
       end
     end
   end
