diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..ab5938f 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,8 +25,23 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      system_users = {}
+
+      Board.includes(:entropy, account: :entropy).find_each do |board|
+        period = board.entropy&.auto_postpone_period
+
+        if period
+          cutoff = now - period
+
+          active
+            .where(board_id: board.id, last_active_at: ..cutoff)
+            .preload(:account, :board)
+            .find_each(cursor: [ :last_active_at, :id ]) do |card|
+              user = system_users[card.account_id] ||= card.account.system_user
+              card.auto_postpone(user: user)
+            end
+        end
       end
     end
   end
diff --git a/app/models/card/eventable/system_commenter.rb b/app/models/card/eventable/system_commenter.rb
index 5c7defc..20cb845 100644
--- a/app/models/card/eventable/system_commenter.rb
+++ b/app/models/card/eventable/system_commenter.rb
@@ -10,10 +10,18 @@ class Card::Eventable::SystemCommenter
   def comment
     return unless comment_body.present?
 
-    card.comments.create! creator: card.account.system_user, body: comment_body, created_at: event.created_at
+    card.comments.create! creator: comment_creator, body: comment_body, created_at: event.created_at
   end
 
   private
+    def comment_creator
+      if event.action.card_auto_postponed? && event.creator.system? && event.creator.account_id == card.account_id
+        event.creator
+      else
+        card.account.system_user
+      end
+    end
+
     def comment_body
       case event.action
       when "card_assigned"
