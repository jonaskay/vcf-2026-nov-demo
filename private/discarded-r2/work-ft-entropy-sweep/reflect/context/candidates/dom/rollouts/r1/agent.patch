@@ -59,6 +59,78 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone all due respects account and board periods and their inclusive boundaries" do
+    freeze_time
+
+    entropies("37s_account").update_column(:auto_postpone_period, 999.days.to_i)
+    entropies(:writebook_board).update! auto_postpone_period: 365.days
+    entropies(:private_board).destroy
+    entropies(:initech_account).update! auto_postpone_period: 7.days
+    entropies(:miltons_wish_list_board).update! auto_postpone_period: 90.days
+
+    cards(:logo).update_column(:last_active_at, 365.days.ago)
+    cards(:shipping).update_column(:last_active_at, 365.days.ago + 1.second)
+    cards(:text).close(user: users(:david))
+    cards(:text).update_column(:last_active_at, 365.days.ago)
+    cards(:buy_domain).postpone(user: users(:david))
+    cards(:buy_domain).update_column(:last_active_at, 365.days.ago)
+    cards(:radio).update_column(:last_active_at, 90.days.ago)
+    cards(:paycheck).update_column(:last_active_at, 90.days.ago + 1.second)
+    cards(:unfinished_thoughts).update_column(:last_active_at, 90.days.ago)
+
+    account_period_due = boards(:private).cards.create!(
+      title: "Due at the account period",
+      creator: users(:kevin),
+      status: :published
+    )
+    account_period_due.update_column(:last_active_at, 999.days.ago)
+
+    account_period_not_due = boards(:private).cards.create!(
+      title: "Not due at the account period",
+      creator: users(:kevin),
+      status: :published
+    )
+    account_period_not_due.update_column(:last_active_at, 999.days.ago + 1.second)
+
+    active_ids_before_sweep = Card.active.pluck(:id).to_set
+    due_ids_before_sweep = Card.due_to_be_postponed.pluck(:id).to_set
+
+    assert_equal [ cards(:logo).id, cards(:radio).id, account_period_due.id ].to_set, due_ids_before_sweep
+    assert_not_includes due_ids_before_sweep, cards(:shipping).id
+    assert_not_includes Card.postponing_soon, cards(:logo)
+    assert_not_includes due_ids_before_sweep, cards(:paycheck).id
+    assert_not_includes due_ids_before_sweep, cards(:text).id
+    assert_not_includes due_ids_before_sweep, cards(:buy_domain).id
+    assert_not_includes due_ids_before_sweep, cards(:unfinished_thoughts).id
+    assert_not_includes due_ids_before_sweep, account_period_not_due.id
+
+    Card.auto_postpone_all_due
+
+    postponed_ids_from_active_cards = Card.joins(:not_now)
+      .where(id: active_ids_before_sweep)
+      .pluck(:id)
+      .to_set
+    assert_equal due_ids_before_sweep, postponed_ids_from_active_cards
+    assert_equal accounts("37s").system_user, cards(:logo).reload.postponed_by
+    assert_equal accounts("37s").system_user, account_period_due.reload.postponed_by
+    assert_equal accounts("initech").system_user, cards(:radio).reload.postponed_by
+  end
+
+  test "due sweep account batches use the activity index on SQLite" do
+    if ActiveRecord::Base.connection.adapter_name == "SQLite"
+      now = Time.now
+      batch = Card.due_to_be_postponed(now)
+        .where(account_id: accounts("37s").id)
+        .where(last_active_at: ..(now - Entropy.where(account_id: accounts("37s").id).minimum(:auto_postpone_period).seconds))
+        .order(:id)
+        .limit(1000)
+      plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{batch.to_sql}").map { |row| row["detail"] }
+
+      assert plan.any? { |detail| detail.include?("SEARCH cards USING INDEX index_cards_on_account_id_and_last_active_at_and_status") }
+      assert_not plan.any? { |detail| detail.start_with?("SCAN cards") }
+    end
+  end
+
