   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+      minimum_periods_by_account = Entropy.where(container_type: %w[Account Board])
+        .group(:account_id)
+        .minimum(:auto_postpone_period)
+
+      minimum_periods_by_account.each do |account_id, minimum_period|
+        # This broad, indexable cutoff keeps the exact board/account rule in the scope below.
+        system_user = nil
+
+        due_to_be_postponed(now)
+          .where(account_id: account_id)
+          .where(last_active_at: ..(now - minimum_period.seconds))
+          .preload(:account)
+          .find_each do |card|
+            system_user ||= card.account.system_user
+            card.auto_postpone(user: system_user)
+          end
       end
     end
   end
