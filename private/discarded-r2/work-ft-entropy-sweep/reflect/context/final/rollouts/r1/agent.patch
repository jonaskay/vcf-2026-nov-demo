@@ -59,6 +59,55 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "the due sweep agrees with the due scope across board and account periods" do
+    freeze_time
+
+    account_entropy = entropies("37s_account")
+    board_entropy = entropies(:writebook_board)
+    board_entropy.update_column(:auto_postpone_period, 999.days)
+    entropies(:private_board).destroy
+
+    boundary = Time.current
+    cards(:logo).update! last_active_at: boundary - board_entropy.auto_postpone_period
+    cards(:text).update! last_active_at: boundary - account_entropy.auto_postpone_period
+
+    account_due_card = boards(:private).cards.create!(creator: users(:kevin), title: "Account entropy card", status: :published)
+    account_due_card.update! last_active_at: boundary - account_entropy.auto_postpone_period
+
+    short_period_board = accounts(:"37s").boards.create!(creator: users(:david), name: "Short period board", all_access: true)
+    short_period_entropy = short_period_board.create_entropy!(auto_postpone_period: 3.days)
+    short_period_entropy.update_column(:auto_postpone_period, 1.day)
+    short_period_card = short_period_board.cards.create!(creator: users(:david), title: "Short period card", status: :published)
+    short_period_card.update! last_active_at: boundary - short_period_entropy.auto_postpone_period
+
+    due_card_ids = Card.due_to_be_postponed.pluck(:id).sort
+
+    Card.auto_postpone_all_due
+
+    assert_equal due_card_ids, Card.postponed.pluck(:id).sort
+    assert cards(:logo).reload.postponed?, "board period is inclusive at its boundary"
+    assert_not cards(:text).reload.postponed?, "board entropy still overrides a shorter account period"
+    assert account_due_card.reload.postponed?, "cards without board entropy use the account period at its boundary"
+    assert short_period_card.reload.postponed?, "stored periods below the allowed minimum are still covered by the prefilter"
+  end
+
+  test "due sweep uses the account activity index for each batch on SQLite" do
+    if ActiveRecord::Base.connection.adapter_name == "SQLite"
+      account = accounts(:"37s")
+      minimum_period = Entropy.where(account_id: account.id).minimum(:auto_postpone_period)
+      first_batch = Card.due_to_be_postponed(account.id, minimum_period, Time.now).reorder(id: :asc).limit(1000)
+      next_batch = first_batch.where("cards.id > ?", cards(:logo).id)
+      plans = [ first_batch, next_batch ].map do |batch|
+        ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{batch.to_sql}").map { |row| row["detail"] }
+      end
+
+      plans.each do |plan|
+        assert plan.any? { |detail| detail.include?("SEARCH cards USING INDEX index_cards_on_account_id_and_last_active_at_and_status") }, plan.join("\n")
+        assert_not plan.any? { |detail| detail.match?(/\bSCAN cards\b/) }, plan.join("\n")
+      end
+    end
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
