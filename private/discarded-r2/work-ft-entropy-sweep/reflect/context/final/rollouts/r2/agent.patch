--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -2,12 +2,26 @@ module Card::Entropic
   extend ActiveSupport::Concern
 
   included do
-    scope :due_to_be_postponed, -> do
-      active
+    scope :due_to_be_postponed, ->(account = nil, period = nil, now = Time.now) do
+      period_expression = "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"
+      due_cards = active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+        .where("last_active_at <= #{connection.date_subtract('?', period_expression)}", now)
+
+      if account
+        due_cards = due_cards.where(cards: { account_id: account.id })
+      end
+
+      if period
+        # Keep an indexable timestamp range alongside the exact COALESCE predicate, with slack for date precision.
+        due_cards = due_cards
+          .where("#{period_expression} = ?", period)
+          .where("cards.last_active_at <= ?", now - period + 1.second)
+      end
+
+      due_cards
     end
 
     scope :postponing_soon, -> do
@@ -25,8 +39,19 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+      # Read stored values so periods outside the current validation list are still included.
+      entropy_container_types = %w[ Account Board ]
+
+      Account.where(id: Entropy.where(container_type: entropy_container_types).select(:account_id)).find_each do |account|
+        system_user = nil
+
+        Entropy.where(account_id: account.id, container_type: entropy_container_types).distinct.pluck(:auto_postpone_period).each do |period|
+          due_to_be_postponed(account, period, now).find_each(cursor: [ :last_active_at, :id ], order: [ :asc, :asc ]) do |card|
+            system_user ||= account.system_user
+            card.auto_postpone(user: system_user)
+          end
+        end
       end
     end
   end
