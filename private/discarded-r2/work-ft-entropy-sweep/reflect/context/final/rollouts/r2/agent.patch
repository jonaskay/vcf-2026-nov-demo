diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..ea5dee3 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,73 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone sweep batches cards by their effective entropy period" do
+    travel_to Time.now.change(usec: 0) do
+      now = Time.now
+      account_period = 999.days.to_i
+      board_period = 90.days.to_i
+
+      entropies("37s_account").update_column(:auto_postpone_period, account_period)
+      entropies(:writebook_board).update_column(:auto_postpone_period, board_period)
+      entropies(:private_board).destroy
+
+      account_due_card = boards(:private).cards.create!(
+        creator: users(:kevin), title: "Due by account entropy", status: :published
+      )
+      account_due_card.update!(last_active_at: now - account_period)
+
+      account_not_due_card = boards(:private).cards.create!(
+        creator: users(:kevin), title: "Not due by account entropy", status: :published
+      )
+      account_not_due_card.update!(last_active_at: now - account_period + 1.second)
+
+      cards(:text).close(user: users(:kevin))
+      cards(:text).update!(last_active_at: now - board_period)
+      cards(:buy_domain).postpone(user: users(:david))
+      cards(:buy_domain).update!(last_active_at: now - board_period)
+      cards(:unfinished_thoughts).update!(last_active_at: now - board_period)
+
+      cards(:logo).update!(last_active_at: now - board_period)
+      cards(:shipping).update!(last_active_at: now - board_period + 1.second)
+      cards(:radio).update!(last_active_at: now - board_period)
+      cards(:paycheck).update!(last_active_at: now - board_period + 1.second)
+
+      expected_due_ids = Card.due_to_be_postponed.pluck(:id).to_set
+      assert_equal [ account_due_card, cards(:logo), cards(:radio) ].map(&:id).to_set, expected_due_ids
+      assert_empty Card.postponing_soon.where(id: expected_due_ids)
+      assert_includes Card.postponing_soon, account_not_due_card
+
+      if ActiveRecord::Base.connection.adapter_name == "SQLite"
+        entropy_container_types = %w[ Account Board ]
+        accounts = Account.where(id: Entropy.where(container_type: entropy_container_types).select(:account_id))
+
+        accounts.find_each do |account|
+          periods = Entropy.where(account_id: account.id, container_type: entropy_container_types).distinct.pluck(:auto_postpone_period)
+
+          periods.each do |period|
+            batch = Card.due_to_be_postponed(account, period, now).reorder(last_active_at: :asc, id: :asc).limit(1000)
+            cursor_time = now - period
+            cursor = batch.where("cards.last_active_at > ? OR (cards.last_active_at = ? AND cards.id > ?)", cursor_time, cursor_time, cards(:logo).id)
+
+            [ batch, cursor ].each do |relation|
+              plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{relation.to_sql}").map { |row| row["detail"] }.join("\n")
+
+              assert_includes plan, "SEARCH cards USING INDEX index_cards_on_account_id_and_last_active_at_and_status"
+              assert_no_match(/\bSCAN cards\b/, plan)
+            end
+          end
+        end
+      end
+
+      postponed_before = Card.postponed.pluck(:id).to_set
+      Card.auto_postpone_all_due
+      newly_postponed_ids = Card.postponed.where.not(id: postponed_before.to_a).pluck(:id).to_set
+
+      assert_equal expected_due_ids, newly_postponed_ids
+      assert_equal accounts("37s").system_user, account_due_card.reload.postponed_by
+      assert_equal accounts("37s").system_user, cards(:logo).reload.postponed_by
+      assert_equal accounts(:initech).system_user, cards(:radio).reload.postponed_by
+    end
+  end
 end
