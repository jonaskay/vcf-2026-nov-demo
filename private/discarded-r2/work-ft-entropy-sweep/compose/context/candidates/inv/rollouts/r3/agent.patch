     end
 
     scope :postponing_soon, -> do
@@ -25,8 +25,19 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+      earliest_possible_due_at = now - Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.min
+
+      Account.find_each do |account|
+        system_user = nil
+
+        due_to_be_postponed(now)
+          .where(account_id: account.id, last_active_at: ..earliest_possible_due_at)
+          # Keep keyset batches aligned with the account/time index.
+          .find_each(cursor: [ :last_active_at, :id ]) do |card|
+            system_user ||= account.system_user
+            card.auto_postpone(user: system_user)
+          end
       end
     end
   end
