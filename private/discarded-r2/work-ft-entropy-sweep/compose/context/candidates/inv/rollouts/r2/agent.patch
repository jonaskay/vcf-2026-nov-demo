diff --git a/test/jobs/card/auto_postpone_all_due_job_test.rb b/test/jobs/card/auto_postpone_all_due_job_test.rb
new file mode 100644
index 0000000..efec2a1
--- /dev/null
+++ b/test/jobs/card/auto_postpone_all_due_job_test.rb
@@ -0,0 +1,18 @@
+require "test_helper"
+
+class Card::AutoPostponeAllDueJobTest < ActiveJob::TestCase
+  test "runs the due-card sweep" do
+    Card.expects(:auto_postpone_all_due)
+
+    Card::AutoPostponeAllDueJob.perform_now
+  end
+
+  test "discards overlapping sweeps" do
+    job = Card::AutoPostponeAllDueJob.new
+
+    assert job.concurrency_limited?
+    assert_equal 1, job.concurrency_limit
+    assert_equal :discard, job.concurrency_on_conflict
+    assert_equal 1.day, job.concurrency_duration
+  end
+end
