diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..4475894
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,49 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide margin-block-start-half center">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width", autofocus: @query.blank?, autocorrect: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <% if @page.records.any? %>
+    <section class="search-results margin-block-start">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <article class="panel panel--wide search-result margin-block-half txt-align-start">
+            <h2 class="font-weight-bold margin-none">
+              <%= link_to highlight(card.title, @query), card_path(card) %>
+            </h2>
+
+            <p class="txt-small margin-block-half">
+              <%= link_to card.board.name, card.board %>
+              <span aria-hidden="true"> · </span>
+              Card #<%= card.number %>
+            </p>
+
+            <% if card.description.present? %>
+              <p><%= highlighted_search_excerpt(card.description, @query) %></p>
+            <% end %>
+
+            <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+              <blockquote class="margin-block-half">
+                <%= highlighted_search_excerpt(comment.body, @query) %>
+              </blockquote>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    </section>
+  <% else %>
+    <p class="blank-slate margin-block">No cards matched “<%= @query %>”</p>
+  <% end %>
+<% else %>
+  <p class="blank-slate margin-block">Search card titles, descriptions, and comments</p>
+<% end %>
