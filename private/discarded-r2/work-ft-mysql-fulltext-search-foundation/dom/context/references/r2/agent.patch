@@ -0,0 +1,8 @@
+module SearchesHelper
+  def highlighted_search_excerpt(content, query)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    snippet = excerpt(text, query, radius: 100) || text.truncate(200)
+
+    highlight(snippet, query)
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..6989997 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,37 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :matching_search_term, ->(term) do
+    pattern = "%#{sanitize_sql_like(term, "!")}%"
+
+    where(<<~SQL, pattern, pattern, pattern)
+      (
+        cards.title LIKE ? ESCAPE '!'
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts AS descriptions
+          WHERE descriptions.record_type = 'Card'
+            AND descriptions.record_id = cards.id
+            AND descriptions.name = 'description'
+            AND descriptions.account_id = cards.account_id
+            AND descriptions.body LIKE ? ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+            AND comment_bodies.account_id = comments.account_id
+          WHERE comments.card_id = cards.id
+            AND comments.account_id = cards.account_id
+            AND comment_bodies.body LIKE ? ESCAPE '!'
+        )
+      )
+    SQL
+  end
+
   def card
     self
   end
