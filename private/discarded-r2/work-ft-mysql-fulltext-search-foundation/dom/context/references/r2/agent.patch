diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d06491f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds published cards by title, description, and comment body, newest first, highlighting matches" do
+    older_title_match = create_card(title: "Needle in the title", created_at: 2.days.ago)
+    description_match = create_card(title: "Description result", description: "A needle in the description", created_at: 1.day.ago)
+    newest_comment_match = create_card(title: "Comment result", created_at: 1.hour.ago)
+    with_current_user(:kevin) do
+      newest_comment_match.comments.create!(creator: users(:kevin), body: "A needle in the comment")
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "mark", text: "Needle"
+    assert_select "mark", text: "needle", minimum: 2
+
+    result_positions = [ older_title_match, description_match, newest_comment_match ].map do |card|
+      response.body.index(card_path(card))
+    end
+    assert_equal result_positions.sort, result_positions.reverse
+  end
+
+  test "does not find drafts or cards on boards the user cannot access" do
+    draft = create_card(title: "Hidden draft marker", status: :drafted)
+    comment_id = ActiveRecord::Type::Uuid.generate
+    ActionText::RichText.insert!({
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: accounts("37s").id,
+      name: "body",
+      record_type: "Comment",
+      record_id: comment_id,
+      body: "Hidden draft comment marker",
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+    Comment.insert!({
+      id: comment_id,
+      account_id: accounts("37s").id,
+      card_id: draft.id,
+      creator_id: users(:kevin).id,
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+
+    inaccessible = with_current_user(:kevin) do
+      boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Private board marker")
+    end
+
+    logout_and_sign_in_as :jz
+
+    [ "Hidden draft", "Hidden draft comment", "Private board" ].each do |term|
+      get search_path, params: { q: term }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+
+    assert inaccessible.persisted?
+  end
+
+  test "stops returning cards as soon as board access is revoked" do
+    card = create_card(title: "Revoked access marker")
+    board = boards(:writebook)
+    board.update!(all_access: false)
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "Revoked access" }
+
+    assert_response :success
+    assert_no_match card.title, response.body
+  end
+
+  test "treats SQL wildcard characters in the query literally" do
+    percent_match = create_card(title: "Literal 100% coverage")
+    non_match = create_card(title: "Literal 1000 coverage")
+
+    get search_path, params: { q: "100%" }
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(percent_match)
+    assert_select "a[href=?]", card_path(non_match), count: 0
+    assert_select "mark", text: "100%"
+  end
+
+  test "an empty query does not return every accessible card" do
+    create_card(title: "A card that should not appear")
+
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select "input[name=q][value='']"
+  end
+
+  private
+    def create_card(title:, description: nil, status: :published, created_at: Time.current)
+      with_current_user(:kevin) do
+        boards(:writebook).cards.create!(
+          creator: users(:kevin),
+          status: status,
+          title: title,
+          description: description,
+          created_at: created_at
+        )
+      end
+    end
+end
