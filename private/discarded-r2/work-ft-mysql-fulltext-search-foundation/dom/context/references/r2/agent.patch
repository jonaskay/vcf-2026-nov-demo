@@ -0,0 +1,39 @@
+class SearchesController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from searchable_cards
+    @matching_comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def searchable_cards
+      if @query.present?
+        Current.account.cards
+          .where(id: Current.user.accessible_cards.select(:id))
+          .published
+          .matching_search_term(@query)
+          .reverse_chronologically
+          .preload(:board, :rich_text_description)
+      else
+        Current.account.cards.none
+      end
+    end
+
+    def matching_comments_by_card
+      if @query.present? && @page.records.any?
+        Comment
+          .joins(:rich_text_body)
+          .where(card_id: @page.records.map(&:id), account_id: Current.account.id)
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", search_pattern)
+          .chronologically
+          .preload(:rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+
+    def search_pattern
+      "%#{Card.sanitize_sql_like(@query, "!")}%"
+    end
+end
