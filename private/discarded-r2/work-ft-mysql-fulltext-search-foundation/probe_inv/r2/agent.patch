+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,52 @@
+class SearchesController < ApplicationController
+  SEARCH_CONDITIONS = <<~SQL.squish
+    cards.title LIKE :query ESCAPE '!'
+    OR EXISTS (
+      SELECT 1 FROM action_text_rich_texts descriptions
+      WHERE descriptions.record_type = 'Card'
+        AND descriptions.record_id = cards.id
+        AND descriptions.name = 'description'
+        AND descriptions.body LIKE :query ESCAPE '!'
+    )
+    OR EXISTS (
+      SELECT 1
+      FROM comments
+      INNER JOIN action_text_rich_texts comment_bodies
+        ON comment_bodies.record_type = 'Comment'
+        AND comment_bodies.record_id = comments.id
+        AND comment_bodies.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND comment_bodies.body LIKE :query ESCAPE '!'
+    )
+  SQL
+
+  def show
+    @query = params[:q].to_s.strip
+
+    if @query.present?
+      set_page_and_extract_portion_from search_results
+      @matching_comments_by_card = matching_comments_by_card
+    end
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards.published
+        .where(SEARCH_CONDITIONS, query: search_pattern)
+        .reverse_chronologically
+        .preloaded
+    end
+
+    def matching_comments_by_card
+      Current.user.accessible_comments
+        .joins(:rich_text_body)
+        .where(card_id: @page.records.map(&:id))
+        .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", search_pattern)
+        .preload(:rich_text_body)
+        .group_by(&:card_id)
+    end
+
+    def search_pattern
+      "%#{Card.sanitize_sql_like(@query, '!')}%"
+    end
+end
