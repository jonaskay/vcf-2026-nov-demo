+<article class="search-result panel margin-block-half">
+  <p class="txt-small txt-tinted margin-none"><%= link_to card.board.name, board_path(card.board) %></p>
+  <h3 class="margin-block-half"><%= link_to highlight(card.title, query), card_path(card) %></h3>
+
+  <% if excerpt = highlighted_search_excerpt(card.description, query) %>
+    <p class="search-result-description margin-none"><%= excerpt %></p>
+  <% end %>
+
+  <% comments_by_card[card.id].to_a.each do |comment| %>
+    <% if excerpt = highlighted_search_excerpt(comment.body, query) %>
+      <blockquote class="search-result-comment margin-block-half margin-inline-start">
+        <%= excerpt %>
+      </blockquote>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..ec74eff
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel center-block margin-block">
+  <%= form_with url: search_path, method: :get, class: "flex flex-column gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "font-weight-bold" %>
+    <div class="flex gap">
+      <%= form.search_field :q, value: @query, class: "input full-width", autofocus: @query.blank?, autocorrect: "off", autocomplete: "off" %>
+      <%= form.submit "Search", class: "btn" %>
+    </div>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="search-results margin-block" aria-labelledby="search-results-title">
+    <h2 id="search-results-title" class="txt-medium">Results for “<%= @query %>”</h2>
+
+    <% if @page.records.empty? %>
+      <div class="blank-slate">No cards match this search</div>
+    <% else %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "result", collection: @page.records, as: :card, locals: { query: @query, comments_by_card: @matching_comments_by_card } %>
+      <% end %>
+    <% end %>
+  </section>
+<% end %>
