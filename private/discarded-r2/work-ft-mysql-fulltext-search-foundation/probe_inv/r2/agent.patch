diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..183b09c
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions, and comment bodies with highlighted matches" do
+    term = "silverneedle"
+    board = boards(:writebook)
+
+    title_card = create_card(board, title: "A #{term} title")
+    create_card(board, title: "Description match", description: "A description with #{term} inside")
+    comment_card = create_card(board, title: "Comment match")
+    create_comment(comment_card, "A comment mentioning #{term}")
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_select ".search-result", count: 3
+    assert_select ".search-result mark", text: term, count: 3
+    assert_select ".search-result a[href=?]", card_path(title_card)
+    assert_select ".search-result-description mark", text: term
+    assert_select ".search-result-comment mark", text: term
+  end
+
+  test "returns search results newest first" do
+    term = "newestneedle"
+    board = boards(:writebook)
+    older_card = create_card(board, title: "Older #{term}", created_at: 2.days.ago)
+    newer_card = create_card(board, title: "Newer #{term}", created_at: 1.day.ago)
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_select ".search-result h3" do |titles|
+      assert_equal [ newer_card.title, older_card.title ], titles.map(&:text)
+    end
+  end
+
+  test "only searches boards the current user can still access" do
+    term = "accessneedle"
+    board = boards(:writebook)
+    create_card(board, title: term)
+
+    logout_and_sign_in_as :jz
+    get search_path, params: { q: term }
+    assert_response :success
+    assert_select ".search-result", count: 1
+
+    board.update! all_access: false
+    board.accesses.revoke_from users(:jz)
+
+    get search_path, params: { q: term }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return draft cards or comments on draft cards" do
+    term = "draftneedle"
+    title_draft = create_card(boards(:writebook), title: "Draft #{term} card")
+    comment_draft = create_card(boards(:writebook), title: "Draft comment card")
+    create_comment(comment_draft, "#{term} is in this comment")
+    [ title_draft, comment_draft ].each { |card| card.update_column :status, "drafted" }
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not interpret LIKE wildcards as search terms" do
+    board = boards(:writebook)
+    create_card(board, title: "A 100% finished card")
+    create_card(board, title: "A card that should not match")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "%", count: 1
+  end
+
+  test "shows a search form without results when no query is given" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?] input[name=q]", search_path
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_card(board, **attributes)
+      with_current_user :kevin do
+        board.cards.create!({ creator: users(:kevin), status: :published }.merge(attributes))
+      end
+    end
+
+    def create_comment(card, body)
+      with_current_user :kevin do
+        card.comments.create!(creator: users(:kevin), body: body)
+      end
+    end
+end
