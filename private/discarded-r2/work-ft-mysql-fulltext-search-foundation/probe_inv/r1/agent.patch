diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..22d23ce
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,51 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…", autofocus: @query.blank? %>
+    <%= form.button class: "btn" do %>
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    <% end %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="panel panel--wide shadow center margin-block-start">
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <ul class="flex flex-column gap margin-none-block-start unpad">
+          <% @page.records.each do |card| %>
+            <li class="search-result border-bottom pad-block-half">
+              <article>
+                <%= link_to card_path(card), class: "search-result__title font-weight-medium" do %>
+                  <%= highlight(card.title, @query) %>
+                <% end %>
+                <p class="txt-x-small txt-subtle margin-none-block-start"><%= card.board.name %></p>
+
+                <% description = card.description.to_plain_text %>
+                <% if description_excerpt = excerpt(description, @query, radius: 100) %>
+                  <p class="search-result__match txt-small"><%= highlight(description_excerpt, @query) %></p>
+                <% end %>
+
+                <% @matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+                  <% comment_excerpt = excerpt(comment.body.to_plain_text, @query, radius: 100) %>
+                  <% if comment_excerpt %>
+                    <p class="search-result__match txt-small"><%= highlight(comment_excerpt, @query) %></p>
+                  <% end %>
+                <% end %>
+              </article>
+            </li>
+          <% end %>
+        </ul>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”</p>
+    <% end %>
+  </section>
+<% end %>
