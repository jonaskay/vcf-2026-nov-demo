+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = if @query.present?
+      Current.user.accessible_cards.published
+        .matching_search_term(@query)
+        .reverse_chronologically
+        .with_rich_text_description
+        .preload(:board)
+    else
+      Card.none
+    end
+
+    set_page_and_extract_portion_from cards
+    @matching_comments_by_card_id = matching_comments_by_card_id
+  end
+
+  private
+    def matching_comments_by_card_id
+      if @query.present? && @page.records.any?
+        Comment
+          .where(card_id: @page.records.map(&:id))
+          .joins(:rich_text_body)
+          .where("action_text_rich_texts.body LIKE :pattern ESCAPE '!'", pattern: search_pattern)
+          .preload(:rich_text_body)
+          .order(created_at: :desc, id: :desc)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+
+    def search_pattern
+      "%#{ActiveRecord::Base.sanitize_sql_like(@query, "!")}%"
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..ab5a9d6 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -22,6 +22,31 @@ class Card < ApplicationRecord
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
+  scope :matching_search_term, ->(term) do
+    pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+
+    where(<<~SQL.squish, pattern:)
+      cards.title LIKE :pattern ESCAPE '!'
+      OR EXISTS (
+        SELECT 1 FROM action_text_rich_texts AS card_descriptions
+        WHERE card_descriptions.record_type = 'Card'
+          AND card_descriptions.record_id = cards.id
+          AND card_descriptions.name = 'description'
+          AND card_descriptions.body LIKE :pattern ESCAPE '!'
+      )
+      OR EXISTS (
+        SELECT 1
+        FROM comments
+        INNER JOIN action_text_rich_texts AS comment_bodies
+          ON comment_bodies.record_type = 'Comment'
+          AND comment_bodies.record_id = comments.id
+          AND comment_bodies.name = 'body'
+        WHERE comments.card_id = cards.id
+          AND comment_bodies.body LIKE :pattern ESCAPE '!'
+      )
+    SQL
+  end
+
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
   scope :preloaded,               -> { with_users.preload(:column, :tags, :steps, :closure, :goldness, :activity_spike, :image_attachment, reactions: :reacter, board: [ :entropy, :columns ], not_now: [ :user ]).with_rich_text_description_and_embeds }
 
