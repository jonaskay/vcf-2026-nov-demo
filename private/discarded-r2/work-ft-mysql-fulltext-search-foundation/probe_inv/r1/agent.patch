diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..66fcca5
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "search finds titles, descriptions, and comments and highlights matches" do
+    title_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "The silver banana"
+    )
+    description_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Description match",
+      description: "A silver banana appears in this description."
+    )
+    comment_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Comment match"
+    )
+    comment_card.comments.create!(creator: users(:kevin), body: "A silver banana appears in this comment.")
+
+    get search_path, params: { q: "SILVER BANANA" }
+
+    assert_response :success
+    [ title_card, description_card, comment_card ].each do |card|
+      assert_select "a.search-result__title[href='#{card_path(card)}']"
+    end
+    assert_select "mark", text: "silver banana", minimum: 3
+    assert_select ".search-result__match mark", text: "silver banana", count: 2
+  end
+
+  test "results are ordered newest first" do
+    older_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Newest test result",
+      created_at: 2.days.ago
+    )
+    newer_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Newest test result",
+      created_at: 1.day.ago
+    )
+
+    get search_path, params: { q: "Newest test result" }
+
+    assert_response :success
+    assert_operator response.body.index(card_path(newer_card)), :<, response.body.index(card_path(older_card))
+  end
+
+  test "only cards on boards the user currently has access to are returned" do
+    board = boards(:private)
+    board.accesses.grant_to users(:jz)
+    card = board.cards.create!(creator: users(:kevin), status: :published, title: "Private card")
+    card.comments.create!(creator: users(:kevin), body: "Restricted search result")
+
+    logout_and_sign_in_as :jz
+    get search_path, params: { q: "Restricted search result" }
+    assert_response :success
+    assert_select "a.search-result__title[href='#{card_path(card)}']"
+
+    board.accesses.revoke_from users(:jz)
+    get search_path, params: { q: "Restricted search result" }
+    assert_response :success
+    assert_select "a.search-result__title[href='#{card_path(card)}']", count: 0
+  end
+
+  test "draft cards and their comments are not returned" do
+    card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Drafted saffron needle"
+    )
+    card.comments.create!(creator: users(:kevin), body: "Drafted saffron needle in comment")
+    card.update!(status: :drafted)
+
+    get search_path, params: { q: "saffron needle" }
+
+    assert_response :success
+    assert_select "a.search-result__title[href='#{card_path(card)}']", count: 0
+    assert_no_match "Drafted saffron needle in comment", response.body
+  end
+
+  test "blank search does not list cards" do
+    get search_path, params: { q: " " }
+
+    assert_response :success
+    assert_select ".search-result__title", count: 0
+  end
+
+  test "search treats wildcard characters as literal text" do
+    matching_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Literal %_needle"
+    )
+    other_card = boards(:writebook).cards.create!(
+      creator: users(:kevin), status: :published, title: "Literal any-needle"
+    )
+
+    get search_path, params: { q: "%_needle" }
+
+    assert_response :success
+    assert_select "a.search-result__title[href='#{card_path(matching_card)}']"
+    assert_select "a.search-result__title[href='#{card_path(other_card)}']", count: 0
+    assert_select "mark", text: "%_needle"
+  end
+end
