+    writer.close
+    tempfile.rewind
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.new(Current.account)
+      .import(from: ZipFile::Reader.new(tempfile))
+
+    assert_equal "Imported searchable text", ActionText::RichText.find(rich_text_id).body_plain_text
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
   test "check rejects ActionText record referencing existing card in another account" do
     importing_account = Account.create!(name: "Importing Account", external_account_id: 99999999)
 
