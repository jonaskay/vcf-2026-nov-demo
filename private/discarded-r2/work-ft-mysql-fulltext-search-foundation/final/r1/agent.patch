diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..22620b9
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,45 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search cards</h1>
+<% end %>
+
+<section class="pad-inline pad-block" style="margin-inline: auto; max-inline-size: var(--main-width); text-align: start;">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap margin-block-end" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input", required: true, autofocus: true, autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page, tag_element: :ol, role: "list" do %>
+        <% @page.records.each do |card| %>
+          <li class="pad-block border-bottom">
+            <h2 class="txt-medium margin-block-end-half">
+              <%= link_to highlight_search_text(card.title, @query), card_path(card) %>
+            </h2>
+
+            <p class="txt-small margin-block-end-half">
+              <%= link_to card.board.name, board_path(card.board) %>
+            </p>
+
+            <% if excerpt = highlighted_search_excerpt(card.description, @query) %>
+              <p class="txt-small"><%= excerpt %></p>
+            <% end %>
+
+            <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+              <% if excerpt = highlighted_search_excerpt(comment.body, @query) %>
+                <p class="txt-small margin-block-start-half">
+                  <span class="for-screen-reader">Comment: </span><%= excerpt %>
+                </p>
+              <% end %>
+            <% end %>
+          </li>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”.</p>
+    <% end %>
+  <% end %>
+</section>
