diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e2df3a4
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,173 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches comments and highlights the matching text" do
+    get search_path, params: { q: "overflowing" }
+
+    assert_response :success
+    assert_select "a[href='#{card_path(cards(:layout))}']", text: "Layout is broken"
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "searches titles and descriptions newest first" do
+    older, newer = cards(:logo), cards(:layout)
+    older.update_columns(title: "search-order-needle", created_at: 2.days.ago)
+    newer.update_columns(title: "search-order-needle", created_at: 1.day.ago)
+    described = cards(:text)
+    described.update!(description: "<p>A <strong>search-description-needle</strong> in the body.</p>")
+
+    get search_path, params: { q: "search-order-needle" }
+
+    assert_response :success
+    assert_equal [ card_path(newer), card_path(older) ], search_result_links
+
+    same_created_at = 1.hour.ago
+    older.update_column(:created_at, same_created_at)
+    newer.update_column(:created_at, same_created_at)
+    get search_path, params: { q: "search-order-needle" }
+    expected = Card.where(id: [ older.id, newer.id ]).order(id: :desc).map { |card| card_path(card) }
+    assert_equal expected, search_result_links
+
+    get search_path, params: { q: "search-description-needle" }
+
+    assert_response :success
+    assert_select "a[href='#{card_path(described)}']", text: "The text is too small"
+    assert_select "mark", text: "search-description-needle"
+  end
+
+  test "searches plain text rather than Action Text markup or attributes" do
+    comment = cards(:layout).comments.joins(:rich_text_body).first
+    comment.update!(body: "<p><strong>visible-body-needle</strong> <a href=\"/attribute-only-needle\">link</a></p>")
+
+    assert_equal "visible-body-needle link", comment.reload.body.to_plain_text
+
+    get search_path, params: { q: "visible-body-needle" }
+    assert_response :success
+    assert_select "a[href='#{card_path(cards(:layout))}']", text: "Layout is broken"
+    assert_select "mark", text: "visible-body-needle"
+
+    get search_path, params: { q: "strong" }
+    assert_response :success
+    assert_select "ol#search_results-pagination-list", count: 0
+
+    get search_path, params: { q: "attribute-only-needle" }
+    assert_response :success
+    assert_select "ol#search_results-pagination-list", count: 0
+
+    comment.update!(body: "<p>Tom &amp; Jerry and &lt;visible-marker&gt;</p>")
+    assert_equal "Tom & Jerry and <visible-marker>", comment.reload.rich_text_body.body_plain_text
+    get search_path, params: { q: "Tom & Jerry" }
+    assert_response :success
+    assert_select "mark", text: "Tom & Jerry"
+    get search_path, params: { q: "<visible-marker>" }
+    assert_response :success
+    assert_select "mark", text: "<visible-marker>"
+  end
+
+  test "returns each card once when several fields or comments match" do
+    card = cards(:layout)
+    card.update!(description: "<p>needle repeated in the description</p>")
+    with_current_user(:kevin) do
+      card.comments.create!(creator: users(:kevin), body: "<p>needle in another comment</p>")
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "ol#search_results-pagination-list li", 1
+    assert_select "a[href='#{card_path(card)}']", text: "Layout is broken"
+  end
+
+  test "search results only include boards the user can currently access" do
+    card = nil
+    with_current_user(:kevin) do
+      card = boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "private-search-needle")
+    end
+
+    get search_path, params: { q: "private-search-needle" }
+    assert_response :success
+    assert_select "a[href='#{card_path(card)}']", text: "private-search-needle"
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "private-search-needle" }
+    assert_response :success
+    assert_select "a[href='#{card_path(card)}']", count: 0
+  end
+
+  test "does not search cards from another account" do
+    cards(:radio).update_column(:title, "cross-account-search-needle")
+
+    get search_path, params: { q: "cross-account-search-needle" }
+
+    assert_response :success
+    assert_select "ol#search_results-pagination-list", count: 0
+  end
+
+  test "draft cards and comments on drafts are never searchable" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), title: "draft-card-search-needle")
+    draft_comment = draft.comments.new(creator: users(:kevin), account: accounts("37s"))
+    draft_comment.body = "<p>draft-comment-search-needle</p>"
+    draft_comment.rich_text_body.account = accounts("37s")
+    draft_comment.save!(validate: false)
+
+    get search_path, params: { q: "draft-card-search-needle" }
+    assert_response :success
+    assert_select "ol#search_results-pagination-list", count: 0
+
+    get search_path, params: { q: "draft-comment-search-needle" }
+    assert_response :success
+    assert_select "ol#search_results-pagination-list", count: 0
+  end
+
+  test "treats percent and underscore in the query as literal characters" do
+    cards(:logo).update_column(:title, "literal%search-needle")
+    cards(:layout).update_column(:title, "literalXsearch-needle")
+    cards(:text).update_column(:title, "literal_search_needle")
+    cards(:shipping).update_column(:title, "literalXsearchYneedle")
+
+    get search_path, params: { q: "literal%search-needle" }
+
+    assert_response :success
+    assert_equal [ card_path(cards(:logo)) ], search_result_links
+
+    get search_path, params: { q: "literal_search_needle" }
+
+    assert_response :success
+    assert_equal [ card_path(cards(:text)) ], search_result_links
+  end
+
+  test "search input and matched text remain escaped" do
+    card = cards(:logo)
+    card.update_column(:title, "safe <script>search-xss-needle</script>")
+
+    get search_path, params: { q: "search-xss-needle" }
+
+    assert_response :success
+    assert_select "mark", text: "search-xss-needle"
+    assert_no_match "<script>", response.body
+    assert_match "&lt;script&gt;", response.body
+
+    get search_path, params: { q: "<img src=x onerror=alert(1)>" }
+
+    assert_response :success
+    assert_no_match "<img src=x", response.body
+  end
+
+  test "empty search does not list cards" do
+    get search_path
+
+    assert_response :success
+    assert_select "ol#search_results-pagination-list", count: 0
+    assert_select "input[name='q']"
+  end
+
+  private
+    def search_result_links
+      css_select("ol#search_results-pagination-list h2 a").map { |link| link["href"] }
+    end
+end
