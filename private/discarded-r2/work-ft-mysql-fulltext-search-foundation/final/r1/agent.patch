--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,15 @@
+module SearchesHelper
+  def highlight_search_text(text, query)
+    escaped_text = ERB::Util.html_escape(text)
+    escaped_query = ERB::Util.html_escape(query)
+
+    highlight(escaped_text, escaped_query, sanitize: false)
+  end
+
+  def highlighted_search_excerpt(content, query)
+    text = content&.to_plain_text
+    snippet = excerpt(text, query, radius: 100)
+
+    highlight_search_text(snippet, query) if snippet
+  end
+end
