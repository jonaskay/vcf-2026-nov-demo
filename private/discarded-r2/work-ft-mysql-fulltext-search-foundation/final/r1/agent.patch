+    now = Time.current.iso8601
+    data = {
+      id: rich_text_id,
+      record_id: record_id,
+      record_type: "Card",
+      name: "description",
+      body: "<p>Imported <strong>searchable text</strong></p>",
+      created_at: now,
+      updated_at: now
+    }
+
+    tempfile = Tempfile.new([ "rich_text_import", ".zip" ])
