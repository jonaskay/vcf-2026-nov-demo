diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
new file mode 100644
index 0000000..eda670f
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,29 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = searchable_cards
+    set_page_and_extract_portion_from @cards
+    @comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def searchable_cards
+      cards = Current.user.accessible_cards.where(account_id: Current.account.id).published
+      cards = @query.present? ? cards.search(@query) : cards.none
+      cards.reverse_chronologically.preload(:board, :rich_text_description)
+    end
+
+    def matching_comments_by_card
+      card_ids = @page.records.map(&:id)
+      if @query.present? && card_ids.any?
+        Current.user.accessible_comments
+          .where(account_id: Current.account.id, card_id: card_ids)
+          .searching_body(@query)
+          .preload(:rich_text_body)
+          .order(:created_at, :id)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
