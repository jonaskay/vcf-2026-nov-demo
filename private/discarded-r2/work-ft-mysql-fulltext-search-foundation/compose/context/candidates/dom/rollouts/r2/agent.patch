diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..86389d2
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,23 @@
+<article class="panel panel--wide shadow search-result">
+  <h3 class="margin-none">
+    <%= link_to highlight(card.title, @query), card_path(card), class: "search-result__title" %>
+  </h3>
+
+  <p class="txt-small txt-subtle margin-none">
+    <%= link_to card.board.name, board_path(card.board) %>
+  </p>
+
+  <% if description_excerpt = search_excerpt(card.description, @query) %>
+    <p class="search-result__excerpt margin-none">
+      <strong>Description:</strong> <%= highlight(description_excerpt, @query) %>
+    </p>
+  <% end %>
+
+  <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+    <% if comment_excerpt = search_excerpt(comment.body, @query) %>
+      <p class="search-result__excerpt margin-none">
+        <strong>Comment:</strong> <%= highlight(comment_excerpt, @query) %>
+      </p>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..929c587
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,30 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide shadow center margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex flex-column gap" do |form| %>
+    <div class="flex flex-column gap-half">
+      <%= form.label :q, "Search cards" %>
+      <%= form.search_field :q, value: @query, class: "input", autofocus: true %>
+    </div>
+
+    <%= form.submit "Search", class: "btn btn--link center" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="search-results flex flex-column gap margin-block-start" aria-label="Search results">
+    <h2 class="txt-large">Results for “<%= @query %>”</h2>
+
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page, class: "flex flex-column gap" do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match your search</p>
+    <% end %>
+  </section>
+<% end %>
