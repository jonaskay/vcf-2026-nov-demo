+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,16 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    cards = Current.user.accessible_cards.published.search(@query)
+      .reverse_chronologically
+      .preload(:board, :rich_text_description)
+
+    set_page_and_extract_portion_from cards
+
+    @comments_by_card = Current.user.accessible_comments.search(@query)
+      .where(card_id: @page.records.map(&:id))
+      .with_rich_text_body
+      .group_by(&:card_id)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..2ed4d9e
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,6 @@
+module SearchesHelper
+  def search_excerpt(content, query)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    excerpt(text, query, radius: 120)
+  end
+end
