diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..9435a6f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "search page finds a card by title" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "logo"
+  end
+
+  test "search finds descriptions and comment bodies and highlights plain-text excerpts" do
+    description_card = cards(:text)
+    comment_card = cards(:layout)
+    description_card.update! description: "<p>A vivid description match</p>"
+
+    with_current_user(:kevin) do
+      comment_card.comments.create!(creator: users(:kevin), body: "<p>A vivid comment match</p>")
+    end
+
+    get search_path, params: { q: "vivid" }
+
+    assert_response :success
+    assert_select ".search-result", count: 2
+    assert_select ".search-result__excerpt mark", text: "vivid", count: 2
+    assert_select ".search-result__excerpt", text: /Description: A vivid description match/
+    assert_select ".search-result__excerpt", text: /Comment: A vivid comment match/
+    assert_no_match(/<p>A vivid/, response.body)
+  end
+
+  test "search results are newest first, then ordered by descending id" do
+    newest = cards(:shipping)
+    same_time_first = cards(:logo)
+    same_time_second = cards(:layout)
+    timestamp = 1.day.ago
+
+    newest.update_columns title: "search-order newest", created_at: timestamp + 1.hour
+    same_time_first.update_columns title: "search-order first", created_at: timestamp
+    same_time_second.update_columns title: "search-order second", created_at: timestamp
+
+    expected_cards = [ newest ] + [ same_time_first, same_time_second ].sort_by(&:id).reverse
+
+    get search_path, params: { q: "search-order" }
+
+    assert_response :success
+    assert_equal expected_cards.map { |card| card_path(card) },
+      css_select(".search-result__title").map { |link| link["href"] }
+  end
+
+  test "search treats percent and underscore as literal characters" do
+    literal = cards(:logo)
+    wildcard_match = cards(:layout)
+    literal.update_column :title, "literal%wild_under_score"
+    wildcard_match.update_column :title, "literalXwildXunderXscore"
+
+    get search_path, params: { q: "literal%wild_under_score" }
+
+    assert_response :success
+    assert_equal [ card_path(literal) ], css_select(".search-result__title").map { |link| link["href"] }
+  end
+
+  test "a blank query returns no cards" do
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search only returns cards from boards the user can currently access" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(
+        title: "access-revocation-term", creator: users(:kevin), status: :published
+      )
+    end
+
+    get search_path, params: { q: "access-revocation-term" }
+    assert_response :success
+    assert_select ".search-result__title", text: /access-revocation-term/
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "access-revocation-term" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search never exposes cards from another account" do
+    get search_path, params: { q: "reasonable volume" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "draft cards and their comments never appear in search" do
+    draft = nil
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted)
+    end
+    draft.update_column :title, "draft-only-search-term"
+
+    comment = Comment.new(account: accounts("37s"), card: draft, creator: users(:kevin))
+    comment.body = "<p>draft-comment-only-term</p>"
+    comment.rich_text_body.account = accounts("37s")
+    comment.save!(validate: false)
+
+    get search_path, params: { q: "draft-only-search-term" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draft-comment-only-term" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "matched card text is sanitized before highlighting" do
+    card = cards(:logo)
+    card.update_column :title, "<script>alert(1)</script> safe-search-term"
+
+    get search_path, params: { q: "safe-search-term" }
+
+    assert_response :success
+    assert_select ".search-result__title script", count: 0
+    assert_select ".search-result__title mark", text: "safe-search-term"
+  end
+end
