index 0000000..1f5bb5d
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,30 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.published.search(@query)
+      .reverse_chronologically
+      .preload(:board, :rich_text_description)
+
+    set_page_and_extract_portion_from cards
+    @comments_by_card_id = matching_comments
+  end
+
+  private
+    def matching_comments
+      card_ids = @page.records.map(&:id)
+      if @query.present? && card_ids.any?
+        search_patterns = Card.search_patterns_for(@query)
+        body_condition = search_patterns.map { "action_text_rich_texts.body LIKE ? ESCAPE '!'" }.join(" OR ")
+
+        Current.user.accessible_comments
+          .joins(:rich_text_body)
+          .where(card_id: card_ids)
+          .where(body_condition, *search_patterns)
+          .preload(:rich_text_body)
+          .select { |comment| Card.searchable_text_matches?(comment.body, @query) }
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..10b4efd
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,14 @@
+module SearchesHelper
+  def search_excerpt(content, query)
+    if content.present?
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      excerpted_text = excerpt(text, query, radius: 100)
+      highlight_search_text(excerpted_text, query) if excerpted_text
+    end
+  end
+
+  def highlight_search_text(text, query)
+    # Escape first so literal HTML-like text can still be highlighted safely.
+    highlight(ERB::Util.html_escape(text), ERB::Util.html_escape(query).to_s, sanitize: false)
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..c9a1e09 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,54 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :search, ->(query) do
+    if query.present?
+      search_query = query.to_s
+      search_patterns = Card.search_patterns_for(search_query)
+      body_condition = search_patterns.map { "action_text_rich_texts.body LIKE ? ESCAPE '!'" }.join(" OR ")
+      searchable_card_ids = select(:id)
+
+      # Rich-text bodies are HTML, so only count SQL candidates that match their visible plain text.
+
+      matching_description_ids = ActionText::RichText
+        .where(record_type: "Card", record_id: searchable_card_ids, name: "description")
+        .where(body_condition, *search_patterns)
+        .select { |rich_text| Card.searchable_text_matches?(rich_text.body, search_query) }
+        .map(&:record_id)
+
+      matching_comment_card_ids = Comment
+        .joins(:rich_text_body)
+        .where(card_id: searchable_card_ids)
+        .where(body_condition, *search_patterns)
+        .preload(:rich_text_body)
+        .select { |comment| Card.searchable_text_matches?(comment.body, search_query) }
+        .map(&:card_id)
+
+      title_pattern = search_patterns.first
+      title_matches = where("cards.title LIKE ? ESCAPE '!'", title_pattern)
+      content_matches = where(id: (matching_description_ids + matching_comment_card_ids).uniq)
+
+      where(id: title_matches.select(:id)).or(content_matches)
+    else
+      none
+    end
+  end
+
+  def self.search_patterns_for(query)
+    [ query, ERB::Util.html_escape(query).to_s ].uniq.flat_map do |pattern|
+      escaped_pattern = ActiveRecord::Base.sanitize_sql_like(pattern, "!")
+      # A visible word may be split by HTML tags inside rich text.
+      interleaved_pattern = pattern.each_char.map { |character| ActiveRecord::Base.sanitize_sql_like(character, "!") }.join("%")
+
+      [ "%#{escaped_pattern}%", "%#{interleaved_pattern}%" ]
+    end.uniq
+  end
+
+  def self.searchable_text_matches?(content, query)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    text.downcase.include?(query.downcase)
+  end
+
   def card
     self
   end
