diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1412436
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show searches card titles and highlights matches" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    result_link = css_select(".search-result[data-card-number='#{cards(:logo).number}'] h2 a").first
+    assert_equal "The <mark>logo</mark> isn't big enough", result_link.inner_html
+  end
+
+  test "show searches descriptions and comment bodies" do
+    card = cards(:layout)
+    card.update! description: "A descriptionneedle inside the description."
+    comments(:layout_overflowing_david).update! body: "<p>A <strong>commentneedle</strong> inside the comment.</p>"
+
+    get search_path, params: { q: "descriptionneedle" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}'] .search-result__excerpt mark", text: "descriptionneedle"
+
+    get search_path, params: { q: "commentneedle" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}'] .search-result__excerpt mark", text: "commentneedle"
+
+    get search_path, params: { q: "strong" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "show searches visible rich text instead of HTML markup and escapes excerpts" do
+    card = cards(:layout)
+    card.update! description: '<p>Readable <strong>emphasis</strong> with a <a href="https://example.test">link</a> and <span>super<em>sensitive</em></span> &lt;script&gt; text.</p>'
+
+    get search_path, params: { q: "strong" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "href" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "supersensitive" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}'] .search-result__excerpt mark", text: "supersensitive"
+
+    get search_path, params: { q: "<script>" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}'] .search-result__excerpt mark", text: "<script>" do |elements|
+      assert_equal "&lt;script&gt;", elements.first.inner_html
+    end
+  end
+
+  test "show returns results newest first, with id as a tie breaker" do
+    timestamp = 2.days.ago.change(usec: 0)
+    cards(:logo).update_columns(title: "Shared search phrase", created_at: timestamp)
+    cards(:layout).update_columns(title: "Shared search phrase", created_at: timestamp)
+    cards(:shipping).update_columns(title: "Shared search phrase", created_at: timestamp + 1.day)
+
+    get search_path, params: { q: "Shared search phrase" }
+
+    assert_response :success
+    result_numbers = css_select(".search-result").map { |element| element["data-card-number"] }
+    expected_numbers = [ cards(:shipping), cards(:logo), cards(:layout) ]
+      .sort_by { |card| [ card.created_at, card.id ] }
+      .reverse
+      .map { |card| card.number.to_s }
+    assert_equal expected_numbers, result_numbers
+  end
+
+  test "show does not search blank queries" do
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select "form[action='#{search_path}'][method='get']"
+    assert_select ".search-result", count: 0
+  end
+
+  test "show treats percent and underscore as literal characters" do
+    cards(:logo).update_column :title, "Literal 100% result"
+    cards(:layout).update_column :title, "Literal 100x result"
+
+    get search_path, params: { q: "%" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{cards(:logo).number}']"
+    assert_select ".search-result[data-card-number='#{cards(:layout).number}']", count: 0
+
+    cards(:logo).update_column :title, "Literal one_result"
+    cards(:layout).update_column :title, "Literal oneXresult"
+    get search_path, params: { q: "_" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{cards(:logo).number}']"
+    assert_select ".search-result[data-card-number='#{cards(:layout).number}']", count: 0
+  end
+
+  test "show only returns currently accessible published cards and their comments" do
+    private_card = create_published_card(boards(:private), "privateonlyphrase")
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: "drafted", title: "drafttitlephrase")
+
+    with_current_user(:kevin) do
+      draft_comment = Comment.new(card: draft, creator: users(:kevin), account: accounts("37s"))
+      draft_comment.save!(validate: false)
+      ActionText::RichText.create!(record: draft_comment, name: "body", account: accounts("37s"), body: "draftcommentphrase")
+    end
+
+    get search_path, params: { q: "privateonlyphrase" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{private_card.number}']"
+
+    get search_path, params: { q: "radio" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    boards(:private).accesses.revoke_from users(:kevin)
+    get search_path, params: { q: "privateonlyphrase" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{private_card.number}']", count: 0
+
+    get search_path, params: { q: "drafttitlephrase" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftcommentphrase" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    logout_and_sign_in_as :jz
+    get search_path, params: { q: "privateonlyphrase" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_published_card(board, title)
+      with_current_user(:kevin) do
+        board.cards.create!(creator: users(:kevin), title: title, status: "published")
+      end
+    end
+end
