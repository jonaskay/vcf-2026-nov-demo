diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..9b1fe84
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search-results">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <div class="search-results__list">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <%= tag.article class: "search-result pad-block", data: { card_number: card.number } do %>
+            <h2><%= link_to highlight_search_text(card.title, @query), card_path(card) %></h2>
+            <p><%= card.board.name %></p>
+
+            <% if excerpt = search_excerpt(card.description, @query) %>
+              <p class="search-result__excerpt"><%= excerpt %></p>
+            <% end %>
+
+            <% @comments_by_card_id.fetch(card.id, []).each do |comment| %>
+              <% if excerpt = search_excerpt(comment.body, @query) %>
+                <p class="search-result__excerpt"><%= excerpt %></p>
+              <% end %>
+            <% end %>
+          <% end %>
+        <% end %>
+      <% end %>
+      <% if @page.empty? %>
+        <div class="blank-slate">No cards match this search</div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
