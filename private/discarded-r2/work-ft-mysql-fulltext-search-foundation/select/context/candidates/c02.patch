diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..4f5fac3
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title, description, and comment body with highlights" do
+    cards(:shipping).update! description: "<p>The hidden moonstone shines.</p>"
+
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_select ".search-result__title mark", text: "logo"
+
+    get search_path, params: { q: "moonstone" }
+    assert_response :success
+    assert_select ".search-result__description mark", text: "moonstone"
+
+    get search_path, params: { q: "overflowing" }
+    assert_response :success
+    assert_select ".search-result__comment mark", text: "overflowing"
+  end
+
+  test "returns cards newest first" do
+    older_card = cards(:logo)
+    newer_card = cards(:layout)
+
+    older_card.update_column :title, "searchorder older result"
+    newer_card.update_column :title, "searchorder newer result"
+    older_card.update_column :created_at, 2.days.ago
+    newer_card.update_column :created_at, 1.day.ago
+
+    get search_path, params: { q: "searchorder" }
+    assert_response :success
+
+    assert_equal [ "searchorder newer result", "searchorder older result" ],
+      css_select(".search-result__title").map { |element| element.text.squish }
+  end
+
+  test "treats wildcard characters as literal search terms" do
+    cards(:logo).update_column :title, "A 100% literal title"
+    cards(:layout).update_column :title, "A 100 percent title"
+
+    get search_path, params: { q: "%" }
+    assert_response :success
+    assert_equal [ "A 100% literal title" ], css_select(".search-result__title").map { |element| element.text.squish }
+    assert_select ".search-result__title mark", text: "%"
+
+    get search_path, params: { q: "_" }
+    assert_response :success
+    assert_empty css_select(".search-result__title")
+  end
+
+  test "highlights title text without rendering unsafe markup" do
+    cards(:logo).update_column :title, "<script>alert(1)</script> needle"
+
+    get search_path, params: { q: "needle" }
+    assert_response :success
+
+    assert_select ".search-result__title mark", text: "needle"
+    assert_select ".search-result__title script", count: 0
+  end
+
+  test "only searches boards the current user can still access" do
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_equal 1, css_select(".search-result").length
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:jz)
+
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_empty css_select(".search-result")
+  end
+
+  test "does not return cards from another account" do
+    get search_path, params: { q: "radio" }
+    assert_response :success
+    assert_empty css_select(".search-result")
+  end
+
+  test "does not return draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), title: "draftonlytitle")
+    comment = Comment.new(card: draft, creator: users(:kevin), account: accounts("37s"))
+    comment.body = "<p>draftonlycomment</p>"
+    comment.rich_text_body.account = accounts("37s")
+    comment.save! validate: false
+
+    get search_path, params: { q: "draftonlytitle" }
+    assert_response :success
+    assert_empty css_select(".search-result")
+
+    get search_path, params: { q: "draftonlycomment" }
+    assert_response :success
+    assert_empty css_select(".search-result")
+  end
+
+  test "an empty query returns no results" do
+    get search_path
+    assert_response :success
+    assert_empty css_select(".search-result")
+  end
+end
