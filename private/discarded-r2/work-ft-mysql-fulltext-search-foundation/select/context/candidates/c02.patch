+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,19 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    cards = if @query.present?
+      Current.user.accessible_cards.published.matching(@query)
+    else
+      Current.user.accessible_cards.none
+    end
+
+    set_page_and_extract_portion_from cards.reverse_chronologically.preload(:rich_text_description, :board)
+    @cards = @page.records.to_a
+    @matching_comments = if @query.present? && @cards.any?
+      Comment.matching(@query).where(card_id: @cards.map(&:id)).includes(:rich_text_body).chronologically.group_by(&:card_id)
+    else
+      {}
+    end
+  end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..10ec365
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,8 @@
+module SearchHelper
+  def search_excerpt(content, query)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    snippet = excerpt(text, query, radius: 100)
+
+    highlight(snippet, query) if snippet
+  end
+end
