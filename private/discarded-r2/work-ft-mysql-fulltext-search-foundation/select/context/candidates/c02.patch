diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..d388ab2
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search cards</h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @query, class: "input full-width", placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% @cards.each do |card| %>
+        <article class="search-result pad-block-half" id="<%= dom_id(card, :search_result) %>">
+          <h2 class="search-result__title txt-small">
+            <%= link_to highlight(card.title, @query), card_path(card) %>
+          </h2>
+          <p class="search-result__board txt-x-small"><%= card.board.name %></p>
+
+          <% if snippet = search_excerpt(card.description, @query) %>
+            <p class="search-result__description"><%= snippet %></p>
+          <% end %>
+
+          <% @matching_comments.fetch(card.id, []).each do |comment| %>
+            <% if snippet = search_excerpt(comment.body, @query) %>
+              <p class="search-result__comment"><%= snippet %></p>
+            <% end %>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+
+    <% if @cards.empty? %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% else %>
+    <p class="txt-small">Search card titles, descriptions, and comments.</p>
+  <% end %>
+</section>
