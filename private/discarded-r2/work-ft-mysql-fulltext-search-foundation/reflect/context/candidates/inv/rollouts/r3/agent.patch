@@ -0,0 +1,29 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.squish
+    @query_terms = @query.split.uniq
+    set_page_and_extract_portion_from search_results
+    @matching_comments_by_card = matching_comments.group_by(&:card_id)
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards
+        .published
+        .search(@query_terms)
+        .reverse_chronologically
+        .includes(:board)
+        .with_rich_text_description
+    end
+
+    def matching_comments
+      if @page.records.any?
+        Comment.search(@query_terms)
+          .where(card_id: @page.records.map(&:id))
+          .includes(:rich_text_body)
+          .order(created_at: :desc, id: :desc)
+      else
+        Comment.none
+      end
+    end
+end
