+++ b/app/models/card.rb
@@ -22,6 +22,46 @@ class Card < ApplicationRecord
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
+
+  scope :search, ->(query) do
+    terms = Array(query).flat_map { |value| value.to_s.squish.split }.reject(&:blank?).uniq
+
+    if terms.any?
+      conditions = terms.each_index.map do |index|
+        <<~SQL.squish
+          (
+            cards.title LIKE :pattern_#{index} ESCAPE '!'
+            OR EXISTS (
+              SELECT 1
+              FROM action_text_rich_texts card_descriptions
+              WHERE card_descriptions.record_type = 'Card'
+                AND card_descriptions.record_id = cards.id
+                AND card_descriptions.name = 'description'
+                AND card_descriptions.body LIKE :pattern_#{index} ESCAPE '!'
+            )
+            OR EXISTS (
+              SELECT 1
+              FROM comments search_comments
+              INNER JOIN action_text_rich_texts comment_bodies
+                ON comment_bodies.record_type = 'Comment'
+                AND comment_bodies.record_id = search_comments.id
+                AND comment_bodies.name = 'body'
+              WHERE search_comments.card_id = cards.id
+                AND comment_bodies.body LIKE :pattern_#{index} ESCAPE '!'
+            )
+          )
+        SQL
+      end
+
+      patterns = terms.each_with_index.to_h do |term, index|
+        [ "pattern_#{index}".to_sym, "%#{sanitize_sql_like(term, "!")}%" ]
+      end
+
+      where(conditions.join(" AND "), **patterns)
+    else
+      none
+    end
+  end
