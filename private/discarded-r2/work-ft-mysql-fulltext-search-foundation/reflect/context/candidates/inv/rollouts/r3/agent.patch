diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..d436fda
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,39 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="search-page margin-block-double txt-align-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap full-width" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @query, class: "input flex-1", placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <section class="search-results margin-block-start" aria-label="Search results">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <% @page.records.each do |card| %>
+            <article class="search-result margin-block-end" data-card-id="<%= card.id %>">
+              <h2><%= link_to highlight(card.title, @query_terms), card_path(card) %></h2>
+              <p class="search-result__board"><%= link_to card.board.name, board_path(card.board) %></p>
+
+              <% if card.description.present? %>
+                <p class="search-result__description"><%= highlighted_search_excerpt(card.description) %></p>
+              <% end %>
+
+              <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+                <p class="search-result__comment"><%= highlighted_search_excerpt(comment.body) %></p>
+              <% end %>
+            </article>
+          <% end %>
+        <% end %>
+      </section>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”</p>
+    <% end %>
+  <% end %>
+</div>
