diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..5fca766
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions and comments newest first with highlighted matches" do
+    board = boards(:writebook)
+    title_card = create_card(board, title: "Quartz title result", created_at: 3.days.ago)
+    description_card = create_card(board, title: "Description result", description: "The quartz description match", created_at: 2.days.ago)
+    comment_card = create_card(board, title: "Comment result", created_at: 1.day.ago)
+    Current.set(account: board.account, session: sessions(:kevin)) do
+      comment_card.comments.create!(creator: users(:kevin), body: "The quartz comment match")
+    end
+
+    get search_path, params: { q: "quartz result" }
+
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ comment_card, description_card, title_card ].map(&:id), results.map { |result| result["data-card-id"] }
+    end
+    assert_select ".search-result h2 mark", text: "Quartz"
+    assert_select ".search-result p mark", text: "quartz"
+    assert_select ".search-result__comment mark", text: "quartz"
+  end
+
+  test "only shows cards on boards the user currently can access and excludes drafts and their comments" do
+    restricted_board = Current.set(account: accounts("37s"), session: sessions(:kevin)) do
+      Board.create!(name: "Temporarily shared", all_access: false, creator: users(:kevin))
+    end
+    restricted_board.accesses.grant_to(users(:jz))
+    inaccessible_card = create_card(restricted_board, title: "opal hidden board result")
+    restricted_board.accesses.destroy_by(user: users(:jz))
+
+    draft_card = Current.set(account: accounts("37s"), session: sessions(:kevin)) do
+      card = boards(:writebook).cards.create!(
+        creator: users(:kevin), title: "opal hidden draft", status: :drafted,
+        created_at: Time.current, last_active_at: Time.current
+      )
+      comment_id = ActiveRecord::Type::Uuid.generate
+      now = Time.current
+      Comment.insert_all! [ {
+        id: comment_id, account_id: card.account_id, card_id: card.id, creator_id: users(:kevin).id,
+        created_at: now, updated_at: now
+      } ]
+      ActionText::RichText.insert_all! [ {
+        id: ActiveRecord::Type::Uuid.generate, account_id: card.account_id,
+        record_type: "Comment", record_id: comment_id, name: "body", body: "opal hidden draft comment",
+        created_at: now, updated_at: now
+      } ]
+      card
+    end
+
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "opal" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_not_includes response.body, inaccessible_card.title
+    assert_not_includes response.body, draft_card.title
+    assert_not_includes response.body, "opal hidden draft comment"
+  end
+
+  test "shows the search form without returning results until a query is entered" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?][method=get]", search_path
+    assert_select ".search-result", count: 0
+  end
+
+  test "treats percent and underscore as literal search characters" do
+    literal_card = create_card(boards(:writebook), title: "100%_complete")
+    create_card(boards(:writebook), title: "An unrelated card")
+
+    get search_path, params: { q: "%_" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{literal_card.id}']"
+  end
+
+  private
+    def create_card(board, title:, description: nil, created_at: Time.current)
+      Current.set(account: board.account, session: sessions(:kevin)) do
+        board.cards.create!(
+          creator: users(:kevin), title: title, description: description, status: :published,
+          created_at: created_at, last_active_at: created_at
+        )
+      end
+    end
+end
