+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,7 @@
+module SearchesHelper
+  def highlighted_search_excerpt(content)
+    text = content.to_plain_text.squish
+    snippet = @query_terms.filter_map { |term| excerpt(text, term, radius: 100) }.first || text.truncate(200)
+    highlight(snippet, @query_terms)
+  end
+end
