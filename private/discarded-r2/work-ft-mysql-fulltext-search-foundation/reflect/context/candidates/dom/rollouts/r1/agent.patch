diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..11f43bc
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search-page">
+  <%= form_with url: search_path, method: :get, class: "flex gap margin-block-end", role: "search" do %>
+    <%= search_field_tag :q, @query, class: "input", aria: { label: "Search cards" } %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <article class="search-result panel margin-block-end" data-card-id="<%= card.id %>">
+            <h2 class="txt-large margin-none">
+              <%= link_to highlight(card.title, @query), card_path(card) %>
+            </h2>
+            <p class="txt-small margin-block-half">
+              <%= link_to card.board.name, board_path(card.board) %>
+            </p>
+
+            <% if description = excerpt(card.description.to_plain_text, @query, radius: 120) %>
+              <p class="search-result__description margin-block-half"><%= highlight(description, @query) %></p>
+            <% end %>
+
+            <% card.comments.each do |comment| %>
+              <% if comment_excerpt = excerpt(comment.body.to_plain_text, @query, radius: 120) %>
+                <p class="search-result__comment margin-block-half"><%= highlight(comment_excerpt, @query) %></p>
+              <% end %>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match your search</p>
+    <% end %>
+  <% end %>
+</section>
