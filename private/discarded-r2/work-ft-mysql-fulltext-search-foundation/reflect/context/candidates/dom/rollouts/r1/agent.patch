diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e59abeb
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comment bodies with highlighted excerpts" do
+    with_current_user(:kevin) do
+      cards(:logo).update!(title: "A titleterm result")
+      cards(:text).update!(description: "<p>A descriptionterm result</p>")
+      comments(:layout_1).update!(body: "<p>A commentterm result</p>")
+    end
+
+    get search_path, params: { q: "titleterm" }
+    assert_response :success
+    assert_select ".search-result a[href=?] mark", card_path(cards(:logo)), text: "titleterm"
+
+    get search_path, params: { q: "descriptionterm" }
+    assert_response :success
+    assert_select ".search-result__description mark", text: "descriptionterm"
+
+    get search_path, params: { q: "commentterm" }
+    assert_response :success
+    assert_select ".search-result__comment mark", text: "commentterm"
+  end
+
+  test "returns cards newest first and breaks ties by descending id" do
+    same_created_at = 1.day.ago.change(usec: 0)
+    oldest = create_published_card("orderingterm oldest", created_at: 2.days.ago.change(usec: 0))
+    first_at_same_time = create_published_card("orderingterm first", created_at: same_created_at)
+    second_at_same_time = create_published_card("orderingterm second", created_at: same_created_at)
+    newest = create_published_card("orderingterm newest", created_at: 1.hour.ago.change(usec: 0))
+
+    get search_path, params: { q: "orderingterm" }
+    assert_response :success
+
+    expected = [ newest, *[ first_at_same_time, second_at_same_time ].sort_by(&:id).reverse, oldest ].map(&:id)
+    assert_select ".search-result" do |results|
+      assert_equal expected, results.map { |result| result["data-card-id"] }
+    end
+  end
+
+  test "does not return drafts or comments on drafts" do
+    draft = nil
+    with_current_user(:kevin) do
+      draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "drafttitleterm")
+    end
+
+    comment = draft.comments.build(creator: users(:kevin), account: accounts("37s"))
+    comment.body = "draftcommentterm"
+    comment.rich_text_body.account = accounts("37s")
+    comment.save!(validate: false)
+
+    get search_path, params: { q: "drafttitleterm" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftcommentterm" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "removes a card from results as soon as board access is revoked" do
+    card = create_published_card("revokedaccessneedle", board: boards(:private))
+
+    get search_path, params: { q: "revokedaccessneedle" }
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ card.id ], results.map { |result| result["data-card-id"] }
+    end
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "revokedaccessneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path, params: { q: "reasonable volume" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return cards on boards the viewer cannot access" do
+    create_published_card("inaccessibleboardneedle", board: boards(:private))
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "inaccessibleboardneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes card text while highlighting a match" do
+    create_published_card("<img src=x onerror=alert(1)> escapedneedle")
+
+    get search_path, params: { q: "escapedneedle" }
+    assert_response :success
+    assert_select ".search-result h2 mark", text: "escapedneedle"
+    assert_no_match "onerror=", response.body
+  end
+
+  test "treats percent and underscore as literal characters" do
+    percent_card = create_published_card("100% literal needle")
+    create_published_card("underXscore literal needle")
+    underscore_card = create_published_card("under_score literal needle")
+
+    get search_path, params: { q: "%" }
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ percent_card.id ], results.map { |result| result["data-card-id"] }
+    end
+
+    get search_path, params: { q: "under_score" }
+    assert_response :success
+    assert_select ".search-result" do |results|
+      assert_equal [ underscore_card.id ], results.map { |result| result["data-card-id"] }
+    end
+  end
+
+  test "a blank query returns no cards" do
+    get search_path, params: { q: "" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "   " }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_published_card(title, board: boards(:writebook), created_at: Time.current)
+      with_current_user(:kevin) do
+        board.cards.create!(
+          creator: users(:kevin),
+          title: title,
+          status: :published,
+          created_at: created_at,
+          last_active_at: created_at
+        )
+      end
+    end
+end
