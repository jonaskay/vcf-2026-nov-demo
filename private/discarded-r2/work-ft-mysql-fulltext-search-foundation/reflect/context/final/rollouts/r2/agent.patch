+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    accessible_cards = Current.user.accessible_cards.published
+    search_candidates = accessible_cards.searching(@query)
+    candidate_cards = search_candidates.with_rich_text_description.to_a
+    @comments_by_card = matching_comments(search_candidates.select(:id))
+
+    matching_card_ids = candidate_cards.filter_map do |card|
+      card.id if card.matches_search?(@query, comments: @comments_by_card.fetch(card.id, []))
+    end
+    matched_card_ids = matching_card_ids.to_h { |id| [ id, true ] }
+    @comments_by_card.select! { |card_id, _comments| matched_card_ids.key?(card_id) }
+
+    cards = accessible_cards.where(id: matching_card_ids).reverse_chronologically
+      .with_rich_text_description.includes(:board)
+    set_page_and_extract_portion_from cards
+  end
+
+  private
+    def matching_comments(card_ids)
+      if @query.present?
+        condition, patterns = Card.search_body_condition("action_text_rich_texts.body", @query)
+
+        Comment
+          .joins(:rich_text_body)
+          .where(card_id: card_ids)
+          .where(condition, *patterns)
+          .preload(:rich_text_body)
+          .select { |comment| comment.body.to_plain_text.downcase.include?(@query.downcase) }
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
