+module SearchesHelper
+  def highlight_search_term(text, query)
+    # Escape text first so literal angle brackets remain searchable when skipping highlight's sanitizer.
+    escaped_text = ERB::Util.html_escape(text.to_s)
+    escaped_query = ERB::Util.html_escape(query.to_s)
+
+    highlight(escaped_text, escaped_query, sanitize: false)
+  end
+end
