diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d941501
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles and highlights matches" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "logo"
+    assert_select ".search-result a[href='#{card_path(cards(:logo))}']"
+  end
+
+  test "searches descriptions and comment bodies with plain-text highlights" do
+    with_current_user(:kevin) do
+      cards(:layout).update!(description: "<p>The matching <strong>description</strong> phrase appears here.</p>")
+      cards(:text).comments.create!(creator: users(:kevin), body: "<p>A searchable <em>comment phrase</em> is here.</p>")
+    end
+
+    get search_path, params: { q: "description phrase" }
+    assert_response :success
+    assert_equal [ "description phrase" ], Nokogiri::HTML(response.body).css(".search-result__description mark").map(&:text)
+
+    get search_path, params: { q: "phrase description" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "searchable comment phrase" }
+    assert_response :success
+    assert_equal [ "searchable comment phrase" ], Nokogiri::HTML(response.body).css(".search-result__comment mark").map(&:text)
+  end
+
+  test "searches visible text, not rich-text markup, and highlights escaped titles safely" do
+    with_current_user(:kevin) do
+      card = boards(:writebook).cards.create!(title: "Card with harmless text", status: :published)
+      card.comments.create!(creator: users(:kevin), body: "<p>Visible <strong>formatting</strong> only.</p>")
+      card.comments.create!(creator: users(:kevin), body: "<p>Tom &amp; Jerry searched literally.</p>")
+      boards(:writebook).cards.create!(title: "<script>safe-highlightneedle</script>", status: :published)
+    end
+
+    get search_path, params: { q: "strong" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "Tom & Jerry" }
+    assert_response :success
+    marks = Nokogiri::HTML(response.body).css(".search-result__comment mark").map(&:text)
+    assert_equal [ "Tom & Jerry" ], marks
+    assert_select ".search-result", count: 1
+
+    get search_path, params: { q: "safe-highlightneedle" }
+    assert_response :success
+    assert_select ".search-result__title script", count: 0
+    assert_equal [ "safe-highlightneedle" ], Nokogiri::HTML(response.body).css(".search-result__title mark").map(&:text)
+
+    get search_path, params: { q: "<script>" }
+    assert_response :success
+    assert_select ".search-result__title script", count: 0
+    assert_select ".search-result__title mark", text: "<script>"
+  end
+
+  test "returns newest matching cards first, breaking timestamp ties by id" do
+    older_card = newer_card = nil
+
+    with_current_user(:kevin) do
+      same_creation_time = 1.day.ago
+      older_card = boards(:writebook).cards.create!(title: "Older search-order-token", status: :published, created_at: same_creation_time)
+      newer_card = boards(:writebook).cards.create!(title: "Newer search-order-token", status: :published, created_at: same_creation_time)
+    end
+
+    get search_path, params: { q: "search-order-token" }
+
+    assert_response :success
+    titles = Nokogiri::HTML(response.body).css(".search-result__title").map { |title| title.text.squish }
+    assert_equal [ newer_card.title, older_card.title ], titles
+  end
+
+  test "search respects current board access and excludes drafts and their comments" do
+    draft = nil
+
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "accessneedle in private board", status: :published)
+      draft = boards(:writebook).cards.create!(title: "draftneedle in a draft", status: :drafted)
+      draft_comment = Comment.new(card: draft, creator: users(:kevin), account: accounts("37s"))
+      draft_comment.save!(validate: false)
+      ActionText::RichText.create!(record: draft_comment, name: "body", body: "draftcommentneedle", account: accounts("37s"))
+    end
+
+    get search_path, params: { q: "accessneedle" }
+    assert_response :success
+    assert_select ".search-result__title", text: /accessneedle/
+
+    boards(:private).accesses.revoke_from users(:kevin)
+    get search_path, params: { q: "accessneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftcommentneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "blank searches show the form without returning cards" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action='#{search_path}']"
+    assert_select ".search-result", count: 0
+  end
+
+  test "search treats SQL wildcards literally and stays within the current account" do
+    with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Literal 100%_needle", status: :published)
+    end
+
+    get search_path, params: { q: "%_" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "%_"
+
+    get search_path, params: { q: "radio" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+end
