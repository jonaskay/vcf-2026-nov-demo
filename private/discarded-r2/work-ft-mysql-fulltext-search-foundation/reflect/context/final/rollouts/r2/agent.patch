     Readable, Stallable, Statuses, Storage::Tracked, Taggable, Triageable, Watchable
 
+  # Rich-text bodies are stored as HTML, so include both literal and escaped text forms.
+  def self.search_patterns(term)
+    [ term, ERB::Util.html_escape(term).to_s ].map do |pattern|
+      "%#{ActiveRecord::Base.sanitize_sql_like(pattern, "!")}%"
+    end
+  end
+
+  def self.search_body_condition(column, term)
+    terms = term.scan(/[\p{Alnum}]+/)
+    terms = [ term ] if terms.empty?
+
+    pattern_groups = terms.map { |word| search_patterns(word) }
+    conditions = pattern_groups.map do
+      "(#{column} LIKE ? ESCAPE '!' OR #{column} LIKE ? ESCAPE '!')"
+    end
+
+    [ conditions.join(" AND "), pattern_groups.flatten ]
+  end
+
