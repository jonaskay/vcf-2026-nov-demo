diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..67b6338
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,45 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search cards</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @query, class: "input full-width", placeholder: "Search cards…", autofocus: true %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <div class="flex flex-column gap">
+        <% @page.records.each do |card| %>
+          <article class="search-result">
+            <h2 class="search-result__title">
+              <%= link_to highlight_search_term(card.title, @query), card_path(card) %>
+            </h2>
+
+            <p class="search-result__board"><%= link_to card.board.name, card.board %></p>
+
+            <% description = card.description.to_plain_text %>
+            <% if description.downcase.include?(@query.downcase) %>
+              <% description_excerpt = excerpt(description, @query, radius: 100) || description.truncate(200) %>
+              <p class="search-result__description"><%= highlight_search_term(description_excerpt, @query) %></p>
+            <% end %>
+
+            <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+              <% comment_text = comment.body.to_plain_text %>
+              <% comment_excerpt = excerpt(comment_text, @query, radius: 100) || comment_text.truncate(200) %>
+              <p class="search-result__comment"><%= highlight_search_term(comment_excerpt, @query) %></p>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    <% end %>
+  <% elsif @query.present? %>
+    <p class="blank-slate">No cards match “<%= @query %>”</p>
+  <% else %>
+    <p class="blank-slate">Search card titles, descriptions, and comments</p>
+  <% end %>
+</section>
