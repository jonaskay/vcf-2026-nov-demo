     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone all due respects account defaults and board overrides at the boundary" do
+    freeze_time do
+      entropies("37s_account").update! auto_postpone_period: 7.days
+      entropies(:writebook_board).update! auto_postpone_period: 3.days
+      entropies(:private_board).destroy
+      entropies(:initech_account).update! auto_postpone_period: 30.days
+      entropies(:miltons_wish_list_board).destroy
+
+      cards(:layout).update! board: boards(:private)
+      cards(:text).update! board: boards(:private)
+
+      cards(:logo).update! last_active_at: 3.days.ago
+      cards(:shipping).update! last_active_at: 3.days.ago + 1.second
+      cards(:layout).update! last_active_at: 7.days.ago
+      cards(:text).update! last_active_at: 7.days.ago + 1.second
+      cards(:radio).update! last_active_at: 30.days.ago
+      cards(:paycheck).update! last_active_at: 30.days.ago + 1.second
+
+      assert_kind_of ActiveRecord::Relation, Card.due_to_be_postponed
+
+      Card.auto_postpone_all_due
+
+      assert cards(:logo).reload.postponed?
+      assert_not cards(:shipping).reload.postponed?
+      assert cards(:layout).reload.postponed?
+      assert_not cards(:text).reload.postponed?
+      assert cards(:radio).reload.postponed?
+      assert_not cards(:paycheck).reload.postponed?
+    end
+  end
+
+  test "auto postpone all due uses literal cutoffs instead of joining entropy for every card" do
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+    cards(:logo).update! last_active_at: 4.days.ago
+
+    selection_queries = []
+    subscriber = ->(*args) do
+      sql = args.last[:sql]
+      selection_queries << sql if sql.match?(/SELECT .* FROM ["`]cards["`]/m) && sql.include?("last_active_at")
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      Card.auto_postpone_all_due
+    end
+
+    assert_not_empty selection_queries
+    assert selection_queries.all? { |sql| sql.include?("cards.last_active_at <= ?") }
+    assert selection_queries.none? { |sql| sql.include?("COALESCE") || sql.match?(/JOIN ["`]boards["`]/) }
+  end
+
+  test "auto postpone all due processes candidates beyond the first batch" do
+    freeze_time do
+      entropies(:writebook_board).update! auto_postpone_period: 3.days
+      now = Time.current
+      account = accounts("37s")
+      board = boards(:writebook)
+      creator = users(:david)
+      ids = Array.new(1_001) { ActiveRecord::Type::Uuid.generate }
+      rows = ids.each_with_index.map do |id, index|
+        {
+          id: id,
+          account_id: account.id,
+          board_id: board.id,
+          creator_id: creator.id,
+          number: 10_000 + index,
+          status: "published",
+          last_active_at: now - 4.days,
+          created_at: now - 4.days,
+          updated_at: now - 4.days
+        }
+      end
+
+      rows.each_slice(250) { |batch| Card.insert_all!(batch) }
+
+      Card.auto_postpone_all_due
+
+      assert_equal ids.length, Card.postponed.where(id: ids).count
+    end
+  end
+
