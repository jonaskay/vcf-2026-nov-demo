+  test "due scope includes the minimum account entropy deadline and excludes newer activity" do
+    travel_to Time.utc(2025, 1, 10, 12, 0, 0)
+
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 3.days)
+    cards(:logo).update!(last_active_at: 3.days.ago)
+    cards(:shipping).update!(last_active_at: 3.days.ago + 1.second)
+
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+    assert_not_includes Card.due_to_be_postponed, cards(:shipping)
+  end
+
+  test "due scope honors a board period shorter than the account period" do
+    travel_to Time.utc(2025, 1, 10, 12, 0, 0)
+
+    entropies("37s_account").update!(auto_postpone_period: 365.days)
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    cards(:logo).update!(last_active_at: 3.days.ago)
+    cards(:shipping).update!(last_active_at: 3.days.ago + 1.second)
+
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+    assert_not_includes Card.due_to_be_postponed, cards(:shipping)
+  end
+
+  test "auto postpone all due includes the exact minimum period boundary" do
+    travel_to Time.utc(2025, 1, 10, 12, 0, 0)
+
+    entropies(:writebook_board).destroy
