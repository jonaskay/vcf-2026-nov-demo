diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..9e14f83
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,97 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :stalled, -> do
+      now = Time.current
+      quiet_cutoff = connection.quote(now - 14.days)
+      auto_close_period = "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"
+      latest_user_comment_at = <<~SQL.squish
+        (
+          SELECT MAX(latest_comments.created_at)
+          FROM comments AS latest_comments
+          INNER JOIN users AS latest_comment_creators ON latest_comment_creators.id = latest_comments.creator_id
+          WHERE latest_comments.card_id = cards.id
+            AND latest_comment_creators.role != 'system'
+        )
+      SQL
+      comment_window_start = connection.date_subtract(latest_user_comment_at, "#{auto_close_period} / 3")
+      latest_activity_start = connection.date_subtract("cards.last_active_at", "1")
+      no_activity_after = ->(activity_at) do
+        <<~SQL.squish
+          NOT EXISTS (
+            SELECT 1
+            FROM events AS later_card_events
+            WHERE later_card_events.eventable_type = 'Card'
+              AND later_card_events.eventable_id = cards.id
+              AND later_card_events.created_at > #{activity_at}
+            UNION ALL
+            SELECT 1
+            FROM comments AS later_card_comments
+            WHERE later_card_comments.card_id = cards.id
+              AND later_card_comments.created_at > #{activity_at}
+            UNION ALL
+            SELECT 1
+            FROM reactions AS later_reactions
+            LEFT OUTER JOIN comments AS reacted_comments
+              ON reacted_comments.id = later_reactions.reactable_id
+              AND later_reactions.reactable_type = 'Comment'
+            WHERE (
+              (later_reactions.reactable_type = 'Card' AND later_reactions.reactable_id = cards.id)
+              OR (later_reactions.reactable_type = 'Comment' AND reacted_comments.card_id = cards.id)
+            )
+              AND later_reactions.created_at > #{activity_at}
+          )
+        SQL
+      end
+
+      comment_burst = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM comments AS burst_comments
+          INNER JOIN users AS burst_comment_creators ON burst_comment_creators.id = burst_comments.creator_id
+          WHERE burst_comments.card_id = cards.id
+            AND burst_comment_creators.role != 'system'
+            AND burst_comments.created_at >= #{comment_window_start}
+            AND burst_comments.created_at <= #{latest_user_comment_at}
+          GROUP BY burst_comments.card_id
+          HAVING COUNT(*) >= 3
+            AND COUNT(DISTINCT burst_comments.creator_id) >= 2
+        )
+        AND #{latest_user_comment_at} <= #{quiet_cutoff}
+        AND #{latest_user_comment_at} >= #{latest_activity_start}
+        AND #{no_activity_after.call(latest_user_comment_at)}
+      SQL
+
+      assignment_or_reopen_burst = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM events AS burst_events
+          WHERE burst_events.eventable_type = 'Card'
+            AND burst_events.eventable_id = cards.id
+            AND burst_events.action IN ('card_assigned', 'card_reopened')
+            AND burst_events.created_at <= #{quiet_cutoff}
+            AND burst_events.created_at >= #{latest_activity_start}
+            AND #{no_activity_after.call('burst_events.created_at')}
+        )
+      SQL
+
+      active
+        .joins(board: :account)
+        .left_outer_joins(board: :entropy)
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+        .where(last_active_at: ..(now - 14.days))
+        .where("(#{comment_burst}) OR (#{assignment_or_reopen_burst})")
+    end
+  end
+
+  class_methods do
+    def stalled_ids_for(cards)
+      stalled.where(id: cards.map(&:id)).pluck(:id).to_set
+    end
+  end
+
+  def stalled?
+    self.class.stalled.exists?(id: id)
+  end
+end
