@@ -24,11 +18,63 @@ module Card::Entropic
   end
 
   class_methods do
+    def due_to_be_postponed_relation(relation = all, now: Time.current)
+      queries = due_to_be_postponed_queries(relation, now)
+      due_to_be_postponed_relation_from_queries(relation, queries)
+    end
+
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      queries = due_to_be_postponed_queries(all, now)
+      due_cards_relation = due_to_be_postponed_relation_from_queries(all, queries)
+      system_users = {}
+
+      queries.each do |due_cards|
+        due_cards.preload(:account).find_each do |card|
+          system_user = system_users[card.account_id] ||= card.account.system_user
+          card.auto_postpone(user: system_user)
+        end
       end
+
+      due_cards_relation
     end
+
+    private
+      def due_to_be_postponed_relation_from_queries(relation, queries)
+        if queries.any?
+          ids_sql = queries.map { |query| query.reselect(:id).to_sql }.join(" UNION ALL ")
+          relation.where("cards.id IN (#{ids_sql})")
+        else
+          relation.none
+        end
+      end
+
+      def due_to_be_postponed_queries(relation, now)
+        board_entropies = Entropy.where(container_type: "Board")
+        account_entropies = Entropy.where(container_type: "Account")
+          .where("entropies.account_id = entropies.container_id")
+        periods = board_entropies.distinct.pluck(:auto_postpone_period) +
+          account_entropies.distinct.pluck(:auto_postpone_period)
+        active_cards = relation.except(:select, :order, :limit, :offset).active
+
+        periods.uniq.flat_map do |period|
+          cutoff = now - period.seconds
+          board_ids = Board.joins(:account)
+            .where(id: board_entropies.where(auto_postpone_period: period).select(:container_id))
+            .select(:id)
+          account_ids = account_entropies.where(auto_postpone_period: period).select(:container_id)
+          default_board_ids = Board.joins(:account)
+            .where(account_id: account_ids)
+            .where.not(id: board_entropies.select(:container_id))
+            .select(:id)
+
+          [ board_ids, default_board_ids ].map do |ids|
+            active_cards
+              .where(board_id: ids)
+              .where("cards.last_active_at <= ?", cutoff)
+          end
+        end
+      end
   end
 
   def entropy
