+        account_ids = account_entropies.where(auto_postpone_period: period).select(:container_id)
+        board_ids = Board.joins(:account).where(account_id: account_ids)
+          .left_outer_joins(:entropy)
+          .where(entropies: { id: nil })
+          .select(:id)
+        postpone_due_cards_on_boards(board_ids, period, now, system_users_by_account_id)
       end
+
+      due_cards
     end
+
+    private
+      def postpone_due_cards_on_boards(board_ids, period, now, system_users_by_account_id)
+        active
+          .where(board_id: board_ids)
+          .where("cards.last_active_at <= #{connection.date_subtract('?', '?')}", now, period)
+          .find_each do |card|
+            system_user = system_users_by_account_id.fetch(card.account_id) { card.account.system_user }
+            card.auto_postpone(user: system_user)
+          end
+      end
   end
 
