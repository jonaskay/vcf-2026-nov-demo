+          number: first_number + index,
+          status: "published",
+          last_active_at: last_active_at,
+          created_at: now,
+          updated_at: now
+        }
+      end)
+
+      Card.any_instance.expects(:auto_postpone).with(user: users(:system)).times(card_count)
+      Card.auto_postpone_all_due
+    end
+  end
