+  test "due scope uses the board override at its inclusive boundary" do
+    freeze_time do
+      entropies(:writebook_board).update!(auto_postpone_period: 7.days)
+      entropies("37s_account").update!(auto_postpone_period: 30.days)
+
+      boundary_card = cards(:logo)
+      boundary_card.update!(last_active_at: Time.current - 7.days)
+
+      recent_card = cards(:shipping)
+      recent_card.update!(last_active_at: Time.current - 7.days + 1.second)
+
+      older_than_account_default = cards(:text)
+      older_than_account_default.update!(last_active_at: Time.current - 15.days)
+
+      due_cards = Card.due_to_be_postponed
+
+      assert_includes due_cards, boundary_card
+      assert_not_includes due_cards, recent_card
+      assert_includes due_cards, older_than_account_default
+    end
+  end
+
+  test "due scope falls back to the account period when the board has no override" do
+    freeze_time do
+      entropies(:writebook_board).destroy
+      entropies("37s_account").update!(auto_postpone_period: 7.days)
+
+      boundary_card = cards(:logo)
+      boundary_card.update!(last_active_at: Time.current - 7.days)
+
+      recent_card = cards(:shipping)
+      recent_card.update!(last_active_at: Time.current - 7.days + 1.second)
+
+      due_cards = Card.due_to_be_postponed
+
+      assert_includes due_cards, boundary_card
+      assert_not_includes due_cards, recent_card
+    end
+  end
+
+  test "auto postpone uses board overrides and each account default for active cards only" do
+    freeze_time do
+      entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+      entropies("37s_account").update!(auto_postpone_period: 30.days)
+      entropies("initech_account").update!(auto_postpone_period: 7.days)
+      entropies(:miltons_wish_list_board).destroy
+
+      boundary_card = cards(:logo)
+      boundary_card.update!(last_active_at: Time.current - 90.days)
+
+      board_override_card = cards(:shipping)
+      board_override_card.update!(last_active_at: Time.current - 45.days)
+
+      account_boundary_card = cards(:radio)
+      account_boundary_card.update!(last_active_at: Time.current - 7.days)
+
+      recent_account_card = cards(:paycheck)
+      recent_account_card.update!(last_active_at: Time.current - 7.days + 1.second)
+
+      closed_card = cards(:text)
+      closed_card.close
+      closed_card.update!(last_active_at: Time.current - 120.days)
+
+      postponed_card = cards(:layout)
+      postponed_card.postpone
+      postponed_card.update!(last_active_at: Time.current - 120.days)
+
+      drafted_card = cards(:unfinished_thoughts)
+      drafted_card.update!(last_active_at: Time.current - 120.days)
+
+      due_cards = Card.due_to_be_postponed
+      assert_includes due_cards, boundary_card
+      assert_includes due_cards, account_boundary_card
+      assert_not_includes due_cards, board_override_card
+      assert_not_includes due_cards, recent_account_card
+      assert_not_includes due_cards, closed_card
+      assert_not_includes due_cards, postponed_card
+      assert_not_includes due_cards, drafted_card
+
+      board_system_user = boundary_card.account.system_user
+      account_system_user = account_boundary_card.account.system_user
+      postponed_events_count = postponed_card.events.count
+
+      result = Card.auto_postpone_all_due
+
+      assert_kind_of ActiveRecord::Relation, result
+      assert boundary_card.reload.postponed?
+      assert_equal board_system_user, boundary_card.postponed_by
+      assert account_boundary_card.reload.postponed?
+      assert_equal account_system_user, account_boundary_card.postponed_by
+      assert_not board_override_card.reload.postponed?
+      assert_not recent_account_card.reload.postponed?
+      assert closed_card.reload.closed?
+      assert_equal users(:david), postponed_card.reload.postponed_by
+      assert_equal postponed_events_count, postponed_card.events.count
+      assert_not drafted_card.reload.postponed?
+    end
+  end
+
+  test "auto postpone processes due cards across find_each batches" do
