+      due_cards = due_to_be_postponed
+      now = Time.current
+      system_users_by_account_id = User.where(role: :system).index_by(&:account_id)
+
+      board_entropy_periods = Entropy.where(container_type: "Board").distinct.pluck(:auto_postpone_period)
+      board_entropy_periods.each do |period|
