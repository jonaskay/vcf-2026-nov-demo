@@ -0,0 +1,30 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.squish
+
+    if @query.present?
+      cards = Current.user.accessible_cards.published
+        .matching_search(@query)
+        .reverse_chronologically
+        .preload(:board, :rich_text_description)
+
+      set_page_and_extract_portion_from cards
+      @matching_comments_by_card = matching_comments_for(@page.records)
+    end
+  end
+
+  private
+    def matching_comments_for(cards)
+      Comment
+        .joins(:rich_text_body)
+        .where(card_id: cards.map(&:id))
+        .where("LOWER(action_text_rich_texts.body) LIKE LOWER(?) ESCAPE '!'", search_pattern)
+        .order(created_at: :desc, id: :desc)
+        .preload(:creator, :rich_text_body)
+        .group_by(&:card_id)
+    end
+
+    def search_pattern
+      "%#{Card.sanitize_sql_like(@query, "!")}%"
+    end
+end
