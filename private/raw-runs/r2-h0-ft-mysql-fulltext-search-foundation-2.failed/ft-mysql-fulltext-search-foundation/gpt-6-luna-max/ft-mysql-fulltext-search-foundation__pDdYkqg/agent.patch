diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b47c3ab
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "search page is available" do
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "form[action='#{search_path}'] input[name='q'][value='needle']"
+  end
+
+  test "finds cards by title, description, and comment body and highlights matches" do
+    title_match = create_card(title: "Needle in the title")
+    description_match = create_card(title: "Description match", description: "The needle is in this description.")
+    comment_match = create_card(title: "Comment match")
+    comment_match.comments.create!(creator: users(:kevin), body: "A comment containing the needle.")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_equal [ title_match, description_match, comment_match ].sort_by(&:id),
+      assigns_cards.sort_by(&:id)
+    assert_select ".search-result h2 mark", text: "Needle"
+    assert_select ".search-result__description mark", text: "needle"
+    assert_select ".search-result__comment mark", text: "needle"
+  end
+
+  test "returns newest matching cards first" do
+    older = create_card(title: "newestterm older", created_at: 2.days.ago)
+    newer = create_card(title: "newestterm newer", created_at: 1.day.ago)
+
+    get search_path, params: { q: "newestterm" }
+
+    assert_response :success
+    assert_equal [ newer.title, older.title ], response.body.scan(/<h2 class="txt-medium margin-none">\s*<a.*?>(.*?)<\/a>/m).flatten.map { |html| strip_tags(html).strip }
+  end
+
+  test "does not return draft cards or comments on draft cards" do
+    draft = create_card(title: "draftneedle title", description: "draftneedle description", status: :drafted)
+    card_with_comment = create_card(title: "Published before draft")
+    card_with_comment.comments.create!(creator: users(:kevin), body: "draftneedle comment")
+    card_with_comment.update!(status: :drafted)
+
+    get search_path, params: { q: "draftneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_no_match "draftneedle", response.body
+    assert draft.drafted?
+  end
+
+  test "does not return cards on boards the current user can no longer access" do
+    board = boards(:private)
+    card = create_card(board: board, title: "accessneedle")
+    board.accesses.revoke_from(users(:kevin))
+
+    get search_path, params: { q: "accessneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_no_match card.title, response.body
+  end
+
+  test "treats wildcard characters in the query literally" do
+    exact_match = create_card(title: "100%_literal")
+    create_card(title: "100XXliteral")
+
+    get search_path, params: { q: "100%_literal" }
+
+    assert_response :success
+    assert_select ".search-result h2", text: exact_match.title
+    assert_select ".search-result h2", count: 1
+  end
+
+  private
+    def create_card(board: boards(:writebook), title:, description: nil, status: :published, created_at: Time.current)
+      board.cards.create!(
+        creator: users(:kevin),
+        title: title,
+        description: description,
+        status: status,
+        created_at: created_at,
+        last_active_at: created_at
+      )
+    end
+
+    def assigns_cards
+      response.body.scan(/href="[^\"]*\/cards\/(\d+)"/).flatten.map { |number| Card.find_by!(number: number.to_i) }
+    end
+end
