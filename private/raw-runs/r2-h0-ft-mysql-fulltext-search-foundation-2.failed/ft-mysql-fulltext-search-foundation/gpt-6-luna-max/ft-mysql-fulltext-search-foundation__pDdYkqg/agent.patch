diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..7851311
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,56 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search cards</h1>
+<% end %>
+
+<section class="search panel panel--wide center margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap-half" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards, descriptions, and comments…", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="search-results panel panel--wide center margin-block-start" aria-label="Search results">
+    <% if @page.records.any? %>
+      <div class="flex flex-column gap">
+        <% @page.records.each do |card| %>
+          <article class="search-result" id="<%= dom_id(card, :search_result) %>">
+            <h2 class="txt-medium margin-none">
+              <%= link_to card_path(card), class: "btn btn--plain" do %>
+                <%= highlight(card.title, @query) %>
+              <% end %>
+            </h2>
+
+            <p class="txt-x-small translucent margin-block-half">
+              In <%= link_to card.board.name, board_path(card.board) %>
+            </p>
+
+            <% if description_excerpt = search_excerpt(card.description, @query) %>
+              <p class="search-result__description txt-small margin-block-half"><%= description_excerpt %></p>
+            <% end %>
+
+            <% if matching_comments = @matching_comments_by_card[card.id] %>
+              <ul class="search-result__comments flex flex-column gap-half unpad margin-block-half">
+                <% matching_comments.each do |comment| %>
+                  <li class="search-result__comment list-style-none txt-small">
+                    <%= link_to card_path(card, anchor: dom_id(comment)), class: "btn btn--plain" do %>
+                      <strong><%= comment.creator.name %>:</strong>
+                      <%= search_excerpt(comment.body, @query) %>
+                    <% end %>
+                  </li>
+                <% end %>
+              </ul>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+
+      <%= link_to_next_page :search_results, @page %>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”</p>
+    <% end %>
+  </section>
+<% end %>
