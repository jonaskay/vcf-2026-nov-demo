+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "new settings default to off" do
+    assert_equal "never", users(:david).settings.bundle_email_frequency
+  end
+
+  test "bundle email frequency only accepts the four supported choices" do
+    settings = users(:kevin).settings
+
+    %w[never every_few_hours daily weekly].each do |frequency|
+      assert settings.update(bundle_email_frequency: frequency), "#{frequency} should be accepted"
+      assert_equal frequency, settings.reload.bundle_email_frequency
+    end
+
+    assert_not settings.update(bundle_email_frequency: "hourly")
+    assert_equal "weekly", settings.reload.bundle_email_frequency
+  end
+
+  test "bundle email frequency belongs to each person's settings" do
+    kevin_settings = users(:kevin).settings
+    david_settings = users(:david).settings
+
+    kevin_settings.update!(bundle_email_frequency: "daily")
+    david_settings.update!(bundle_email_frequency: "weekly")
+
+    assert_equal "daily", kevin_settings.reload.bundle_email_frequency
+    assert_equal "weekly", david_settings.reload.bundle_email_frequency
+  end
+end
