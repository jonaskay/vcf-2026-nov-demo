+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_memberships, class_name: "Notification::BundleMembership", dependent: :delete_all, inverse_of: :notification
+    has_many :bundles, through: :bundle_memberships, source: :bundle
+
+    after_save_commit :add_to_email_bundle, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def bundle
+    bundles.order(:starts_at).last
+  end
+
+  private
+    def add_to_email_bundle
+      Notification::Bundle.add_notification(self)
+    end
+end
