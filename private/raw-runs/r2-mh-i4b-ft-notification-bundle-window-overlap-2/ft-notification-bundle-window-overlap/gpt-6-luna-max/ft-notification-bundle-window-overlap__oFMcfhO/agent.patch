diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..4b1d250
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,41 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_many :notifications, class_name: "Notification", foreign_key: :notification_bundle_id, dependent: :nullify
+
+  after_create_commit :deliver_later
+
+  def add_notification(notification)
+    notification.update_column(:notification_bundle_id, id) unless notification.notification_bundle_id == id
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    if settings = user.settings
+      settings.with_lock do
+        reload
+
+        if sent_at.nil?
+          if Time.current < ends_at
+            deliver_later
+          else
+            if settings.bundle_email_frequency != "never" && deliverable?
+              NotificationMailer.digest(self).deliver_now
+            end
+
+            update!(sent_at: Time.current)
+          end
+        end
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active? && user.identity&.email_address.present? && notifications.exists?
+    end
+end
