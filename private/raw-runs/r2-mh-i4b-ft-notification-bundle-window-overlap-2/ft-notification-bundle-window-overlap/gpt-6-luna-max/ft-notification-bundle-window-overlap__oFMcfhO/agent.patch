@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Notifications::SettingsFrequencyControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    @other_user = users(:david)
+    sign_in_as @user
+  end
+
+  test "notification settings show the supported bundle email frequencies" do
+    get notifications_settings_path
+
+    assert_response :success
+    { "never" => "Off", "every_few_hours" => "Every four hours", "daily" => "Daily", "weekly" => "Weekly" }.each do |frequency, label|
+      assert_select "select[name='user_settings[bundle_email_frequency]'] option[value=?]", frequency, text: label
+    end
+  end
+
+  test "a person can update their own bundle email frequency" do
+    @other_user.settings.update!(bundle_email_frequency: "weekly")
+
+    patch notifications_settings_path, params: {
+      user_settings: { bundle_email_frequency: "daily" }
+    }
+
+    assert_response :redirect
+    assert_equal "daily", @user.settings.reload.bundle_email_frequency
+    assert_equal "weekly", @other_user.settings.reload.bundle_email_frequency
+  end
+end
diff --git a/test/models/notification/bundle_email_test.rb b/test/models/notification/bundle_email_test.rb
new file mode 100644
index 0000000..934ea40
--- /dev/null
+++ b/test/models/notification/bundle_email_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class Notification::BundleEmailTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "first notification starts a four-hour window and later notifications share its email" do
+    started_at = Time.zone.local(2026, 1, 5, 9)
+
+    travel_to(started_at) do
+      @first_notification = create_notification(:logo_assignment_kevin, created_at: started_at - 1.day)
+    end
+
+    travel_to(started_at + 3.hours) do
+      @second_notification = create_notification(:layout_commented_kevin, created_at: started_at)
+    end
+
+    travel_to(started_at + 4.hours - 1.minute) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 0 do
+        perform_enqueued_jobs
+      end
+    end
+
+    travel_to(started_at + 4.hours) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    travel_to(started_at + 4.hours + 1.minute) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 0 do
+        perform_enqueued_jobs
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    [ @first_notification.card.title, @second_notification.card.title ].each do |title|
+      assert_includes email.body.encoded, title
+    end
+  end
+
+  test "daily and weekly windows send at their configured thresholds" do
+    { "daily" => 24.hours, "weekly" => 168.hours }.each_with_index do |(frequency, duration), index|
+      started_at = Time.zone.local(2026, 1, 5, 9) + index * 10.days
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      travel_to(started_at) do
+        create_notification(:logo_assignment_kevin)
+      end
+
+      travel_to(started_at + duration - 1.minute) do
+        assert_difference -> { ActionMailer::Base.deliveries.size }, 0 do
+          perform_enqueued_jobs
+        end
+      end
+
+      travel_to(started_at + duration) do
+        assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+          perform_enqueued_jobs
+        end
+      end
+
+      travel_to(started_at + duration + 1.minute) do
+        assert_difference -> { ActionMailer::Base.deliveries.size }, 0 do
+          perform_enqueued_jobs
+        end
+      end
+    end
+  end
+
+  test "late arrivals join the open window and the next window starts after delivery" do
+    started_at = Time.zone.local(2026, 2, 2, 9)
+
+    travel_to(started_at) do
+      @first_notification = create_notification(:logo_assignment_kevin)
+    end
+
+    # The first window is due, but its delivery job has not run yet.
+    travel_to(started_at + 4.hours + 1.minute) do
+      @second_notification = create_notification(:layout_commented_kevin, created_at: started_at)
+
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    [ @first_notification.card.title, @second_notification.card.title ].each do |title|
+      assert_includes email.body.encoded, title
+    end
+
+    next_window_started_at = started_at + 4.hours + 1.minute
+    travel_to(next_window_started_at) do
+      create_notification(:logo_assignment_kevin)
+    end
+
+    travel_to(next_window_started_at + 4.hours - 1.minute) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 0 do
+        perform_enqueued_jobs
+      end
+    end
+
+    travel_to(next_window_started_at + 4.hours) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "notifications created by the notifier are included in the digest" do
+    notifications(:layout_commented_kevin).destroy!
+    started_at = Time.zone.local(2026, 5, 4, 9)
+
+    travel_to(started_at) do
+      Notifier.for(events(:layout_commented)).notify
+    end
+
+    travel_to(started_at + 4.hours) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_includes ActionMailer::Base.deliveries.last.body.encoded, cards(:layout).title
+  end
+
+  test "each person's frequency is independent" do
+    other_user = users(:david)
+    other_user.settings.update!(bundle_email_frequency: "daily")
+    started_at = Time.zone.local(2026, 3, 2, 9)
+
+    travel_to(started_at) do
+      create_notification(:logo_assignment_kevin, user: @user)
+      create_notification(:logo_assignment_kevin, user: other_user)
+    end
+
+    travel_to(started_at + 4.hours) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_equal [ @user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+
+    travel_to(started_at + 24.hours) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_equal [ other_user.identity.email_address ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "never does not open or send a digest window" do
+    @user.settings.update!(bundle_email_frequency: "never")
+    started_at = Time.zone.local(2026, 4, 6, 9)
+
+    travel_to(started_at) do
+      create_notification(:logo_assignment_kevin)
+    end
+
+    travel_to(started_at + 168.hours) do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 0 do
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  private
+    def create_notification(fixture_name, user: @user, created_at: nil)
+      source = notifications(fixture_name).source
+      user.notifications.where(card: source.card).destroy_all
+
+      Notification.create!(user: user, source: source, creator: users(:david), created_at: created_at || Time.current)
+    end
+end
