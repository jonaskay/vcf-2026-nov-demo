+require "test_helper"
+
+class User::SettingsBundleEmailTest < ActiveSupport::TestCase
+  test "bundle email frequency supports only the available choices" do
+    settings = users(:kevin).settings
+
+    assert_equal "never", settings.bundle_email_frequency
+
+    %w[never every_few_hours daily weekly].each do |frequency|
+      settings.bundle_email_frequency = frequency
+      assert settings.valid?, "Expected #{frequency.inspect} to be valid"
+    end
+
+    settings.bundle_email_frequency = "hourly"
+    assert_not settings.valid?
+  end
+end
