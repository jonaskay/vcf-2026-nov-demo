new file mode 100644
index 0000000..140240e
--- /dev/null
+++ b/app/models/user/settings/bundle_email.rb
@@ -0,0 +1,50 @@
+module User::Settings::BundleEmail
+  extend ActiveSupport::Concern
+
+  FREQUENCY_OPTIONS = [
+    [ "Off", "never" ],
+    [ "Every four hours", "every_few_hours" ],
+    [ "Daily", "daily" ],
+    [ "Weekly", "weekly" ]
+  ].freeze
+
+  FREQUENCY_DURATIONS = {
+    "never" => nil,
+    "every_few_hours" => 4.hours,
+    "daily" => 24.hours,
+    "weekly" => 168.hours
+  }.freeze
+
+  included do
+    has_many :notification_bundles, class_name: "Notification::Bundle", foreign_key: :user_id, primary_key: :user_id, dependent: :destroy
+
+    validates :bundle_email_frequency, inclusion: { in: FREQUENCY_DURATIONS.keys }
+  end
+
+  def bundle_email_frequency_options
+    FREQUENCY_OPTIONS
+  end
+
+  def bundle_email_notification(notification)
+    with_lock do
+      landed_at = Time.current
+
+      if duration = FREQUENCY_DURATIONS[bundle_email_frequency]
+        bundle = notification_bundles.where(sent_at: nil).order(:started_at).last
+
+        unless bundle
+          previous_bundle = notification_bundles.order(:started_at).last
+          started_at = [ landed_at, previous_bundle&.ends_at ].compact.max
+          bundle = notification_bundles.create!(
+            account: account,
+            user: user,
+            started_at: started_at,
+            ends_at: started_at + duration
+          )
+        end
+
+        bundle.add_notification(notification)
+      end
+    end
+  end
+end
