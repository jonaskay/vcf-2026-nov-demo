diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..f66de62
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    boards(:writebook).update! auto_postpone_period: 3.days
+  end
+
+  test "three comments from two people within a third of the board period create a burst" do
+    card = create_card
+    now = Time.current
+
+    add_comment(card, users(:david), created_at: now - 24.hours)
+    add_comment(card, users(:kevin), created_at: now - 12.hours)
+    add_comment(card, users(:david), created_at: now)
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "comments from one person do not create a burst" do
+    card = create_card
+    now = Time.current
+
+    3.times { |index| add_comment(card, users(:david), created_at: now - index.hours) }
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    card = create_card
+    now = Time.current
+
+    add_comment(card, users(:david), created_at: now - 2.hours)
+    add_comment(card, users(:system), created_at: now - 1.hour)
+    add_comment(card, users(:kevin), created_at: now)
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "fewer than three comments do not create a burst" do
+    card = create_card
+    now = Time.current
+
+    add_comment(card, users(:david), created_at: now - 1.hour)
+    add_comment(card, users(:kevin), created_at: now)
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments outside the board period fraction do not create a burst" do
+    card = create_card
+    now = Time.current
+
+    add_comment(card, users(:david), created_at: now - 24.hours - 1.second)
+    add_comment(card, users(:kevin), created_at: now - 12.hours)
+    add_comment(card, users(:david), created_at: now)
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "assigning someone creates a burst" do
+    card = create_card
+
+    card.toggle_assignment(users(:kevin))
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "creating an assignment directly creates a burst" do
+    card = create_card
+
+    card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "assigning a card resets the stalled period" do
+    card = create_card
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+
+    assert_not card.reload.stalled?
+  end
+
+  test "reopening a card creates a burst" do
+    card = cards(:shipping)
+
+    card.reopen(user: users(:kevin))
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "reopening an unpublished card creates a burst" do
+    card = boards(:writebook).cards.create!(creator: users(:david), status: :drafted, title: "Draft")
+    card.close(user: users(:david))
+
+    card.reopen(user: users(:david))
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "a card is stalled after two weeks without activity since a burst" do
+    card = create_card
+    now = Time.current.change(usec: 0)
+    card.update_columns burst_at: now - 2.weeks, last_active_at: now - 2.weeks
+
+    travel_to now - 1.second do
+      assert_not card.stalled?
+    end
+
+    travel_to now do
+      assert card.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "activity resets the stalled period" do
+    card = create_card
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    card.comments.create! creator: users(:kevin), body: "An update"
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "activity after publishing resets the stalled period" do
+    card = boards(:writebook).cards.create!(creator: users(:david), status: :published, title: "Burst test", last_active_at: 3.weeks.ago)
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    card.close(user: users(:david))
+
+    assert_not card.reload.stalled?
+  end
+
+  test "touching a card resets the stalled period" do
+    card = create_card
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    card.touch
+
+    assert_not card.reload.stalled?
+  end
+
+  test "editing a card resets the stalled period" do
+    card = create_card
+    card.update_columns burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    card.update! due_on: Date.tomorrow
+
+    assert_not card.reload.stalled?
+  end
+
+  private
+    def create_card
+      boards(:writebook).cards.create!(creator: users(:david), status: :published, title: "Burst test")
+    end
+
+    def add_comment(card, creator, created_at:)
+      card.comments.create!(creator: creator, created_at: created_at, body: "A comment")
+    end
+end
