diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..2e520c2
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,28 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?(as_of: Time.current)
+    burst_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def register_comment_burst(comment)
+    return if burst_at.present?
+
+    window = (comment.created_at - board.auto_postpone_period / 3.0)..comment.created_at
+    comment_counts = comments.by_user.where(created_at: window).group(:creator_id).count
+
+    if comment_counts.values.sum >= 3 && comment_counts.size >= 2
+      register_burst
+    end
+  end
+
+  def register_burst
+    update!(burst_at: Time.current) if burst_at.nil?
+  end
+end
