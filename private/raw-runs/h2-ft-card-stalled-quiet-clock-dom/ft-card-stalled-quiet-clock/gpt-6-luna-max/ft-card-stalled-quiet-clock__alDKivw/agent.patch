diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..f87ab37
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,38 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  MINIMUM_BURST_COMMENTS = 3
+  MINIMUM_BURST_PEOPLE = 2
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      where.not(burst_at: nil).where(last_active_at: ..(Time.current - STALLED_AFTER))
+    }
+  end
+
+  def stalled?(as_of: Time.current)
+    burst_at.present? && last_active_at.present? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  def register_comment_burst(comment)
+    return if burst_at.present?
+
+    burst_window = auto_postpone_period.seconds / 3
+    recent_comments = comments.by_user.where(created_at: (comment.created_at - burst_window)..comment.created_at)
+    comment_counts_by_person = recent_comments.group(:creator_id).count
+
+    if comment_counts_by_person.values.sum >= MINIMUM_BURST_COMMENTS && comment_counts_by_person.size >= MINIMUM_BURST_PEOPLE
+      record_burst(at: comment.created_at)
+    end
+  end
+
+  def record_burst(at: Time.current)
+    update_column(:burst_at, at) if burst_at.nil?
+  end
+
+  def cache_version
+    version = super
+    version && "#{version}-#{stalled?}"
+  end
+end
