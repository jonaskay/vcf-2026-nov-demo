diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..44dabb8
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "three comments from two people within a third of the board period create a burst" do
+    travel_to Time.utc(2026, 1, 1, 12)
+    burst_window = @card.auto_postpone_period.seconds / 3
+    earliest_comment_at = Time.current - burst_window
+
+    @card.comments.create! creator: users(:david), body: "First comment", created_at: earliest_comment_at
+    @card.comments.create! creator: users(:david), body: "Second comment", created_at: earliest_comment_at
+
+    assert_nil @card.reload.burst_at
+
+    @card.comments.create! creator: users(:kevin), body: "Third comment", created_at: Time.current
+
+    assert @card.reload.burst_at
+  end
+
+  test "a comment burst requires at least two people and excludes system comments" do
+    @card.comments.create! creator: users(:david), body: "First comment"
+    @card.comments.create! creator: users(:david), body: "Second comment"
+    @card.comments.create! creator: users(:system), body: "System comment"
+
+    assert_nil @card.reload.burst_at
+
+    @card.comments.create! creator: users(:david), body: "Another comment"
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "comments outside one third of the board period do not create a burst" do
+    burst_window = @card.auto_postpone_period.seconds / 3
+
+    @card.comments.create! creator: users(:david), body: "Old comment", created_at: Time.current - burst_window - 1.second
+    @card.comments.create! creator: users(:kevin), body: "Recent comment", created_at: Time.current - burst_window
+    @card.comments.create! creator: users(:david), body: "Latest comment", created_at: Time.current
+
+    assert_nil @card.reload.burst_at
+  end
+
+  test "assigning someone or reopening a card creates a burst" do
+    @card.toggle_assignment(users(:jz))
+
+    assert @card.reload.burst_at
+
+    card = cards(:shipping)
+    card.reopen
+
+    assert card.reload.burst_at
+  end
+
+  test "closing or unassigning does not create a burst" do
+    card = cards(:logo)
+
+    card.toggle_assignment(users(:jz))
+    card.close
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "a burst is stalled at two weeks of inactivity and the scope matches the predicate" do
+    travel_to Time.utc(2026, 1, 1, 12)
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago + 1.second
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.update_column :last_active_at, 2.weeks.ago
+
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "cards without a burst or activity are not stalled" do
+    card = @card.dup
+    card.burst_at = Time.current
+    card.last_active_at = nil
+
+    assert_not card.stalled?
+
+    @card.update_columns burst_at: nil, last_active_at: 3.weeks.ago
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity resets the stalled timer without forgetting the burst" do
+    @card.update_columns burst_at: 4.weeks.ago, last_active_at: 3.weeks.ago
+    assert @card.reload.stalled?
+
+    @card.comments.create! creator: users(:kevin), body: "Back in the conversation"
+
+    assert_not @card.reload.stalled?
+    assert @card.burst_at
+  end
+
+  test "cache version changes when a card becomes stalled without a write" do
+    travel_to Time.utc(2026, 1, 1, 12)
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago + 1.second
+    active_cache_version = @card.cache_version
+
+    travel 1.second
+
+    assert @card.stalled?
+    assert_not_equal active_cache_version, @card.cache_version
+  end
+end
