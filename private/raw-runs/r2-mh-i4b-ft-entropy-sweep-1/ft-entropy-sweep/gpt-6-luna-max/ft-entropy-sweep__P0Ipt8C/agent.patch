     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      board_settings = Entropy.where(container_type: "Board")
+      account_settings = Entropy.where(container_type: "Account")
+      overridden_board_ids = board_settings.select(:container_id)
+      system_users = {}
+
+      board_settings.distinct.pluck(:auto_postpone_period).each do |period|
+        settings = board_settings.where(auto_postpone_period: period)
+        due_cards = active
+          .where(account_id: settings.select(:account_id))
+          .where(board_id: settings.select(:container_id))
+          .where("cards.last_active_at <= ?", now - period.seconds)
+
+        postpone_due_cards(due_cards, system_users)
+      end
+
+      account_settings.distinct.pluck(:auto_postpone_period).each do |period|
+        settings = account_settings.where(auto_postpone_period: period)
+        due_cards = active
+          .where(account_id: settings.select(:container_id))
+          .where.not(board_id: overridden_board_ids)
+          .where("cards.last_active_at <= ?", now - period.seconds)
+
+        postpone_due_cards(due_cards, system_users)
       end
+
+      nil
     end
+
+    private
+      def postpone_due_cards(due_cards, system_users)
+        due_cards.preload(:account, :board).find_in_batches do |cards|
+          account_ids = cards.map(&:account_id).uniq.reject { |account_id| system_users.key?(account_id) }
+
+          unless account_ids.empty?
+            system_users.merge!(User.where(role: :system, account_id: account_ids).index_by(&:account_id))
+          end
+
+          cards.each do |card|
+            system_user = system_users.fetch(card.account_id) { card.account.system_user }
+            card.auto_postpone(user: system_user)
+          end
+        end
+      end
   end
 
   def entropy
