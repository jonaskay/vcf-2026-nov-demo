diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..7a38fb3
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "a comment burst includes the one-third auto-close window and needs two people" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      window = card.board.auto_postpone_period / 3
+
+      add_comment(card, users(:david), created_at: Time.current - window)
+      add_comment(card, users(:david), created_at: Time.current - window / 2)
+      add_comment(card, users(:kevin), created_at: Time.current)
+
+      assert_predicate card, :had_burst?
+      assert_predicate card, :burst?
+      assert_includes Card.with_burst, card
+    end
+  end
+
+  test "comments outside the one-third auto-close window do not make a burst" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      window = card.board.auto_postpone_period / 3
+
+      add_comment(card, users(:david), created_at: Time.current - window - 1.second)
+      add_comment(card, users(:kevin), created_at: Time.current - window / 2)
+      add_comment(card, users(:david), created_at: Time.current)
+
+      assert_not_predicate card, :had_burst?
+      assert_not_includes Card.with_burst, card
+    end
+  end
+
+  test "two comments or three comments by one person do not make a burst" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      window = boards(:writebook).auto_postpone_period / 3
+      two_comments = new_card
+      add_comment(two_comments, users(:david), created_at: Time.current - window)
+      add_comment(two_comments, users(:kevin), created_at: Time.current)
+
+      one_person = new_card
+      add_comment(one_person, users(:david), created_at: Time.current - window)
+      add_comment(one_person, users(:david), created_at: Time.current - window / 2)
+      add_comment(one_person, users(:david), created_at: Time.current)
+
+      assert_not_predicate two_comments, :had_burst?
+      assert_not_predicate one_person, :had_burst?
+    end
+  end
+
+  test "system comments do not count as people in a comment burst" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      window = card.board.auto_postpone_period / 3
+
+      add_comment(card, users(:david), created_at: Time.current - window)
+      add_comment(card, users(:kevin), created_at: Time.current - window / 2)
+      add_comment(card, users(:system), created_at: Time.current)
+
+      assert_not_predicate card, :had_burst?
+    end
+  end
+
+  test "comment bursts use the account auto-close period when the board has no override" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      board = boards(:writebook)
+      board.entropy.destroy!
+      board.account.entropy.update! auto_postpone_period: 30.days
+      card = new_card(board: board)
+      window = 10.days
+
+      add_comment(card, users(:david), created_at: Time.current - window)
+      add_comment(card, users(:kevin), created_at: Time.current - window / 2)
+      add_comment(card, users(:david), created_at: Time.current)
+
+      assert_predicate card, :had_burst?
+    end
+  end
+
+  test "assigning directly creates a burst and resets inactivity" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      card.update_column(:last_active_at, 15.days.ago)
+
+      card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+
+      assert_predicate card, :had_burst?
+      assert_equal Time.current, card.reload.last_active_at
+      assert_not_predicate card, :stalled?
+    end
+  end
+
+  test "assignment and reopening each make a burst" do
+    card = new_card
+
+    card.toggle_assignment(users(:kevin))
+    assert_predicate card, :had_burst?
+
+    card.toggle_assignment(users(:kevin))
+    assert_predicate card, :had_burst?, "removing the assignee does not erase the assignment burst"
+
+    reopened_card = new_card
+    reopened_card.close
+    assert_not_predicate reopened_card, :had_burst?
+
+    reopened_card.reopen
+    assert_predicate reopened_card, :had_burst?
+    assert_includes Card.with_burst, reopened_card
+  end
+
+  test "stalled starts at exactly two weeks of inactivity and requires a burst" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      burst_card = new_card
+      burst_card.toggle_assignment(users(:kevin))
+      burst_card.update_column(:last_active_at, 2.weeks.ago + 1.second)
+
+      assert_not_predicate burst_card, :stalled?
+      assert_not_includes Card.stalled, burst_card
+
+      burst_card.update_column(:last_active_at, 2.weeks.ago)
+
+      assert_predicate burst_card, :stalled?
+      assert_includes Card.stalled, burst_card
+
+      quiet_card = new_card
+      quiet_card.update_column(:last_active_at, 4.weeks.ago)
+      assert_not_predicate quiet_card, :stalled?
+      assert_not_includes Card.stalled, quiet_card
+    end
+  end
+
+  test "step activity resets the stalled period" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      card.toggle_assignment(users(:kevin))
+      card.update_column(:last_active_at, 15.days.ago)
+
+      assert_predicate card, :stalled?
+
+      travel 1.hour
+      card.steps.create! content: "A newly added step"
+
+      assert_equal Time.current, card.reload.last_active_at
+      assert_not_predicate card, :stalled?
+    end
+  end
+
+  test "a new comment resets the stalled period" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      card.toggle_assignment(users(:kevin))
+      card.update_column(:last_active_at, 15.days.ago)
+
+      assert_predicate card, :stalled?
+
+      travel 1.hour
+      add_comment(card, users(:kevin), created_at: Time.current)
+
+      assert_equal Time.current, card.reload.last_active_at
+      assert_not_predicate card, :stalled?
+    end
+  end
+
+  test "tag activity resets the stalled period" do
+    travel_to Time.utc(2026, 2, 1, 12) do
+      card = new_card
+      card.toggle_assignment(users(:kevin))
+      card.update_column(:last_active_at, 15.days.ago)
+
+      assert_predicate card, :stalled?
+
+      travel 1.hour
+      card.toggle_tag_with("urgent")
+
+      assert_equal Time.current, card.reload.last_active_at
+      assert_not_predicate card, :stalled?
+    end
+  end
+
+  private
+    def new_card(board: boards(:writebook))
+      board.cards.create!(creator: users(:david), title: "A card with activity", status: :published)
+    end
+
+    def add_comment(card, creator, created_at:)
+      card.comments.create!(creator: creator, created_at: created_at, body: "A comment")
+    end
+end
