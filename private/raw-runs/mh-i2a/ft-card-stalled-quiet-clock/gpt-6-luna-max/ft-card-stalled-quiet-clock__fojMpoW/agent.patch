diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..c76d67f
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,73 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :with_burst, -> do
+      auto_close_period = "COALESCE(burst_board_entropy.auto_postpone_period, burst_account_entropy.auto_postpone_period)"
+      burst_window_start = connection.date_subtract("burst_window_comment.created_at", "(#{auto_close_period}) / 3")
+
+      where(<<~SQL.squish)
+        (
+          EXISTS (
+            SELECT 1
+            FROM events burst_events
+            WHERE burst_events.eventable_type = 'Card'
+              AND burst_events.eventable_id = cards.id
+              AND burst_events.action IN ('card_assigned', 'card_reopened')
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM assignments burst_assignments
+            WHERE burst_assignments.card_id = cards.id
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments burst_comment_start
+            INNER JOIN users burst_start_person
+              ON burst_start_person.id = burst_comment_start.creator_id
+              AND burst_start_person.role <> 'system'
+            INNER JOIN comments burst_window_comment
+              ON burst_window_comment.card_id = burst_comment_start.card_id
+              AND burst_comment_start.created_at <= burst_window_comment.created_at
+              AND burst_comment_start.created_at >= #{burst_window_start}
+            INNER JOIN users burst_window_person
+              ON burst_window_person.id = burst_window_comment.creator_id
+              AND burst_window_person.role <> 'system'
+            INNER JOIN boards burst_board ON burst_board.id = cards.board_id
+            LEFT OUTER JOIN entropies burst_board_entropy
+              ON burst_board_entropy.container_type = 'Board'
+              AND burst_board_entropy.container_id = burst_board.id
+            LEFT OUTER JOIN entropies burst_account_entropy
+              ON burst_account_entropy.container_type = 'Account'
+              AND burst_account_entropy.container_id = burst_board.account_id
+            WHERE burst_comment_start.card_id = cards.id
+            GROUP BY burst_comment_start.id
+            HAVING COUNT(DISTINCT burst_window_comment.id) >= 3
+              AND COUNT(DISTINCT burst_window_person.id) >= 2
+          )
+        )
+      SQL
+    end
+
+    scope :stalled, -> { with_burst.where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def had_burst?
+    if persisted?
+      self.class.with_burst.where(id: id).exists?
+    else
+      false
+    end
+  end
+  alias_method :burst?, :had_burst?
+
+  def stalled?
+    if persisted?
+      self.class.stalled.where(id: id).exists?
+    else
+      false
+    end
+  end
+end
