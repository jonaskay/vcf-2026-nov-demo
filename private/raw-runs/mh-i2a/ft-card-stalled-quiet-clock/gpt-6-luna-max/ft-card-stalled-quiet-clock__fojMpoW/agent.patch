diff --git a/test/controllers/cards_stalled_controller_test.rb b/test/controllers/cards_stalled_controller_test.rb
new file mode 100644
index 0000000..11adf6f
--- /dev/null
+++ b/test/controllers/cards_stalled_controller_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class CardsStalledControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+    travel_to Time.utc(2026, 2, 1, 12)
+  end
+
+  test "the cards index can list stalled cards, including closed and postponed cards" do
+    open_card = stalled_card
+
+    closed_card = stalled_card
+    closed_card.close
+    make_stale(closed_card)
+
+    postponed_card = stalled_card
+    postponed_card.postpone
+    make_stale(postponed_card)
+
+    quiet_card = new_card
+    make_stale(quiet_card)
+
+    get cards_path(indexed_by: "stalled", format: :json)
+
+    assert_response :success
+    assert_equal [ open_card, closed_card, postponed_card ].map(&:number).sort,
+      @response.parsed_body.map { |card| card["number"] }.sort
+
+    get cards_path(indexed_by: "stalled")
+
+    assert_response :success
+    assert_select "li[data-combobox-value='stalled']"
+    assert_equal "Stalled", Filter.indexed_by_human_name("stalled")
+    assert_select ".card__stalled", text: "Stalled"
+    assert_select "article##{quiet_card.number}", count: 0
+  end
+
+  test "stalled is shown on card HTML and JSON" do
+    card = stalled_card
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    get card_path(card, format: :json)
+
+    assert_response :success
+    assert_equal true, @response.parsed_body["stalled"]
+  end
+
+  test "card edits reset the stalled period without changing burst history" do
+    card = stalled_card
+
+    put card_path(card, format: :json), params: { card: { description: "Updated description" } }
+
+    assert_response :success
+    assert_equal Time.current, card.reload.last_active_at
+    assert_not_predicate card, :stalled?
+    assert_predicate card, :had_burst?
+  end
+
+  test "stalled appears on public cards" do
+    board = boards(:writebook)
+    card = stalled_card
+    board.publish
+
+    get public_board_card_path(board.publication.key, card)
+
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+
+  test "stalled state is refreshed in cached card previews when only time changes" do
+    card = stalled_card
+    card.update_column(:last_active_at, 13.days.ago)
+
+    with_actionview_partial_caching do
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      travel 1.day
+
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "stalled appears in notification HTML and JSON" do
+    card = cards(:logo)
+    card.update_column(:last_active_at, 15.days.ago)
+
+    get notifications_path
+
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    get notifications_path(format: :json)
+
+    assert_response :success
+    notification = @response.parsed_body.find { |item| item["id"] == notifications(:logo_mentioned_david).id }
+    assert_equal true, notification.dig("card", "stalled")
+  end
+
+  private
+    def new_card
+      boards(:writebook).cards.create!(creator: users(:david), title: "A stalled card", status: :published)
+    end
+
+    def stalled_card
+      card = new_card
+      card.toggle_assignment(users(:kevin))
+      make_stale(card)
+      card
+    end
+
+    def make_stale(card)
+      card.update_column(:last_active_at, 15.days.ago)
+    end
+end
