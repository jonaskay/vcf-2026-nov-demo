diff --git a/app/helpers/local_time_helper.rb b/app/helpers/local_time_helper.rb
new file mode 100644
index 0000000..967aa96
--- /dev/null
+++ b/app/helpers/local_time_helper.rb
@@ -0,0 +1,16 @@
+module LocalTimeHelper
+  def local_time_tag(timestamp, format:)
+    raw_timestamp = if timestamp.respond_to?(:utc)
+      timestamp.utc.iso8601(3)
+    else
+      timestamp.iso8601
+    end
+
+    tag.time raw_timestamp,
+      datetime: raw_timestamp,
+      data: {
+        controller: "local-time",
+        local_time_format_value: format.to_s.dasherize
+      }
+  end
+end
