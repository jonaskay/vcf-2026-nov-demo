diff --git a/test/system/local_time_rendering_test.rb b/test/system/local_time_rendering_test.rb
new file mode 100644
index 0000000..b72087a
--- /dev/null
+++ b/test/system/local_time_rendering_test.rb
@@ -0,0 +1,127 @@
+require "application_system_test_case"
+
+class LocalTimeRenderingTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = @card.comments.create!(creator: users(:kevin), body: "A timestamped comment")
+  end
+
+  test "a comment from today displays its local clock time" do
+    set_browser_timezone("America/Los_Angeles")
+    timestamp = 2.hours.ago
+    @comment.update!(created_at: timestamp)
+
+    visit card_url(@card)
+
+    is_today = page.evaluate_script(<<~JS)
+      (() => {
+        const timestamp = new Date(#{timestamp.utc.iso8601(3).to_json})
+        const now = new Date()
+        return timestamp.getFullYear() === now.getFullYear() && timestamp.getMonth() === now.getMonth() && timestamp.getDate() === now.getDate()
+      })()
+    JS
+    expected = if is_today
+      page.evaluate_script("new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' }).format(new Date(#{timestamp.utc.iso8601(3).to_json}))")
+    else
+      "yesterday"
+    end
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: expected
+  end
+
+  test "a comment from the previous local date says yesterday" do
+    set_browser_timezone("America/Los_Angeles")
+    visit card_url(@card)
+    timestamp = browser_timestamp(-1, hour: 23, minute: 59)
+    @comment.update!(created_at: Time.iso8601(timestamp))
+
+    visit card_url(@card)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: "yesterday"
+  end
+
+  test "a comment five days ago uses an elapsed-day label" do
+    visit card_url(@card)
+    timestamp = browser_timestamp(-5, hour: 12)
+    @comment.update!(created_at: Time.iso8601(timestamp))
+
+    visit card_url(@card)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: "5 days ago"
+  end
+
+  test "a comment six days ago remains relative" do
+    visit card_url(@card)
+    timestamp = browser_timestamp(-6, hour: 12)
+    @comment.update!(created_at: Time.iso8601(timestamp))
+
+    visit card_url(@card)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: "6 days ago"
+  end
+
+  test "a comment seven days ago uses a local calendar date" do
+    visit card_url(@card)
+    timestamp = browser_timestamp(-7, hour: 12)
+    expected = page.evaluate_script("new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(new Date(#{timestamp.to_json}))")
+    @comment.update!(created_at: Time.iso8601(timestamp))
+
+    visit card_url(@card)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: expected
+  end
+
+  test "an auto-close date on the next local day says tomorrow" do
+    set_browser_timezone("America/Los_Angeles")
+    visit card_url(@card)
+    timestamp = browser_timestamp(1, hour: 0, minute: 30)
+    set_auto_close_at(timestamp)
+
+    visit card_url(@card)
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "tomorrow"
+  end
+
+test "an auto-close date later today says today" do
+  visit card_url(@card)
+  set_browser_timezone("America/Los_Angeles")
+  timestamp = browser_timestamp(0, hour: 23, minute: 59)
+  set_auto_close_at(timestamp)
+
+  visit card_url(@card)
+
+  assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "today"
+end
+
+  test "an auto-close date three local days away says in 3 days" do
+    visit card_url(@card)
+    timestamp = browser_timestamp(3, hour: 12)
+    set_auto_close_at(timestamp)
+
+    visit card_url(@card)
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "in 3 days"
+  end
+
+  private
+    def browser_timestamp(days_from_today, hour:, minute: 0)
+      page.evaluate_script(<<~JS)
+        (() => {
+          const date = new Date()
+          date.setDate(date.getDate() + #{days_from_today})
+          date.setHours(#{hour}, #{minute}, 0, 0)
+          return date.toISOString()
+        })()
+      JS
+    end
+
+def set_browser_timezone(timezone)
+  page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+end
+
+    def set_auto_close_at(timestamp)
+      auto_close_at = Time.iso8601(timestamp)
+      @card.update!(last_active_at: auto_close_at - @card.auto_postpone_period)
+    end
+end
