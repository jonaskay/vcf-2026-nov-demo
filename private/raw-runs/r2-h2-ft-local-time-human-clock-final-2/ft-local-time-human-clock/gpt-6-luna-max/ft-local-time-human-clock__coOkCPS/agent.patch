diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..b584b99
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  include BridgeHelper
+  include ERB::Util
+
+  test "client_time_tag emits the same UTC timestamp in every server timezone" do
+    timestamp = Time.utc(2024, 9, 12, 20, 42)
+
+    rendered = %w[UTC America/Los_Angeles].map do |timezone|
+      Time.use_zone(timezone) do
+        client_time_tag(timestamp.in_time_zone, format: "relative").to_s
+      end
+    end
+
+    assert_equal rendered.first, rendered.last
+    assert_includes rendered.first, 'datetime="2024-09-12T20:42:00Z"'
+    assert_includes rendered.first, 'data-time-format="relative"'
+    assert_includes rendered.first, ">2024-09-12T20:42:00Z</time>"
+  end
+
+  test "client_date_tag emits a calendar date, not a UTC timestamp" do
+    rendered = client_date_tag(Date.new(2024, 9, 12), format: "weekday-date").to_s
+
+    assert_includes rendered, 'datetime="2024-09-12"'
+    assert_includes rendered, 'data-time-format="weekday-date"'
+    assert_includes rendered, ">2024-09-12</time>"
+  end
+
+  test "bridge share descriptions carry raw timestamps for client formatting" do
+    card = cards(:logo)
+
+    descriptions = %w[UTC America/Los_Angeles].map do |timezone|
+      Time.use_zone(timezone) { bridge_share_card_description(card) }
+    end
+
+    assert_equal descriptions.first, descriptions.last
+    assert_includes descriptions.first, "{{time:#{card.created_at.utc.iso8601}}}"
+    assert_includes descriptions.first, "{{time:#{card.last_active_at.utc.iso8601}}}"
+  end
+end
diff --git a/test/system/time_display_test.rb b/test/system/time_display_test.rb
new file mode 100644
index 0000000..ec4ed09
--- /dev/null
+++ b/test/system/time_display_test.rb
@@ -0,0 +1,61 @@
+require "application_system_test_case"
+
+class TimeDisplayTest < ApplicationSystemTestCase
+  test "converts cached timestamps into the viewer's timezone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    comment = comments(:logo_agreement_kevin)
+    comment.update_columns(created_at: Time.utc(2024, 9, 13, 2), updated_at: Time.current)
+
+    sign_in_as(users(:david))
+    page.execute_script('document.cookie = "timezone=UTC; path=/"')
+    visit card_url(comment.card)
+
+    timestamp = find('.comment__permalink-title time[datetime="2024-09-13T02:00:00Z"]')
+    assert_equal "2024-09-13T02:00:00Z", timestamp["datetime"]
+    assert_equal "Sep 12, 2024", timestamp.text
+  end
+
+  test "auto-closing dates use tomorrow rather than a server-relative duration" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    card = cards(:layout)
+    card.update!(last_active_at: Time.current + 1.day - card.auto_postpone_period)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    assert_text "Moves to “Not Now” tomorrow if there’s no activity."
+  end
+
+  test "relative dates follow viewer calendar days, including DST and future timestamps" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    actual = page.evaluate_async_script(<<~JAVASCRIPT)
+      const done = arguments[0]
+
+      import("helpers/date_helpers").then(({ formatTimestamp, formatTimestampTokens }) => {
+        const now = new Date("2024-09-12T22:42:00Z")
+        const daylightSavingNow = new Date("2024-03-11T07:30:00Z")
+
+        done([
+          formatTimestamp("2024-09-12T20:42:00Z", "relative", now),
+          formatTimestamp("2024-09-12T06:30:00Z", "relative", now),
+          formatTimestamp("2024-09-07T20:42:00Z", "relative", now),
+          formatTimestamp("2024-09-13T08:00:00Z", "relative", now),
+          formatTimestamp("2024-09-15T08:00:00Z", "relative", now),
+          formatTimestamp("2024-10-12T08:00:00Z", "relative", now),
+          formatTimestamp("2024-09-01T20:42:00Z", "relative", now),
+          formatTimestamp("2023-09-12T20:42:00Z", "short-date", now),
+          formatTimestamp("2024-03-10T09:30:00Z", "relative", daylightSavingNow),
+          formatTimestamp("2024-09-12", "weekday-date", now),
+          formatTimestampTokens("Added {{time:2024-09-12T20:42:00Z}}", "short-date", now)
+        ])
+      })
+    JAVASCRIPT
+
+    assert_equal [
+      "1:42 PM", "yesterday", "5 days ago", "tomorrow", "in 3 days", "in 30 days", "Sep 1", "Sep 12, 2023", "yesterday", "Thursday, September 12", "Added Sep 12"
+    ], actual
+  end
+end
