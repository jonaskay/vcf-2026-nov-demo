diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..93e37d2
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,18 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/date_helpers"
+
+export default class extends Controller {
+  connect() {
+    this.#formatTime()
+    this.observer = new MutationObserver(() => this.#formatTime())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime", "data-time-format" ] })
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  #formatTime() {
+    this.element.textContent = formatTimestamp(this.element.dateTime, this.element.dataset.timeFormat)
+  }
+}
