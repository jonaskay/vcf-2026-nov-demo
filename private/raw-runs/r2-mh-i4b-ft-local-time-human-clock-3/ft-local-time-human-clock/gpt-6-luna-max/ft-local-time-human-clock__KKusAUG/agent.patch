+
+  def local_date_tag(date, format: "long-date", **options)
+    local_time_element(date.to_date.iso8601, format, date_only: true, **options)
+  end
+
+  private
+    def local_time_element(datetime, format, date_only: false, **options)
+      data = (options.delete(:data) || {}).dup
