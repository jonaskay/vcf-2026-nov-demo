diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..832b0fa
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,112 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  BROWSER_TIMEZONE = "America/Los_Angeles"
+
+  setup do
+    travel_to Time.utc(2024, 9, 12, 22, 42)
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: BROWSER_TIMEZONE)
+    page.driver.browser.execute_cdp("Page.addScriptToEvaluateOnNewDocument", source: <<~JS)
+      const RealDate = Date
+      const fixedNow = RealDate.parse("2024-09-12T22:42:00Z")
+      class FixedDate extends RealDate {
+        constructor(...args) {
+          super(...(args.length ? args : [fixedNow]))
+        }
+        static now() { return fixedNow }
+      }
+      window.Date = FixedDate
+    JS
+    sign_in_as(users(:kevin))
+  end
+
+  test "a comment from two hours ago is shown in the viewer's local time" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: local_time(13, 42))
+
+    visit_with_server_timezone card_comment_path(comment.card, comment)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: "1:42 PM"
+  end
+
+  test "a comment from last night is shown as yesterday" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update!(created_at: local_time(23, 42, days_ago: 1))
+
+    visit_with_server_timezone card_comment_path(comment.card, comment)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: "yesterday"
+  end
+
+  test "a comment from five days ago is relative and six days ago is an abbreviated date" do
+    comment = comments(:logo_agreement_kevin)
+    five_days_ago = local_time(13, 42, days_ago: 5)
+    comment.update!(created_at: five_days_ago)
+
+    visit_with_server_timezone card_comment_path(comment.card, comment)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: "5 days ago"
+
+    six_days_ago = local_time(13, 42, days_ago: 6)
+    comment.update!(created_at: six_days_ago)
+    visit_with_server_timezone card_comment_path(comment.card, comment)
+
+    assert_selector "a.comment__permalink-title time[data-local-time-format-value='comment']", text: six_days_ago.in_time_zone(BROWSER_TIMEZONE).strftime("%b %-d")
+  end
+
+  test "an auto-closing card due today shows the viewer's local time" do
+    card = cards(:logo)
+    set_auto_close_at(card, days_from_now: 0, hour: 17, minute: 42)
+
+    visit_with_server_timezone card_path(card)
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "at 5:42 PM"
+  end
+
+  test "an auto-closing card due tomorrow is labeled tomorrow" do
+    card = cards(:logo)
+    set_auto_close_at(card, days_from_now: 1, hour: 0, minute: 30)
+
+    visit_with_server_timezone card_path(card)
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "tomorrow"
+  end
+
+  test "an auto-closing card due in two days is labeled in two days" do
+    card = cards(:logo)
+    set_auto_close_at(card, days_from_now: 2)
+
+    visit_with_server_timezone card_path(card)
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "in 2 days"
+  end
+
+  test "an auto-closing card due in three days is labeled in three days" do
+    card = cards(:logo)
+    set_auto_close_at(card, days_from_now: 3)
+
+    visit_with_server_timezone card_path(card)
+
+    assert_selector ".card-perma__closure-message time[data-local-time-format-value='auto-close']", text: "in 3 days"
+  end
+
+  private
+    def visit_with_server_timezone(path)
+      page.execute_script("document.cookie = 'timezone=America/New_York; path=/'")
+      visit path
+    end
+
+    def local_time(hour, minute, days_ago: 0)
+      Time.use_zone(BROWSER_TIMEZONE) do
+        day = Time.zone.today - days_ago
+        Time.zone.parse("#{day.iso8601} #{hour}:#{minute}")
+      end
+    end
+
+    def set_auto_close_at(card, days_from_now:, hour: 12, minute: 0)
+      Time.use_zone(BROWSER_TIMEZONE) do
+        target = Time.zone.parse("#{(Time.zone.today + days_from_now).iso8601} #{hour}:#{minute}")
+        card.update!(last_active_at: target - card.auto_postpone_period)
+      end
+    end
+end
