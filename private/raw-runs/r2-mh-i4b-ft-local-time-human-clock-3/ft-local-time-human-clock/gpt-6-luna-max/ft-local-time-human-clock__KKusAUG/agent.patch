diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..52cc142
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,93 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalDate, signedDifferenceInDays } from "helpers/date_helpers"
+
+const clockFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const relativeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+
+export default class extends Controller {
+  static values = { format: String, dateOnly: Boolean }
+
+  connect() {
+    const date = this.#date
+
+    if (date && !Number.isNaN(date.getTime())) {
+      this.element.textContent = this.#format(date)
+    }
+  }
+
+  #format(date) {
+    switch (this.formatValue) {
+      case "comment":
+        return this.#comment(date)
+      case "relative":
+        return this.#relative(date)
+      case "auto-close":
+        return this.#autoClose(date)
+      case "time":
+        return clockFormatter.format(date)
+      case "short-date":
+        return formatLocalDate(date, { month: "short", day: "numeric" })
+      case "date":
+        return formatLocalDate(date, { month: "short", day: "2-digit", year: "numeric" })
+      case "access-token":
+        return new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" }).format(date)
+      case "long-date":
+        return formatLocalDate(date, { weekday: "long", month: "long", day: "numeric" })
+      default:
+        return clockFormatter.format(date)
+    }
+  }
+
+  #comment(date) {
+    const daysAgo = signedDifferenceInDays(date, new Date())
+
+    if (daysAgo === 0) {
+      return clockFormatter.format(date)
+    } else if (daysAgo === 1) {
+      return "yesterday"
+    } else if (daysAgo >= 2 && daysAgo <= 5) {
+      return `${daysAgo} days ago`
+    } else {
+      return formatLocalDate(date, { month: "short", day: "numeric" })
+    }
+  }
+
+  #relative(date) {
+    const seconds = (date.getTime() - Date.now()) / 1000
+    const magnitude = Math.abs(seconds)
+    const [unit, secondsPerUnit] = magnitude < 60 ? ["second", 1] :
+      magnitude < 3600 ? ["minute", 60] :
+      magnitude < 86400 ? ["hour", 3600] :
+      magnitude < 2592000 ? ["day", 86400] :
+      magnitude < 31536000 ? ["month", 2592000] : ["year", 31536000]
+
+    return relativeFormatter.format(Math.round(seconds / secondsPerUnit), unit)
+  }
+
+  #autoClose(date) {
+    const daysFromNow = signedDifferenceInDays(new Date(), date)
+
+    if (daysFromNow === 0) {
+      return `at ${clockFormatter.format(date)}`
+    } else if (daysFromNow === 1) {
+      return "tomorrow"
+    } else if (daysFromNow > 1) {
+      return `in ${daysFromNow} days`
+    } else if (daysFromNow === -1) {
+      return "yesterday"
+    } else {
+      return `${Math.abs(daysFromNow)} days ago`
+    }
+  }
+
+  get #date() {
+    const value = this.element.dateTime
+
+    if (this.dateOnlyValue) {
+      const [year, month, day] = value.split("-").map(Number)
+      return new Date(year, month - 1, day, 12)
+    }
+
+    return new Date(value)
+  }
+}
