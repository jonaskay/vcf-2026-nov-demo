diff --git a/app/models/notification/email_digest.rb b/app/models/notification/email_digest.rb
new file mode 100644
index 0000000..6657fc2
--- /dev/null
+++ b/app/models/notification/email_digest.rb
@@ -0,0 +1,72 @@
+class Notification::EmailDigest < ApplicationRecord
+  WINDOW_LENGTHS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 24.hours,
+    "weekly" => 168.hours
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+
+  has_many :entries,
+    class_name: "Notification::EmailDigestEntry",
+    foreign_key: :notification_email_digest_id, dependent: :destroy
+  has_many :notifications, through: :entries
+
+  class << self
+    def receive(notification)
+      settings = notification.user.settings
+
+      if settings
+        settings.with_lock do
+          if duration = WINDOW_LENGTHS[settings.bundle_email_frequency]
+            now = Time.current
+            digest = where(user: notification.user)
+              .where("started_at <= ? AND ends_at > ?", now, now)
+              .order(:started_at)
+              .last
+
+            if digest
+              schedule_delivery = false
+            else
+              digest = create!(
+                account: notification.account,
+                user: notification.user,
+                started_at: now,
+                ends_at: now + duration
+              )
+              schedule_delivery = true
+            end
+
+            digest.entries.create_or_find_by!(account: notification.account, notification: notification)
+
+            if schedule_delivery
+              Notification::EmailDigest::DeliveryJob.set(wait_until: digest.ends_at).perform_later(digest)
+            end
+          end
+        end
+      end
+    end
+  end
+
+  def deliver_now
+    return if delivered_at.present? || ends_at > Time.current
+
+    settings = user.settings
+
+    if settings
+      settings.with_lock do
+        reload
+
+        unless delivered_at.present? || ends_at > Time.current
+          if settings.bundle_email_frequency != "never" && user.active? && account.active? &&
+              user.identity.present? && notifications.exists?
+            NotificationMailer.digest(self).deliver_now
+          end
+
+          update!(delivered_at: Time.current)
+        end
+      end
+    end
+  end
+end
