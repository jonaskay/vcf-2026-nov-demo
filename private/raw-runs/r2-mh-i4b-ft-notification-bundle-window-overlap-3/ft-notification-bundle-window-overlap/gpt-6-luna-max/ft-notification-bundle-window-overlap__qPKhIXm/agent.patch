@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Notifications::BundleEmailSettingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "settings page offers each frequency and shows the saved choice" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    get notifications_settings_path
+
+    assert_response :success
+    assert_select "select[name='user_settings[bundle_email_frequency]']" do
+      assert_select "option[value='never']", text: "Off"
+      assert_select "option[value='every_few_hours']", text: "Every four hours"
+      assert_select "option[value='daily']", text: "Daily"
+      assert_select "option[value='weekly']", text: "Weekly"
+      assert_select "option[selected][value='daily']"
+    end
+  end
+
+  test "an unsupported frequency is rejected" do
+    patch notifications_settings_path, params: { user_settings: { bundle_email_frequency: "monthly" } }
+
+    assert_response :unprocessable_entity
+    assert_equal "never", @user.settings.reload.bundle_email_frequency
+  end
+
+  test "updating notification settings saves the frequency for this person" do
+    patch notifications_settings_path, params: { user_settings: { bundle_email_frequency: "weekly" } }
+
+    assert_redirected_to notifications_settings_path
+    assert_equal "weekly", @user.settings.reload.bundle_email_frequency
+  end
+end
diff --git a/test/models/notification/email_digest_test.rb b/test/models/notification/email_digest_test.rb
new file mode 100644
index 0000000..eaa5f0b
--- /dev/null
+++ b/test/models/notification/email_digest_test.rb
@@ -0,0 +1,179 @@
+require "test_helper"
+
+class Notification::EmailDigestTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "notifications produced by the notifier enter the recipient's digest" do
+    notifications = Notifier.for(events(:logo_assignment_jz)).notify
+    notification = notifications.find { |record| record.user == @user }
+
+    assert notification
+    assert_equal [ notification ], Notification::EmailDigest.find_by!(user: @user).notifications.to_a
+  end
+
+  test "the first notification starts a four hour window and later notifications do not reset it" do
+    started_at = Time.zone.parse("2026-01-05 09:00")
+
+    first = travel_to(started_at) { create_notification(@user, events(:shipping_published)) }
+    digest = Notification::EmailDigest.find_by!(user: @user)
+
+    assert_equal started_at, digest.started_at
+    assert_equal started_at + 4.hours, digest.ends_at
+
+    second = travel_to(started_at + 3.hours) { create_notification(@user, events(:layout_published)) }
+
+    assert_equal 1, Notification::EmailDigest.where(user: @user).count
+    assert_equal started_at + 4.hours, digest.reload.ends_at
+    assert_equal 2, digest.notifications.count
+    assert_includes digest.notifications, first
+    assert_includes digest.notifications, second
+  end
+
+  test "daily and weekly windows use elapsed time and belong to each recipient" do
+    daily_user = users(:david)
+    weekly_user = users(:jz)
+    daily_user.settings.update!(bundle_email_frequency: "daily")
+    weekly_user.settings.update!(bundle_email_frequency: "weekly")
+    started_at = Time.zone.parse("2026-01-06 12:30")
+
+    daily_notification = travel_to(started_at) { create_notification(daily_user, events(:layout_published)) }
+    weekly_notification = travel_to(started_at) do
+      create_notification(weekly_user, events(:buy_domain_sent_back_to_triage))
+    end
+
+    daily_digest = Notification::EmailDigest.find_by!(user: daily_user)
+    weekly_digest = Notification::EmailDigest.find_by!(user: weekly_user)
+
+    assert_equal started_at + 24.hours, daily_digest.ends_at
+    assert_equal started_at + 168.hours, weekly_digest.ends_at
+    assert_equal [ daily_notification ], daily_digest.notifications.to_a
+    assert_equal [ weekly_notification ], weekly_digest.notifications.to_a
+  end
+
+  test "notifications just inside the deadline join the open window and one at the deadline opens an adjacent window" do
+    started_at = Time.zone.parse("2026-01-07 08:00")
+
+    first = travel_to(started_at) { create_notification(@user, events(:shipping_published)) }
+    first_digest = Notification::EmailDigest.find_by!(user: @user)
+    second = travel_to(started_at + 4.hours - 1.minute) do
+      create_notification(@user, events(:layout_published))
+    end
+
+    assert_equal first_digest, Notification::EmailDigest.find_by!(user: @user)
+    assert_equal 2, first_digest.notifications.count
+
+    third = travel_to(started_at + 4.hours) { create_notification(@user, events(:text_published)) }
+    digests = Notification::EmailDigest.where(user: @user).order(:started_at)
+    second_digest = digests.second
+
+    assert_equal 2, digests.count
+    assert_equal started_at + 4.hours, second_digest.started_at
+    assert_operator first_digest.ends_at, :<=, second_digest.started_at
+    assert_equal [ third ], second_digest.notifications.to_a
+    assert_includes first_digest.notifications, first
+    assert_includes first_digest.notifications, second
+
+    outside = travel_to(started_at + 4.hours + 1.second) do
+      create_notification(@user, events(:buy_domain_sent_back_to_triage))
+    end
+
+    assert_equal 2, digests.reload.count
+    assert_equal [ third, outside ], second_digest.notifications.order(:created_at, :id).to_a
+  end
+
+  test "an updated notification is assigned to the window open when it arrives" do
+    started_at = Time.zone.parse("2026-01-08 08:00")
+    notification = travel_to(started_at) { create_notification(@user, events(:shipping_published)) }
+    first_digest = Notification::EmailDigest.find_by!(user: @user)
+
+    travel_to(started_at + 4.hours) do
+      event = events(:shipping_closed)
+      notification.update!(source: event, creator: event.creator, unread_count: 2)
+    end
+
+    second_digest = Notification::EmailDigest.where(user: @user).order(:started_at).last
+
+    assert_equal 2, Notification::EmailDigest.where(user: @user).count
+    assert_includes first_digest.notifications, notification
+    assert_includes second_digest.notifications, notification
+    assert_equal started_at + 4.hours, second_digest.started_at
+  end
+
+  test "one email contains each recipient's notifications once per window" do
+    other_user = users(:david)
+    other_user.settings.update!(bundle_email_frequency: "every_few_hours")
+    started_at = Time.zone.parse("2026-01-08 10:00")
+
+    first = travel_to(started_at) { create_notification(@user, events(:shipping_published)) }
+    second = travel_to(started_at + 1.hour) { create_notification(@user, events(:layout_published)) }
+    other = travel_to(started_at + 2.hours) { create_notification(other_user, events(:buy_domain_sent_back_to_triage)) }
+
+    assert_empty ActionMailer::Base.deliveries
+
+    travel_to(started_at + 6.hours) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal 2, ActionMailer::Base.deliveries.size
+    Notification::EmailDigest.where(user: @user).first.deliver_now
+    assert_equal 2, ActionMailer::Base.deliveries.size
+
+    recipient_email = ActionMailer::Base.deliveries.find { |mail| mail.to == [ @user.identity.email_address ] }
+    other_recipient_email = ActionMailer::Base.deliveries.find do |mail|
+      mail.to == [ other_user.identity.email_address ]
+    end
+
+    assert_includes recipient_email.body.encoded, first.card.title
+    assert_includes recipient_email.body.encoded, second.card.title
+    assert_includes other_recipient_email.body.encoded, other.card.title
+    assert_not_includes recipient_email.body.encoded, other.card.title
+    assert_not_includes other_recipient_email.body.encoded, first.card.title
+
+    next_notification = travel_to(started_at + 6.hours) { create_notification(@user, events(:text_published)) }
+    travel_to(started_at + 10.hours) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal 3, ActionMailer::Base.deliveries.size
+    next_email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], next_email.to
+    assert_includes next_email.body.encoded, next_notification.card.title
+  end
+
+  test "delivery waits until the window boundary" do
+    started_at = Time.zone.parse("2026-01-09 10:00")
+    travel_to(started_at) { create_notification(@user, events(:shipping_published)) }
+
+    travel_to(started_at + 4.hours - 1.second) do
+      perform_enqueued_jobs
+    end
+
+    assert_empty ActionMailer::Base.deliveries
+
+    travel_to(started_at + 4.hours) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+  end
+
+  test "never skips email windows without suppressing existing push notifications" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      create_notification(@user, events(:shipping_published))
+    end
+
+    assert_not Notification::EmailDigest.exists?(user: @user)
+    assert_empty ActionMailer::Base.deliveries
+  end
+
+  private
+    def create_notification(user, event)
+      Notification.create!(user: user, source: event, creator: event.creator, unread_count: 1)
+    end
+end
