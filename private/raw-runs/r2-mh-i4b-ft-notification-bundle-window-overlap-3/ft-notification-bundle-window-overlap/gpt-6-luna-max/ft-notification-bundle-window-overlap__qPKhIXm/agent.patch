@@ -0,0 +1,11 @@
+class Notification::EmailDigest::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(email_digest)
+    if email_digest.ends_at > Time.current
+      self.class.set(wait_until: email_digest.ends_at).perform_later(email_digest)
+    else
+      email_digest.deliver_now
+    end
+  end
+end
