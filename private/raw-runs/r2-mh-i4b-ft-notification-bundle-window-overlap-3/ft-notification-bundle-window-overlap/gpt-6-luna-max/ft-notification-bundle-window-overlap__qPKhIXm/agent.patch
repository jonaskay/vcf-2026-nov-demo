+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequency defaults to off" do
+    assert_equal "never", users(:kevin).settings.bundle_email_frequency
+  end
+
+  test "bundle email frequency only accepts the four supported values" do
+    settings = users(:kevin).settings
+
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      settings.bundle_email_frequency = frequency
+      assert settings.valid?, "#{frequency} should be valid"
+    end
+
+    settings.bundle_email_frequency = "monthly"
+    assert_not settings.valid?
+  end
+end
