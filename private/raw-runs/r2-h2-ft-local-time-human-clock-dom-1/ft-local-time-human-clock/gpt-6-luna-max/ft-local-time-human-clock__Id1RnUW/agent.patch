diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..cb3eec2 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,24 @@
 module TimeHelper
+  def browser_time_tag(timestamp, format: "relative", **attributes)
+    time_tag_for_browser_value(browser_time_value(timestamp), format, attributes)
+  end
+
+  def browser_date_tag(date, **attributes)
+    time_tag_for_browser_value(date.to_date.iso8601, "calendar-date", attributes)
+  end
+
+  def browser_time_value(timestamp)
+    timestamp.utc.iso8601(6)
+  end
+
+  private
+    def time_tag_for_browser_value(value, format, attributes)
+      data = attributes.delete(:data) || {}
+      controllers = [ data[:controller], "time-display" ].compact.flat_map { it.to_s.split }.uniq.join(" ")
+
+      tag.time value,
+        **attributes,
+        datetime: value,
+        data: data.merge(controller: controllers, time_display_format_value: format)
+    end
 end
