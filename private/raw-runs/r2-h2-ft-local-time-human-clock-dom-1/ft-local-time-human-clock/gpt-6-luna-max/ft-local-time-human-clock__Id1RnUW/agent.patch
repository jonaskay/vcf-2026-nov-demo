diff --git a/app/javascript/controllers/time_display_controller.js b/app/javascript/controllers/time_display_controller.js
new file mode 100644
index 0000000..9be0cdf
--- /dev/null
+++ b/app/javascript/controllers/time_display_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  #observer
+
+  connect() {
+    this.#observer = new MutationObserver(() => this.update())
+    this.#observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-time-display-format-value" ],
+      childList: true
+    })
+    this.update()
+  }
+
+  disconnect() {
+    this.#observer.disconnect()
+  }
+
+  update() {
+    const text = formatDateTime(this.element.dateTime, this.formatValue)
+    if (this.element.textContent !== text) this.element.textContent = text
+  }
+}
