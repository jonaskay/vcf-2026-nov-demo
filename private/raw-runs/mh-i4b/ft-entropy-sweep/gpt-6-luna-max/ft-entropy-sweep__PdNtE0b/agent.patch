+  test "due scope includes the exact account-level cutoff across accounts" do
+    freeze_time
+    entropies(:writebook_board).destroy
+    entropies(:miltons_wish_list_board).destroy
+    entropies("37s_account").update! auto_postpone_period: 7.days
+    entropies("initech_account").update! auto_postpone_period: 3.days
+
+    boundary, older, newer = cards(:logo, :layout, :shipping)
+    boundary.update! last_active_at: 7.days.ago
+    older.update! last_active_at: 8.days.ago
+    newer.update! last_active_at: 6.days.ago
+
+    other_boundary = cards(:radio)
+    other_older = cards(:paycheck)
+    other_newer = cards(:unfinished_thoughts)
+    other_boundary.update! last_active_at: 3.days.ago
+    other_older.update! last_active_at: 4.days.ago
+    other_newer.update! status: "published", last_active_at: 2.days.ago
+
+    due_ids = Card.due_to_be_postponed.where(id: [ boundary, older, newer, other_boundary, other_older, other_newer ]).pluck(:id)
+
+    assert_includes due_ids, boundary.id
+    assert_includes due_ids, older.id
+    assert_not_includes due_ids, newer.id
+    assert_includes due_ids, other_boundary.id
+    assert_includes due_ids, other_older.id
+    assert_not_includes due_ids, other_newer.id
+    assert_kind_of ActiveRecord::Relation, Card.due_to_be_postponed
+    assert_kind_of ActiveRecord::Relation, Card.latest.due_to_be_postponed
+    assert_equal 1, Card.select(:title).due_to_be_postponed.where(id: boundary.id).count
+    assert_operator Card.latest.due_to_be_postponed.where(id: [ boundary.id, older.id ]).count, :>, 0
+  end
+
+  test "due scope uses a board override at its cutoff instead of the account default" do
+    freeze_time
+    entropies("37s_account").update! auto_postpone_period: 365.days
+    entropies(:writebook_board).update! auto_postpone_period: 7.days
+    entropies(:private_board).destroy
+
+    default_period_card = Card.create!(
+      board: boards(:private),
+      creator: users(:david),
+      status: "published",
+      title: "Uses the account entropy period",
+      last_active_at: 366.days.ago
+    )
+    boundary = cards(:logo)
+    older = cards(:layout)
+    newer = cards(:shipping)
+    boundary.update! last_active_at: 7.days.ago
+    older.update! last_active_at: 8.days.ago
+    newer.update! last_active_at: 6.days.ago
+
+    due_ids = Card.due_to_be_postponed.where(id: [ boundary.id, older.id, newer.id, default_period_card.id ]).pluck(:id)
+
+    assert_includes due_ids, boundary.id
+    assert_includes due_ids, older.id
+    assert_not_includes due_ids, newer.id
+    assert_includes due_ids, default_period_card.id
+  end
+
+  test "due scope excludes closed, postponed, and unpublished cards" do
+    freeze_time
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update! auto_postpone_period: 3.days
+
+    due = cards(:logo)
+    closed = cards(:shipping)
+    postponed = cards(:text)
+    unpublished = cards(:buy_domain)
+    [ due, closed, postponed, unpublished ].each { |card| card.update! last_active_at: 4.days.ago }
+    closed.close
+    postponed.postpone
+    unpublished.update! status: "drafted"
+
+    due_ids = Card.due_to_be_postponed.where(id: [ due.id, closed.id, postponed.id, unpublished.id ]).pluck(:id)
+
+    assert_equal [ due.id ], due_ids
+  end
+
+  test "auto postpone all due processes cards across batches" do
+    freeze_time
+    account = accounts("37s")
