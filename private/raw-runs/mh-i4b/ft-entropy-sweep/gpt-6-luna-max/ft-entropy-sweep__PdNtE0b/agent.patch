   class_methods do
+    def due_to_be_postponed_queries(now, active_cards = active)
+      active_cards = active_cards.except(:order, :limit, :offset)
+      board_periods = Entropy.where(container_type: "Board").distinct.pluck(:auto_postpone_period)
+      account_periods = Entropy.where(container_type: "Account").distinct.pluck(:auto_postpone_period)
+
+      board_queries = board_periods.map do |period|
+        settings = Entropy.where(container_type: "Board", auto_postpone_period: period)
+
+        active_cards
+          .where(board_id: settings.select(:container_id))
+          .where(account_id: settings.select(:account_id))
+          .where("cards.last_active_at <= ?", now - period.seconds)
+      end
+
+      account_queries = account_periods.map do |period|
+        settings = Entropy.where(container_type: "Account", auto_postpone_period: period)
+        overridden_boards = Entropy.where(container_type: "Board", account_id: settings.select(:account_id))
+
+        active_cards
+          .where(account_id: settings.select(:account_id))
+          .where.not(board_id: overridden_boards.select(:container_id))
+          .where("cards.last_active_at <= ?", now - period.seconds)
+      end
+
+      board_queries + account_queries
+    end
+
     def auto_postpone_all_due
