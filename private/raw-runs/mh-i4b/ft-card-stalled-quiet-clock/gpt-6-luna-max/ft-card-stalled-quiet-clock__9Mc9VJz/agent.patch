diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..016321f
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,200 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from distinct people within a third of the board period stall after fourteen quiet days" do
+    card = create_card
+    started_at = Time.current.change(usec: 0)
+    window = boards(:writebook).auto_postpone_period / 3
+
+    comment_at card, users(:david), started_at
+    comment_at card, users(:jz), started_at + window / 2
+    comment_at card, users(:kevin), started_at + window
+
+    burst_at = card.reload.last_active_at
+
+    travel_to burst_at + 14.days - 1.hour do
+      assert_not card.reload.stalled?
+    end
+
+    travel_to burst_at + 14.days, with_usec: true do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "comments just outside one third of the board period do not qualify" do
+    card = create_card
+    started_at = Time.current.change(usec: 0)
+    window = boards(:writebook).auto_postpone_period / 3
+
+    comment_at card, users(:david), started_at
+    comment_at card, users(:jz), started_at + window / 2
+    comment_at card, users(:kevin), started_at + window + 1.hour
+
+    travel_to card.reload.last_active_at + 14.days, with_usec: true do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "account period is used when the board has no override" do
+    entropies(:writebook_board).destroy!
+
+    card = create_card
+    started_at = Time.current.change(usec: 0)
+    window = accounts("37s").entropy.auto_postpone_period / 3
+
+    comment_at card, users(:david), started_at
+    comment_at card, users(:jz), started_at + window / 2
+    comment_at card, users(:kevin), started_at + window
+
+    travel_to card.reload.last_active_at + 14.days, with_usec: true do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "assigning someone is a burst" do
+    card = create_card
+    card.toggle_assignment users(:jz)
+    burst_at = card.reload.last_active_at
+
+    travel_to burst_at + 14.days, with_usec: true do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "reopening a card is a burst" do
+    card = create_card
+    card.close(user: users(:david))
+    travel_to card.reload.last_active_at + 1.hour do
+      card.reopen(user: users(:david))
+    end
+    burst_at = card.reload.last_active_at
+
+    travel_to burst_at + 14.days, with_usec: true do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "one comment, two comments, one author, or system comments do not produce a burst" do
+    started_at = Time.current.change(usec: 0)
+    one_comment = create_card
+    two_comments = create_card
+    one_author = create_card
+    with_system_comment = create_card
+
+    comment_at one_comment, users(:david), started_at
+
+    comment_at two_comments, users(:david), started_at
+    comment_at two_comments, users(:jz), started_at
+
+    comment_at one_author, users(:david), started_at
+    comment_at one_author, users(:david), started_at
+    comment_at one_author, users(:david), started_at
+
+    comment_at with_system_comment, users(:david), started_at
+    comment_at with_system_comment, users(:jz), started_at
+    comment_at with_system_comment, users(:system), started_at
+
+    [ one_comment, two_comments, one_author, with_system_comment ].each do |card|
+      travel_to card.reload.last_active_at + 14.days, with_usec: true do
+        assert_not card.reload.stalled?
+      end
+    end
+  end
+
+  test "non-burst activity does not qualify by itself" do
+    card = create_card
+    card.close(user: users(:david))
+
+    travel_to card.reload.last_active_at + 14.days, with_usec: true do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "activity after a burst clears it until another burst occurs" do
+    card = create_card
+    card.toggle_assignment users(:jz)
+    first_burst_at = card.reload.last_active_at
+
+    travel_to first_burst_at + 7.days do
+      card.reactions.create!(content: "🎉")
+    end
+
+    travel_to first_burst_at + 14.days, with_usec: true do
+      assert_not card.reload.stalled?
+    end
+
+    travel_to first_burst_at + 15.days do
+      card.comments.create!(creator: users(:kevin))
+    end
+
+    comment_at = card.reload.last_active_at
+    travel_to comment_at + 14.days, with_usec: true do
+      assert_not card.reload.stalled?
+    end
+
+    travel_to comment_at + 15.days do
+      card.toggle_assignment users(:kevin)
+    end
+
+    second_burst_at = card.reload.last_active_at
+    travel_to second_burst_at + 14.days, with_usec: true do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "activity after a burst at the same timestamp clears it" do
+    started_at = Time.current.change(usec: 0)
+    card = nil
+
+    travel_to started_at do
+      card = create_card
+      card.toggle_assignment users(:jz)
+      card.reactions.create!(content: "🎉")
+    end
+
+    travel_to started_at + 14.days, with_usec: true do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "stalled scope is a relation and agrees with the predicate" do
+    stalled_card = create_card
+    stalled_card.toggle_assignment users(:jz)
+    stalled_at = stalled_card.reload.last_active_at + 14.days
+
+    reset_card = create_card
+    reset_card.toggle_assignment users(:jz)
+    travel_to reset_card.reload.last_active_at + 1.day do
+      reset_card.comments.create!(creator: users(:kevin))
+    end
+
+    cards = [ stalled_card, reset_card ]
+    travel_to stalled_at, with_usec: true do
+      assert_kind_of ActiveRecord::Relation, Card.stalled
+      assert_equal [ stalled_card.id ], Card.stalled.where(id: cards.map(&:id)).pluck(:id)
+      cards.each do |card|
+        assert_equal Card.stalled.where(id: card.id).exists?, card.reload.stalled?
+      end
+    end
+  end
+
+  private
+    def create_card
+      created_card = boards(:writebook).cards.create!(
+        title: "Stalled state test",
+        creator: users(:david),
+        status: :published
+      )
+      Card.find(created_card.id)
+    end
+
+    def comment_at(card, creator, time)
+      travel_to time do
+        card.comments.create!(creator: creator)
+      end
+    end
+end
