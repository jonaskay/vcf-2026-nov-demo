diff --git a/test/controllers/cards/stalled_test.rb b/test/controllers/cards/stalled_test.rb
new file mode 100644
index 0000000..548321c
--- /dev/null
+++ b/test/controllers/cards/stalled_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Cards::StalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:david)
+  end
+
+  test "cards index filters stalled cards and marks them in HTML" do
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @stalled_card = create_card("A recently quiet card")
+      @stalled_card.toggle_assignment users(:jz)
+      @active_card = create_card("A card with no burst")
+    end
+
+    travel_to started_at + 14.days, with_usec: true do
+      get cards_path, params: { indexed_by: "stalled" }
+
+      assert_response :success
+      assert_includes response.body, @stalled_card.title
+      assert_not_includes response.body, @active_card.title
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "stalled filter includes closed and postponed cards" do
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @closed_card = create_card("Closed stalled card")
+      @closed_card.close(user: users(:david))
+      @closed_card.toggle_assignment users(:jz)
+
+      @postponed_card = create_card("Postponed stalled card")
+      @postponed_card.auto_postpone(user: users(:david))
+      @postponed_card.toggle_assignment users(:jz)
+    end
+
+    travel_to started_at + 14.days, with_usec: true do
+      get cards_path, params: { indexed_by: "stalled" }
+
+      assert_response :success
+      assert_includes response.body, @closed_card.title
+      assert_includes response.body, @postponed_card.title
+    end
+  end
+
+  test "card show HTML marks a stalled card" do
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @card = create_card("Stalled card detail")
+      @card.toggle_assignment users(:jz)
+    end
+
+    travel_to started_at + 14.days, with_usec: true do
+      get card_path(@card)
+
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "cards index JSON filters stalled cards and marks them" do
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @stalled_card = create_card("Stalled JSON card")
+      @stalled_card.toggle_assignment users(:jz)
+      @active_card = create_card("Active JSON card")
+    end
+
+    travel_to started_at + 14.days, with_usec: true do
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+      assert_response :success
+      cards = response.parsed_body
+      assert_includes cards.pluck("number"), @stalled_card.number
+      assert_not_includes cards.pluck("number"), @active_card.number
+      assert cards.find { |card| card["number"] == @stalled_card.number }["stalled"]
+    end
+  end
+
+  test "card show JSON includes stalled state" do
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @card = create_card("Stalled JSON detail")
+      @card.toggle_assignment users(:jz)
+    end
+
+    travel_to started_at + 14.days, with_usec: true do
+      get card_path(@card), as: :json
+
+      assert_response :success
+      assert_equal true, response.parsed_body["stalled"]
+    end
+  end
+
+  private
+    def create_card(title)
+      card = boards(:writebook).cards.create!(title: title, creator: users(:kevin), status: :published)
+      Card.find(card.id)
+    end
+end
