diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..dc69372
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,102 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  QUIET_PERIOD = 14.days
+
+  AUTO_CLOSE_PERIOD_SQL = <<~SQL.squish
+    COALESCE(
+      (SELECT auto_postpone_period FROM entropies WHERE container_type = 'Board' AND container_id = cards.board_id),
+      (SELECT auto_postpone_period FROM entropies WHERE container_type = 'Account' AND container_id = cards.account_id)
+    )
+  SQL
+
+  NO_ACTIVITY_AFTER_BURST_SQL = <<~SQL.squish
+    NOT EXISTS (
+      SELECT 1
+      FROM events later_event
+      LEFT JOIN comments later_comment
+        ON later_event.eventable_type = 'Comment' AND later_event.eventable_id = later_comment.id
+      WHERE (
+        (later_event.eventable_type = 'Card' AND later_event.eventable_id = cards.id)
+        OR later_comment.card_id = cards.id
+      )
+        AND (
+          later_event.created_at > burst_event.created_at
+          OR (later_event.created_at = burst_event.created_at AND later_event.id > burst_event.id)
+        )
+    )
+    AND NOT EXISTS (
+      SELECT 1
+      FROM reactions later_reaction
+      LEFT JOIN comments reaction_comment
+        ON later_reaction.reactable_type = 'Comment' AND later_reaction.reactable_id = reaction_comment.id
+      WHERE (
+        (later_reaction.reactable_type = 'Card' AND later_reaction.reactable_id = cards.id)
+        OR reaction_comment.card_id = cards.id
+      )
+        AND (
+          later_reaction.created_at > burst_event.created_at
+          OR (later_reaction.created_at = burst_event.created_at AND later_reaction.id > burst_event.id)
+        )
+    )
+  SQL
+
+  included do
+    scope :stalled, -> do
+      cutoff = Time.current - QUIET_PERIOD
+      comment_window_start = connection.date_subtract("burst_comment.created_at", "((#{AUTO_CLOSE_PERIOD_SQL}) / 3)")
+
+      assignment_burst = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM events burst_event
+          WHERE burst_event.eventable_type = 'Card'
+            AND burst_event.eventable_id = cards.id
+            AND burst_event.action IN ('card_assigned', 'card_reopened')
+            AND burst_event.created_at <= ?
+            AND #{NO_ACTIVITY_AFTER_BURST_SQL}
+        )
+      SQL
+
+      comment_burst = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM events burst_event
+          INNER JOIN comments burst_comment
+            ON burst_event.eventable_type = 'Comment' AND burst_event.eventable_id = burst_comment.id
+          INNER JOIN users burst_author ON burst_author.id = burst_comment.creator_id
+          WHERE burst_event.action = 'comment_created'
+            AND burst_comment.card_id = cards.id
+            AND burst_author.role <> 'system'
+            AND burst_comment.created_at >= #{comment_window_start}
+            AND burst_event.created_at <= ?
+            AND (
+              SELECT COUNT(*)
+              FROM comments window_comment
+              INNER JOIN users window_author ON window_author.id = window_comment.creator_id
+              WHERE window_comment.card_id = cards.id
+                AND window_comment.created_at >= #{comment_window_start}
+                AND window_comment.created_at <= burst_comment.created_at
+                AND window_author.role <> 'system'
+            ) >= 3
+            AND (
+              SELECT COUNT(DISTINCT window_comment.creator_id)
+              FROM comments window_comment
+              INNER JOIN users window_author ON window_author.id = window_comment.creator_id
+              WHERE window_comment.card_id = cards.id
+                AND window_comment.created_at >= #{comment_window_start}
+                AND window_comment.created_at <= burst_comment.created_at
+                AND window_author.role <> 'system'
+            ) >= 2
+            AND #{NO_ACTIVITY_AFTER_BURST_SQL}
+        )
+      SQL
+
+      where("cards.last_active_at <= ? AND ((#{assignment_burst}) OR (#{comment_burst}))", cutoff, cutoff, cutoff)
+    end
+  end
+
+  def stalled?
+    self.class.stalled.where(id: id).exists?
+  end
+end
