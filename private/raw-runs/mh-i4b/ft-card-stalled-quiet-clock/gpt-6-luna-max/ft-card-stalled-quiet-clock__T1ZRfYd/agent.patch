diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..06943bb
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,335 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three user comments by at least two people within a third of the board period create a burst" do
+    as_of = Time.current
+    board = boards(:writebook)
+    card = create_card(board:, at: as_of - 120.days)
+    burst_at = as_of - 14.days
+    window = board.auto_postpone_period / 3
+
+    add_comment(card, users(:david), at: burst_at - window)
+    add_comment(card, users(:kevin), at: burst_at - window / 2)
+    add_comment(card, users(:david), at: burst_at)
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+      assert_kind_of ActiveRecord::Relation, Card.stalled
+      assert_includes Card.stalled, card
+      assert_equal card.stalled?, Card.indexed_by("stalled").include?(card)
+    end
+  end
+
+  test "a prior burst is found when last_active_at was touched after its comments" do
+    as_of = Time.current
+    card = create_card(at: as_of - 120.days)
+    burst_at = as_of - 14.days - 1.second
+
+    add_comment(card, users(:david), at: burst_at - 1.day)
+    add_comment(card, users(:kevin), at: burst_at - 1.hour)
+    add_comment(card, users(:david), at: burst_at)
+    travel_to(burst_at + 1.second) do
+      card.update_column(:last_active_at, Time.current)
+    end
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "comment window includes its exact one-third edge and rejects comments just outside it" do
+    as_of = Time.current
+    board = boards(:writebook)
+    window = board.auto_postpone_period / 3
+    burst_at = as_of - 14.days
+
+    inside = create_card(board:, at: as_of - 120.days)
+    add_comment(inside, users(:david), at: burst_at - window + 1.hour)
+    add_comment(inside, users(:kevin), at: burst_at - 1.hour)
+    add_comment(inside, users(:david), at: burst_at)
+
+    edge = create_card(board:, at: as_of - 120.days)
+    add_comment(edge, users(:david), at: burst_at - window)
+    add_comment(edge, users(:kevin), at: burst_at - window / 2)
+    add_comment(edge, users(:david), at: burst_at)
+
+    outside = create_card(board:, at: as_of - 120.days)
+    add_comment(outside, users(:david), at: burst_at - window - 1.hour)
+    add_comment(outside, users(:kevin), at: burst_at - 1.hour)
+    add_comment(outside, users(:david), at: burst_at)
+
+    travel_to(as_of) do
+      assert_predicate inside.reload, :stalled?
+      assert_predicate edge.reload, :stalled?
+      assert_not_predicate outside.reload, :stalled?
+    end
+  end
+
+  test "comments use the board override instead of the account default" do
+    as_of = Time.current
+    board = boards(:writebook)
+    assert_equal 90.days.to_i, board.auto_postpone_period
+    assert_equal 30.days, board.account.entropy.auto_postpone_period.seconds
+
+    card = create_card(board:, at: as_of - 120.days)
+    burst_at = as_of - 14.days
+    add_comment(card, users(:david), at: burst_at - 20.days)
+    add_comment(card, users(:kevin), at: burst_at - 15.days)
+    add_comment(card, users(:david), at: burst_at)
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+    end
+  end
+
+  test "comments use the account period when the board has no override" do
+    as_of = Time.current
+    board = boards(:writebook)
+    board.entropy.destroy!
+    board.reload
+    assert_equal board.account.entropy.auto_postpone_period, board.auto_postpone_period
+
+    card = create_card(board:, at: as_of - 120.days)
+    burst_at = as_of - 14.days
+    window = board.auto_postpone_period / 3
+    add_comment(card, users(:david), at: burst_at - window)
+    add_comment(card, users(:kevin), at: burst_at - window / 2)
+    add_comment(card, users(:david), at: burst_at)
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+    end
+  end
+
+  test "two comments or three comments by only one person do not create a burst" do
+    as_of = Time.current
+    burst_at = as_of - 14.days
+
+    two_comments = create_card(at: as_of - 60.days)
+    add_comment(two_comments, users(:david), at: burst_at - 1.day)
+    add_comment(two_comments, users(:kevin), at: burst_at)
+
+    one_person = create_card(at: as_of - 60.days)
+    add_comment(one_person, users(:david), at: burst_at - 1.day)
+    add_comment(one_person, users(:david), at: burst_at - 1.hour)
+    add_comment(one_person, users(:david), at: burst_at)
+
+    system_comment = create_card(at: as_of - 60.days)
+    add_comment(system_comment, users(:david), at: burst_at - 1.day)
+    add_comment(system_comment, users(:kevin), at: burst_at - 1.hour)
+    add_comment(system_comment, users(:system), at: burst_at)
+
+    travel_to(as_of) do
+      assert_not_predicate two_comments.reload, :stalled?
+      assert_not_predicate one_person.reload, :stalled?
+      assert_not_predicate system_comment.reload, :stalled?
+      assert_equal system_comment.stalled?, Card.stalled.include?(system_comment)
+    end
+  end
+
+  test "assigning someone to a card creates a burst without comments" do
+    as_of = Time.current
+    card = create_card(at: as_of - 30.days)
+
+    travel_to(as_of - 14.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "direct assignment records create bursts too" do
+    as_of = Time.current
+    card = create_card(at: as_of - 30.days, status: :drafted)
+
+    travel_to(as_of - 14.days) do
+      assignment = card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+      assert_equal Time.current, assignment.created_at
+      assert_equal assignment.created_at, card.reload.last_active_at
+    end
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "reopening a card creates a burst without comments" do
+    as_of = Time.current
+    card = create_card(at: as_of - 30.days)
+
+    travel_to(as_of - 14.days) do
+      card.close
+      card.reopen
+    end
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "a burst must be followed by the full two weeks of inactivity" do
+    as_of = Time.current
+    exactly = create_card(at: as_of - 30.days)
+    just_short = create_card(at: as_of - 30.days)
+
+    travel_to(as_of - 14.days) do
+      exactly.toggle_assignment(users(:kevin))
+    end
+    travel_to(as_of - 14.days + 1.hour) do
+      just_short.toggle_assignment(users(:jz))
+    end
+
+    travel_to(as_of) do
+      assert_predicate exactly.reload, :stalled?
+      assert_not_predicate just_short.reload, :stalled?
+    end
+  end
+
+  test "a later comment resets a burst until another burst occurs" do
+    as_of = Time.current
+    card = create_card(at: as_of - 40.days)
+
+    travel_to(as_of - 31.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+    add_comment(card, users(:david), at: as_of - 15.days)
+
+    travel_to(as_of) do
+      assert_not_predicate card.reload, :stalled?
+    end
+
+    travel_to(as_of - 14.days) do
+      card.toggle_assignment(users(:jz))
+    end
+
+    travel_to(as_of) do
+      assert_predicate card.reload, :stalled?
+    end
+  end
+
+  test "touching card activity after a burst resets it" do
+    as_of = Time.current
+    card = create_card(at: as_of - 40.days)
+
+    travel_to(as_of - 31.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+    travel_to(as_of - 15.days) do
+      card.touch_last_active_at
+    end
+
+    travel_to(as_of) do
+      assert_not_predicate card.reload, :stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "a later reaction resets a burst" do
+    as_of = Time.current
+    card = create_card(at: as_of - 40.days)
+
+    travel_to(as_of - 31.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+    travel_to(as_of - 15.days) do
+      card.reactions.create!(content: "🎉", reacter: users(:kevin))
+    end
+
+    travel_to(as_of) do
+      assert_not_predicate card.reload, :stalled?
+    end
+  end
+
+  test "a later non-burst card event resets a burst" do
+    as_of = Time.current
+    card = create_card(at: as_of - 40.days)
+
+    travel_to(as_of - 31.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+    travel_to(as_of - 15.days) do
+      card.close
+    end
+
+    travel_to(as_of) do
+      assert_not_predicate card.reload, :stalled?
+    end
+  end
+
+  test "publishing counts as activity and resets a burst" do
+    as_of = Time.current
+    card = create_card(at: as_of - 40.days)
+
+    travel_to(as_of - 31.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+    travel_to(as_of - 15.days) do
+      card.publish
+    end
+
+    travel_to(as_of) do
+      assert_not_predicate card.reload, :stalled?
+    end
+  end
+
+  test "the stalled card filter accepts stalled cards" do
+    as_of = Time.current
+    card = create_card(at: as_of - 30.days)
+    travel_to(as_of - 14.days) do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    travel_to(as_of) do
+      assert_includes Filter::INDEXES, "stalled"
+      assert_includes users(:david).filters.new(indexed_by: "stalled").cards, card
+    end
+  end
+
+  test "the stalled filter includes closed and postponed cards" do
+    as_of = Time.current
+    closed = create_card(at: as_of - 40.days)
+    postponed = create_card(at: as_of - 40.days)
+
+    travel_to(as_of - 30.days) do
+      closed.close
+      postponed.postpone
+    end
+    travel_to(as_of - 14.days) do
+      closed.toggle_assignment(users(:kevin))
+      postponed.toggle_assignment(users(:jz))
+    end
+
+    travel_to(as_of) do
+      stalled_cards = users(:david).filters.new(indexed_by: "stalled").cards
+      assert_includes stalled_cards, closed
+      assert_includes stalled_cards, postponed
+    end
+  end
+
+  private
+    def create_card(board: boards(:writebook), at: Time.current - 60.days, status: :published)
+      card = nil
+
+      travel_to(at) do
+        card = board.cards.create!(title: "A stalled candidate", creator: users(:david), status: status)
+      end
+
+      card
+    end
+
+    def add_comment(card, creator, at:)
+      travel_to(at) do
+        card.comments.create!(body: "A comment", creator: creator)
+      end
+    end
+end
