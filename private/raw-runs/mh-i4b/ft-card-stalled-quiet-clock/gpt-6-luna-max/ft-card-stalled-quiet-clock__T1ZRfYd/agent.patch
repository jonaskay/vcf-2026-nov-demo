diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..f736cf3
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,117 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  ACTIVITY_TIMESTAMP_TOLERANCE = 1.second
+
+  def self.no_activity_after_sql(burst_at)
+    <<~SQL.squish
+      NOT EXISTS (
+        SELECT 1
+        FROM comments AS later_comments
+        WHERE later_comments.card_id = cards.id
+          AND later_comments.created_at > #{burst_at}
+      )
+      AND NOT EXISTS (
+        SELECT 1
+        FROM events AS later_events
+        WHERE later_events.eventable_type = 'Card'
+          AND later_events.eventable_id = cards.id
+          AND later_events.created_at > #{burst_at}
+      )
+      AND NOT EXISTS (
+        SELECT 1
+        FROM assignments AS later_assignments
+        WHERE later_assignments.card_id = cards.id
+          AND later_assignments.created_at > #{burst_at}
+      )
+      AND NOT EXISTS (
+        SELECT 1
+        FROM reactions AS later_reactions
+        WHERE later_reactions.created_at > #{burst_at}
+          AND (
+            (later_reactions.reactable_type = 'Card' AND later_reactions.reactable_id = cards.id)
+            OR EXISTS (
+              SELECT 1
+              FROM comments AS reaction_comments
+              WHERE later_reactions.reactable_type = 'Comment'
+                AND reaction_comments.id = later_reactions.reactable_id
+                AND reaction_comments.card_id = cards.id
+            )
+          )
+      )
+    SQL
+  end
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      auto_close_period = <<~SQL.squish
+        COALESCE(
+          (SELECT board_entropy.auto_postpone_period
+           FROM entropies AS board_entropy
+           WHERE board_entropy.container_type = 'Board'
+             AND board_entropy.container_id = cards.board_id),
+          (SELECT account_entropy.auto_postpone_period
+           FROM entropies AS account_entropy
+           WHERE account_entropy.container_type = 'Account'
+             AND account_entropy.container_id = cards.account_id)
+        )
+      SQL
+      comment_window_start = connection.date_subtract("stalled_burst_comment.created_at", "(#{auto_close_period} / 3)")
+
+      where("cards.last_active_at <= ?", as_of - STALLED_AFTER)
+        .where(<<~SQL.squish)
+          EXISTS (
+            SELECT 1
+            FROM events AS stalled_burst_event
+            WHERE stalled_burst_event.eventable_type = 'Card'
+              AND stalled_burst_event.eventable_id = cards.id
+              AND stalled_burst_event.action IN ('card_assigned', 'card_reopened')
+              AND stalled_burst_event.created_at >= #{connection.date_subtract("cards.last_active_at", Card::Stalled::ACTIVITY_TIMESTAMP_TOLERANCE.to_i.to_s)}
+              AND stalled_burst_event.created_at <= cards.last_active_at
+              AND #{Card::Stalled.no_activity_after_sql('stalled_burst_event.created_at')}
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM assignments AS stalled_burst_assignment
+            WHERE stalled_burst_assignment.card_id = cards.id
+              AND stalled_burst_assignment.created_at >= #{connection.date_subtract("cards.last_active_at", Card::Stalled::ACTIVITY_TIMESTAMP_TOLERANCE.to_i.to_s)}
+              AND stalled_burst_assignment.created_at <= cards.last_active_at
+              AND #{Card::Stalled.no_activity_after_sql('stalled_burst_assignment.created_at')}
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments AS stalled_burst_comment
+            INNER JOIN users AS stalled_burst_commenter ON stalled_burst_commenter.id = stalled_burst_comment.creator_id
+            WHERE stalled_burst_comment.card_id = cards.id
+              AND stalled_burst_comment.created_at >= #{connection.date_subtract("cards.last_active_at", Card::Stalled::ACTIVITY_TIMESTAMP_TOLERANCE.to_i.to_s)}
+              AND stalled_burst_comment.created_at <= cards.last_active_at
+              AND stalled_burst_commenter.role <> 'system'
+              AND (
+                SELECT COUNT(*)
+                FROM comments AS burst_window_comments
+                INNER JOIN users AS burst_window_commenters ON burst_window_commenters.id = burst_window_comments.creator_id
+                WHERE burst_window_comments.card_id = cards.id
+                  AND burst_window_comments.created_at >= #{comment_window_start}
+                  AND burst_window_comments.created_at <= stalled_burst_comment.created_at
+                  AND burst_window_commenters.role <> 'system'
+              ) >= 3
+              AND (
+                SELECT COUNT(DISTINCT burst_window_comments.creator_id)
+                FROM comments AS burst_window_comments
+                INNER JOIN users AS burst_window_commenters ON burst_window_commenters.id = burst_window_comments.creator_id
+                WHERE burst_window_comments.card_id = cards.id
+                  AND burst_window_comments.created_at >= #{comment_window_start}
+                  AND burst_window_comments.created_at <= stalled_burst_comment.created_at
+                  AND burst_window_commenters.role <> 'system'
+              ) >= 2
+              AND #{Card::Stalled.no_activity_after_sql('stalled_burst_comment.created_at')}
+          )
+        SQL
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    self.class.stalled(as_of).where(id: id).exists?
+  end
+end
