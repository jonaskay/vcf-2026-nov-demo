+++ b/test/controllers/cards/stalled_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class CardsStalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "cards index displays stalled cards in HTML when indexed by stalled" do
+    as_of = Time.current
+    card = create_stalled_card(as_of)
+
+    travel_to(as_of) do
+      get cards_path(indexed_by: "stalled")
+
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+      assert_includes response.body, card.title
+    end
+  end
+
+  test "cards index filters and marks stalled cards in JSON" do
+    as_of = Time.current
+    card = create_stalled_card(as_of)
+
+    travel_to(as_of) do
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+      assert_response :success
+      assert_equal [ card.number ], response.parsed_body.pluck("number")
+      assert_equal true, response.parsed_body.first["stalled"]
+    end
+  end
+
+  test "the permanent card view shows the stalled state" do
+    as_of = Time.current
+    card = create_stalled_card(as_of)
+
+    travel_to(as_of) do
+      get card_path(card)
+
+      assert_response :success
+      assert_select ".card--stalled"
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "a cached card becomes stalled as time passes without activity" do
+    as_of = Time.current
+    card = create_stalled_card(as_of + 2.days)
+
+    travel_to(as_of) do
+      get card_path(card)
+      assert_response :success
+      assert_select ".card--stalled", count: 0
+    end
+
+    travel_to(as_of + 1.day) do
+      get card_path(card)
+      assert_response :success
+      assert_select ".card--stalled"
+    end
+  end
+
+  test "draft cards show stalled state after an assignment burst" do
+    as_of = Time.current
+    card = nil
+
+    travel_to(as_of - 30.days) do
+      card = boards(:writebook).cards.create!(title: "Stalled draft", creator: users(:kevin), status: :drafted)
+    end
+    travel_to(as_of - 15.days) do
+      card.assignments.create!(assignee: users(:david), assigner: users(:kevin))
+    end
+
+    travel_to(as_of) do
+      get card_draft_path(card)
+
+      assert_response :success
+      assert_select ".card--stalled .card__stalled", text: "Stalled"
+    end
+  end
+
+  test "the cached card preview becomes stalled as time passes" do
+    as_of = Time.current
+    card = create_stalled_card(as_of + 2.days)
+
+    travel_to(as_of) do
+      get cards_path
+      assert_response :success
+      assert_select "article[data-id=?] .card__stalled", card.number.to_s, count: 0
+    end
+
+    travel_to(as_of + 1.day) do
+      get cards_path
+      assert_response :success
+      assert_select "article[data-id=?] .card__stalled", card.number.to_s
+    end
+  end
+
+  test "card show JSON includes the stalled state" do
+    as_of = Time.current
+    card = create_stalled_card(as_of)
+
+    travel_to(as_of) do
+      get card_path(card, format: :json)
+
+      assert_response :success
+      assert_equal true, response.parsed_body["stalled"]
+    end
+  end
+
+  private
+    def create_stalled_card(as_of)
+      card = nil
+      travel_to(as_of - 30.days) do
+        card = boards(:writebook).cards.create!(title: "Stalled request card", creator: users(:kevin), status: :published)
+      end
+      travel_to(as_of - 15.days) do
+        card.toggle_assignment(users(:david))
+      end
+      card
+    end
+end
