diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..2bd348b
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @board.update! auto_postpone_period: 3.days.to_i
+  end
+
+  test "a card with three comments from two people in one third of the auto-close period stalls after two inactive weeks" do
+    card = create_card
+    first_comment_time = Time.current.change(usec: 0)
+
+    travel_to first_comment_time do
+      create_comment(card, users(:david), created_at: first_comment_time - 1.day)
+      create_comment(card, users(:kevin), created_at: first_comment_time)
+      create_comment(card, users(:david), created_at: first_comment_time)
+    end
+
+    card.reload
+    burst_time = card.burst_at
+    assert_not_nil burst_time
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    travel_to burst_time + 2.weeks - 1.second do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+
+    travel_to burst_time + 2.weeks do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "a comment burst requires at least three comments from two non-system people" do
+    same_author_card = create_card
+    create_comment(same_author_card, users(:david))
+    create_comment(same_author_card, users(:david))
+    create_comment(same_author_card, users(:david))
+    assert_nil same_author_card.reload.burst_at
+
+    system_comment_card = create_card
+    create_comment(system_comment_card, users(:david))
+    create_comment(system_comment_card, users(:kevin))
+    create_comment(system_comment_card, users(:system))
+    assert_nil system_comment_card.reload.burst_at
+  end
+
+  test "comments outside the one-third auto-close window do not make a burst" do
+    card = create_card
+    now = Time.current
+
+    create_comment(card, users(:david), created_at: now - 1.day - 1.second)
+    create_comment(card, users(:kevin), created_at: now)
+    create_comment(card, users(:david), created_at: now)
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "assigning someone to a card creates a burst" do
+    card = create_card
+
+    card.toggle_assignment(users(:kevin))
+
+    assert_not_nil card.reload.burst_at
+
+    card.toggle_assignment(users(:kevin))
+    assert_nil card.reload.burst_at, "unassigning is activity but is not a burst"
+  end
+
+  test "reopening a card creates a burst" do
+    card = cards(:shipping)
+
+    card.reopen
+
+    assert_not_nil card.reload.burst_at
+  end
+
+  test "ordinary activity after a burst resets it" do
+    card = create_card
+    card.toggle_assignment(users(:kevin))
+    assert_not_nil card.reload.burst_at
+
+    create_comment(card, users(:jz))
+    assert_nil card.reload.burst_at
+
+    travel_to 2.weeks.from_now do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "cache version changes when a card becomes stalled without a database update" do
+    card = create_card
+    burst_time = Time.current.change(usec: 0)
+    card.update!(burst_at: burst_time, last_active_at: burst_time)
+    cache_version = card.cache_version
+
+    travel_to burst_time + 2.weeks do
+      assert card.stalled?
+      assert_not_equal cache_version, card.cache_version
+    end
+  end
+
+  private
+    def create_card
+      @board.cards.create!(title: "Stalled test card", creator: users(:david), status: :published).reload
+    end
+
+    def create_comment(card, creator, created_at: Time.current)
+      card.comments.create!(body: "A comment", creator: creator, created_at: created_at)
+    end
+end
