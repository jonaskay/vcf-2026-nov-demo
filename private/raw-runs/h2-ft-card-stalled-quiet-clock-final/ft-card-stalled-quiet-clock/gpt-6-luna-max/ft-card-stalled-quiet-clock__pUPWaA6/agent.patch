diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..8e93644
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,41 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  COMMENT_BURST_THRESHOLD = 3
+  COMMENT_BURST_PEOPLE_THRESHOLD = 2
+  COMMENT_BURST_PERIOD_DIVISOR = 3
+
+  included do
+    scope :stalled, -> {
+      where(burst_at: ..(Time.current - STALLED_AFTER))
+        .where("cards.last_active_at <= cards.burst_at")
+    }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= burst_at && burst_at <= Time.current - STALLED_AFTER
+  end
+
+  def record_burst
+    update!(burst_at: Time.current)
+  end
+
+  def record_comment_burst(comment)
+    return if comment.creator.system?
+
+    window_end = comment.created_at
+    window_start = window_end - auto_postpone_period.to_f / COMMENT_BURST_PERIOD_DIVISOR
+    recent_comments = comments.by_user.where(created_at: window_start..window_end)
+
+    if recent_comments.count >= COMMENT_BURST_THRESHOLD &&
+        recent_comments.distinct.count(:creator_id) >= COMMENT_BURST_PEOPLE_THRESHOLD
+      record_burst
+    end
+  end
+
+  def cache_version
+    version = super
+    version && "#{version}-#{stalled?}"
+  end
+end
