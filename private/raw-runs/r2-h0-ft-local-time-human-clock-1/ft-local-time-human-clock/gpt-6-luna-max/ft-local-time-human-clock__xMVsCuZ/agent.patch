 import { Controller } from "@hotwired/stimulus"
+import { put } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
 
 export default class extends Controller {
+  #pendingTimezoneSync
+
   connect() {
-    this.#setTimezoneCookie()
+    this.synchronizeTimezone = this.#synchronizeTimezone.bind(this)
+    document.addEventListener("turbo:load", this.synchronizeTimezone)
+    this.#synchronizeTimezone()
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:load", this.synchronizeTimezone)
   }
 
-  #setTimezoneCookie() {
+  #synchronizeTimezone() {
     const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+
+    this.#setTimezoneCookie(timezone)
+    this.#updateUserTimezone(timezone)
+  }
+
+  #setTimezoneCookie(timezone) {
     document.cookie = `timezone=${encodeURIComponent(timezone)}; path=/`
   }
+
+  #updateUserTimezone(timezone) {
+    const userId = getMetaContent("current-user-id")
+    const updateUrl = getMetaContent("timezone-update-url")
+    const syncValue = `${userId}:${timezone}`
+
+    if (userId && updateUrl && this.#timezoneSyncValue !== syncValue && this.#pendingTimezoneSync !== syncValue) {
+      this.#pendingTimezoneSync = syncValue
+
+      put(updateUrl, { body: { timezone_name: timezone } }).then(response => {
+        if (response.ok) this.#setTimezoneSyncValue(syncValue)
+      }).catch(() => {}).finally(() => {
+        if (this.#pendingTimezoneSync === syncValue) this.#pendingTimezoneSync = null
+      })
+    }
+  }
+
+  get #timezoneSyncValue() {
+    const cookie = document.cookie.split("; ").find(cookie => cookie.startsWith("timezone-sync="))
+    const value = cookie?.split("=").slice(1).join("=")
+    return value ? decodeURIComponent(value) : null
+  }
+
+  #setTimezoneSyncValue(value) {
+    document.cookie = `timezone-sync=${encodeURIComponent(value)}; path=/`
+  }
 }
