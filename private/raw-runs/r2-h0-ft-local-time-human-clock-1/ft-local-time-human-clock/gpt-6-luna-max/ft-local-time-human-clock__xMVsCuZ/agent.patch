diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..a1771c3
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders UTC timestamp for client-side formatting" do
+    timestamp = Time.utc(2025, 9, 12, 20, 42)
+
+    html = local_time_tag(timestamp, format: "comment")
+    time_tag = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal timestamp.iso8601(6), time_tag["datetime"]
+    assert_equal timestamp.iso8601(6), time_tag.text
+    assert_equal "local-time", time_tag["data-controller"]
+    assert_equal "comment", time_tag["data-local-time-format-value"]
+  end
+
+  test "renders calendar dates without a timezone offset" do
+    date = Date.new(2025, 9, 12)
+
+    html = local_date_tag(date, format: "full-date")
+    time_tag = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "2025-09-12", time_tag["datetime"]
+    assert_equal "2025-09-12", time_tag.text
+    assert_equal "true", time_tag["data-local-time-date-only-value"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..ec33d3e
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,76 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats timestamps and relative dates in the browser timezone" do
+    sign_in_as(users(:kevin))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    visit card_url(cards(:logo))
+
+    assert_equal "America/Los_Angeles", page.evaluate_script("Intl.DateTimeFormat().resolvedOptions().timeZone")
+    assert_equal "America/Los_Angeles", wait_for_user_timezone(users(:kevin))
+
+    add_timestamp_to_page("2025-09-13T00:42:00.000Z", "time", id: "local-clock")
+    assert_selector "#local-clock", text: "5:42 PM"
+
+    add_calendar_date_to_page("2025-09-13", "full-date", id: "local-calendar-date")
+    assert_selector "#local-calendar-date", text: "Saturday, September 13"
+
+    assert_equal "5:42 PM", format_timestamp("2025-09-13T00:42:00.000Z", "comment", "2025-09-13T02:42:00.000Z")
+    assert_equal "yesterday", format_timestamp("2025-09-12T04:00:00.000Z", "comment", "2025-09-13T02:42:00.000Z")
+    assert_equal "5 days ago", format_timestamp("2025-09-08T00:42:00.000Z", "comment", "2025-09-13T02:42:00.000Z")
+    assert_equal "Sep 4", format_timestamp("2025-09-05T00:42:00.000Z", "comment", "2025-09-13T02:42:00.000Z")
+    assert_equal "tomorrow", format_timestamp("2025-09-13T12:00:00.000Z", "future", "2025-09-13T02:42:00.000Z")
+    assert_equal "in 3 days", format_timestamp("2025-09-15T12:00:00.000Z", "future", "2025-09-13T02:42:00.000Z")
+    assert_equal "Saturday, September 13", format_timestamp("2025-09-13", "full-date", "2025-09-13T02:42:00.000Z", true)
+  end
+
+  private
+    def wait_for_user_timezone(user)
+      timeout_at = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 5
+
+      loop do
+        timezone = user.reload.timezone.name
+        return timezone if timezone == "America/Los_Angeles"
+        break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= timeout_at
+        sleep 0.05
+      end
+
+      user.reload.timezone.name
+    end
+
+    def add_timestamp_to_page(timestamp, format, id:)
+      page.execute_script(<<~JS, timestamp, format, id)
+        const [timestamp, format, id] = arguments
+        const element = document.createElement("time")
+        element.id = id
+        element.dateTime = timestamp
+        element.dataset.controller = "local-time"
+        element.dataset.localTimeFormatValue = format
+        document.body.append(element)
+      JS
+    end
+
+    def add_calendar_date_to_page(date, format, id:)
+      page.execute_script(<<~JS, date, format, id)
+        const [date, format, id] = arguments
+        const element = document.createElement("time")
+        element.id = id
+        element.dateTime = date
+        element.dataset.controller = "local-time"
+        element.dataset.localTimeFormatValue = format
+        element.dataset.localTimeDateOnlyValue = "true"
+        document.body.append(element)
+      JS
+    end
+
+    def format_timestamp(timestamp, format, now, date_only = false)
+      page.driver.browser.execute_async_script(<<~JS, timestamp, format, now, date_only)
+        const [timestamp, format, now, dateOnly] = arguments
+        const done = arguments[arguments.length - 1]
+
+        import("helpers/date_helpers").then(({ formatTimestamp }) => {
+          done(formatTimestamp(timestamp, format, new Date(now), dateOnly))
+        }).catch(error => done({ error: error.message }))
+      JS
+    end
+end
