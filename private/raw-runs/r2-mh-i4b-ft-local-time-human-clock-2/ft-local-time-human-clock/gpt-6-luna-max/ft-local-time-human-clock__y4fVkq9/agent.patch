diff --git a/app/javascript/lib/local_time.js b/app/javascript/lib/local_time.js
new file mode 100644
index 0000000..4b6190f
--- /dev/null
+++ b/app/javascript/lib/local_time.js
@@ -0,0 +1,92 @@
+const clockFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const shortDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const longDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const dayFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const relativeTimeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "always" })
+const numericDateTimeFormatter = new Intl.DateTimeFormat("en-US", {
+  month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit"
+})
+
+function parseLocalTime(value) {
+  const dateOnly = value.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+
+  if (dateOnly) {
+    return new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+  } else {
+    return new Date(value)
+  }
+}
+
+function localDayNumber(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / 86_400_000
+}
+
+function relativeTime(date) {
+  const seconds = (date.getTime() - Date.now()) / 1000
+  const absoluteSeconds = Math.abs(seconds)
+
+  if (absoluteSeconds < 60) {
+    return seconds < 0 ? "less than a minute ago" : "in less than a minute"
+  } else if (absoluteSeconds < 60 * 60) {
+    return relativeTimeFormatter.format(Math.round(seconds / 60), "minute")
+  } else if (absoluteSeconds < 24 * 60 * 60) {
+    return relativeTimeFormatter.format(Math.round(seconds / (60 * 60)), "hour")
+  } else if (absoluteSeconds < 7 * 24 * 60 * 60) {
+    return relativeTimeFormatter.format(Math.round(seconds / (24 * 60 * 60)), "day")
+  } else if (absoluteSeconds < 30 * 24 * 60 * 60) {
+    return relativeTimeFormatter.format(Math.round(seconds / (7 * 24 * 60 * 60)), "week")
+  } else if (absoluteSeconds < 365 * 24 * 60 * 60) {
+    return relativeTimeFormatter.format(Math.round(seconds / (30 * 24 * 60 * 60)), "month")
+  } else {
+    return relativeTimeFormatter.format(Math.round(seconds / (365 * 24 * 60 * 60)), "year")
+  }
+}
+
+function commentTime(date) {
+  const daysAgo = localDayNumber(new Date()) - localDayNumber(date)
+
+  if (daysAgo === 0) {
+    return clockFormatter.format(date)
+  } else if (daysAgo === 1) {
+    return "yesterday"
+  } else if (daysAgo > 1 && daysAgo < 7) {
+    return `${daysAgo} days ago`
+  } else {
+    return shortDateFormatter.format(date)
+  }
+}
+
+function futureDate(date) {
+  const daysFromToday = localDayNumber(date) - localDayNumber(new Date())
+
+  if (daysFromToday === 0) {
+    return "today"
+  } else if (daysFromToday === 1) {
+    return "tomorrow"
+  } else if (daysFromToday > 1) {
+    return `in ${daysFromToday} days`
+  } else if (daysFromToday === -1) {
+    return "yesterday"
+  } else {
+    return `${Math.abs(daysFromToday)} days ago`
+  }
+}
+
+export function formatLocalTime(value, format) {
+  if (!value) return ""
+
+  const date = parseLocalTime(value)
+  if (Number.isNaN(date.getTime())) return value
+
+  switch (format) {
+    case "comment": return commentTime(date)
+    case "relative": return relativeTime(date)
+    case "future": return futureDate(date)
+    case "clock": return clockFormatter.format(date)
+    case "date": return shortDateFormatter.format(date)
+    case "long_date": return longDateFormatter.format(date)
+    case "day": return dayFormatter.format(date)
+    case "date_time": return numericDateTimeFormatter.format(date)
+    default: return value
+  }
+}
