diff --git a/app/helpers/local_time_helper.rb b/app/helpers/local_time_helper.rb
new file mode 100644
index 0000000..9fef462
--- /dev/null
+++ b/app/helpers/local_time_helper.rb
@@ -0,0 +1,12 @@
+module LocalTimeHelper
+  include ActionView::Helpers::TagHelper
+
+  def local_time_tag(value, format:, **options)
+    timestamp = value.respond_to?(:utc) ? value.utc.iso8601(6) : value.iso8601
+    data = options.delete(:data) || {}
+
+    tag.time timestamp, datetime: timestamp,
+      data: { controller: "local-time", local_time_format_value: format, **data },
+      **options
+  end
+end
