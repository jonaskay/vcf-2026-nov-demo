diff --git a/test/controllers/local_time_rendering_test.rb b/test/controllers/local_time_rendering_test.rb
new file mode 100644
index 0000000..48f86e2
--- /dev/null
+++ b/test/controllers/local_time_rendering_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card comments and metadata expose raw timestamps to the browser" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_timestamp_tag comment.created_at
+    assert_timestamp_tag card.created_at
+    assert_timestamp_tag card.last_active_at
+  end
+
+  test "auto-close notice exposes its raw timestamp to the browser" do
+    card = cards(:logo)
+    auto_close_at = Time.current + 3.days
+    card.update_column(:last_active_at, auto_close_at - card.auto_postpone_period)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_timestamp_tag auto_close_at
+  end
+
+  test "closed card stamps expose raw dates to the browser" do
+    card = cards(:shipping)
+
+    get card_path(card)
+
+    assert_response :success
+    assert_timestamp_tag card.closed_at
+    assert_select "time[datetime=?]", card.entropy.auto_clean_at.utc.iso8601(6), count: 0
+  end
+
+  test "filtered card list exposes timestamps to the browser" do
+    get cards_path(indexed_by: "maybe")
+
+    assert_response :success
+    assert_select ".card__meta-text--added time[datetime]"
+  end
+
+  test "timestamp markup is identical for viewers in different timezones" do
+    cookies[:timezone] = "UTC"
+    get card_path(cards(:logo))
+    utc_timestamps = rendered_timestamps
+
+    cookies[:timezone] = "America/Los_Angeles"
+    get card_path(cards(:logo))
+
+    assert_equal utc_timestamps, rendered_timestamps
+  end
+
+  test "comment JSON contains the unformatted timestamp" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comments_path(comment.card, format: :json)
+
+    assert_response :success
+    json_comment = @response.parsed_body.find { |item| item["id"] == comment.id }
+    assert_equal comment.created_at.to_i, Time.iso8601(json_comment.fetch("created_at")).to_i
+  end
+
+  private
+    def rendered_timestamps
+      css_select("time[datetime]").map do |tag|
+        [ tag["datetime"], tag.text ]
+      end
+    end
+
+    def assert_timestamp_tag(timestamp)
+      element = css_select("time[datetime]").find { |tag| Time.iso8601(tag["datetime"]).to_i == timestamp.to_i }
+      assert element, "Expected a time tag for #{timestamp.iso8601}"
+      assert_equal element["datetime"], element.text
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..3978125
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,91 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+  end
+
+  test "a comment from two hours ago uses the browser's local clock" do
+    card = cards(:logo)
+    timestamp = Time.at(page.evaluate_script("Date.now() / 1000.0")).utc - 2.hours
+    comment = comment_at(card, timestamp, "Recent comment")
+
+    visit card_path(card)
+
+    expected = page.evaluate_script("new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' }).format(new Date('#{timestamp.iso8601}'))")
+    assert_equal expected, comment_timestamp(comment)
+  end
+
+  test "a comment from last night says yesterday and older comments use relative dates" do
+    card = cards(:logo)
+    yesterday = local_date(-1, 21, 42)
+    five_days_ago = local_date(-5, 12, 0)
+    six_days_ago = local_date(-6, 12, 0)
+    seven_days_ago = local_date(-7, 12, 0)
+    yesterday_comment = comment_at(card, yesterday, "Last night")
+    five_day_comment = comment_at(card, five_days_ago, "Earlier this week")
+    six_day_comment = comment_at(card, six_days_ago, "Nearly a week ago")
+    seven_day_comment = comment_at(card, seven_days_ago, "A week ago")
+
+    visit card_path(card)
+
+    assert_equal "yesterday", comment_timestamp(yesterday_comment)
+    assert_equal "5 days ago", comment_timestamp(five_day_comment)
+    assert_equal "6 days ago", comment_timestamp(six_day_comment)
+    expected_date = page.evaluate_script("new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(new Date('#{seven_days_ago.iso8601}'))")
+    assert_equal expected_date, comment_timestamp(seven_day_comment)
+  end
+
+  test "an auto-closing card says tomorrow or in three days in the browser's calendar" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Pacific/Kiritimati")
+    page.execute_script("document.cookie = 'timezone=UTC; path=/'")
+
+    tomorrow_card = cards(:logo)
+    three_days_card = cards(:layout)
+    tomorrow = local_date(1, 0, 30)
+    three_days = local_date(3, 12, 0)
+    set_auto_close_at(tomorrow_card, tomorrow)
+    set_auto_close_at(three_days_card, three_days)
+
+    visit card_path(tomorrow_card)
+    assert_equal "tomorrow", timestamp_element(tomorrow, within: ".card-perma__closure-message").text
+    assert_match(/Closes\s*tomorrow/i, find(".bubble").text)
+
+    visit card_path(three_days_card)
+    assert_equal "in 3 days", timestamp_element(three_days, within: ".card-perma__closure-message").text
+    assert_match(/Closes in\s*3\s*days/i, find(".bubble").text)
+  end
+
+  private
+    def comment_timestamp(comment)
+      find("#comment_#{comment.id} .comment__permalink-title time[datetime]").text
+    end
+
+    def timestamp_element(timestamp, within: "body")
+      elements = find(within).all("time[datetime]")
+      elements.find { |element| Time.iso8601(element["datetime"]).to_i == timestamp.to_i } || flunk("No timestamp for #{timestamp.iso8601}")
+    end
+
+    def comment_at(card, timestamp, body)
+      comment = card.comments.create!(creator: users(:kevin), body: body)
+      comment.update_column(:created_at, timestamp)
+      comment
+    end
+
+    def local_date(days_from_today, hour, minute)
+      timestamp = page.evaluate_script(<<~JAVASCRIPT)
+        (() => {
+          const date = new Date()
+          date.setDate(date.getDate() + #{days_from_today})
+          date.setHours(#{hour}, #{minute}, 0, 0)
+          return date.toISOString()
+        })()
+      JAVASCRIPT
+      Time.iso8601(timestamp).utc
+    end
+
+    def set_auto_close_at(card, auto_close_at)
+      card.update_column(:last_active_at, auto_close_at - card.auto_postpone_period)
+    end
+end
