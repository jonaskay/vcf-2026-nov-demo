diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..3fb31b0
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,50 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide shadow center margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-end gap-half" do %>
+    <div class="flex flex-column gap-half flex-item-grow">
+      <%= label_tag :q, "Search card titles, descriptions, and comments" %>
+      <%= search_field_tag :q, @query, class: "input", autofocus: true, autocomplete: "off" %>
+    </div>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <% if @page.records.any? %>
+    <section class="panel panel--wide shadow center margin-block-start" aria-label="Search results">
+      <h2 class="txt-normal">Results for “<%= @query %>”</h2>
+
+      <%= with_automatic_pagination :search_results, @page do %>
+        <ol id="search-results" class="flex flex-column gap pad-inline-start">
+          <% @page.records.each do |card| %>
+            <li id="<%= dom_id(card, :search_result) %>">
+              <article>
+                <h3 class="txt-normal margin-none">
+                  <%= link_to highlight(card.title, @query), card_path(card) %>
+                </h3>
+                <p class="txt-small txt-subtle margin-none">In <%= link_to card.board.name, board_path(card.board) %></p>
+
+                <% if snippet = highlight_search_excerpt(card.description, @query) %>
+                  <p><%= snippet %></p>
+                <% end %>
+
+                <% @matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+                  <% if snippet = highlight_search_excerpt(comment.body, @query) %>
+                    <blockquote class="txt-small"><%= snippet %></blockquote>
+                  <% end %>
+                <% end %>
+              </article>
+            </li>
+          <% end %>
+        </ol>
+      <% end %>
+    </section>
+  <% else %>
+    <p class="blank-slate center margin-block-start">No cards found for “<%= @query %>”</p>
+  <% end %>
+<% end %>
