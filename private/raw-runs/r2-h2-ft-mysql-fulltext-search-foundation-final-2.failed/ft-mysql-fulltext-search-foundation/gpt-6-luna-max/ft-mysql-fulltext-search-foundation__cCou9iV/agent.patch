@@ -0,0 +1,32 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @matching_comments_by_card_id = {}
+
+    if @query.present?
+      @page = set_page_and_extract_portion_from search_results
+      @matching_comments_by_card_id = matching_comments_for(@page.records)
+    end
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards.published
+        .matching_text(@query)
+        .reverse_chronologically
+        .preload(:board)
+        .with_rich_text_description
+    end
+
+    def matching_comments_for(cards)
+      if cards.any?
+        Current.user.accessible_comments
+          .matching_text(@query)
+          .where(card_id: cards.map(&:id))
+          .includes(:rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
