diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..1859d26
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,40 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  COMMENTS_FOR_BURST = 3
+  COMMENTERS_FOR_BURST = 2
+
+  included do
+    scope :stalled, -> do
+      where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago)
+    end
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def register_burst!
+    update! last_burst_at: Time.current
+  end
+
+  def register_comment_burst(comment)
+    burst_window = board.auto_postpone_period / 3
+    comments_in_window = comments.by_user.where(created_at: (comment.created_at - burst_window)..comment.created_at)
+
+    if comments_in_window.count >= COMMENTS_FOR_BURST && comments_in_window.distinct.count(:creator_id) >= COMMENTERS_FOR_BURST
+      register_burst!
+    end
+  end
+
+  def cache_key_with_version
+    cache_key_with_burst_status = super
+
+    if last_burst_at.present?
+      "#{cache_key_with_burst_status}-#{stalled?}"
+    else
+      cache_key_with_burst_status
+    end
+  end
+end
