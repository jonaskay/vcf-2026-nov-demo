diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..ef37118
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments by at least two people within a third of the board period mark a burst" do
+    freeze_time do
+      card = published_card
+
+      card.comments.create! creator: users(:david), body: "First", created_at: 28.days.ago
+      card.comments.create! creator: users(:david), body: "Second", created_at: 20.days.ago
+      card.comments.create! creator: users(:jz), body: "Third"
+
+      assert_equal Time.current, card.reload.last_burst_at
+    end
+  end
+
+  test "comments from only one person do not mark a burst" do
+    card = published_card
+
+    3.times do |index|
+      card.comments.create! creator: users(:david), body: "Comment #{index}"
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "two comments do not mark a burst" do
+    card = published_card
+    card.comments.create! creator: users(:david), body: "First"
+    card.comments.create! creator: users(:jz), body: "Second"
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments exactly one third of the board period apart mark a burst" do
+    freeze_time do
+      card = published_card
+      card.comments.create! creator: users(:david), body: "First", created_at: 30.days.ago
+      card.comments.create! creator: users(:jz), body: "Second"
+      card.comments.create! creator: users(:david), body: "Third"
+
+      assert_equal Time.current, card.reload.last_burst_at
+    end
+  end
+
+  test "comments outside a third of the board period do not mark a burst" do
+    card = published_card
+
+    card.comments.create! creator: users(:david), body: "First", created_at: 31.days.ago
+    card.comments.create! creator: users(:david), body: "Second", created_at: 20.days.ago
+    card.comments.create! creator: users(:jz), body: "Third"
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a comment burst" do
+    card = published_card
+
+    card.comments.create! creator: users(:david), body: "First"
+    card.comments.create! creator: users(:jz), body: "Second"
+    card.comments.create! creator: users(:system), body: "System update"
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "assignment and reopening mark a burst" do
+    card = published_card
+
+    card.toggle_assignment(users(:jz))
+    assert card.reload.last_burst_at
+
+    reopened_card = cards(:shipping)
+    reopened_card.reopen
+    assert reopened_card.reload.last_burst_at
+  end
+
+  test "a card is stalled only after two weeks without activity following a burst" do
+    freeze_time do
+      card = published_card
+      card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 14.days.ago + 1.second
+
+      assert_not card.stalled?
+      travel 1.second
+      assert card.stalled?
+
+      card.comments.create! creator: users(:david), body: "It's moving again"
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "assigning or reopening a stalled card resets its inactivity timer" do
+    card = published_card
+    card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 15.days.ago
+
+    card.toggle_assignment(users(:jz))
+    assert_not card.reload.stalled?
+
+    reopened_card = cards(:shipping)
+    reopened_card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 15.days.ago
+    reopened_card.reopen
+    assert_not reopened_card.reload.stalled?
+  end
+
+  test "the cache key changes when a card becomes stalled" do
+    freeze_time do
+      card = published_card
+      card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 14.days.ago + 1.second
+      active_cache_key = card.reload.cache_key_with_version
+
+      travel 1.second
+
+      assert_not_equal active_cache_key, card.reload.cache_key_with_version
+    end
+  end
+
