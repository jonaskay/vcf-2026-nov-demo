diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..a1ada10
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comments newest first with highlighted matches" do
+    title_match = create_card(title: "A NeedLe in the title", created_at: 3.hours.ago)
+    description_match = create_card(title: "Description result", description: "A needle in the description", created_at: 2.hours.ago)
+    comment_match = create_card(title: "Comment result", created_at: 1.hour.ago)
+    create_comment(comment_match, "A needle in the comment")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    results = css_select(".search-result")
+    assert_equal [ comment_match.id, description_match.id, title_match.id ], results.map { |result| result["data-card-id"] }
+    assert_select ".search-result[data-card-id='#{title_match.id}'] mark", text: /needle/i
+    assert_select ".search-result[data-card-id='#{description_match.id}'] mark", text: /needle/i
+    assert_select ".search-result[data-card-id='#{comment_match.id}'] mark", text: /needle/i
+  end
+
+  test "does not find a draft or comments on a draft" do
+    draft = create_card(title: "draftneedle card", description: "draftneedle description")
+    create_comment(draft, "draftneedle comment")
+    draft.update_column(:status, "drafted")
+
+    get search_path(q: "draftneedle")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select ".search-result mark", count: 0
+  end
+
+  test "stops returning a card after access to its board is revoked" do
+    card = create_card(title: "private card", board: boards(:private))
+    create_comment(card, "private needle")
+
+    get search_path(q: "needle")
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{card.id}']"
+
+    boards(:private).accesses.revoke_from(users(:kevin))
+
+    get search_path(q: "needle")
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{card.id}']", count: 0
+  end
+
+  test "escapes search terms and highlights text safely" do
+    card = create_card(title: "C++ guide <script>alert(1)</script>")
+
+    get search_path(q: "C++")
+
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{card.id}'] mark", text: "C++"
+    assert_no_match "<script>", response.body
+  end
+
+  test "treats SQL wildcard characters as literal search text" do
+    matching_card = create_card(title: "100%_ready to ship")
+    create_card(title: "100XYready to ship")
+
+    get search_path(q: "100%_ready")
+
+    assert_response :success
+    assert_equal [ matching_card.id ], css_select(".search-result").map { |result| result["data-card-id"] }
+    assert_select ".search-result mark", text: "100%_ready"
+  end
+
+  test "an empty query has no results" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select "form input[name='q']"
+  end
+
+  private
+    def create_card(title:, description: nil, created_at: Time.current, board: boards(:writebook))
+      with_current_user(users(:kevin)) do
+        card = board.cards.create!(
+          creator: users(:kevin),
+          title: title,
+          description: description,
+          status: "published"
+        )
+        card.update_column(:created_at, created_at)
+        card
+      end
+    end
+
+    def create_comment(card, body)
+      with_current_user(users(:kevin)) do
+        card.comments.create!(creator: users(:kevin), body: body)
+      end
+    end
+end
