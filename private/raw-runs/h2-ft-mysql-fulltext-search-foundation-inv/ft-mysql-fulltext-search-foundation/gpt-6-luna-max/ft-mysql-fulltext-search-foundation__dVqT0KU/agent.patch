+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = set_page_and_extract_portion_from(search_results)
+    @comment_matches = matching_comments_for(@cards)
+  end
+
+  private
+    def search_results
+      if @query.present?
+        Current.user.accessible_cards.matching(@query)
+          .reverse_chronologically
+          .preload(:board, :rich_text_description)
+      else
+        Current.user.accessible_cards.none
+      end
+    end
+
+    def matching_comments_for(cards)
+      card_ids = cards.map(&:id)
+
+      if card_ids.any?
+        Current.user.accessible_comments
+          .where(card_id: card_ids)
+          .joins(:rich_text_body)
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", search_pattern)
+          .preload(:rich_text_body)
+          .order(created_at: :desc, id: :desc)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+
+    def search_pattern
+      "%#{ActiveRecord::Base.sanitize_sql_like(@query, "!")}%"
+    end
+end
