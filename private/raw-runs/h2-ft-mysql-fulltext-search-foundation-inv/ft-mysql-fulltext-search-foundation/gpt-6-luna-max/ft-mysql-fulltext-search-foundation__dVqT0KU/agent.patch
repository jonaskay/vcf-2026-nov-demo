+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,8 @@
+module SearchHelper
+  def highlighted_search_excerpt(text, query)
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    match_excerpt = excerpt(plain_text, query, radius: 100) || plain_text.truncate(200)
+
+    highlight(match_excerpt, query)
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..40e0f68 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,37 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :matching, ->(term) do
+    if term.present?
+      search_term = "%#{ActiveRecord::Base.sanitize_sql_like(term, "!")}%"
+
+      published.where(<<~SQL.squish, search_term: search_term)
+        cards.title LIKE :search_term ESCAPE '!'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts AS card_descriptions
+          WHERE card_descriptions.record_type = 'Card'
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.account_id = cards.account_id
+            AND card_descriptions.name = 'description'
+            AND card_descriptions.body LIKE :search_term ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.account_id = comments.account_id
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comments.account_id = cards.account_id
+            AND comment_bodies.body LIKE :search_term ESCAPE '!'
+        )
+      SQL
+    else
+      none
+    end
+  end
+
   def card
     self
   end
