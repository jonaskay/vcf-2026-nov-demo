diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..bb26863
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,48 @@
+<% @page_title = "Search" %>
+
+<section class="panel borderless center margin pad">
+  <h1 class="margin-block-end">Search cards</h1>
+
+  <%= form_with url: search_path, method: :get, class: "flex align-center justify-center gap" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search card titles, descriptions, and comments…", class: "input full-width", autocorrect: "off", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="margin">
+    <h2 class="for-screen-reader">Search results</h2>
+
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% if @cards.any? %>
+        <ol class="flex flex-column gap pad-none">
+          <% @cards.each do |card| %>
+            <li class="search-result panel borderless pad" data-card-id="<%= card.id %>">
+              <article class="flex flex-column gap-half">
+                <header class="flex align-start justify-space-between gap">
+                  <h3 class="margin-none">
+                    <%= link_to highlight(card.title, @query), card_path(card) %>
+                  </h3>
+                  <%= link_to card.board.name, board_path(card.board), class: "txt-small overflow-ellipsis" %>
+                </header>
+
+                <% if card.description.present? %>
+                  <p class="txt-small margin-none"><%= highlighted_search_excerpt(card.description, @query) %></p>
+                <% end %>
+
+                <% if comment = @comment_matches[card.id]&.first %>
+                  <p class="txt-small margin-none">
+                    <%= icon_tag "comment" %>
+                    <%= highlighted_search_excerpt(comment.body, @query) %>
+                  </p>
+                <% end %>
+              </article>
+            </li>
+          <% end %>
+        </ol>
+      <% else %>
+        <p class="blank-slate">No cards match this search</p>
+      <% end %>
+    <% end %>
+  </section>
+<% end %>
