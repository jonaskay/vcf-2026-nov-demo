diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..6776830
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,66 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  QUIET_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      period = "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"
+      comment_window_start = connection.date_subtract("terminal_comments.created_at", "(#{period} / 3)")
+      system_role = connection.quote(User.roles.fetch("system"))
+
+      joins(board: :account)
+        .left_outer_joins(board: :entropy)
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+        # A burst only counts while it is still the card's latest activity.
+        .where("cards.last_active_at <= ?", Time.current - QUIET_PERIOD)
+        .where(<<~SQL.squish)
+          EXISTS (
+            SELECT 1 FROM events burst_events
+            WHERE burst_events.eventable_type = 'Card'
+              AND burst_events.eventable_id = cards.id
+              AND burst_events.action IN ('card_assigned', 'card_reopened')
+              AND burst_events.created_at = cards.last_active_at
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM events terminal_comment_events
+            JOIN comments terminal_comments ON terminal_comments.id = terminal_comment_events.eventable_id
+            JOIN users terminal_authors ON terminal_authors.id = terminal_comments.creator_id
+            WHERE terminal_comment_events.eventable_type = 'Comment'
+              AND terminal_comment_events.action = 'comment_created'
+              AND terminal_comments.card_id = cards.id
+              AND terminal_authors.role <> #{system_role}
+              AND terminal_comment_events.created_at = cards.last_active_at
+              AND (
+                SELECT COUNT(*)
+                FROM comments window_comments
+                JOIN users window_authors ON window_authors.id = window_comments.creator_id
+                WHERE window_comments.card_id = terminal_comments.card_id
+                  AND window_authors.role <> #{system_role}
+                  AND window_comments.created_at >= #{comment_window_start}
+                  AND window_comments.created_at <= terminal_comments.created_at
+              ) >= 3
+              AND EXISTS (
+                SELECT 1
+                FROM comments other_comments
+                JOIN users other_authors ON other_authors.id = other_comments.creator_id
+                WHERE other_comments.card_id = terminal_comments.card_id
+                  AND other_authors.role <> #{system_role}
+                  AND other_comments.creator_id <> terminal_comments.creator_id
+                  AND other_comments.created_at >= #{comment_window_start}
+                  AND other_comments.created_at <= terminal_comments.created_at
+              )
+          )
+        SQL
+    end
+  end
+
+  def stalled?
+    if persisted? && last_active_at <= Time.current - QUIET_PERIOD
+      self.class.stalled.where(id: id).exists?
+    else
+      false
+    end
+  end
+end
