diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..2dd4ce9
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    entropies(:writebook_board).update!(auto_postpone_period: 30.days)
+    entropies("37s_account").update!(auto_postpone_period: 90.days)
+  end
+
+  test "three comments from two people at the inclusive one-third period edge stall after fourteen quiet days" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, users(:jz), at: 35.days.ago)
+    add_comment(card, users(:david), at: 30.days.ago)
+    burst_at = 30.days.ago
+
+    travel_to(burst_at + 13.days) { assert_not card.reload.stalled? }
+    travel_to(burst_at + 14.days) { assert card.reload.stalled? }
+  end
+
+  test "three comments just inside one-third of the board period form a burst" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago + 1.hour)
+    add_comment(card, users(:jz), at: 35.days.ago)
+    add_comment(card, users(:david), at: 30.days.ago)
+
+    travel_to(16.days.ago) { assert card.reload.stalled? }
+  end
+
+  test "comments just outside one-third of the board period do not form a burst" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, users(:jz), at: 35.days.ago)
+    add_comment(card, users(:david), at: 30.days.ago + 1.hour)
+    burst_at = 30.days.ago + 1.hour
+
+    travel_to(burst_at + 14.days) { assert_not card.reload.stalled? }
+  end
+
+  test "four comments from at least two people form a burst" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, users(:jz), at: 37.days.ago)
+    add_comment(card, users(:david), at: 34.days.ago)
+    add_comment(card, users(:kevin), at: 30.days.ago)
+
+    travel_to(16.days.ago) { assert card.reload.stalled? }
+  end
+
+  test "three comments by only one person do not form a burst" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, users(:david), at: 35.days.ago)
+    add_comment(card, users(:david), at: 30.days.ago)
+
+    travel_to(16.days.ago) { assert_not card.reload.stalled? }
+  end
+
+  test "fewer than three comments do not form a burst" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, users(:jz), at: 35.days.ago)
+
+    travel_to(21.days.ago) { assert_not card.reload.stalled? }
+  end
+
+  test "system comments do not count toward a comment burst" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, accounts("37s").system_user, at: 35.days.ago)
+    add_comment(card, accounts("37s").system_user, at: 30.days.ago)
+
+    travel_to(16.days.ago) { assert_not card.reload.stalled? }
+  end
+
+  test "comment burst window uses the board override instead of the longer account period" do
+    freeze_time
+    card = create_card_at(50.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    add_comment(card, users(:jz), at: 30.days.ago)
+    add_comment(card, users(:david), at: 20.days.ago)
+
+    travel_to(6.days.ago) { assert_not card.reload.stalled? }
+  end
+
+  test "comment window uses the account period when the board has no override" do
+    freeze_time
+    entropies(:writebook_board).destroy!
+    entropies("37s_account").update!(auto_postpone_period: 90.days)
+    card = create_card_at(80.days.ago)
+    add_comment(card, users(:david), at: 60.days.ago)
+    add_comment(card, users(:jz), at: 45.days.ago)
+    add_comment(card, users(:david), at: 35.days.ago)
+    burst_at = 35.days.ago
+
+    travel_to(burst_at + 14.days) { assert card.reload.stalled? }
+  end
+
+  test "assigning someone to a card forms a burst without comments" do
+    freeze_time
+    card = create_card_at(20.days.ago)
+    assigned_at = 15.days.ago
+    travel_to(assigned_at) { card.toggle_assignment(users(:jz)) }
+
+    travel_to(assigned_at + 14.days) { assert card.reload.stalled? }
+  end
+
+  test "reopening a card forms a burst without comments" do
+    freeze_time
+    card = create_card_at(20.days.ago)
+    reopened_at = 15.days.ago
+    travel_to(reopened_at) do
+      card.close
+      card.reopen
+    end
+
+    travel_to(reopened_at + 14.days) { assert card.reload.stalled? }
+  end
+
+  test "a later comment resets the burst and requires a new burst" do
+    freeze_time
+    card = create_card_at(60.days.ago)
+    add_comment(card, users(:david), at: 50.days.ago)
+    add_comment(card, users(:jz), at: 45.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    activity_at = 27.days.ago
+    add_comment(card, users(:kevin), at: activity_at)
+
+    travel_to(activity_at + 13.days) { assert_not card.reload.stalled? }
+    travel_to(activity_at + 14.days) { assert_not card.reload.stalled? }
+
+    add_comment(card, users(:david), at: activity_at + 1.day)
+    add_comment(card, users(:jz), at: activity_at + 2.days)
+    add_comment(card, users(:david), at: activity_at + 3.days)
+    new_burst_at = activity_at + 3.days
+
+    travel_to(new_burst_at + 14.days) { assert card.reload.stalled? }
+  end
+
+  test "a reaction resets an already stalled card until another burst occurs" do
+    freeze_time
+    card = create_card_at(60.days.ago)
+    add_comment(card, users(:david), at: 50.days.ago)
+    add_comment(card, users(:jz), at: 45.days.ago)
+    add_comment(card, users(:david), at: 40.days.ago)
+    burst_at = 40.days.ago
+    travel_to(burst_at + 14.days) { assert card.reload.stalled? }
+
+    activity_at = 25.days.ago
+    travel_to(activity_at) { card.reactions.create!(content: "🎉", reacter: users(:david)) }
+    travel_to(activity_at + 14.days) { assert_not card.reload.stalled? }
+  end
+
+  test "stalled is a supported index and its relation agrees with the predicate" do
+    freeze_time
+    card = create_card_at(20.days.ago)
+    recent_burst = create_card_at(20.days.ago)
+    fresh_card = create_card_at(Time.current)
+    assigned_at = 15.days.ago
+    travel_to(assigned_at) { card.toggle_assignment(users(:jz)) }
+    travel_to(1.day.ago) { recent_burst.toggle_assignment(users(:david)) }
+    card_ids = [ card.id, recent_burst.id, fresh_card.id ]
+
+    travel_to(assigned_at + 14.days) do
+      assert_includes Filter::Fields::INDEXES, "stalled"
+      assert card.reload.stalled?
+      assert_equal [ card.id ], Card.stalled.where(id: card_ids).pluck(:id)
+      assert_equal [ card.id ], Card.where(id: card_ids).select(&:stalled?).map(&:id)
+    end
+  end
+
+  private
+    def create_card_at(time)
+      travel_to(time) do
+        boards(:writebook).cards.create!(
+          creator: users(:david),
+          title: "A stalled feature test card",
+          status: :published
+        )
+      end
+    end
+
+    def add_comment(card, creator, at:)
+      travel_to(at) do
+        card.comments.create!(creator: creator, body: "A comment")
+      end
+    end
+end
