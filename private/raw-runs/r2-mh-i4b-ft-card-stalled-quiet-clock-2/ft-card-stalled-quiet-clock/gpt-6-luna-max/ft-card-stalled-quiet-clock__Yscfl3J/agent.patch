diff --git a/test/controllers/cards_stalled_test.rb b/test/controllers/cards_stalled_test.rb
new file mode 100644
index 0000000..0d8047c
--- /dev/null
+++ b/test/controllers/cards_stalled_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class CardsStalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+    entropies(:writebook_board).update!(auto_postpone_period: 30.days)
+  end
+
+  test "cards index lists only stalled cards and shows the state in HTML and JSON" do
+    card = create_stalled_card
+    create_card_at(Time.current)
+
+    get cards_path, params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+    assert_select "article.card", count: 1
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ card.number ], response.parsed_body.pluck("number")
+    assert_equal true, response.parsed_body.first["stalled"]
+  end
+
+  test "stalled state appears on the card detail and public card pages" do
+    card = create_stalled_card
+
+    get card_path(card)
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    card.board.publish
+    get public_board_card_path(card.board.publication.key, card)
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+
+  test "comment JSON exposes the stalled state of its card" do
+    card = create_stalled_card
+    comment = card.comments.first
+
+    get card_comments_path(card, format: :json)
+    assert_response :success
+    comment_json = response.parsed_body.find { |item| item["id"] == comment.id }
+    assert_equal true, comment_json.dig("card", "stalled")
+  end
+
+  test "card JSON exposes the stalled state" do
+    card = create_stalled_card
+
+    get card_path(card, format: :json)
+    assert_response :success
+    assert_equal true, response.parsed_body["stalled"]
+  end
+
+  test "cached card previews show the stalled state when the quiet period passes" do
+    card = create_card_at(20.days.ago)
+    assigned_at = 13.days.ago
+    travel_to(assigned_at) { card.toggle_assignment(users(:david)) }
+
+    get cards_path
+    assert_response :success
+    assert_select ".card__stalled", count: 0
+
+    travel_to(assigned_at + 14.days) do
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "stalled state appears on notifications in HTML and JSON" do
+    card = create_stalled_card
+    assignment_event = card.events.find_by!(action: "card_assigned")
+    notification = Notification.create!(user: users(:kevin), creator: assignment_event.creator, source: assignment_event)
+
+    get notifications_path(format: :json)
+    assert_response :success
+    notification_json = response.parsed_body.find { |item| item["id"] == notification.id }
+    assert_equal true, notification_json.dig("card", "stalled")
+
+    get notifications_path
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+
+  private
+    def create_stalled_card
+      card = create_card_at(20.days.ago)
+      travel_to(17.days.ago) { card.comments.create!(creator: users(:david), body: "An earlier comment") }
+      travel_to(15.days.ago) { card.toggle_assignment(users(:david)) }
+      card
+    end
+
+    def create_card_at(time)
+      travel_to(time) do
+        boards(:writebook).cards.create!(
+          creator: users(:kevin),
+          title: "A stalled request test card",
+          status: :published
+        )
+      end
+    end
+end
