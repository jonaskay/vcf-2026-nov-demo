diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..7a90afa
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "GET /search accepts q and displays matching cards" do
+    card = create_card(title: "Route cobalt-search-marker")
+
+    get search_path, params: { q: "cobalt-search-marker" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_equal card.title, css_select(".search-result__title a").first.text
+  end
+
+  test "search page finds a description-only match" do
+    card = create_card(title: "Unrelated description result", description: "cobalt-description-page-marker")
+
+    get search_path, params: { q: "cobalt-description-page-marker" }
+
+    assert_response :success
+    assert_equal [ card.id ], css_select(".search-result").map { |result| result["data-card-id"] }
+    assert_select ".search-result__description mark", text: "cobalt-description-page-marker"
+  end
+
+  test "search page finds a comment-only match" do
+    card = create_card(title: "Unrelated comment result")
+    card.comments.create!(body: "cobalt-comment-page-marker", creator: users(:kevin))
+
+    get search_path, params: { q: "cobalt-comment-page-marker" }
+
+    assert_response :success
+    assert_equal [ card.id ], css_select(".search-result").map { |result| result["data-card-id"] }
+    assert_select ".search-result__comment mark", text: "cobalt-comment-page-marker"
+  end
+
+  test "search results mark matches in the title, description, and matching comment" do
+    card = create_card(title: "Needlemark result", description: "Needlemark description")
+    card.comments.create!(body: "Needlemark comment", creator: users(:kevin))
+
+    get search_path, params: { q: "Needlemark" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "Needlemark", count: 3
+  end
+
+  test "search highlights user content without rendering it as HTML" do
+    card = create_card(title: "<script>cobalt-xss-marker</script>")
+
+    get search_path, params: { q: "cobalt-xss-marker" }
+
+    assert_response :success
+    assert_select ".search-result script", count: 0
+    assert_select ".search-result mark", text: "cobalt-xss-marker"
+  end
+
+  test "search results are unique and newest first" do
+    older = newer = nil
+
+    travel_to Time.utc(2025, 2, 1, 12) do
+      older = create_card(title: "cobalt-page-order-marker old")
+    end
+
+    travel_to Time.utc(2025, 2, 2, 12) do
+      newer = create_card(title: "cobalt-page-order-marker new", description: "cobalt-page-order-marker")
+      newer.comments.create!(body: "cobalt-page-order-marker", creator: users(:kevin))
+    end
+
+    get search_path, params: { q: "cobalt-page-order-marker" }
+
+    assert_response :success
+    assert_select ".search-result", count: 2
+    assert_equal [ newer.title, older.title ], css_select(".search-result__title").map(&:text)
+  end
+
+  test "search only shows cards from boards the user can currently access" do
+    logout_and_sign_in_as :jz
+    accessible = create_card(title: "cobalt-access-marker", board: boards(:writebook))
+    inaccessible = create_card(title: "cobalt-access-marker", board: boards(:private))
+
+    get search_path, params: { q: "cobalt-access-marker" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_equal [ accessible.id ], css_select(".search-result").map { |result| result["data-card-id"] }
+    assert_not_includes css_select(".search-result").map { |result| result["data-card-id"] }, inaccessible.id
+  end
+
+  test "removing board access removes its cards from subsequent searches" do
+    card = create_card(title: "cobalt-revoked-access-marker", board: boards(:private))
+
+    get search_path, params: { q: "cobalt-revoked-access-marker" }
+    assert_select ".search-result", count: 1
+
+    boards(:private).accesses.find_by!(user: users(:kevin)).destroy!
+
+    get search_path, params: { q: "cobalt-revoked-access-marker" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_not_includes css_select(".search-result").map { |result| result["data-card-id"] }, card.id
+  end
+
+  test "search never displays draft cards or comments belonging to draft cards" do
+    create_card(title: "cobalt-draft-page-marker", description: "cobalt-draft-page-marker", status: :drafted)
+
+    card = create_card(title: "Published before draft comment")
+    card.comments.create!(body: "cobalt-draft-page-marker", creator: users(:kevin))
+    card.update!(status: :drafted)
+
+    get search_path, params: { q: "cobalt-draft-page-marker" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search without a term shows no card results" do
+    create_card(title: "cobalt-empty-query-marker")
+
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_card(board: boards(:writebook), **attributes)
+      board.cards.create!({ title: "Search page test card", creator: users(:kevin), status: :published }.merge(attributes))
+    end
+end
