@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Card::SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "search finds published cards by title and returns a relation" do
+    card = create_card(title: "cobalt-title-marker")
+
+    results = Card.search("cobalt-title-marker")
+
+    assert_kind_of ActiveRecord::Relation, results
+    assert_includes results, card
+  end
+
+  test "search is partial and case-insensitive" do
+    card = create_card(title: "A cobalt phrase")
+
+    assert_includes Card.search("COBALT"), card
+  end
+
+  test "search finds cards by description" do
+    card = create_card(title: "Unrelated description result", description: "cobalt-description-marker")
+
+    assert_includes Card.search("cobalt-description-marker"), card
+  end
+
+  test "search finds cards by a comment body" do
+    card = create_card(title: "Unrelated comment result")
+    card.comments.create!(body: "cobalt-comment-marker", creator: users(:kevin))
+
+    assert_includes Card.search("cobalt-comment-marker"), card
+  end
+
+  test "search returns cards once in newest-first order" do
+    older = newer = nil
+
+    travel_to Time.utc(2025, 1, 1, 12) do
+      older = create_card(title: "cobalt-order-marker")
+    end
+
+    travel_to Time.utc(2025, 1, 2, 12) do
+      newer = create_card(title: "cobalt-order-marker", description: "cobalt-order-marker")
+      newer.comments.create!(body: "cobalt-order-marker", creator: users(:kevin))
+    end
+
+    results = Card.search("cobalt-order-marker").where(board: boards(:writebook))
+
+    assert_equal [ newer, older ], results.to_a
+  end
+
+  test "search excludes draft cards and comments on cards that became drafts" do
+    create_card(title: "cobalt-draft-marker", description: "cobalt-draft-marker", status: :drafted)
+
+    card = create_card(title: "Unrelated before becoming a draft")
+    card.comments.create!(body: "cobalt-draft-marker", creator: users(:kevin))
+    card.update!(status: :drafted)
+
+    assert_empty Card.search("cobalt-draft-marker")
+  end
+
+  test "search with a blank term returns no cards" do
+    create_card(title: "Anything at all")
+
+    assert_empty Card.search("   ")
+  end
+
+  private
+    def create_card(**attributes)
+      boards(:writebook).cards.create!({ title: "Search test card", creator: users(:kevin), status: :published }.merge(attributes))
+    end
+end
