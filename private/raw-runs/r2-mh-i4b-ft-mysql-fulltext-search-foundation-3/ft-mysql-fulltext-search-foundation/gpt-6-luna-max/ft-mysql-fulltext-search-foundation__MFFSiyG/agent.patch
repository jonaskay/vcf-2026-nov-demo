@@ -0,0 +1,25 @@
+class SearchesController < ApplicationController
+  def index
+    @query = params[:q].to_s
+
+    cards = Current.user.accessible_cards.search(@query).with_rich_text_description
+    set_page_and_extract_portion_from cards
+
+    @matching_comments_by_card_id = matching_comments_by_card_id
+  end
+
+  private
+    def matching_comments_by_card_id
+      return {} if @query.blank? || @page.records.empty?
+
+      search_term = "%#{Card.sanitize_sql_like(@query, "!")}%"
+
+      Comment
+        .joins(:rich_text_body)
+        .where(card_id: @page.records.map(&:id))
+        .where("LOWER(action_text_rich_texts.body) LIKE LOWER(?) ESCAPE '!'", search_term)
+        .includes(:rich_text_body)
+        .order(:created_at, :id)
+        .group_by(&:card_id)
+    end
+end
