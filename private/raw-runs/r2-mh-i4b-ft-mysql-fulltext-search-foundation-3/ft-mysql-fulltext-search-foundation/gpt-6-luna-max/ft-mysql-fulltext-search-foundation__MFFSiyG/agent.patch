diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..fe4823a
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,40 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      if query.present?
+        search_term = "%#{Card.sanitize_sql_like(query.to_s, "!")}%"
+
+        published
+          .where(
+            <<~SQL.squish,
+              LOWER(cards.title) LIKE LOWER(:search_term) ESCAPE '!'
+              OR EXISTS (
+                SELECT 1
+                FROM action_text_rich_texts AS card_descriptions
+                WHERE card_descriptions.record_type = 'Card'
+                  AND card_descriptions.record_id = cards.id
+                  AND card_descriptions.name = 'description'
+                  AND LOWER(card_descriptions.body) LIKE LOWER(:search_term) ESCAPE '!'
+              )
+              OR EXISTS (
+                SELECT 1
+                FROM comments
+                INNER JOIN action_text_rich_texts AS comment_bodies
+                  ON comment_bodies.record_type = 'Comment'
+                  AND comment_bodies.record_id = comments.id
+                  AND comment_bodies.name = 'body'
+                WHERE comments.card_id = cards.id
+                  AND LOWER(comment_bodies.body) LIKE LOWER(:search_term) ESCAPE '!'
+              )
+            SQL
+            search_term: search_term
+          )
+          .reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..51c1c9a
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search</h1>
+<% end %>
+
+<section class="search-page">
+  <%= form_with url: search_path, method: :get, class: "search-page__form" do |form| %>
+    <%= form.search_field :q, value: @query, aria: { label: "Search cards" }, autofocus: true %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <section class="search-results" aria-label="Search results">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <article class="search-result" data-card-id="<%= card.id %>">
+            <h2 class="search-result__title"><%= link_to highlight_search_match(card.title), card_path(card) %></h2>
+
+            <% if card.description.present? %>
+              <p class="search-result__description"><%= highlight_search_match(card.description.to_plain_text) %></p>
+            <% end %>
+
+            <% @matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+              <p class="search-result__comment"><%= highlight_search_match(comment.body.to_plain_text) %></p>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+
+      <% if @page.records.empty? %>
+        <p class="blank-slate">No cards match this search</p>
+      <% end %>
+    </section>
+  <% end %>
+</section>
