diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d3c2859
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles and marks every matching occurrence" do
+    card = published_card(title: "Needle and another needle")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "input[type=search][name=q][value=needle]"
+    assert_select ".search-result[data-card-id='#{card.id}'] .search-result__title mark", count: 2
+  end
+
+  test "searches card descriptions and marks the matching text" do
+    card = published_card(title: "An unrelated title", description: "A description with a needle in it")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{card.id}'] .search-result__description mark", text: "needle"
+  end
+
+  test "searches every comment body on a card and marks matching comments" do
+    card = published_card(title: "An unrelated title")
+    card.comments.create!(creator: users(:kevin), body: "An older needle comment", created_at: 2.days.ago)
+    card.comments.create!(creator: users(:kevin), body: "A newer needle comment", created_at: 1.day.ago)
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{card.id}'] .search-result__comment mark", count: 2
+  end
+
+  test "returns newest cards first with a stable order for equal creation times" do
+    travel_to Time.zone.local(2025, 1, 10, 12) do
+      created_at = Time.current
+      older = published_card(title: "needle older", created_at: created_at - 1.day)
+      tied_first = published_card(title: "needle tied first", created_at: created_at)
+      tied_second = published_card(title: "needle tied second", created_at: created_at)
+
+      get search_path, params: { q: "needle" }
+
+      expected = [ tied_first, tied_second ].sort_by(&:id).reverse + [ older ]
+      assert_equal expected.map(&:id), search_result_ids
+    end
+  end
+
+  test "stops returning a card when board access is revoked" do
+    visible = published_card(title: "needle visible")
+    hidden = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "needle hidden")
+    end
+    boards(:private).accesses.find_by!(user: users(:kevin)).destroy!
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_equal [ visible.id ], search_result_ids
+    assert_not_includes response.body, hidden.title
+  end
+
+  test "does not return draft cards or matching comments on cards made draft" do
+    draft = published_card(title: "needle published temporarily")
+    draft.comments.create!(creator: users(:kevin), body: "needle in a draft comment")
+    draft.update!(status: :drafted, title: "needle draft title", description: "needle draft description")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_not_includes response.body, "needle in a draft comment"
+  end
+
+  test "returns no cards for an absent or blank query" do
+    published_card(title: "needle card")
+
+    get search_path
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: " " }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "treats SQL wildcard characters in the query as literal text" do
+    card = published_card(title: "100% complete")
+    published_card(title: "100 percent complete")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_equal [ card.id ], search_result_ids
+    assert_select ".search-result[data-card-id='#{card.id}'] .search-result__title mark", text: "%"
+  end
+
+  test "returns no cards when nothing matches" do
+    published_card(title: "a different title")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "matches case-insensitively and escapes card text around marks" do
+    card = published_card(title: "Needle <script>alert('unsafe')</script>")
+
+    get search_path, params: { q: "NEEDLE" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id='#{card.id}'] .search-result__title mark", text: "Needle"
+    assert_select ".search-result[data-card-id='#{card.id}'] .search-result__title script", count: 0
+  end
+
+  private
+    def published_card(title:, **attributes)
+      Current.set(user: users(:kevin)) do
+        boards(:writebook).cards.create!({
+          creator: users(:kevin),
+          status: :published,
+          title: title
+        }.merge(attributes))
+      end
+    end
+
+    def search_result_ids
+      css_select(".search-result").map { |result| result["data-card-id"] }
+    end
+end
