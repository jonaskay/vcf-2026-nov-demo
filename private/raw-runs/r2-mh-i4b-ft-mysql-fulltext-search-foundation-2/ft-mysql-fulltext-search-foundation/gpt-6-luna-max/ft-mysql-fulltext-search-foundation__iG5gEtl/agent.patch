diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..90526c3
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,40 @@
+module Card::Search
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      query = query.to_s.strip
+
+      if query.present?
+        escape_character = "!"
+        pattern = "%#{sanitize_sql_like(query, escape_character)}%"
+
+        published
+          .where(<<~SQL.squish, pattern: pattern)
+            LOWER(cards.title) LIKE LOWER(:pattern) ESCAPE '!'
+            OR EXISTS (
+              SELECT 1
+              FROM action_text_rich_texts descriptions
+              WHERE descriptions.record_type = 'Card'
+                AND descriptions.record_id = cards.id
+                AND descriptions.name = 'description'
+                AND LOWER(descriptions.body) LIKE LOWER(:pattern) ESCAPE '!'
+            )
+            OR EXISTS (
+              SELECT 1
+              FROM comments search_comments
+              INNER JOIN action_text_rich_texts comment_bodies
+                ON comment_bodies.record_type = 'Comment'
+                AND comment_bodies.record_id = search_comments.id
+                AND comment_bodies.name = 'body'
+              WHERE search_comments.card_id = cards.id
+                AND LOWER(comment_bodies.body) LIKE LOWER(:pattern) ESCAPE '!'
+            )
+          SQL
+          .reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..efc141e
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.search_field :q, value: @query, autofocus: true, aria: { label: "Search cards" } %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <div class="search-results">
+    <% @cards.each do |card| %>
+      <article class="search-result" data-card-id="<%= card.id %>">
+        <h2 class="search-result__title">
+          <%= link_to card_path(card) do %>
+            <%= highlight_search_result(card.title, @query) %>
+          <% end %>
+        </h2>
+
+        <% description = card.description.to_plain_text %>
+        <% if description.present? %>
+          <p class="search-result__description"><%= highlight_search_result(description, @query) %></p>
+        <% end %>
+
+        <% card.comments.each do |comment| %>
+          <% body = comment.body.to_plain_text %>
+          <% if search_query_matches?(body, @query) %>
+            <p class="search-result__comment"><%= highlight_search_result(body, @query) %></p>
+          <% end %>
+        <% end %>
+      </article>
+    <% end %>
+  </div>
+</section>
