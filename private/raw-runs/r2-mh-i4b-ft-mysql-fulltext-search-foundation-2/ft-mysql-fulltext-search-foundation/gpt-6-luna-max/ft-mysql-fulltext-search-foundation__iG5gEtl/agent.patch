+module SearchesHelper
+  def highlight_search_result(text, query)
+    highlight(text, query, highlighter: "<mark>\\1</mark>")
+  end
+
+  def search_query_matches?(text, query)
+    text.match?(Regexp.new(Regexp.escape(query), Regexp::IGNORECASE))
+  end
+end
