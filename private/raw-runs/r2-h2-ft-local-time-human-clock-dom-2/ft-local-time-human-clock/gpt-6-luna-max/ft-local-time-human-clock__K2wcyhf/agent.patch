diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..c9116b6
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,29 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  connect() {
+    this.render()
+    this.observer = new MutationObserver(() => this.render())
+    this.observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-format" ],
+      childList: true
+    })
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  render() {
+    const formattedTime = formatLocalTime(
+      this.element.getAttribute("datetime"),
+      this.element.dataset.localTimeFormat
+    )
+
+    if (this.element.textContent !== formattedTime) {
+      this.element.textContent = formattedTime
+    }
+  }
+}
