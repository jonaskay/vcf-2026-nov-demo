diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..ac26fcf
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  include BridgeHelper
+
+  def fragment(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time_tag emits a timezone-neutral UTC timestamp and fallback" do
+    time = Time.utc(2025, 9, 12, 20, 42)
+
+    html = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { local_time_tag(time.in_time_zone(Time.zone), format: "relative") }
+    end
+
+    assert_equal html.first, html.last
+    assert_select fragment(html.first), "time[datetime='2025-09-12T20:42:00.000000Z'][data-local-time-format='relative']", text: "2025-09-12T20:42:00.000000Z"
+  end
+
+  test "local_date_tag preserves a calendar date instead of a UTC midnight" do
+    html = local_date_tag(Date.new(2025, 9, 12), format: "weekday_date")
+
+    assert_select fragment(html), "time[datetime='2025-09-12'][data-local-time-format='weekday_date']", text: "2025-09-12"
+  end
+
+  test "bridge share descriptions carry timezone-neutral timestamps for browser formatting" do
+    card = cards(:logo)
+
+    descriptions = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { bridge_share_card_description(card.reload) }
+    end
+
+    assert_equal descriptions.first, descriptions.last
+    description = JSON.parse(descriptions.first)
+    assert_equal card.created_at.to_time.getutc.iso8601(6), description.fetch("created_at")
+    assert_equal card.last_active_at.to_time.getutc.iso8601(6), description.fetch("last_active_at")
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..af39840
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,64 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats comments and future card dates in the browser's timezone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+
+    time_zone = ActiveSupport::TimeZone["America/Los_Angeles"]
+    local_now = Time.current.in_time_zone(time_zone)
+    local_today = local_now.to_date
+    same_local_day = local_now.hour < 2 ? local_now + 2.hours : local_now - 2.hours
+    yesterday = time_zone.local(*(local_today - 1).then { |date| [ date.year, date.month, date.day, 18, 0 ] })
+    five_days_ago = time_zone.local(*(local_today - 5).then { |date| [ date.year, date.month, date.day, 12, 0 ] })
+    older_date = local_today - 10
+    older = time_zone.local(older_date.year, older_date.month, older_date.day, 12, 0)
+    previous_year_date = local_today.prev_year
+    previous_year = time_zone.local(previous_year_date.year, previous_year_date.month, previous_year_date.day, 12, 0)
+
+    card = cards(:logo)
+    same_day_comment = create_comment(card, "Same local day", same_local_day)
+    yesterday_comment = create_comment(card, "Yesterday", yesterday)
+    five_days_ago_comment = create_comment(card, "Five days ago", five_days_ago)
+    older_comment = create_comment(card, "Older date", older)
+    previous_year_comment = create_comment(card, "Previous year", previous_year)
+
+    card.board.update!(auto_postpone_period: 3.days)
+    tomorrow = local_today + 1
+    closes_tomorrow = time_zone.local(tomorrow.year, tomorrow.month, tomorrow.day, 8, 0)
+    card.update!(last_active_at: closes_tomorrow - 3.days)
+
+    sign_in_as(users(:david))
+    visit card_path(card)
+
+    assert_local_comment_time same_day_comment, same_local_day.strftime("%-l:%M %p").strip
+    assert_local_comment_time yesterday_comment, "yesterday"
+    assert_local_comment_time five_days_ago_comment, "5 days ago"
+    assert_local_comment_time older_comment, short_date(older_date, local_today)
+    assert_local_comment_time previous_year_comment, short_date(previous_year_date, local_today)
+    assert_text "Moves to “Not Now” tomorrow if there’s no activity."
+
+    page.execute_script("const date = document.createElement('time'); date.id = 'local-calendar-date'; date.dateTime = '2025-09-12'; date.dataset.controller = 'local-time'; date.dataset.localTimeFormat = 'weekday_date'; document.body.append(date)")
+    assert_selector "#local-calendar-date", text: "Friday, September 12"
+
+    closes_in_three_days = time_zone.local(*(local_today + 3).then { |date| [ date.year, date.month, date.day, 8, 0 ] })
+    card.update!(last_active_at: closes_in_three_days - 3.days)
+    visit card_path(card)
+
+    assert_text "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  private
+    def create_comment(card, body, created_at)
+      card.comments.create!(creator: users(:david), body: body, created_at: created_at)
+    end
+
+    def assert_local_comment_time(comment, text)
+      assert_selector "#comment_#{comment.id} .comment__permalink-title", text: text
+    end
+
+    def short_date(date, today)
+      formatted_date = date.strftime("%b %-d")
+      formatted_date += ", #{date.year}" unless date.year == today.year
+      formatted_date
+    end
+end
