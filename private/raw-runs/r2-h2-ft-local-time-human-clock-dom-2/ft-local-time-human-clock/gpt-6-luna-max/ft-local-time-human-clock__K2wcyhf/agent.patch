diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..ae53796 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,24 @@
 module TimeHelper
+  def local_time_tag(time, format:, **attributes)
+    timestamp = local_time_value(time)
+    local_display_tag(timestamp, format, **attributes)
+  end
+
+  def local_date_tag(date, format:, **attributes)
+    calendar_date = date.to_date.iso8601
+    local_display_tag(calendar_date, format, **attributes)
+  end
+
+  def local_time_value(time)
+    time.to_time.getutc.iso8601(6)
+  end
+
+  private
+    def local_display_tag(value, format, **attributes)
+      data = attributes.delete(:data) || {}
+      tag.time value,
+        datetime: value,
+        data: { controller: "local-time", local_time_format: format }.merge(data),
+        **attributes
+    end
 end
