diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..ab906f4
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,44 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "flex align-center justify-center gap" do |form| %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <%= with_automatic_pagination :search_results, @page, class: "search__results" do %>
+        <% @cards.each do |card| %>
+          <article class="search__result" data-card-id="<%= card.id %>">
+            <h2 class="search__result-title">
+              <%= link_to highlight(card.title, @query), card_path(card) %>
+            </h2>
+
+            <p class="search__result-meta">
+              <%= link_to card.board.name, board_path(card.board) %>
+              <span>Card #<%= card.number %></span>
+              <%= local_datetime_tag card.created_at, style: :daysago %>
+            </p>
+
+            <% if card.description.present? %>
+              <p class="search__result--description"><%= highlighted_search_excerpt card.description, @query %></p>
+            <% end %>
+
+            <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+              <blockquote class="search__result--comment"><%= highlighted_search_excerpt comment.body, @query %></blockquote>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match <strong><%= @query %></strong>.</p>
+    <% end %>
+  <% else %>
+    <p class="search__prompt">Search card titles, descriptions, and comments.</p>
+  <% end %>
+</section>
