@@ -0,0 +1,68 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches card titles, descriptions, and comments, newest first, and highlights matches" do
+    title_card = cards(:logo)
+    description_card = cards(:layout)
+    comment_card = cards(:text)
+
+    Current.set(user: users(:kevin), account: users(:kevin).account) do
+      title_card.update! title: "Quasar in the title"
+      description_card.update! description: "A distant quasar in the description"
+      comments(:text_1).update! body: "The quasar appears in this comment"
+
+      title_card.update_column :created_at, 1.hour.ago
+      description_card.update_column :created_at, 2.hours.ago
+      comment_card.update_column :created_at, 3.hours.ago
+    end
+
+    get search_path, params: { q: "quasar" }
+
+    assert_response :success
+    assert_select ".search__result", 3
+    assert_equal [ title_card, description_card, comment_card ].map(&:id), css_select(".search__result").map { |result| result["data-card-id"] }
+    assert_select ".search__result a[href=?] mark", card_path(title_card), text: "Quasar"
+    assert_select ".search__result--description mark", text: "quasar"
+    assert_select ".search__result--comment mark", text: "quasar"
+  end
+
+  test "search treats LIKE wildcards as literal characters" do
+  card = nil
+  Current.set(user: users(:kevin), account: users(:kevin).account) do
+    card = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Half of 100% done")
+  end
+
+  get search_path, params: { q: "%" }
+
+  assert_response :success
+  assert_equal [ card.id ], css_select(".search__result").map { |result| result["data-card-id"] }
+  assert_select ".search__result-title mark", text: "%"
+end
+
+test "search only returns cards from boards the current user can access" do
+    Current.set(user: users(:kevin), account: users(:kevin).account) do
+      boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "secretquasar")
+    end
+    logout_and_sign_in_as :jz
+
+    get search_path, params: { q: "secretquasar" }
+
+    assert_response :success
+    assert_select ".search__result", 0
+  end
+
+  test "search never returns draft cards" do
+    Current.set(user: users(:kevin), account: users(:kevin).account) do
+      boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "draftquasar", description: "draftquasar")
+    end
+
+    get search_path, params: { q: "draftquasar" }
+
+    assert_response :success
+    assert_select ".search__result", 0
+  end
+end
