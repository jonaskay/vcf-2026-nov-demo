+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    if @query.present?
+      @cards = set_page_and_extract_portion_from search_results
+      @matching_comments_by_card = matching_comments_by_card
+    else
+      @cards = []
+      @matching_comments_by_card = {}
+    end
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards.published
+        .matching_text(@query)
+        .reverse_chronologically
+        .with_rich_text_description_and_embeds
+        .preload(:board)
+    end
+
+    def matching_comments_by_card
+      Current.user.accessible_comments
+        .joins(:rich_text_body)
+        .where(comments: { card_id: @cards.map(&:id) })
+        .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", Card.search_pattern(@query))
+        .preload(:rich_text_body)
+        .order(created_at: :desc, id: :desc)
+        .group_by(&:card_id)
+    end
+end
