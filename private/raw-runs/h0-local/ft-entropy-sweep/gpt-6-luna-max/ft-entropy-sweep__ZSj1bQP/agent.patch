diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..f1e0d31 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,6 +1,8 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  BOARD_ID_BATCH_SIZE = 10_000
+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -25,8 +27,28 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      # Resolve periods once per board so the due-card queries can use the last_active_at index.
+      now = Time.now
+      boards_by_account_and_period = Hash.new { |groups, key| groups[key] = [] }
+
+      Board.includes(:entropy, account: :entropy).find_each do |board|
+        if period = board.entropy&.auto_postpone_period
+          boards_by_account_and_period[[ board.account_id, period ]] << board.id
+        end
+      end
+
+      boards_by_account_and_period.each do |(account_id, period), board_ids|
+        board_ids.each_slice(BOARD_ID_BATCH_SIZE) do |board_ids_batch|
+          due_cards = Card.active
+            .where(account_id: account_id, board_id: board_ids_batch)
+            .where("last_active_at <= #{connection.date_subtract('?', '?')}", now, period)
+            .preload(:board, :creator, :closure, :not_now, :activity_spike, account: :system_user)
+
+          # Use the indexed timestamp with id as a tie-breaker; each processed card stops matching Card.active.
+          due_cards.find_each(cursor: [ :last_active_at, :id ], order: [ :asc, :asc ]) do |card|
+            card.auto_postpone(user: card.account.system_user)
+          end
+        end
       end
     end
   end
