diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..f43c8de
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,112 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 14.days
+
+  included do
+    scope :stalled, -> do
+      as_of = Time.current
+      system_role = connection.quote(User.roles.fetch("system"))
+      auto_postpone_period = "COALESCE(stalled_board_entropies.auto_postpone_period, stalled_account_entropies.auto_postpone_period, #{Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i})"
+      comment_window_start = connection.date_subtract("burst_comments.created_at", "(#{auto_postpone_period} / 3)")
+
+      no_later_activity = ->(burst_event) do
+        <<~SQL.squish
+          cards.last_active_at = #{burst_event}.created_at
+          AND NOT EXISTS (
+            SELECT 1
+            FROM events AS later_events
+            WHERE (
+              (later_events.eventable_type = 'Card' AND later_events.eventable_id = cards.id)
+              OR (later_events.eventable_type = 'Comment' AND later_events.eventable_id IN (
+                SELECT card_comments.id FROM comments AS card_comments WHERE card_comments.card_id = cards.id
+              ))
+            )
+            AND (
+              later_events.created_at > #{burst_event}.created_at
+              OR (later_events.created_at = #{burst_event}.created_at AND later_events.id > #{burst_event}.id)
+            )
+          )
+          AND NOT EXISTS (
+            SELECT 1
+            FROM reactions AS later_reactions
+            WHERE (
+              (later_reactions.reactable_type = 'Card' AND later_reactions.reactable_id = cards.id)
+              OR (later_reactions.reactable_type = 'Comment' AND later_reactions.reactable_id IN (
+                SELECT card_comments.id FROM comments AS card_comments WHERE card_comments.card_id = cards.id
+              ))
+            )
+            AND (
+              later_reactions.created_at > #{burst_event}.created_at
+              OR (later_reactions.created_at = #{burst_event}.created_at AND later_reactions.id > #{burst_event}.id)
+            )
+          )
+        SQL
+      end
+
+      assignment_or_reopen_burst = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM events AS burst_events
+          WHERE burst_events.eventable_type = 'Card'
+            AND burst_events.eventable_id = cards.id
+            AND burst_events.action IN ('card_assigned', 'card_reopened')
+            AND #{no_later_activity.call('burst_events')}
+        )
+      SQL
+
+      comment_burst = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM comments AS burst_comments
+          INNER JOIN users AS burst_comment_creators ON burst_comment_creators.id = burst_comments.creator_id
+          INNER JOIN events AS burst_events
+            ON burst_events.eventable_type = 'Comment'
+            AND burst_events.eventable_id = burst_comments.id
+            AND burst_events.action = 'comment_created'
+          WHERE burst_comments.card_id = cards.id
+            AND burst_comment_creators.role <> #{system_role}
+            AND (
+              SELECT COUNT(*)
+              FROM comments AS window_comments
+              INNER JOIN users AS window_comment_creators ON window_comment_creators.id = window_comments.creator_id
+              WHERE window_comments.card_id = cards.id
+                AND window_comments.created_at >= #{comment_window_start}
+                AND window_comments.created_at <= burst_comments.created_at
+                AND window_comment_creators.role <> #{system_role}
+            ) >= 3
+            AND (
+              SELECT COUNT(DISTINCT window_comments.creator_id)
+              FROM comments AS window_comments
+              INNER JOIN users AS window_comment_creators ON window_comment_creators.id = window_comments.creator_id
+              WHERE window_comments.card_id = cards.id
+                AND window_comments.created_at >= #{comment_window_start}
+                AND window_comments.created_at <= burst_comments.created_at
+                AND window_comment_creators.role <> #{system_role}
+            ) >= 2
+            AND #{no_later_activity.call('burst_events')}
+        )
+      SQL
+
+      joins(<<~SQL.squish)
+        LEFT OUTER JOIN entropies AS stalled_board_entropies
+          ON stalled_board_entropies.container_id = cards.board_id
+          AND stalled_board_entropies.container_type = 'Board'
+        LEFT OUTER JOIN entropies AS stalled_account_entropies
+          ON stalled_account_entropies.container_id = cards.account_id
+          AND stalled_account_entropies.container_type = 'Account'
+      SQL
+        .where("cards.last_active_at <= ?", as_of - STALLED_AFTER)
+        .where("(#{assignment_or_reopen_burst}) OR (#{comment_burst})")
+        .distinct
+    end
+  end
+
+  def stalled?
+    if persisted?
+      self.class.stalled.where(id: id).exists?
+    else
+      false
+    end
+  end
+end
