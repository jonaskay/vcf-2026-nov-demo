diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..365529c
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,239 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @board.update! auto_postpone_period: 30.days
+  end
+
+  test "comment burst requires three comments from two non-system people" do
+    freeze_time
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:kevin), started_at + 1.day)
+
+    travel_to(started_at + 15.days) do
+      assert_stalled_state card, false
+    end
+
+    add_comment(card, users(:jz), started_at + 2.days)
+
+    travel_to(started_at + 16.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  test "three comments by one person do not make a burst" do
+    freeze_time
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:david), started_at + 1.day)
+    add_comment(card, users(:david), started_at + 2.days)
+
+    travel_to(started_at + 16.days) do
+      assert_stalled_state card, false
+    end
+  end
+
+  test "system comments do not count toward a comment burst" do
+    freeze_time
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:kevin), started_at + 1.day)
+    add_comment(card, @board.account.system_user, started_at + 2.days)
+
+    travel_to(started_at + 16.days) do
+      assert_stalled_state card, false
+    end
+  end
+
+  test "comment burst includes the exact one third period boundary" do
+    freeze_time
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:kevin), started_at + 5.days)
+    add_comment(card, users(:david), started_at + 10.days)
+
+    travel_to(started_at + 24.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  test "comment burst excludes a comment just outside the one third period" do
+    freeze_time
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:kevin), started_at + 5.days)
+    add_comment(card, users(:david), started_at + 10.days + 1.second)
+
+    travel_to(started_at + 24.days + 1.second) do
+      assert_stalled_state card, false
+    end
+  end
+
+  test "comment burst uses the board period override instead of the account period" do
+    freeze_time
+    @board.update! auto_postpone_period: 3.days
+    @board.account.entropy.update! auto_postpone_period: 30.days
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:kevin), started_at + 1.day)
+    add_comment(card, users(:david), started_at + 2.days)
+
+    travel_to(started_at + 16.days) do
+      assert_stalled_state card, false
+    end
+  end
+
+  test "comment burst falls back to the account period when the board has no override" do
+    freeze_time
+    @board.entropy.destroy!
+    @board.account.entropy.update! auto_postpone_period: 30.days
+    card = create_card
+    started_at = Time.current
+
+    add_comment(card, users(:david), started_at)
+    add_comment(card, users(:kevin), started_at + 2.days)
+    add_comment(card, users(:david), started_at + 5.days)
+
+    travel_to(started_at + 19.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  test "an assignment makes a card stalled after fourteen full days" do
+    freeze_time
+    card = create_card
+    assigned_at = Time.current
+
+    travel_to(assigned_at) do
+      with_current_user(:david) { card.toggle_assignment users(:kevin) }
+    end
+
+    travel_to(assigned_at + 14.days - 1.second) do
+      assert_stalled_state card, false
+    end
+
+    travel_to(assigned_at + 14.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  test "reopening a card makes it stalled after fourteen days" do
+    freeze_time
+    card = create_card
+    closed_at = Time.current
+    card.close(user: users(:david))
+    reopened_at = closed_at + 1.day
+
+    travel_to(reopened_at) { card.reopen(user: users(:kevin)) }
+
+    travel_to(reopened_at + 14.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  test "later comment activity clears a burst until another burst occurs" do
+    freeze_time
+    card = create_card
+    burst_at = Time.current
+
+    travel_to(burst_at) do
+      with_current_user(:david) { card.toggle_assignment users(:kevin) }
+    end
+
+    add_comment(card, users(:jz), burst_at + 13.days)
+
+    travel_to(burst_at + 27.days) do
+      assert_stalled_state card, false
+    end
+
+    travel_to(burst_at + 27.days) do
+      with_current_user(:david) { card.toggle_assignment users(:jz) }
+    end
+
+    travel_to(burst_at + 41.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  test "a later reaction resets eligibility from the previous burst" do
+    freeze_time
+    card = create_card
+    burst_at = Time.current
+
+    travel_to(burst_at) do
+      with_current_user(:david) { card.toggle_assignment users(:kevin) }
+    end
+
+    travel_to(burst_at + 13.days) do
+      card.reactions.create! content: "👍", reacter: users(:jz)
+    end
+
+    travel_to(burst_at + 27.days) do
+      assert_stalled_state card, false
+    end
+  end
+
+  test "a later activity touch clears the prior burst" do
+    freeze_time
+    card = create_card
+    burst_at = Time.current
+
+    travel_to(burst_at) do
+      with_current_user(:david) { card.toggle_assignment users(:kevin) }
+    end
+
+    travel_to(burst_at + 13.days) { card.touch_last_active_at }
+
+    travel_to(burst_at + 27.days) do
+      assert_stalled_state card, false
+    end
+  end
+
+  test "a burst event after the quiet activity creates a new stalled interval" do
+    freeze_time
+    card = create_card
+    burst_at = Time.current
+    travel_to(burst_at) do
+      with_current_user(:david) { card.toggle_assignment users(:kevin) }
+    end
+
+    travel_to(burst_at + 13.days) do
+      with_current_user(:david) { card.toggle_assignment users(:jz) }
+    end
+
+    travel_to(burst_at + 27.days) do
+      assert_stalled_state card, true
+    end
+  end
+
+  private
+    def create_card
+      @board.cards.create!(creator: users(:david), title: "A card to watch", status: :published)
+    end
+
+    def add_comment(card, creator, at)
+      travel_to(at) do
+        card.comments.create!(creator: creator, body: "A comment")
+      end
+    end
+
+    def assert_stalled_state(card, expected)
+      assert_equal expected, card.reload.stalled?
+      assert_equal expected, Card.stalled.where(id: card.id).exists?
+    end
+end
