@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Account::DataTransfer::NotificationEmailFrequencyTest < ActiveSupport::TestCase
+  test "older settings exports without a bundle email frequency remain valid" do
+    record_set = Account::DataTransfer::RecordSet.new(
+      account: accounts(:"37s"),
+      model: User::Settings,
+      optional_attributes: [ :bundle_email_frequency ],
+      importable_model_names: [ "User::Settings" ]
+    )
+    data = {
+      "id" => "test_settings_id_1234567890123",
+      "account_id" => "missing_account_id_123456",
+      "user_id" => "missing_user_id_1234567890",
+      "timezone_name" => nil,
+      "created_at" => Time.current.iso8601,
+      "updated_at" => Time.current.iso8601
+    }
+    tempfile = Tempfile.new([ "settings_export", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("data/user_settings/#{data['id']}.json", data.to_json)
+    writer.close
+    tempfile.rewind
+
+    assert_nothing_raised do
+      record_set.check(from: ZipFile::Reader.new(tempfile))
+    end
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..24566da
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "opens a window on the first notification and adds later notifications without resetting its clock" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :every_few_hours)
+    started_at = Time.current
+
+    travel_to(started_at) do
+      first_notification = notify(user, events(:layout_published))
+      bundle = user.notification_email_bundles.sole
+
+      assert_equal started_at, bundle.starts_at
+      assert_equal started_at + 4.hours, bundle.ends_at
+      assert_equal [ first_notification ], bundle.notifications
+
+      travel 1.hour do
+        second_notification = notify(user, events(:text_published))
+
+        assert_equal started_at, bundle.reload.starts_at
+        assert_equal started_at + 4.hours, bundle.ends_at
+        assert_equal [ first_notification, second_notification ], bundle.notifications.order(:created_at)
+      end
+    end
+  end
+
+  test "a late notification joins the window that is still pending after its end time" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :daily)
+    started_at = Time.current
+    first_notification = nil
+
+    travel_to(started_at) do
+      first_notification = notify(user, events(:layout_published))
+    end
+
+    bundle = user.notification_email_bundles.sole
+    ends_at = bundle.ends_at
+
+    travel_to(ends_at + 1.hour) do
+      second_notification = notify(user, events(:text_published))
+
+      assert_equal bundle.id, user.notification_email_bundles.sole.id
+      assert_equal ends_at, bundle.reload.ends_at
+      assert_equal [ first_notification, second_notification ], bundle.notifications.order(:created_at)
+
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Notification::EmailBundleDeliveryJob)
+      end
+    end
+
+    assert_not Notification::EmailBundle.exists?(bundle.id)
+    assert_includes ActionMailer::Base.deliveries.last.body.encoded, user.account.slug
+  end
+
+  test "re-notification of an existing notification is added to the bundle" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notification = notify(user, events(:layout_published))
+    bundle = user.notification_email_bundles.sole
+
+    notification.update!(source: events(:text_published), creator: users(:kevin))
+
+    assert_equal [ notification ], bundle.reload.notifications
+    assert_equal events(:text_published), notification.reload.source
+  end
+
+  test "one pending window per user is enforced by a unique index" do
+    user = users(:jason)
+    attributes = { account: user.account, user: user, starts_at: Time.current, ends_at: 4.hours.from_now }
+    Notification::EmailBundle.create!(attributes)
+
+    assert_raises(ActiveRecord::RecordNotUnique) do
+      Notification::EmailBundle.create!(attributes)
+    end
+  end
+
+  test "turning email digests off discards the pending window" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notify(user, events(:layout_published))
+    bundle = user.notification_email_bundles.sole
+
+    user.settings.update!(bundle_email_frequency: :never)
+
+    assert_empty user.notification_email_bundles
+
+    travel_to(bundle.ends_at) do
+      assert_emails 0 do
+        perform_enqueued_jobs(only: Notification::EmailBundleDeliveryJob)
+      end
+    end
+  end
+
+  test "deactivating a user discards the pending window" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notify(user, events(:layout_published))
+
+    user.update!(active: false)
+
+    assert_empty user.notification_email_bundles
+  end
+
+  test "destroying a notification removes its bundle item" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notification = notify(user, events(:layout_published))
+    item = Notification::EmailBundleItem.find_by!(notification: notification)
+
+    notification.destroy!
+
+    assert_not Notification::EmailBundleItem.exists?(item.id)
+  end
+
+  test "destroying a user removes pending bundles and their items" do
+    user = users(:jason)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notification = notify(user, events(:layout_published))
+    bundle = user.notification_email_bundles.sole
+    item_id = Notification::EmailBundleItem.find_by!(notification: notification).id
+
+    user.destroy!
+
+    assert_not Notification::EmailBundle.exists?(bundle.id)
+    assert_not Notification::EmailBundleItem.exists?(item_id)
+  end
+
+  private
+    def notify(user, event)
+      Notification.create!(user: user, source: event, creator: event.creator)
+    end
+end
