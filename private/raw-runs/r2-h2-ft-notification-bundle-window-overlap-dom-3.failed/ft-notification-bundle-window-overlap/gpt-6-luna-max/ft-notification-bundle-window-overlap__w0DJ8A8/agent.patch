+++ b/app/jobs/notification/email_bundle_delivery_job.rb
@@ -0,0 +1,42 @@
+class Notification::EmailBundleDeliveryJob < ApplicationJob
+  include SmtpDeliveryErrorHandling
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    settings = bundle.user.settings
+
+    if settings
+      settings.with_lock do
+        deliver_or_reschedule(bundle.reload, settings)
+      end
+    else
+      bundle.destroy!
+    end
+  rescue ActiveRecord::RecordNotFound
+    # The user or their pending email bundle was removed before this job ran.
+  end
+
+  private
+    def deliver_or_reschedule(bundle, settings)
+      if settings.bundle_email_frequency == "never" ||
+          !bundle.user.active? ||
+          bundle.user.identity.blank? ||
+          !bundle.account.active?
+        bundle.destroy!
+      else
+        ends_at = bundle.starts_at + settings.bundle_email_window
+
+        if bundle.ends_at != ends_at
+          bundle.update!(ends_at: ends_at)
+        end
+
+        if ends_at > Time.current
+          bundle.deliver_later
+        else
+          NotificationMailer.digest(bundle).deliver_now if bundle.notifications.exists?
+          bundle.destroy!
+        end
+      end
+    end
+end
diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..6abc40a
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,9 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(:created_at, :id).to_a
+
+    mail to: @user.identity.email_address, subject: "Your Fizzy notification digest"
+  end
+end
diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..944c6ef
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,58 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::EmailBundleItem", dependent: :destroy
+  has_many :notifications, through: :items
+
+  class << self
+    def open_for(notification)
+      user = notification.user
+      settings = user.settings
+
+      if eligible?(notification, settings)
+        settings.with_lock do
+          if eligible?(notification, settings)
+            bundle = find_by(user_id: user.id)
+
+            if bundle.nil?
+              starts_at = Time.current
+              bundle = create!(
+                account: notification.account,
+                user: user,
+                starts_at: starts_at,
+                ends_at: starts_at + settings.bundle_email_window
+              )
+              bundle.deliver_later
+            end
+
+            bundle.add(notification)
+          end
+        end
+      end
+    end
+
+    private
+      def eligible?(notification, settings)
+        settings.present? &&
+          settings.bundle_email_frequency != "never" &&
+          !notification.creator.system? &&
+          notification.user.active? &&
+          notification.user.identity.present? &&
+          notification.account.active?
+      end
+  end
+
+  def add(notification)
+    items.create_or_find_by!(notification: notification)
+  end
+
+  def deliver_later
+    Notification::EmailBundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def reschedule_later(ends_at:)
+    update!(ends_at: ends_at)
+    deliver_later
+  end
+end
