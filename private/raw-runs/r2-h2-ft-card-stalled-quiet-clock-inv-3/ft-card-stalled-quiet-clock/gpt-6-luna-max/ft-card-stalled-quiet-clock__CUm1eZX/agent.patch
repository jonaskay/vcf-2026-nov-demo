diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..6e1054b
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,43 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      cutoff = as_of - STALLED_AFTER
+      where(last_burst_at: ..cutoff, last_active_at: ..cutoff)
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    cutoff = as_of - STALLED_AFTER
+    last_burst_at.present? && last_burst_at <= cutoff && last_active_at <= cutoff
+  end
+
+  # Stalled status changes with time even when the card is not updated.
+  def cache_key_with_version
+    if has_attribute?(:last_burst_at) && has_attribute?(:last_active_at)
+      "#{super}-#{stalled?}"
+    else
+      super
+    end
+  end
+
+  def record_comment_burst(comment)
+    burst_window = auto_postpone_period.seconds / 3
+    comments_in_window = comments.by_user
+      .where(created_at: (comment.created_at - burst_window)..comment.created_at)
+      .group(:creator_id)
+      .count
+
+    if comments_in_window.values.sum >= BURST_COMMENT_COUNT && comments_in_window.many?
+      record_burst(at: comment.created_at)
+    end
+  end
+
+  def record_burst(at: Time.current)
+    update!(last_burst_at: at) if last_burst_at.nil? || at > last_burst_at
+  end
+end
