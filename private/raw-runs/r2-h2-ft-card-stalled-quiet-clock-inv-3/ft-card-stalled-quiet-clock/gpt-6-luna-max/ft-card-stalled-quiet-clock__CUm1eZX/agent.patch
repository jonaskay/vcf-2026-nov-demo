diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..b7ff4cb
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the auto-close period create a burst" do
+    card = create_published_card
+    now = Time.current.change(usec: 0)
+
+    create_comment(card, users(:david), at: now - 20.days)
+    create_comment(card, users(:david), at: now - 10.days)
+    assert_nil card.reload.last_burst_at
+
+    create_comment(card, users(:kevin), at: now)
+
+    assert_equal now, card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    card = create_published_card
+    now = Time.current.change(usec: 0)
+
+    create_comment(card, users(:david), at: now - 2.days)
+    create_comment(card, users(:system), at: now - 1.day - 12.hours)
+    create_comment(card, users(:david), at: now - 1.day)
+    create_comment(card, users(:david), at: now)
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "board auto-close period determines the comment window" do
+    card = create_published_card
+    card.board.entropy.update!(auto_postpone_period: 3.days)
+    now = Time.current.change(usec: 0)
+
+    create_comment(card, users(:david), at: now - 2.days)
+    create_comment(card, users(:david), at: now - 12.hours)
+    create_comment(card, users(:kevin), at: now)
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments from only one person do not create a burst" do
+    card = create_published_card
+    now = Time.current.change(usec: 0)
+
+    3.times { |index| create_comment(card, users(:david), at: now - index.days) }
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments outside the burst window do not count" do
+    card = create_published_card
+    now = Time.current.change(usec: 0)
+
+    create_comment(card, users(:david), at: now - 31.days)
+    create_comment(card, users(:david), at: now - 1.day)
+    create_comment(card, users(:kevin), at: now)
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "assignment and reopening create a burst" do
+    card = create_published_card
+    assigned_at = Time.current.change(usec: 0)
+
+    travel_to assigned_at do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    assert_equal assigned_at, card.reload.last_burst_at
+
+    card.close
+    reopened_at = 1.day.from_now.change(usec: 0)
+    travel_to reopened_at do
+      card.reopen
+    end
+
+    assert_equal reopened_at, card.reload.last_burst_at
+  end
+
+  test "a card without a burst is not stalled" do
+    card = create_published_card
+    card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+  end
+
+  test "a recent burst is not stalled even if the activity timestamp is older" do
+    card = create_published_card
+    card.update!(last_burst_at: Time.current, last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+  end
+
+  test "a burst card is stalled after two inactive weeks and activity resets it" do
+    card = create_published_card
+    inactive_since = 3.weeks.ago.change(usec: 0)
+    card.update!(last_burst_at: inactive_since, last_active_at: inactive_since)
+
+    assert card.stalled?
+
+    create_comment(card, users(:kevin), at: Time.current)
+
+    assert_not card.reload.stalled?
+  end
+
+  test "cache key changes when a card becomes stalled without an update" do
+    card = create_published_card
+    as_of = Time.current.change(usec: 0)
+    inactive_since = as_of - 2.weeks + 1.second
+    card.update!(last_burst_at: inactive_since, last_active_at: inactive_since)
+    fresh_cache_key = card.cache_key_with_version
+
+    travel_to as_of + 1.second do
+      assert card.stalled?
+      assert_not_equal fresh_cache_key, card.cache_key_with_version
+    end
+  end
+
+  test "stalled cards can be selected with the stalled index" do
+    card = create_published_card
+    inactive_since = 3.weeks.ago.change(usec: 0)
+    card.update!(last_burst_at: inactive_since, last_active_at: inactive_since)
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, card
+  end
+
+  private
+    def create_published_card
+      boards(:writebook).cards.create!(creator: users(:david), title: "Card with a burst", status: "published")
+    end
+
+    def create_comment(card, creator, at:)
+      travel_to at do
+        card.comments.create!(creator: creator, body: "Activity")
+      end
+    end
+end
