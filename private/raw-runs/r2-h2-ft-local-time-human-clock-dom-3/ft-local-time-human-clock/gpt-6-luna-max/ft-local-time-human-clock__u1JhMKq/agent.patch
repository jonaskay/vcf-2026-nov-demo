 import { BridgeComponent } from "@hotwired/hotwire-native-bridge"
+import { formatDateTime } from "helpers/date_helpers"
 
 export default class extends BridgeComponent {
   static component = "share"
 
   shareUrl() {
-    const description = this.bridgeElement.bridgeAttribute("share-description")
+    const description = this.#description()
+
     this.send("shareUrl", {
       title: document.title,
       url: window.location.href,
-      description: description
+      description
     })
   }
+
+  #description() {
+    const description = this.bridgeElement.bridgeAttribute("share-description")
+
+    if (description) {
+      try {
+        const card = JSON.parse(description)
+        if (card.kind === "card") {
+          const added = formatDateTime(card.createdAt, "short-date")
+          const updated = formatDateTime(card.updatedAt, "short-date")
+          return `Added ${added} by ${card.author} and ${card.assignees}. Updated ${updated}`
+        }
+      } catch {
+        // Board descriptions are already static text.
+      }
+    }
+
+    return description
+  }
 }
