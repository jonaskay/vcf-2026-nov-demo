diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..39bea1e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,15 @@
 module TimeHelper
+  def browser_timestamp(timestamp)
+    timestamp.utc.iso8601(6)
+  end
+
+  def browser_time_tag(timestamp, format:, **options)
+    datetime = browser_timestamp(timestamp)
+    tag.time datetime, datetime: datetime, data: { controller: "time", time_format: format.to_s.dasherize }, **options
+  end
+
+  def browser_date_tag(day, format:, **options)
+    date = day.to_date.iso8601
+    tag.time date, datetime: date, data: { controller: "time", time_format: format.to_s.dasherize }, **options
+  end
 end
