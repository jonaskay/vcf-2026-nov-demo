@@ -0,0 +1,17 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card share descriptions contain neutral timestamps for browser formatting" do
+    card = cards(:logo)
+
+    description = bridge_share_card_description(card)
+
+    assert_equal "card", description[:kind]
+    assert_equal card.created_at.utc.iso8601(6), description[:createdAt]
+    assert_equal card.last_active_at.utc.iso8601(6), description[:updatedAt]
+    refute_match(/\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \d{1,2}\b/, description.values.join(" "))
+
+    button = Nokogiri::HTML.fragment(bridged_share_url_button(description).to_s).at_css("button")
+    assert_equal description, JSON.parse(button["data-bridge-share-description"]).deep_symbolize_keys
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..1e7a013
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "browser timestamp tags are identical across server timezones" do
+    timestamp = Time.utc(2025, 9, 12, 23, 42, 0)
+    html = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { browser_time_tag(timestamp, format: :relative).to_s }
+    end
+
+    assert_equal html.first, html.last
+    assert_includes html.first, 'datetime="2025-09-12T23:42:00.000000Z"'
+    assert_includes html.first, 'data-time-format="relative"'
+    assert_includes html.first, ">2025-09-12T23:42:00.000000Z</time>"
+  end
+
+  test "calendar day tags preserve a date across server timezones" do
+    day = Date.new(2025, 9, 12)
+    html = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { browser_date_tag(day, format: :calendar_date).to_s }
+    end
+
+    assert_equal html.first, html.last
+    assert_includes html.first, 'datetime="2025-09-12"'
+    assert_includes html.first, 'data-time-format="calendar-date"'
+    assert_includes html.first, ">2025-09-12</time>"
+  end
+end
diff --git a/test/system/time_display_test.rb b/test/system/time_display_test.rb
new file mode 100644
index 0000000..a95d482
--- /dev/null
+++ b/test/system/time_display_test.rb
@@ -0,0 +1,86 @@
+require "application_system_test_case"
+
+class TimeDisplayTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+  end
+
+  test "comments display relative to the browser's local calendar day" do
+    dates = page.evaluate_script(<<~JAVASCRIPT)
+      (() => {
+        const now = new Date()
+        const atDay = (daysAgo, hour, minute) =>
+          new Date(now.getFullYear(), now.getMonth(), now.getDate() - daysAgo, hour, minute).toISOString()
+        const oldDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 8, 12)
+        const options = { month: "short", day: "numeric" }
+        if (oldDate.getFullYear() !== now.getFullYear()) options.year = "numeric"
+
+        return {
+          today: atDay(0, 13, 42),
+          yesterday: atDay(1, 23, 15),
+          fiveDaysAgo: atDay(5, 12, 0),
+          oldDate: atDay(8, 12, 0),
+          oldDateLabel: new Intl.DateTimeFormat("en-US", options).format(oldDate)
+        }
+      })()
+    JAVASCRIPT
+
+    today = comments(:logo_agreement_kevin)
+    yesterday = comments(:logo_agreement_jz)
+    five_days_ago = cards(:logo).comments.create!(creator: users(:david), body: "Five-day comment")
+    older = cards(:logo).comments.create!(creator: users(:david), body: "Older comment")
+
+    today.update!(created_at: Time.iso8601(dates.fetch("today")))
+    yesterday.update!(created_at: Time.iso8601(dates.fetch("yesterday")))
+    five_days_ago.update!(created_at: Time.iso8601(dates.fetch("fiveDaysAgo")))
+    older.update!(created_at: Time.iso8601(dates.fetch("oldDate")))
+
+    visit card_url(cards(:logo))
+
+    within("##{dom_id(today)}") do
+      assert_selector ".comment__permalink-title time", text: "1:42 PM"
+    end
+    within("##{dom_id(yesterday)}") do
+      assert_selector ".comment__permalink-title time", text: "yesterday"
+    end
+    within("##{dom_id(five_days_ago)}") do
+      assert_selector ".comment__permalink-title time", text: "5 days ago"
+    end
+    within("##{dom_id(older)}") do
+      assert_selector ".comment__permalink-title time", text: dates.fetch("oldDateLabel")
+    end
+  end
+
+  test "auto-closing cards scheduled for tomorrow say tomorrow" do
+    card = cards(:logo)
+    timestamp = page.evaluate_script(<<~JAVASCRIPT)
+      (() => {
+        const now = new Date()
+        return new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 12).toISOString()
+      })()
+    JAVASCRIPT
+    card.update!(last_active_at: Time.iso8601(timestamp) - card.auto_postpone_period)
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(card, :closure_notice)} time[data-time-format='relative-day']", text: "tomorrow"
+  end
+
+  test "future card closures use local calendar-day words" do
+    card = cards(:logo)
+    timestamp = page.evaluate_script(<<~JAVASCRIPT)
+      (() => {
+        const now = new Date()
+        return new Date(now.getFullYear(), now.getMonth(), now.getDate() + 3, 12).toISOString()
+      })()
+    JAVASCRIPT
+    card.update!(last_active_at: Time.iso8601(timestamp) - card.auto_postpone_period)
+
+    visit card_url(card)
+
+    assert_selector "##{dom_id(card, :closure_notice)} time[data-time-format='relative-day']", text: "in 3 days"
+  end
+end
