diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..11f8d22 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,10 +25,37 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      system_users = User.where(role: :system).index_by(&:account_id)
+
+      %w[Board Account].each do |container_type|
+        Entropy.where(container_type: container_type).distinct.pluck(:auto_postpone_period).each do |period|
+          due_to_be_postponed_by_period(period, container_type, now).find_each do |card|
+            card.auto_postpone(user: system_users.fetch(card.account_id))
+          end
+        end
       end
+
+      nil
     end
+
+    private
+      def due_to_be_postponed_by_period(period, container_type, now)
+        entropy_settings = Entropy.where(container_type: container_type, auto_postpone_period: period)
+        due_cards = active
+          .where("cards.last_active_at <= ?", now - period.seconds)
+          .preload(:account, :board, :column, :closure, :not_now, :activity_spike)
+
+        if container_type == "Board"
+          due_cards.where(board_id: entropy_settings.select(:container_id))
+        else
+          boards = Board
+            .where(account_id: entropy_settings.select(:container_id))
+            .where.not(id: Entropy.where(container_type: "Board").select(:container_id))
+
+          due_cards.where(board_id: boards.select(:id))
+        end
+      end
   end
 
   def entropy
