diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..368d306 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,103 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due uses the board period at the boundary, overriding the account period" do
+    freeze_time
+
+    entropies("37s_account").update!(auto_postpone_period: 365.days)
+    entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+    cards(:logo).update!(last_active_at: 90.days.ago)
+    cards(:layout).update!(last_active_at: 90.days.ago - 1.second)
+    cards(:shipping).update!(last_active_at: 90.days.ago + 1.second)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone all due uses the account period at the boundary without a board override" do
+    freeze_time
+
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 30.days)
+    cards(:logo).update!(last_active_at: 30.days.ago)
+    cards(:layout).update!(last_active_at: 30.days.ago - 1.second)
+    cards(:shipping).update!(last_active_at: 30.days.ago + 1.second)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone all due leaves closed, drafted, and already postponed cards alone" do
+    freeze_time
+
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    cards(:logo).update!(last_active_at: 100.days.ago)
+    cards(:shipping).close(user: users(:david))
+    cards(:shipping).update!(last_active_at: 100.days.ago)
+    cards(:layout).postpone(user: users(:david))
+    cards(:layout).update!(last_active_at: 100.days.ago)
+    cards(:unfinished_thoughts).update!(last_active_at: 100.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert_not cards(:shipping).reload.postponed?
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:unfinished_thoughts).reload.postponed?
+  end
+
+  test "auto postpone all due processes cards across batches" do
+    freeze_time
+
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    account_id = accounts("37s").id
+    board_id = boards(:writebook).id
+    creator_id = users(:david).id
+    timestamp = Time.current
+    card_ids = 1_001.times.map { SecureRandom.uuid }
+
+    Card.insert_all!(card_ids.each_with_index.map do |id, index|
+      {
+        id: id,
+        account_id: account_id,
+        board_id: board_id,
+        column_id: cards(:logo).column_id,
+        creator_id: creator_id,
+        number: 10_000 + index,
+        status: "published",
+        last_active_at: 100.days.ago,
+        created_at: timestamp,
+        updated_at: timestamp
+      }
+    end)
+
+    assert_difference -> { Card.postponed.where(id: card_ids).count }, card_ids.length do
+      Card.auto_postpone_all_due
+    end
+
+    assert Card.find(card_ids.last).postponed?
+  end
+
+  test "auto postpone sweep does not join all cards to boards" do
+    statements = []
+    subscriber = ->(_name, _start, _finish, _id, payload) do
+      statements << payload[:sql] if payload[:sql]&.start_with?('SELECT "cards".*')
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      Card.auto_postpone_all_due
+    end
+
+    assert statements.any?
+    assert statements.none? { |sql| sql.include?('INNER JOIN "boards"') }
+  end
+
 end
