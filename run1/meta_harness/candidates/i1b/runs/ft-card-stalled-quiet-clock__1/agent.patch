diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..571751d
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,65 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_AFTER = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_PEOPLE_COUNT = 2
+  BURST_EVENTS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    scope :bursty, -> do
+      auto_close_period = "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"
+      burst_window_start = connection.date_subtract("burst_anchors.created_at", "(#{auto_close_period} / 3)")
+      burst_event_actions = BURST_EVENTS.map { |action| connection.quote(action) }.join(", ")
+
+      left_outer_joins(board: :entropy)
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = cards.account_id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = cards.account_id")
+        .where(<<~SQL.squish)
+          EXISTS (
+            SELECT 1
+            FROM events burst_events
+            WHERE burst_events.eventable_type = 'Card'
+              AND burst_events.eventable_id = cards.id
+              AND burst_events.action IN (#{burst_event_actions})
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments burst_anchors
+            INNER JOIN comments burst_comments
+              ON burst_comments.card_id = burst_anchors.card_id
+              AND burst_comments.created_at >= #{burst_window_start}
+              AND burst_comments.created_at <= burst_anchors.created_at
+            INNER JOIN users burst_commenters
+              ON burst_commenters.id = burst_comments.creator_id
+              AND burst_commenters.role <> 'system'
+            WHERE burst_anchors.card_id = cards.id
+            GROUP BY burst_anchors.id
+            HAVING COUNT(*) >= #{BURST_COMMENT_COUNT}
+              AND COUNT(DISTINCT burst_comments.creator_id) >= #{BURST_PEOPLE_COUNT}
+          )
+        SQL
+    end
+
+    scope :stalled, ->(as_of = Time.current) do
+      bursty.where(last_active_at: ..(as_of - STALL_AFTER))
+    end
+  end
+
+  def burst?
+    self.class.bursty.where(id: id).exists?
+  end
+
+  def had_burst?
+    burst?
+  end
+
+  alias_method :bursty?, :burst?
+
+  def stalled?(as_of: Time.current)
+    last_active_at.present? && last_active_at <= as_of - STALL_AFTER && had_burst?
+  end
+
+  def cache_key_with_stalled_state
+    [ self, stalled? ]
+  end
+end
