diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..00a23eb
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,196 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments by two people within a third of the board period make a burst, including the boundary" do
+    freeze_time do
+      card = new_published_card
+      period = card.auto_postpone_period / 3
+
+      add_comment(card, users(:david), Time.current - period)
+      add_comment(card, users(:kevin), Time.current - 1.hour)
+      add_comment(card, users(:david), Time.current)
+
+      assert_predicate card.reload, :burst?
+      assert_includes Card.bursty, card
+
+      card.update_column(:last_active_at, 2.weeks.ago)
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+    end
+  end
+
+  test "the comment window uses the board auto-close period rather than the account default" do
+    freeze_time do
+      entropies("37s_account").update!(auto_postpone_period: 30.days)
+      entropies(:writebook_board).update!(auto_postpone_period: 90.days)
+      card = new_published_card
+
+      add_comment(card, users(:david), 20.days.ago)
+      add_comment(card, users(:kevin), 10.days.ago + 1.second)
+      add_comment(card, users(:david), Time.current)
+
+      assert_predicate card.reload, :burst?
+    end
+  end
+
+  test "the account auto-close period is used when the board has no override" do
+    freeze_time do
+      entropies(:writebook_board).destroy
+      entropies("37s_account").update!(auto_postpone_period: 30.days)
+      card = new_published_card
+
+      add_comment(card, users(:david), 9.days.ago)
+      add_comment(card, users(:kevin), 4.days.ago)
+      add_comment(card, users(:david), Time.current)
+
+      assert_predicate card.reload, :burst?
+    end
+  end
+
+  test "fewer than three comments do not make a burst" do
+    freeze_time do
+      card = new_published_card
+
+      add_comment(card, users(:david), Time.current - 1.minute)
+      add_comment(card, users(:kevin), Time.current)
+
+      assert_not_predicate card.reload, :burst?
+      assert_not_includes Card.bursty, card
+    end
+  end
+
+  test "three comments from one person do not make a burst" do
+    freeze_time do
+      card = new_published_card
+
+      3.times { add_comment(card, users(:david), Time.current) }
+
+      assert_not_predicate card.reload, :burst?
+    end
+  end
+
+  test "system comments do not count as people in a burst" do
+    freeze_time do
+      card = new_published_card
+
+      add_comment(card, users(:david), Time.current)
+      add_comment(card, users(:system), Time.current)
+      add_comment(card, users(:system), Time.current)
+
+      assert_not_predicate card.reload, :burst?
+    end
+  end
+
+  test "comments outside the one-third-period window do not make a burst" do
+    freeze_time do
+      card = new_published_card
+      outside_window = Time.current - card.auto_postpone_period / 3 - 1.second
+
+      add_comment(card, users(:david), outside_window)
+      add_comment(card, users(:kevin), outside_window + 1.second)
+      add_comment(card, users(:david), Time.current)
+
+      assert_not_predicate card.reload, :burst?
+      assert_not_includes Card.bursty, card
+    end
+  end
+
+  test "assignment and reopening independently make bursts" do
+    assigned_card = new_published_card
+    assigned_card.toggle_assignment(users(:kevin))
+
+    assert_predicate assigned_card.reload, :burst?
+    assert_includes Card.bursty, assigned_card
+
+    reopened_card = cards(:shipping)
+    reopened_card.reopen
+
+    assert_predicate reopened_card.reload, :burst?
+    assert_includes Card.bursty, reopened_card
+
+    reopened_card.update_column(:last_active_at, 3.weeks.ago)
+    assert_predicate reopened_card.reload, :stalled?
+    assert_includes Card.stalled, reopened_card
+  end
+
+  test "a burst card is stalled after two weeks of inactivity and activity resets the clock" do
+    now = Time.current
+    card = nil
+
+    travel_to(now - 15.days) do
+      card = new_published_card
+      card.toggle_assignment(users(:kevin))
+    end
+
+    travel_to(now) do
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+
+      card.comments.create!(creator: users(:jz), body: "One more thought")
+      assert_not_predicate card.reload, :stalled?
+      assert_not_includes Card.stalled, card
+    end
+
+    travel_to(now + 14.days) do
+      assert_predicate card.reload, :stalled?
+
+      card.reactions.create!(content: "🎉", reacter: users(:kevin))
+      assert_not_predicate card.reload, :stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "the two-week stall threshold is inclusive and requires a burst" do
+    freeze_time do
+      card = new_published_card
+      card.toggle_assignment(users(:kevin))
+      card.update_column(:last_active_at, 2.weeks.ago)
+
+      assert_predicate card.reload, :stalled?
+      assert_includes Card.stalled, card
+
+      card.update_column(:last_active_at, 2.weeks.ago + 1.second)
+      assert_not_predicate card.reload, :stalled?
+      assert_not_includes Card.stalled, card
+
+      card.update_column(:last_active_at, 2.weeks.ago - 1.second)
+      assert_predicate card.reload, :stalled?
+
+      no_burst_card = new_published_card
+      no_burst_card.update_column(:last_active_at, 3.weeks.ago)
+      assert_not_predicate no_burst_card.reload, :stalled?
+      assert_not_includes Card.stalled, no_burst_card
+    end
+  end
+
+  test "the view cache key changes when time alone makes a card stalled" do
+    now = Time.current
+    card = nil
+
+    travel_to(now) do
+      card = new_published_card
+      card.toggle_assignment(users(:kevin))
+      card.update_column(:last_active_at, 13.days.ago)
+    end
+
+    cache_key = card.cache_key_with_stalled_state
+
+    travel_to(now + 1.day) do
+      assert_predicate card.reload, :stalled?
+      assert_not_equal cache_key, card.cache_key_with_stalled_state
+    end
+  end
+
+  private
+    def new_published_card
+      boards(:writebook).cards.create!(title: "Stall test", creator: users(:david), status: :published)
+    end
+
+    def add_comment(card, creator, created_at)
+      card.comments.create!(creator:, body: "Comment", created_at:)
+    end
+end
