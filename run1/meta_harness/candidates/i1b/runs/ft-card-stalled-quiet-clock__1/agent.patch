diff --git a/test/controllers/card_stallable_test.rb b/test/controllers/card_stallable_test.rb
new file mode 100644
index 0000000..b32bbb1
--- /dev/null
+++ b/test/controllers/card_stallable_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class CardStallableTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:david)
+    sign_in_as :kevin
+  end
+
+  test "cards index filters stalled cards and includes their state in JSON" do
+    freeze_time do
+      stalled = make_stalled_card("Stalled open card")
+      closed = make_stalled_card("Stalled closed card")
+      closed.close
+      closed.update_column(:last_active_at, 3.weeks.ago)
+      postponed = make_stalled_card("Stalled postponed card")
+      postponed.postpone
+      postponed.update_column(:last_active_at, 3.weeks.ago)
+      recent = make_bursty_card("Recently active card")
+      unbursty = boards(:writebook).cards.create!(title: "Old quiet card", creator: users(:david), status: :published)
+      unbursty.update_column(:last_active_at, 3.weeks.ago)
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+      assert_response :success
+      cards = @response.parsed_body
+      assert_equal [ stalled.number, closed.number, postponed.number ].sort, cards.map { |card| card["number"] }.sort
+      assert cards.all? { |card| card["stalled"] }
+      assert_not_includes cards.map { |card| card["number"] }, recent.number
+      assert_not_includes cards.map { |card| card["number"] }, unbursty.number
+    end
+  end
+
+  test "cards index presents the stalled filter and shows the card indicator" do
+    freeze_time do
+      card = make_stalled_card("Stalled card")
+      get cards_path, params: { indexed_by: "stalled" }
+
+      assert_response :success
+      assert_select "[data-combobox-value='stalled'][data-combobox-label='Stalled']"
+      assert_select ".card__stalled", text: "Stalled"
+      assert_includes Filter::INDEXES, "stalled"
+      assert_equal "stalled", users(:kevin).filters.from_params(indexed_by: "stalled").as_params[:indexed_by]
+    end
+  end
+
+  test "card show and JSON show expose stalled state" do
+    freeze_time do
+      card = make_stalled_card("Stalled show card")
+
+      get card_path(card)
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+
+      get card_path(card, format: :json)
+      assert_response :success
+      assert_equal true, @response.parsed_body["stalled"]
+    end
+  end
+
+  private
+    def make_bursty_card(title)
+      boards(:writebook).cards.create!(title:, creator: users(:david), status: :published).tap do |card|
+        card.toggle_assignment(users(:jz))
+      end
+    end
+
+    def make_stalled_card(title)
+      make_bursty_card(title).tap do |card|
+        card.update_column(:last_active_at, 3.weeks.ago)
+      end
+    end
+end
