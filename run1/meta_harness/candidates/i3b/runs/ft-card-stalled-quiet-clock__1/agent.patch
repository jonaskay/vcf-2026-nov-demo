@@ -0,0 +1,182 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @as_of = Time.utc(2025, 1, 15, 12)
+  end
+
+  test "a stale card without a burst is not stalled" do
+    travel_to @as_of do
+      card = create_card
+
+      assert_stalled_state card, false
+
+      card.close(user: users(:david))
+      make_stale card
+      assert_stalled_state card, false
+    end
+  end
+
+  test "comment bursts need three comments from two people" do
+    travel_to @as_of do
+      one_person = create_card
+      3.times { |index| add_comment one_person, users(:david), @as_of - 20.days + index.seconds }
+      make_stale one_person
+      assert_stalled_state one_person, false
+
+      two_comments = create_card
+      add_comment two_comments, users(:david), @as_of - 20.days
+      add_comment two_comments, users(:jz), @as_of - 20.days + 1.second
+      make_stale two_comments
+      assert_stalled_state two_comments, false
+
+      burst = create_card
+      add_comment burst, users(:david), @as_of - 20.days
+      add_comment burst, users(:jz), @as_of - 20.days + 1.second
+      add_comment burst, users(:david), @as_of - 20.days + 2.seconds
+      make_stale burst
+      assert_stalled_state burst, true
+    end
+  end
+
+  test "system comments do not count as people in a burst" do
+    travel_to @as_of do
+      card = create_card
+      add_comment card, users(:system), @as_of - 20.days
+      add_comment card, users(:system), @as_of - 20.days + 1.second
+      add_comment card, users(:david), @as_of - 20.days + 2.seconds
+      make_stale card
+
+      assert_stalled_state card, false
+    end
+  end
+
+  test "comment burst window includes its exact edge but not a later second" do
+    travel_to @as_of do
+      window = boards(:writebook).auto_postpone_period / 3
+      assert_equal 30.days.to_i, window
+
+      on_edge = create_card
+      start = @as_of - 50.days
+      add_comment on_edge, users(:david), start
+      add_comment on_edge, users(:jz), start + window / 2
+      add_comment on_edge, users(:david), start + window
+      make_stale on_edge
+      assert_stalled_state on_edge, true
+
+      outside = create_card
+      add_comment outside, users(:david), start
+      add_comment outside, users(:jz), start + window / 2
+      add_comment outside, users(:david), start + window + 1.second
+      make_stale outside
+      assert_stalled_state outside, false
+    end
+  end
+
+  test "comment burst window uses the board override or account period fallback" do
+    travel_to @as_of do
+      board = Board.create!(name: "Account period board", creator: users(:david), account: accounts(:"37s"))
+      assert_nil board.association(:entropy).reader
+      assert_equal accounts(:"37s").entropy.auto_postpone_period, board.auto_postpone_period
+
+      window = board.auto_postpone_period / 3
+      at_edge = create_card(board: board)
+      start = @as_of - 40.days
+      add_comment at_edge, users(:david), start
+      add_comment at_edge, users(:jz), start + window / 2
+      add_comment at_edge, users(:david), start + window
+      make_stale at_edge
+      assert_stalled_state at_edge, true
+
+      outside = create_card(board: board)
+      add_comment outside, users(:david), start
+      add_comment outside, users(:jz), start + window / 2
+      add_comment outside, users(:david), start + window + 1.second
+      make_stale outside
+      assert_stalled_state outside, false
+    end
+  end
+
+  test "assignment and reopen events independently create bursts" do
+    travel_to @as_of do
+      assigned = create_card
+      assigned.toggle_assignment(users(:jz))
+      make_stale assigned
+      assert_includes assigned.events.pluck(:action), "card_assigned"
+      assert_stalled_state assigned, true
+
+      reopened = create_card
+      reopened.close(user: users(:david))
+      reopened.reopen(user: users(:david))
+      make_stale reopened
+      assert_includes reopened.events.pluck(:action), "card_reopened"
+      assert_stalled_state reopened, true
+    end
+  end
+
+  test "an assignment after publication resets the quiet period" do
+    travel_to @as_of do
+      card = create_card
+      card.toggle_assignment(users(:jz))
+
+      assert_equal @as_of, card.reload.last_active_at
+      assert_stalled_state card, false
+      assert_stalled_state card, true, as_of: @as_of + 2.weeks
+    end
+  end
+
+  test "any later activity restarts the two-week quiet period" do
+    event_activity = travel_to(@as_of) { create_burst_card }
+    travel_to(@as_of - 13.days) do
+      Card.find(event_activity.id).track_event(:triaged, column: "Triage")
+    end
+    assert_equal @as_of - 13.days, event_activity.reload.last_active_at
+    assert_stalled_state event_activity, false
+    assert_stalled_state event_activity, true, as_of: @as_of + 1.day
+
+    comment_activity = travel_to(@as_of) { create_burst_card }
+    travel_to(@as_of - 13.days) do
+      add_comment comment_activity, users(:jz), @as_of - 13.days
+    end
+    assert_equal @as_of - 13.days, comment_activity.reload.last_active_at
+    assert_stalled_state comment_activity, false
+    assert_stalled_state comment_activity, true, as_of: @as_of + 1.day
+  end
+
+  private
+    def create_card(board: boards(:writebook))
+      board.cards.create!(
+        title: "Stalled state test",
+        creator: users(:david),
+        status: :published,
+        created_at: @as_of - 60.days,
+        last_active_at: @as_of - 14.days
+      )
+    end
+
+    def create_burst_card
+      card = create_card
+      add_comment card, users(:david), @as_of - 20.days
+      add_comment card, users(:jz), @as_of - 20.days + 1.second
+      add_comment card, users(:david), @as_of - 20.days + 2.seconds
+      make_stale card
+      assert_stalled_state card, true
+      card
+    end
+
+    def add_comment(card, creator, created_at)
+      card.comments.create!(creator:, body: "Comment", created_at:, updated_at: created_at)
+    end
+
+    def make_stale(card)
+      quiet_since = @as_of - 14.days
+      card.events.update_all(created_at: quiet_since, updated_at: quiet_since)
+      card.update_column(:last_active_at, quiet_since)
+    end
+
+    def assert_stalled_state(card, expected, as_of: @as_of)
+      assert_equal expected, card.stalled?(as_of:), "Ruby predicate disagrees for card #{card.id}"
+      assert_equal expected, Card.stalled(as_of:).where(id: card.id).exists?, "SQL scope disagrees for card #{card.id}"
+    end
+end
