diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..83771d1
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,61 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of: Time.current) do
+      auto_close_period = "COALESCE(stalled_board_entropy.auto_postpone_period, stalled_account_entropy.auto_postpone_period)"
+      window_seconds = "(#{auto_close_period} / 3)"
+      within_window = if connection.adapter_name == "SQLite"
+        "julianday(comment_anchor.created_at) >= julianday(burst_comment.created_at) - (#{window_seconds} / 86400.0)"
+      else
+        "comment_anchor.created_at >= #{connection.date_subtract('burst_comment.created_at', window_seconds)}"
+      end
+
+      entropy_joins = <<~SQL.squish
+        LEFT OUTER JOIN entropies AS stalled_board_entropy
+          ON stalled_board_entropy.container_type = 'Board'
+          AND stalled_board_entropy.container_id = cards.board_id
+        LEFT OUTER JOIN entropies AS stalled_account_entropy
+          ON stalled_account_entropy.container_type = 'Account'
+          AND stalled_account_entropy.container_id = cards.account_id
+      SQL
+
+      joins(entropy_joins)
+        .where("cards.last_active_at <= ?", as_of - STALLED_AFTER)
+        .where(<<~SQL.squish)
+          EXISTS (
+            SELECT 1
+            FROM events AS stalled_events
+            WHERE stalled_events.eventable_type = 'Card'
+              AND stalled_events.eventable_id = cards.id
+              AND stalled_events.action IN ('card_assigned', 'card_reopened')
+              AND stalled_events.created_at <= cards.last_active_at
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments AS comment_anchor
+            WHERE comment_anchor.card_id = cards.id
+              AND EXISTS (
+                SELECT 1
+                FROM comments AS burst_comment
+                INNER JOIN users AS burst_user ON burst_user.id = burst_comment.creator_id
+                WHERE burst_comment.card_id = cards.id
+                  AND burst_user.role <> 'system'
+                  AND burst_comment.created_at <= cards.last_active_at
+                  AND burst_comment.created_at >= comment_anchor.created_at
+                  AND #{within_window}
+                GROUP BY burst_comment.card_id
+                HAVING COUNT(*) >= 3
+                  AND COUNT(DISTINCT burst_comment.creator_id) >= 2
+              )
+          )
+        SQL
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    persisted? && self.class.stalled(as_of: as_of).where(id: id).exists?
+  end
+end
