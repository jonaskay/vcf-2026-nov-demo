+      closed.events.update_all(created_at: stale_at, updated_at: stale_at)
+      closed.update_column(:last_active_at, 2.weeks.ago)
+
+      postponed = cards(:buy_domain)
+      postponed.track_event(:assigned, creator: users(:kevin), assignee_ids: [ users(:jz).id ])
+      postponed.events.where(action: "card_assigned").update_all(created_at: stale_at, updated_at: stale_at)
+      postponed.postpone(user: users(:kevin))
+      quiet_since = 2.weeks.ago
+      postponed.events.update_all(created_at: quiet_since, updated_at: quiet_since)
+      postponed.update_column(:last_active_at, quiet_since)
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_response :success
+      assert_equal [ stalled.number, closed.number, postponed.number ].sort, @response.parsed_body.pluck("number").sort
+      assert_equal true, @response.parsed_body.first["stalled"]
+
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_select '[data-card-stalled="true"]'
+
+      get card_path(stalled)
+      assert_response :success
+      assert_select '[data-card-stalled="true"]'
+    end
+  end
+
+  test "show as JSON includes whether the card is stalled" do
+    freeze_time do
+      card = cards(:logo)
+      stale_at = 3.weeks.ago
+      card.events.update_all(created_at: stale_at, updated_at: stale_at)
+      card.update_column(:last_active_at, 2.weeks.ago)
+
+      get card_path(card), as: :json
+      assert_response :success
+      assert_equal true, @response.parsed_body["stalled"]
+    end
+  end
+
+  test "cached card output reflects the stalled state when time passes" do
+    activity_at = cards(:logo).last_active_at
+    cards(:logo).events.update_all(created_at: activity_at, updated_at: activity_at)
+    now = Time.current
+
+    with_actionview_partial_caching do
+      travel_to now do
+        get cards_path
+        assert_response :success
+        assert_select ".card[data-id='#{cards(:logo).number}'] [data-card-stalled='true']", count: 0
+
+        get cards_path(format: :json)
+        card = @response.parsed_body.find { |item| item["number"] == cards(:logo).number }
+        assert_equal false, card["stalled"]
+      end
+
+      travel_to now + 8.days do
+        get cards_path
+        assert_response :success
+        assert_select ".card[data-id='#{cards(:logo).number}'] [data-card-stalled='true']"
+
+        get cards_path(format: :json)
+        card = @response.parsed_body.find { |item| item["number"] == cards(:logo).number }
+        assert_equal true, card["stalled"]
+      end
+    end
+  end
+
