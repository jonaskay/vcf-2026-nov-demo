diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..9479d44
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,246 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @board.auto_postpone_period = 90.days.to_i
+    @start = Time.utc(2024, 1, 1, 12)
+  end
+
+  test "three comments by two people within one third of the board period become stalled after two weeks" do
+    card = create_card
+    window = 30.days
+
+    create_comment(card, users(:david), @start)
+    create_comment(card, users(:kevin), @start + window - 1.second)
+    create_comment(card, users(:david), @start + window)
+
+    assert_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "comment count and distinct people thresholds are both required" do
+    two_comments = create_card
+    create_comment(two_comments, users(:david), @start)
+    create_comment(two_comments, users(:kevin), @start + 1.day)
+    refute_stalled_after_quiet(two_comments)
+
+    one_person = create_card
+    3.times { |index| create_comment(one_person, users(:david), @start + index.days) }
+    refute_stalled_after_quiet(one_person)
+
+    three_comments = create_card
+    create_comment(three_comments, users(:david), @start)
+    create_comment(three_comments, users(:kevin), @start + 1.day)
+    create_comment(three_comments, users(:david), @start + 2.days)
+    assert_stalled_at(three_comments, three_comments.reload.last_active_at + 14.days)
+  end
+
+  test "comment burst window is inclusive and board period overrides the account period" do
+    within_window = create_card
+    create_comment(within_window, users(:david), @start)
+    create_comment(within_window, users(:kevin), @start + 15.days)
+    create_comment(within_window, users(:david), @start + 30.days)
+    assert_stalled_at(within_window, within_window.reload.last_active_at + 14.days)
+
+    outside_window = create_card
+    create_comment(outside_window, users(:david), @start)
+    create_comment(outside_window, users(:kevin), @start + 15.days)
+    create_comment(outside_window, users(:david), @start + 30.days + 1.second)
+    refute_stalled_after_quiet(outside_window)
+  end
+
+  test "system comments do not count toward a burst" do
+    card = create_card
+    create_comment(card, users(:david), @start)
+    create_comment(card, users(:system), @start + 1.hour)
+    create_comment(card, users(:kevin), @start + 2.hours)
+
+    refute_stalled_after_quiet(card)
+  end
+
+  test "a later system comment resets a previous burst without counting as a person" do
+    card = add_comment_burst(create_card)
+
+    create_comment(card, users(:system), card.reload.last_active_at + 1.day)
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "comment window falls back to the account period when the board has no override" do
+    @board.entropy.destroy!
+    card = create_card
+
+    create_comment(card, users(:david), @start)
+    create_comment(card, users(:kevin), @start + 5.days)
+    create_comment(card, users(:david), @start + 10.days)
+
+    assert_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "publishing a card refreshes its activity timestamp" do
+    card = travel_to(@start) do
+      @board.cards.create!(creator: users(:david), status: :drafted)
+    end
+    card.update_column(:last_active_at, @start - 30.days)
+
+    travel_to @start do
+      card.publish
+    end
+
+    assert_equal @start, card.reload.last_active_at
+    refute card.stalled?(as_of: @start + 14.days)
+  end
+
+  test "assignment and reopening each create a burst" do
+    assigned = create_card
+    travel_to @start do
+      assigned.toggle_assignment(users(:kevin))
+    end
+    assert_stalled_at(assigned, assigned.reload.last_active_at + 14.days)
+
+    reopened = create_card
+    travel_to @start do
+      reopened.close(user: users(:david))
+      reopened.reopen(user: users(:david))
+    end
+    assert reopened.events.exists?(action: "card_reopened")
+    assert_stalled_at(reopened, reopened.reload.last_active_at + 14.days)
+  end
+
+  test "unassigning after a burst resets it" do
+    card = create_card
+    travel_to @start do
+      card.toggle_assignment(users(:kevin))
+    end
+    burst_at = card.reload.last_active_at
+
+    travel_to burst_at + 1.day do
+      card.toggle_assignment(users(:kevin))
+    end
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "stalled begins at fourteen days and activity resets the previous burst" do
+    card = add_comment_burst(create_card)
+    burst_at = card.reload.last_active_at
+
+    refute_stalled_at(card, burst_at + 14.days - 1.second)
+    assert_stalled_at(card, burst_at + 14.days)
+
+    travel_to burst_at + 10.days do
+      card.update!(title: "Updated after the burst")
+    end
+
+    refute_stalled_at(card, burst_at + 14.days)
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+
+    travel_to card.last_active_at + 1.day do
+      card.reactions.create!(reacter: users(:kevin), content: "👍")
+    end
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "a single comment after a burst resets it when it does not form another burst" do
+    card = add_comment_burst(create_card)
+    burst_at = card.reload.last_active_at
+
+    create_comment(card, users(:david), burst_at + 31.days)
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "deleting a comment resets the previous burst" do
+    card = add_comment_burst(create_card)
+    comment = card.comments.last
+
+    travel_to card.reload.last_active_at + 1.day do
+      comment.destroy!
+    end
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "removing a reaction resets the previous burst" do
+    card = add_comment_burst(create_card)
+    reaction = card.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    travel_to card.reload.last_active_at + 1.day do
+      reaction.destroy!
+    end
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "updating a comment resets the previous burst" do
+    card = add_comment_burst(create_card)
+    comment = card.comments.last
+
+    travel_to card.reload.last_active_at + 1.day do
+      comment.update!(body: "Edited after the burst")
+    end
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "a reaction at the burst timestamp still resets activity" do
+    card = add_comment_burst(create_card)
+
+    travel_to card.reload.last_active_at do
+      card.reactions.create!(reacter: users(:kevin), content: "👍")
+    end
+
+    refute_stalled_at(card, card.reload.last_active_at + 14.days)
+  end
+
+  test "scope and predicate agree and unburst activity does not inherit an old burst" do
+    card = add_comment_burst(create_card)
+    burst_at = card.reload.last_active_at
+
+    assert_equal card.stalled?(as_of: burst_at + 14.days), Card.stalled(burst_at + 14.days).where(id: card.id).exists?
+
+    travel_to burst_at + 1.day do
+      card.update!(title: "A later non-burst activity")
+    end
+
+    as_of = card.reload.last_active_at + 14.days
+    refute card.stalled?(as_of: as_of)
+    refute_includes Card.stalled(as_of), card
+  end
+
+  private
+    def create_card
+      travel_to @start do
+        @board.cards.create!(creator: users(:david), status: :published)
+      end
+    end
+
+    def create_comment(card, creator, at)
+      travel_to at do
+        card.comments.create!(creator: creator, body: "An update")
+      end
+    end
+
+    def add_comment_burst(card)
+      create_comment(card, users(:david), @start)
+      create_comment(card, users(:kevin), @start + 1.hour)
+      create_comment(card, users(:david), @start + 2.hours)
+      card
+    end
+
+    def assert_stalled_at(card, as_of)
+      assert card.stalled?(as_of: as_of), "expected card to be stalled at #{as_of}"
+      assert_includes Card.stalled(as_of), card
+    end
+
+    def refute_stalled_at(card, as_of)
+      refute card.stalled?(as_of: as_of), "expected card not to be stalled at #{as_of}"
+      refute_includes Card.stalled(as_of), card
+    end
+
+    def refute_stalled_after_quiet(card)
+      refute_stalled_at(card, card.reload.last_active_at + 14.days)
+    end
+end
