diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..2ea6ab0
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,123 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 14.days.to_i.seconds
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      relation = if connection.adapter_name.match?(/sqlite/i)
+        where("julianday(cards.last_active_at) <= julianday(?)", as_of - STALLED_AFTER)
+      else
+        where("cards.last_active_at <= ?", as_of - STALLED_AFTER)
+      end
+
+      relation.where(Card.stalled_burst_sql)
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    if persisted?
+      self.class.stalled(as_of).where(id: id).exists?
+    else
+      false
+    end
+  end
+
+  class_methods do
+    def stalled_burst_sql
+      <<~SQL.squish
+        (
+          EXISTS (
+            SELECT 1 FROM events stalled_burst_events
+            WHERE stalled_burst_events.eventable_type = #{connection.quote(Card.name)}
+              AND stalled_burst_events.eventable_id = cards.id
+              AND stalled_burst_events.action IN (
+                #{connection.quote("card_assigned")}, #{connection.quote("card_reopened")}
+              )
+              AND stalled_burst_events.created_at = cards.last_active_at
+          )
+          OR EXISTS (
+            SELECT 1 FROM assignments stalled_burst_assignments
+            WHERE stalled_burst_assignments.card_id = cards.id
+              AND stalled_burst_assignments.created_at = cards.last_active_at
+          )
+          OR EXISTS (
+            SELECT 1 FROM events stalled_burst_comment_events
+            INNER JOIN comments stalled_burst_end_comments
+              ON stalled_burst_end_comments.id = stalled_burst_comment_events.eventable_id
+            WHERE stalled_burst_comment_events.eventable_type = #{connection.quote(Comment.name)}
+              AND stalled_burst_comment_events.action = #{connection.quote("comment_created")}
+              AND stalled_burst_comment_events.created_at = cards.last_active_at
+              AND stalled_burst_end_comments.card_id = cards.id
+              AND stalled_burst_end_comments.creator_id IN (#{human_user_ids_sql})
+              AND ((
+                #{comment_count_sql}
+              ) >= 3)
+              AND ((
+                #{commenter_count_sql}
+              ) >= 2)
+          )
+        )
+      SQL
+    end
+
+    private
+      def human_user_ids_sql
+        User.where.not(role: :system).select(:id).to_sql
+      end
+
+      def auto_close_period_sql
+        board_period = <<~SQL.squish
+          SELECT stalled_board_entropy.auto_postpone_period
+          FROM entropies stalled_board_entropy
+          WHERE stalled_board_entropy.container_type = #{connection.quote("Board")}
+            AND stalled_board_entropy.container_id = cards.board_id
+        SQL
+
+        account_period = <<~SQL.squish
+          SELECT stalled_account_entropy.auto_postpone_period
+          FROM entropies stalled_account_entropy
+          WHERE stalled_account_entropy.container_type = #{connection.quote("Account")}
+            AND stalled_account_entropy.container_id = cards.account_id
+        SQL
+
+        "COALESCE((#{board_period}), (#{account_period}), #{Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i})"
+      end
+
+      def comment_count_sql
+        <<~SQL.squish
+          SELECT COUNT(*)
+          FROM comments stalled_burst_window_comments
+          WHERE stalled_burst_window_comments.card_id = stalled_burst_end_comments.card_id
+            AND stalled_burst_window_comments.creator_id IN (#{human_user_ids_sql})
+            AND stalled_burst_window_comments.created_at <= stalled_burst_end_comments.created_at
+            AND #{comment_within_window_sql}
+        SQL
+      end
+
+      def commenter_count_sql
+        <<~SQL.squish
+          SELECT COUNT(DISTINCT stalled_burst_window_comments.creator_id)
+          FROM comments stalled_burst_window_comments
+          WHERE stalled_burst_window_comments.card_id = stalled_burst_end_comments.card_id
+            AND stalled_burst_window_comments.creator_id IN (#{human_user_ids_sql})
+            AND stalled_burst_window_comments.created_at <= stalled_burst_end_comments.created_at
+            AND #{comment_within_window_sql}
+        SQL
+      end
+
+      def comment_within_window_sql
+        period = auto_close_period_sql
+
+        if connection.adapter_name.match?(/sqlite/i)
+          "(julianday(stalled_burst_end_comments.created_at) - julianday(stalled_burst_window_comments.created_at)) * 86400 <= ((#{period}) / 3.0)"
+        else
+          beginning_of_window = connection.date_subtract(
+            "stalled_burst_end_comments.created_at",
+            "(#{period}) / 3"
+          )
+          "stalled_burst_window_comments.created_at >= #{beginning_of_window}"
+        end
+      end
+  end
+end
