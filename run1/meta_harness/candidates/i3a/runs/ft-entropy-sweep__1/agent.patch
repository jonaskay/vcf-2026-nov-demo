   included do
     scope :due_to_be_postponed, -> do
+      now = Time.current
       active
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
-        .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", Time.now)
+        .where("cards.last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
     end
 
     scope :postponing_soon, -> do
@@ -25,10 +26,46 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      account_ids = Entropy.where(container_type: [ "Account", "Board" ]).select(:account_id)
+      system_users = User.where(role: :system, account_id: account_ids).index_by(&:account_id)
+
+      due_to_be_postponed_by_period(now).each do |cards|
+        cards.find_each do |card|
+          card.auto_postpone(user: system_users.fetch(card.account_id) { card.account.system_user })
+        end
       end
+
+      nil
     end
+
+    private
+      def due_to_be_postponed_by_period(now)
+        board_settings = Entropy.where(container_type: "Board")
+        account_settings = Entropy.where(container_type: "Account")
+
+        board_scopes = board_settings.distinct.pluck(:auto_postpone_period).map do |period|
+          settings = board_settings.where(auto_postpone_period: period)
+
+          active
+            .where(board_id: settings.select(:container_id))
+            .where("cards.last_active_at <= ?", now - period.seconds)
+        end
+
+        account_scopes = account_settings.distinct.pluck(:auto_postpone_period).map do |period|
+          settings = account_settings.where(auto_postpone_period: period)
+          account_ids = settings.select(:container_id)
+          overridden_board_ids = Entropy.where(container_type: "Board").select(:container_id)
+
+          boards = Board.where(account_id: account_ids).where.not(id: overridden_board_ids)
+
+          active
+            .where(board_id: boards.select(:id))
+            .where("cards.last_active_at <= ?", now - period.seconds)
+        end
+
+        board_scopes + account_scopes
+      end
   end
 
   def entropy
