@@ -0,0 +1,12 @@
+class SearchesController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = Current.user.accessible_cards.search(@query).reverse_chronologically.preloaded
+
+    @comments_by_card = if @query.present?
+      Comment.search(@query).where(card_id: @cards.map(&:id)).preloaded.group_by(&:card_id)
+    else
+      {}
+    end
+  end
+end
