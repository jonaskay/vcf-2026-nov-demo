diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..d6ef484
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,23 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      if query.present?
+        pattern = "%#{Card.sanitize_sql_like(query, "!")}%"
+        conditions = <<~SQL.squish
+          LOWER(cards.title) LIKE LOWER(:query) ESCAPE '!'
+          OR LOWER(action_text_rich_texts.body) LIKE LOWER(:query) ESCAPE '!'
+          OR LOWER(rich_text_bodies_comments.body) LIKE LOWER(:query) ESCAPE '!'
+        SQL
+
+        published
+          .left_joins(:rich_text_description, comments: :rich_text_body)
+          .where(conditions, query: pattern)
+          .distinct
+      else
+        none
+      end
+    end
+  end
+end
