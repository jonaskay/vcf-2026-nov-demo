new file mode 100644
index 0000000..9f749de
--- /dev/null
+++ b/app/models/comment/searchable.rb
@@ -0,0 +1,17 @@
+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      if query.present?
+        pattern = "%#{Comment.sanitize_sql_like(query, "!")}%"
+
+        joins(:card, :rich_text_body)
+          .merge(Card.published)
+          .where("LOWER(action_text_rich_texts.body) LIKE LOWER(?) ESCAPE '!'", pattern)
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..e8f2af3
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.label :q, "Search cards" %>
+    <%= form.search_field :q, value: @query %>
+    <%= form.submit "Search" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <ol class="search-results">
+        <% @cards.each do |card| %>
+          <li class="search-result" data-card-number="<%= card.number %>">
+            <h2 class="search-result__title"><%= link_to highlight(card.title, @query), card_path(card) %></h2>
+
+            <% if description = card.description.to_plain_text.presence %>
+              <p class="search-result__description"><%= highlight(description, @query) %></p>
+            <% end %>
+
+            <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+              <p class="search-result__comment"><%= highlight(comment.body.to_plain_text, @query) %></p>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <p class="search-results__empty">No cards found</p>
+    <% end %>
+  <% end %>
+</section>
