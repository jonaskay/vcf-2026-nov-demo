+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |_name, _started, _finished, _unique_id, payload|
+        batch_queries << payload[:sql] if payload[:name] == "Card Load"
+        user_queries << payload[:sql] if payload[:sql].include?("FROM \"users\"")
+      end
+
+      Card.any_instance.expects(:auto_postpone).with(user: system_user).times(1001)
