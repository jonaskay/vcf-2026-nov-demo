@@ -25,10 +28,53 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      groups = due_to_be_postponed_groups
+
+      if groups.any?
+        system_users = User.where(role: :system).index_by(&:account_id)
+
+        groups.each do |cards|
+          cards.find_each(batch_size: 1000) do |card|
+            system_user = system_users.fetch(card.account_id) { card.account.system_user }
+            card.auto_postpone(user: system_user)
+          end
+        end
+      end
+
+      nil
+    end
+
+    def due_to_be_postponed_groups(now = Time.current)
+      board_entropies = Entropy.where(container_type: "Board")
+      overridden_board_ids = board_entropies.select(:container_id)
+
+      board_groups = board_entropies.distinct.pluck(:auto_postpone_period).map do |period|
+        boards = Board.joins(:entropy).where(entropies: { auto_postpone_period: period })
+
+        Card.active
+          .where(board_id: boards.select(:id), account_id: boards.select(:account_id))
+          .where("cards.last_active_at <= ?", entropy_cutoff(now, period))
+      end
+
+      account_entropies = Entropy.where(container_type: "Account")
+      account_groups = account_entropies.distinct.pluck(:auto_postpone_period).map do |period|
+        accounts = account_entropies.where(auto_postpone_period: period)
+
+        Card.active
+          .where(account_id: accounts.select(:container_id))
+          .where.not(board_id: overridden_board_ids)
+          .where("cards.last_active_at <= ?", entropy_cutoff(now, period))
       end
+
+      board_groups + account_groups
     end
+
+    private
+      def entropy_cutoff(now, period)
+        cutoff = now - period
+        cutoff = cutoff.change(usec: 0) if connection.adapter_name == "SQLite"
+        cutoff
+      end
   end
 
   def entropy
