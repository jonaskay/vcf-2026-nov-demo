+
+  test "due scope stays a relation and uses indexed per-period cutoffs with over 100,000 cards" do
+    freeze_time do
+      account = accounts("37s")
+      board = boards(:writebook)
+      creator = users(:david)
+      now = Time.current
+      cutoff = now - entropies(:writebook_board).auto_postpone_period
+
+      (1..100_001).each_slice(3_000) do |numbers|
+        Card.insert_all!(numbers.map do |number|
+          {
+            id: ActiveRecord::Type::Uuid.generate,
+            account_id: account.id,
+            board_id: board.id,
+            creator_id: creator.id,
+            number: 100_000 + number,
+            title: "Scale card #{number}",
+            status: "published",
+            last_active_at: number == 1 ? cutoff : now,
+            created_at: now,
+            updated_at: now
+          }
+        end)
+      end
+
+      relation = Card.due_to_be_postponed
+      sql = relation.to_sql
+
+      assert_kind_of ActiveRecord::Relation, relation
+      assert_includes sql, "UNION ALL"
+      assert_includes sql, "cards.last_active_at <="
+      assert_not_includes sql, "COALESCE"
+      assert_not_includes sql, "JOIN \"boards\""
+      assert_equal 1, relation.count
+
+      plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{sql}").map { |row| row["detail"] }
+
+      assert plan.any? { |line| line.include?("index_cards_on_account_id_and_last_active_at_and_status") }
+      assert_not plan.any? { |line| line.start_with?("SCAN cards") }
+
+      assert_nil Card.auto_postpone_all_due
+      assert Card.find_by!(number: 100_001).reload.postponed?
+    end
+  end
+
+  test "due scope respects every board override and account default cutoff" do
+    freeze_time do
+      board_entropy = entropies(:writebook_board)
+      account_entropy = entropies("37s_account")
+
+      Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.each do |period|
+        board_entropy.update!(auto_postpone_period: period)
+        cutoff = Time.current - period
+        cards(:logo).update!(last_active_at: cutoff)
+        cards(:text).update!(last_active_at: cutoff + 1.second)
+
+        assert_includes Card.due_to_be_postponed, cards(:logo)
+        assert_not_includes Card.due_to_be_postponed, cards(:text)
+      end
+
+      board_entropy.destroy
+
+      Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.each do |period|
+        account_entropy.update!(auto_postpone_period: period)
+        cutoff = Time.current - period
+        cards(:logo).update!(last_active_at: cutoff)
+        cards(:text).update!(last_active_at: cutoff + 1.second)
+
+        assert_includes Card.due_to_be_postponed, cards(:logo)
+        assert_not_includes Card.due_to_be_postponed, cards(:text)
+      end
+    end
+  end
+
+  test "auto postpone all due processes cards across a batch boundary" do
