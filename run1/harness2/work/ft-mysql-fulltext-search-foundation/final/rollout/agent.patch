@@ -0,0 +1,28 @@
+module SearchesHelper
+  def highlight_search_text(text)
+    text = text.to_s
+
+    if @query.present?
+      pattern = Regexp.new(Regexp.escape(@query), Regexp::IGNORECASE)
+      highlighted_segments = []
+      position = 0
+
+      text.to_enum(:scan, pattern).each do
+        match = Regexp.last_match
+        highlighted_segments << text[position...match.begin(0)]
+        highlighted_segments << tag.mark(match[0])
+        position = match.end(0)
+      end
+
+      highlighted_segments << text[position..]
+      safe_join(highlighted_segments)
+    else
+      text
+    end
+  end
+
+  def search_excerpt(text)
+    text = excerpt(text.to_s, @query, radius: 100)
+    highlight_search_text(text) if text
+  end
+end
