diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..56aa441
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,48 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search">
+  <div class="panel borderless center margin pad">
+    <%= form_with url: search_path, method: :get, class: "flex gap-half" do |form| %>
+      <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…", aria: { label: "Search cards" } %>
+      <%= form.submit "Search", class: "btn" %>
+    <% end %>
+  </div>
+
+  <% if @query.blank? %>
+    <p class="blank-slate">Enter a search term to find cards</p>
+  <% else %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% if @page.records.any? %>
+        <% @page.records.each do |card| %>
+          <article class="search-result panel borderless margin-block-end pad">
+            <h2 class="search-result__title">
+              <%= link_to highlight_search_text(card.title), card_path(card) %>
+            </h2>
+
+            <p class="txt-small margin-block-end-half">in <%= link_to card.board.name, board_path(card.board) %></p>
+
+            <% if description = search_excerpt(card.description.to_plain_text) %>
+              <p class="search-result__description"><%= description %></p>
+            <% end %>
+
+            <% @matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+              <% if comment_excerpt = search_excerpt(comment.body.to_plain_text) %>
+                <p class="search-result__comment"><%= comment_excerpt %></p>
+              <% end %>
+            <% end %>
+          </article>
+        <% end %>
+      <% else %>
+        <p class="blank-slate">No cards found</p>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
