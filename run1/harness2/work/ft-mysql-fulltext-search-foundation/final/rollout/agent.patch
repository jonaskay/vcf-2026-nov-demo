@@ -0,0 +1,26 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].is_a?(String) ? params[:q].strip : ""
+    set_page_and_extract_portion_from(search_results)
+    @matching_comments_by_card_id = matching_comments_by_card_id
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards.published
+        .matching_search_term(@query)
+        .reverse_chronologically
+        .preload(:board, :rich_text_description)
+    end
+
+    def matching_comments_by_card_id
+      if @query.present? && @page.records.any?
+        Comment.matching_search_term(@query)
+          .where(card_id: @page.records.map(&:id))
+          .preload(:rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
