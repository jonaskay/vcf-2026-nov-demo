diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d4de798
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles and safely highlights matches" do
+    card = create_published_card(title: "HTML Needle <img src=x onerror=alert(1)>")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "Needle"
+    assert_select ".search-result__title img", count: 0
+    assert_select ".search-result__title a[href=?]", card_path(card)
+    assert_includes response.body, "&lt;img src=x onerror=alert(1)&gt;"
+  end
+
+  test "searches descriptions and highlights matches" do
+    create_published_card(title: "A card", description: "<p>DescriptionNeedle appears here.</p>")
+
+    get search_path, params: { q: "DescriptionNeedle" }
+
+    assert_response :success
+    assert_select ".search-result__description mark", text: "DescriptionNeedle"
+  end
+
+  test "searches comment bodies and highlights matches" do
+    card = create_published_card(title: "A card")
+    create_comment(card, "CommentNeedle appears here.")
+
+    get search_path, params: { q: "CommentNeedle" }
+
+    assert_response :success
+    assert_select ".search-result__comment mark", text: "CommentNeedle"
+  end
+
+  test "returns cards newest first and only once when several fields and comments match" do
+    older = create_published_card(title: "OrderNeedle older")
+    newer = create_published_card(title: "OrderNeedle newer")
+    create_comment(newer, "OrderNeedle in a comment")
+    create_comment(newer, "OrderNeedle in another comment")
+    older.update_column(:created_at, 2.days.ago)
+    newer.update_column(:created_at, 1.day.ago)
+
+    get search_path, params: { q: "OrderNeedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 2
+    assert_equal [ newer, older ].map(&:number), css_select(".search-result__title a").map { |link| link["href"].split("/").last.to_i }
+  end
+
+  test "does not return cards or comment matches after board access is revoked" do
+    card = create_published_card(title: "RevokedNeedle")
+    create_comment(card, "RevokedCommentNeedle")
+    board = boards(:writebook)
+    board.update!(all_access: false)
+    board.accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "RevokedNeedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "RevokedCommentNeedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return drafts or comments on drafts" do
+    draft = create_published_card(title: "DraftTitleNeedle")
+    create_comment(draft, "DraftCommentNeedle")
+    draft.update_column(:status, "drafted")
+
+    get search_path, params: { q: "DraftTitleNeedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "DraftCommentNeedle" }
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "blank and missing queries render without results" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "   " }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "treats percent and underscore in a query literally" do
+    create_published_card(title: "Wildcard X%_Y literal")
+    create_published_card(title: "Wildcard XabY literal")
+
+    get search_path, params: { q: "X%_Y" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "X%_Y"
+  end
+
+  private
+    def create_published_card(title:, description: nil, board: boards(:writebook))
+      Current.set(account: accounts("37s"), user: users(:kevin)) do
+        board.cards.create!(creator: users(:kevin), title: title, description: description, status: :published)
+      end
+    end
+
+    def create_comment(card, body)
+      Current.set(account: accounts("37s"), user: users(:kevin)) do
+        card.comments.create!(creator: users(:kevin), body: body)
+      end
+    end
+end
