diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..3955825
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title and highlights the match" do
+    card = create_card(title: "The needle is in this title")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?] h2 a[href=?]", card.id, card_path(card) do
+      assert_select "mark", text: "needle"
+    end
+  end
+
+  test "finds cards by description and highlights plain text" do
+    card = create_card(title: "Description result", description: "The needle is in this description")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?] .search-result__description mark", card.id, text: "needle"
+  end
+
+  test "finds cards by comment body and returns a card only once" do
+    card = create_card(title: "Comment result")
+    Current.set(account: accounts("37s"), user: users(:kevin)) do
+      card.comments.create!(creator: users(:kevin), body: "The needle is in this comment")
+      card.comments.create!(creator: users(:kevin), body: "Another needle in a second comment")
+    end
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", card.id, count: 1 do
+      assert_select ".search-result__comments mark", text: "needle", count: 2
+    end
+  end
+
+  test "orders matching cards newest first" do
+    older = create_card(title: "ordered search term older")
+    newer = create_card(title: "ordered search term newer")
+    older.update_column(:created_at, 2.days.ago)
+    newer.update_column(:created_at, 1.day.ago)
+
+    get search_path(q: "ordered search term")
+
+    assert_response :success
+    result_ids = css_select(".search-result").map { |result| result["data-search-result-card-id"] }
+    assert_equal [ newer.id, older.id ], result_ids
+  end
+
+  test "does not show cards after board access is revoked" do
+    card = create_card(title: "revoked access search term", board: boards(:private))
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "revoked access search term")
+
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", card.id, count: 0
+  end
+
+  test "excludes drafts and comments on drafts" do
+    draft = create_card(title: "draft title search needle", status: :drafted)
+    Current.set(account: accounts("37s"), user: users(:kevin)) do
+      comment = draft.comments.build(account: accounts("37s"), creator: users(:kevin))
+      comment.save!(validate: false)
+      ActionText::RichText.create!(
+        account: accounts("37s"), record: comment, name: "body", body: "draft comment search needle"
+      )
+    end
+
+    get search_path(q: "draft title search needle")
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", draft.id, count: 0
+
+    get search_path(q: "draft comment search needle")
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", draft.id, count: 0
+  end
+
+  test "treats percent and underscore as literal characters" do
+    percent_match = create_card(title: "literal wildcard needle%token")
+    percent_non_match = create_card(title: "literal wildcard needleXtoken")
+    underscore_match = create_card(title: "literal wildcard needle_token")
+    underscore_non_match = create_card(title: "literal wildcard needleXtoken")
+
+    get search_path(q: "needle%token")
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", percent_match.id, count: 1
+    assert_select ".search-result[data-search-result-card-id=?]", percent_non_match.id, count: 0
+
+    get search_path(q: "needle_token")
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", underscore_match.id, count: 1
+    assert_select ".search-result[data-search-result-card-id=?]", underscore_non_match.id, count: 0
+  end
+
+  test "blank and missing queries render with no results" do
+    get search_path
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "  ")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "trims whitespace around the query" do
+    card = create_card(title: "Trimmed search needle")
+
+    get search_path(q: "  needle  ")
+
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?]", card.id, count: 1
+  end
+
+  test "highlights HTML-bearing titles without rendering their markup" do
+    card = create_card(title: "<script>needle</script>")
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result[data-search-result-card-id=?] h2 mark", card.id, text: "needle"
+    assert_no_match "<script>", response.body
+  end
+
+  private
+    def create_card(title:, description: nil, board: boards(:writebook), status: :published)
+      Current.set(account: accounts("37s"), user: users(:kevin)) do
+        board.cards.create!(title: title, description: description, creator: users(:kevin), status: status)
+      end
+    end
+end
