diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..f8daa39
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,45 @@
+<% @page_title = "Search cards" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center flex flex-column gap">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap-half" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width", autofocus: true %>
+    <%= form.button "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page, class: "flex flex-column gap" do %>
+        <% @page.records.each do |card| %>
+          <article class="search-result flex flex-column gap-half" data-search-result-card-id="<%= card.id %>">
+            <h2 class="search-result__title txt-medium">
+              <%= link_to highlight(card.title, @query), card_path(card) %>
+            </h2>
+            <p class="search-result__board txt-small"><%= link_to card.board.name, card.board %></p>
+
+            <% if description_excerpt = excerpt(card.description.to_plain_text, @query, radius: 120) %>
+              <p class="search-result__description"><%= highlight(description_excerpt, @query) %></p>
+            <% end %>
+
+            <% @matching_comments_by_card.fetch(card.id, []).each do |comment| %>
+              <% if comment_excerpt = excerpt(comment.body.to_plain_text, @query, radius: 120) %>
+                <p class="search-result__comments"><%= highlight(comment_excerpt, @query) %></p>
+              <% end %>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match this search</p>
+    <% end %>
+  <% end %>
+</section>
