@@ -0,0 +1,21 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = Current.user.accessible_cards.published.search(@query).reverse_chronologically
+
+    set_page_and_extract_portion_from cards.includes(:board).with_rich_text_description
+    @matching_comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def matching_comments_by_card
+      if @page.records.any?
+        Comment.search(@query)
+          .where(card_id: @page.records.map(&:id))
+          .with_rich_text_body
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..52c2549 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -19,6 +19,36 @@ class Card < ApplicationRecord
   after_touch  -> { board.touch }, if: :published?
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
+  scope :search, ->(query) do
+    if query.present?
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(query, "!")}%"
+
+      where(<<~SQL.squish, pattern: pattern)
+        cards.title LIKE :pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts descriptions
+          WHERE descriptions.record_type = 'Card'
+            AND descriptions.record_id = cards.id
+            AND descriptions.name = 'description'
+            AND descriptions.body LIKE :pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comment_bodies.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+    else
+      none
+    end
+  end
+
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
