diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..2784883
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,35 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(term) do
+      if term.present?
+        pattern = "%#{Card.sanitize_sql_like(term)}%"
+
+        published.where(<<~SQL.squish, pattern: pattern).reverse_chronologically
+          cards.title LIKE :pattern
+          OR EXISTS (
+            SELECT 1
+            FROM action_text_rich_texts AS card_descriptions
+            WHERE card_descriptions.record_type = 'Card'
+              AND card_descriptions.record_id = cards.id
+              AND card_descriptions.name = 'description'
+              AND card_descriptions.body LIKE :pattern
+          )
+          OR EXISTS (
+            SELECT 1
+            FROM comments
+            INNER JOIN action_text_rich_texts AS comment_bodies
+              ON comment_bodies.record_type = 'Comment'
+              AND comment_bodies.record_id = comments.id
+              AND comment_bodies.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND comment_bodies.body LIKE :pattern
+          )
+        SQL
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..4ea2aee
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">Search</h1>
+
+  <div class="header__actions header__actions--end">
+    <%= form_with url: search_path, method: :get do |form| %>
+      <%= form.search_field :q, value: @query, placeholder: "Search cards…", aria: { label: "Search cards" } %>
+      <%= form.submit "Search" %>
+    <% end %>
+  </div>
+<% end %>
+
+<section class="search-results">
+  <% @cards.each do |card| %>
+    <article class="search-result" data-card-number="<%= card.number %>">
+      <h2 class="search-result__title">
+        <%= link_to highlight_search_text(card.title, @query), card_path(card) %>
+      </h2>
+
+      <% if card.description.present? %>
+        <p class="search-result__description"><%= highlight_search_text(card.description, @query) %></p>
+      <% end %>
+
+      <% @comments_by_card_id.fetch(card.id, []).each do |comment| %>
+        <p class="search-result__comment"><%= highlight_search_text(comment.body, @query) %></p>
+      <% end %>
+
+      <p class="search-result__board"><%= link_to card.board.name, card.board %></p>
+    </article>
+  <% end %>
+
+  <% if @cards.empty? %>
+    <p class="blank-slate">No cards match your search</p>
+  <% end %>
+</section>
