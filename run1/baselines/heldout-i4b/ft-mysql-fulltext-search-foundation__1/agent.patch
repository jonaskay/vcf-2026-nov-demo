diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..5db0ac4
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches published cards by title" do
+    card = create_card(title: "A quartz title")
+
+    get search_path, params: { q: "quartz" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}']"
+  end
+
+  test "searches published cards by description" do
+    card = create_card(title: "An unrelated title", description: "Description contains malachite")
+
+    get search_path, params: { q: "malachite" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}']"
+  end
+
+  test "searches comment bodies and renders a highlighted matching comment" do
+    card = create_card(title: "An unrelated title")
+    card.comments.create!(creator: users(:kevin), body: "A comment contains turquoise")
+
+    get search_path, params: { q: "turquoise" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}']"
+    assert_select ".search-result__comment mark", text: "turquoise"
+  end
+
+  test "orders results by card creation time newest first" do
+    travel_to Time.zone.local(2025, 1, 2, 12) do
+      older = create_card(title: "chronology amethyst", created_at: 1.day.ago, last_active_at: Time.current)
+      newer = create_card(title: "chronology amethyst", created_at: 1.hour.ago, last_active_at: 1.year.ago)
+
+      get search_path, params: { q: "chronology" }
+
+      assert_response :success
+      assert_equal [ newer.number.to_s, older.number.to_s ], css_select(".search-result").map { |result| result["data-card-number"] }
+    end
+  end
+
+  test "highlights every matching occurrence in title, description, and comment body" do
+    card = create_card(title: "needle and NEEDLE", description: "Needle then needle")
+    card.comments.create!(creator: users(:kevin), body: "NEEDLE with needle")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", count: 2
+    assert_select ".search-result__description mark", count: 2
+    assert_select ".search-result__comment mark", count: 2
+  end
+
+  test "stops returning a board's cards immediately after access is revoked" do
+    card = create_card(board: boards(:private), title: "private zircon")
+
+    get search_path, params: { q: "zircon" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}']"
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "zircon" }
+    assert_response :success
+    assert_select ".search-result[data-card-number='#{card.number}']", count: 0
+    assert_no_match "private zircon", response.body
+  end
+
+  test "never returns draft cards or matches in comments on draft cards" do
+    draft_title = create_card(title: "draft opal").tap { |card| card.update!(status: :drafted) }
+    draft_comment = create_card(title: "unrelated draft card")
+    draft_comment.comments.create!(creator: users(:kevin), body: "draft comment opal")
+    draft_comment.update!(status: :drafted)
+
+    get search_path, params: { q: "opal" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_no_match draft_title.title, response.body
+    assert_no_match "draft comment opal", response.body
+  end
+
+  test "an empty query does not return every card" do
+    create_card(title: "ordinary card")
+
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "shows no results when no published card field matches the query" do
+    create_card(title: "ordinary card")
+
+    get search_path, params: { q: "unmatched-citrine" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_card(title:, description: nil, created_at: Time.current, last_active_at: created_at, status: :published, board: boards(:writebook))
+      Current.set(user: users(:kevin)) do
+        board.cards.create!(
+          creator: users(:kevin),
+          title: title,
+          description: description,
+          created_at: created_at,
+          last_active_at: last_active_at,
+          status: status
+        )
+      end
+    end
+end
