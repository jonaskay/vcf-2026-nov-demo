@@ -0,0 +1,23 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = Current.user.accessible_cards.search(@query).preload(:board, :rich_text_description)
+    @comments_by_card_id = matching_comments_by_card_id
+  end
+
+  private
+    def matching_comments_by_card_id
+      if @query.present? && @cards.any?
+        pattern = "%#{Card.sanitize_sql_like(@query)}%"
+
+        Comment.joins(:rich_text_body)
+          .where(card_id: @cards.map(&:id))
+          .where("action_text_rich_texts.body LIKE ?", pattern)
+          .preload(:rich_text_body)
+          .chronologically
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
