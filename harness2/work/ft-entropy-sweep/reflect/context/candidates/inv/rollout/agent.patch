+++ b/test/models/card/entropic_test.rb
@@ -59,6 +59,46 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone all due across entropy periods without postponing inactive cards" do
+    freeze_time
+
+    entropies(:writebook_board).destroy
+    cards(:logo).update!(last_active_at: 31.days.ago)
+    cards(:shipping).update!(last_active_at: 29.days.ago)
+    cards(:radio).update!(last_active_at: 91.days.ago)
+
+    cards(:text).postpone
+    cards(:text).update!(last_active_at: 40.days.ago)
+    cards(:paycheck).close
+    cards(:paycheck).update!(last_active_at: 100.days.ago)
+    cards(:unfinished_thoughts).update!(last_active_at: 400.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +2 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+    assert cards(:text).reload.postponed?
+    assert cards(:paycheck).reload.closed?
+    assert_not cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "auto postpone all due includes legacy periods shorter than the allowed minimum" do
+    freeze_time
+
+    entropies(:writebook_board).update_column(:auto_postpone_period, 1.day.to_i)
+    cards(:layout, :text, :shipping, :buy_domain).each { |card| card.update!(last_active_at: 1.minute.ago) }
+    cards(:logo).update!(last_active_at: 2.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
