diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..ec2a671
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the board period create a burst" do
+    card = new_card
+    window = card.auto_postpone_period / 3
+    started_at = Time.current
+
+    travel_to started_at do
+      card.comments.create! body: "One", creator: users(:david)
+    end
+    travel_to started_at + window do
+      card.comments.create! body: "Two", creator: users(:kevin)
+      card.comments.create! body: "Three", creator: users(:david)
+    end
+
+    assert_in_delta started_at + window, card.reload.last_burst_at, 1.second
+  end
+
+  test "comments by one person or by system users do not create a burst" do
+    card = new_card
+    started_at = Time.current
+
+    travel_to started_at do
+      3.times { card.comments.create! body: "Repeated", creator: users(:david) }
+    end
+
+    assert_nil card.reload.last_burst_at
+
+    travel_to started_at + 1.day do
+      3.times { card.comments.create! body: "System comment", creator: users(:system) }
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the board period do not create a burst" do
+    card = new_card
+    window = card.auto_postpone_period / 3
+    started_at = Time.current
+
+    travel_to started_at do
+      card.comments.create! body: "One", creator: users(:david)
+    end
+    travel_to started_at + window + 1.second do
+      card.comments.create! body: "Two", creator: users(:kevin)
+      card.comments.create! body: "Three", creator: users(:david)
+    end
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "creating an assignment directly creates a burst and resets activity" do
+    card = new_card
+    card.update_columns(last_active_at: 3.weeks.ago)
+
+    card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+
+    assert_in_delta Time.current, card.reload.last_burst_at, 1.second
+    assert_in_delta Time.current, card.last_active_at, 1.second
+  end
+
+  test "unassigning directly resets activity" do
+    card = new_card
+    assignment = card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+    card.update_columns(last_active_at: 3.weeks.ago)
+
+    assignment.destroy!
+
+    assert_not card.reload.stalled?
+    assert_in_delta Time.current, card.last_active_at, 1.second
+  end
+
+  test "assigning or reopening a card creates a burst" do
+    card = new_card
+
+    card.toggle_assignment users(:kevin)
+    assert_in_delta Time.current, card.reload.last_burst_at, 1.second
+
+    card.close
+    card.reopen
+    assert_in_delta Time.current, card.reload.last_burst_at, 1.second
+  end
+
+  test "a burst card is stalled after two weeks without activity and activity resets it" do
+    card = new_card
+    card.update_columns(last_burst_at: 2.weeks.ago, last_active_at: 2.weeks.ago)
+
+    assert card.stalled?
+    assert_includes Card.stalled, card
+
+    card.comments.create! body: "New activity", creator: users(:kevin)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.update_columns(last_active_at: 2.weeks.ago)
+    assert card.stalled?
+  end
+
+  test "editing a card resets the stalled timer" do
+    card = new_card
+    card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    card.update!(description: "Additional context")
+
+    assert_not card.stalled?
+  end
+
+
+  test "a burst newer than the last activity does not count as stalled" do
+    card = new_card
+    card.update_columns(last_burst_at: 1.day.ago, last_active_at: 3.weeks.ago)
+
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "card-related activity resets the stalled timer" do
+    card = new_card
+    card.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    card.steps.create!(content: "A new step")
+
+    assert_not card.reload.stalled?
+    assert_in_delta Time.current, card.last_active_at, 1.second
+  end
+
+  test "stalled cards must be active and have had a burst" do
+    stalled = new_card
+    stalled.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    without_burst = new_card
+    without_burst.update_columns(last_active_at: 3.weeks.ago)
+
+    closed = new_card
+    closed.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    closed.close
+    closed.update_columns(last_active_at: 3.weeks.ago)
+
+    postponed = new_card
+    postponed.update_columns(last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    postponed.postpone
+    postponed.update_columns(last_active_at: 3.weeks.ago)
+
+    assert_equal [ stalled ].to_set, Card.stalled.to_set
+  end
+
+  private
+    def new_card
+      boards(:writebook).cards.create!(title: "A card", status: :published, creator: users(:david))
+    end
+end
