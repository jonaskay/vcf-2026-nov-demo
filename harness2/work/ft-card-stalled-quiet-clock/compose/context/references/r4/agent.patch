diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..b74c21c
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,46 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    before_update :update_last_active_at_for_activity, if: :card_activity_updated?
+
+    scope :stalled, -> do
+      active
+        .where.not(last_burst_at: nil)
+        .where("cards.last_burst_at <= cards.last_active_at")
+        .where(last_active_at: ..(STALLED_AFTER.ago))
+    end
+  end
+
+  def stalled?
+    last_burst_at.present? && last_burst_at <= last_active_at && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def record_burst
+    burst_at = Time.current
+    update! last_burst_at: burst_at, last_active_at: burst_at
+  end
+
+  def comment_was_created(comment)
+    return if comment.creator.system?
+
+    window_starts_at = comment.created_at - auto_postpone_period / 3
+    comments_in_window = comments.by_user.where(created_at: window_starts_at..comment.created_at)
+
+    if comments_in_window.count >= 3 && comments_in_window.distinct.count(:creator_id) >= 2
+      record_burst
+    end
+  end
+
+  private
+    def card_activity_updated?
+      changed_activity = changes.keys - %w[ created_at updated_at last_active_at last_burst_at ]
+      changed_activity.any? || rich_text_description&.changed_for_autosave?
+    end
+
+    def update_last_active_at_for_activity
+      self.last_active_at = Time.current unless will_save_change_to_last_active_at?
+    end
+end
