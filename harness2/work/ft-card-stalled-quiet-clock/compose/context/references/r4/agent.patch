@@ -0,0 +1,95 @@
+class AddLastBurstAtToCards < ActiveRecord::Migration[8.2]
+  def up
+    add_column :cards, :last_burst_at, :datetime
+    backfill_event_bursts
+    backfill_comment_bursts
+  end
+
+  def down
+    remove_column :cards, :last_burst_at
+  end
+
+  private
+    def backfill_event_bursts
+      execute <<~SQL
+        UPDATE cards
+        SET last_burst_at = (
+          SELECT MAX(events.created_at)
+          FROM events
+          LEFT JOIN users ON users.id = events.creator_id
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND (
+              events.action = 'card_assigned'
+              OR (events.action = 'card_reopened' AND users.role != 'system')
+            )
+        )
+        WHERE EXISTS (
+          SELECT 1
+          FROM events
+          LEFT JOIN users ON users.id = events.creator_id
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND (
+              events.action = 'card_assigned'
+              OR (events.action = 'card_reopened' AND users.role != 'system')
+            )
+        )
+      SQL
+    end
+
+    def backfill_comment_bursts
+      board_auto_close_periods.each do |board_id, period|
+        burst_timestamp = comment_burst_timestamp(period.to_i / 3)
+        board_id = connection.quote(board_id)
+
+        execute <<~SQL
+          UPDATE cards
+          SET last_burst_at = (#{burst_timestamp})
+          WHERE board_id = #{board_id}
+            AND last_burst_at IS NULL
+            AND (#{burst_timestamp}) IS NOT NULL
+        SQL
+      end
+    end
+
+    def board_auto_close_periods
+      connection.select_rows(<<~SQL)
+        SELECT boards.id,
+          COALESCE(board_entropies.auto_postpone_period, account_entropies.auto_postpone_period, 2592000)
+        FROM boards
+        LEFT JOIN entropies AS board_entropies
+          ON board_entropies.account_id = boards.account_id
+          AND board_entropies.container_type = 'Board'
+          AND board_entropies.container_id = boards.id
+        LEFT JOIN entropies AS account_entropies
+          ON account_entropies.account_id = boards.account_id
+          AND account_entropies.container_type = 'Account'
+          AND account_entropies.container_id = boards.account_id
+      SQL
+    end
+
+    def comment_burst_timestamp(window_in_seconds)
+      window_starts_at = connection.date_subtract("anchor_comments.created_at", window_in_seconds.to_s)
+
+      <<~SQL
+        SELECT MAX(anchor_comments.created_at)
+        FROM comments AS anchor_comments
+        INNER JOIN users AS anchor_authors ON anchor_authors.id = anchor_comments.creator_id
+        WHERE anchor_comments.card_id = cards.id
+          AND anchor_authors.role != 'system'
+          AND EXISTS (
+            SELECT window_comments.card_id
+            FROM comments AS window_comments
+            INNER JOIN users AS window_authors ON window_authors.id = window_comments.creator_id
+            WHERE window_comments.card_id = anchor_comments.card_id
+              AND window_comments.created_at >= #{window_starts_at}
+              AND window_comments.created_at <= anchor_comments.created_at
+              AND window_authors.role != 'system'
+            GROUP BY window_comments.card_id
+            HAVING COUNT(window_comments.id) >= 3
+              AND COUNT(DISTINCT window_comments.creator_id) >= 2
+          )
+      SQL
+    end
+end
