diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..2c18fd9
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "searches card titles and highlights matches" do
+    card = create_search_card(title: "Raspberry interface")
+
+    get search_path, params: { q: "raspberry" }
+
+    assert_response :success
+    assert_select ".search-result a[href=?]", card_path(card)
+    assert_select "mark", text: "Raspberry"
+  end
+
+  test "searches descriptions and comment bodies" do
+    description_card = create_search_card(title: "Description result", description: "Contains a hiddenword in this description")
+    comment_card = create_search_card(title: "Comment result")
+    comment_card.comments.create!(body: "A hiddenword appears in this comment")
+
+    get search_path, params: { q: "hiddenword" }
+
+    assert_response :success
+    assert_select ".search-result a[href=?]", card_path(description_card)
+    assert_select ".search-result a[href=?]", card_path(comment_card)
+    assert_select "mark", text: "hiddenword", minimum: 2
+  end
+
+  test "search results are newest first" do
+    older_card = create_search_card(title: "Orderneedle older", created_at: 2.days.ago)
+    newer_card = create_search_card(title: "Orderneedle newer", created_at: 1.day.ago)
+
+    get search_path, params: { q: "orderneedle" }
+
+    assert_response :success
+    result_links = css_select(".search-result h2 a").map { |link| link["href"] }
+    assert_operator result_links.index(card_path(newer_card)), :<, result_links.index(card_path(older_card))
+  end
+
+  test "search excludes cards and comments on drafts" do
+    draft = create_search_card(title: "Draftcardneedle")
+    draft.comments.create!(body: "Draftcommentneedle")
+    draft.update!(status: :drafted)
+
+    get search_path, params: { q: "draftcardneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path, params: { q: "draftcommentneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search only returns results on boards the user currently has access to" do
+    card = boards(:private).cards.create!(creator: users(:kevin), title: "Restricted card", status: :published)
+    card.comments.create!(body: "Restrictedneedle")
+    logout_and_sign_in_as :david
+
+    get search_path, params: { q: "restrictedneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_no_match "Restrictedneedle", response.body
+  end
+
+  test "search treats wildcard characters as literal text" do
+    card = create_search_card(title: "Progress is 100% complete")
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result a[href=?]", card_path(card)
+    assert_select "mark", text: "%"
+  end
+
+  test "search safely highlights card content" do
+    card = create_search_card(title: "<script>alert(1)</script> Securityneedle")
+
+    get search_path, params: { q: "securityneedle" }
+
+    assert_response :success
+    assert_select ".search-result a[href=?]", card_path(card)
+    assert_select ".search-result script", count: 0
+    assert_select "mark", text: "Securityneedle"
+  end
+
+  test "an empty search shows no card results" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select ".search-result", count: 0
+  end
+
+  private
+    def create_search_card(title:, description: nil, created_at: Time.current)
+      Current.session = sessions(:kevin)
+
+      boards(:writebook).cards.create!(
+        creator: users(:kevin),
+        title: title,
+        description: description,
+        created_at: created_at,
+        status: :published
+      )
+    end
+end
