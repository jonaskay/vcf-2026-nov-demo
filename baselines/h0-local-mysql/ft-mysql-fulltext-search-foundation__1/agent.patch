diff --git a/app/views/search/_result.html.erb b/app/views/search/_result.html.erb
new file mode 100644
index 0000000..6903ad1
--- /dev/null
+++ b/app/views/search/_result.html.erb
@@ -0,0 +1,22 @@
+<article class="search-result">
+  <h2 class="search-result__title">
+    <%= link_to card_path(card) do %>
+      <span class="search-result__number">#<%= card.number %></span>
+      <%= highlight(card.title, query) %>
+    <% end %>
+  </h2>
+
+  <p class="search-result__board"><%= card.board.name %></p>
+
+  <% if description = excerpt(card.description&.to_plain_text, query, radius: 100) %>
+    <p class="search-result__excerpt"><%= highlight(description, query) %></p>
+  <% end %>
+
+  <% comments_by_card.fetch(card.id, []).each do |comment| %>
+    <% if comment_excerpt = excerpt(comment.body&.to_plain_text, query, radius: 100) %>
+      <blockquote class="search-result__comment">
+        <%= highlight(comment_excerpt, query) %>
+      </blockquote>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..bf9d5e3
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,24 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search-page">
+  <%= form_with url: search_path, method: :get, class: "search-page__form" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "search/result", collection: @page.records, as: :card,
+          locals: { query: @query, comments_by_card: @comments_by_card } %>
+      <% end %>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”</p>
+    <% end %>
+  <% end %>
+</section>
