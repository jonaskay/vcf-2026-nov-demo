@@ -0,0 +1,28 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+
+    cards = Current.user.accessible_cards.published
+      .matching_search_term(@query)
+      .preload(:board, :rich_text_description)
+
+    set_page_and_extract_portion_from cards.reverse_chronologically
+    @comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def matching_comments_by_card
+      if @query.present? && @page.records.any?
+        pattern = "%#{Card.sanitize_sql_like(@query, "!")}%"
+
+        Current.user.accessible_comments
+          .joins(:rich_text_body)
+          .where(card_id: @page.records.map(&:id))
+          .where("LOWER(action_text_rich_texts.body) LIKE LOWER(?) ESCAPE '!'", pattern)
+          .includes(:rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..589b8af 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -25,6 +25,36 @@ class Card < ApplicationRecord
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
   scope :preloaded,               -> { with_users.preload(:column, :tags, :steps, :closure, :goldness, :activity_spike, :image_attachment, reactions: :reacter, board: [ :entropy, :columns ], not_now: [ :user ]).with_rich_text_description_and_embeds }
 
+  scope :matching_search_term, ->(term) do
+    if term.present?
+      pattern = "%#{sanitize_sql_like(term, "!")}%"
+
+      where(<<~SQL.squish, pattern: pattern)
+        LOWER(cards.title) LIKE LOWER(:pattern) ESCAPE '!'
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts AS card_descriptions
+          WHERE card_descriptions.record_type = 'Card'
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.name = 'description'
+            AND LOWER(card_descriptions.body) LIKE LOWER(:pattern) ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment'
+            AND comment_bodies.record_id = comments.id
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND LOWER(comment_bodies.body) LIKE LOWER(:pattern) ESCAPE '!'
+        )
+      SQL
+    else
+      none
+    end
+  end
+
   scope :indexed_by, ->(index) do
     case index
     when "stalled" then stalled
