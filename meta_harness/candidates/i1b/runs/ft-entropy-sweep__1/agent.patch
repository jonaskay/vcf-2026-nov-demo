diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..7dbf186 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -59,6 +59,64 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "due scope includes the board override's exact minimum period and excludes newer activity" do
+    freeze_time Time.utc(2025, 1, 1, 12, 0, 0)
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    cards(:logo).update!(last_active_at: 3.days.ago)
+    cards(:layout).update!(last_active_at: 3.days.ago - 1.second)
+    cards(:text).update!(last_active_at: 3.days.ago + 1.second)
+
+    due_cards = Card.due_to_be_postponed
+
+    assert_includes due_cards, cards(:logo)
+    assert_includes due_cards, cards(:layout)
+    assert_not_includes due_cards, cards(:text)
+  end
+
+  test "due scope uses the account period at the candidate boundary when the board has no override" do
+    freeze_time Time.utc(2025, 1, 1, 12, 0, 0)
+    entropies(:writebook_board).destroy
+    entropies("37s_account").update!(auto_postpone_period: 3.days)
+    cards(:logo).update!(last_active_at: 3.days.ago)
+    cards(:layout).update!(last_active_at: 3.days.ago + 1.second)
+
+    due_cards = Card.due_to_be_postponed
+
+    assert_includes due_cards, cards(:logo)
+    assert_not_includes due_cards, cards(:layout)
+  end
+
+  test "due scope resets its candidate status after card activity" do
+    freeze_time Time.utc(2025, 1, 1, 12, 0, 0)
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    card = cards(:logo)
+    card.update!(last_active_at: 4.days.ago)
+
+    assert_includes Card.due_to_be_postponed, card
+
+    card.update!(last_active_at: Time.current)
+
+    assert_not_includes Card.due_to_be_postponed, card
+  end
+
+  test "due scope uses the indexed activity prefilter" do
+    index = ActiveRecord::Base.connection.indexes(:cards).find do |candidate|
+      candidate.columns == %w[status last_active_at]
+    end
+
+    assert index, "expected a status/last_active_at index for the global entropy sweep"
+    assert_equal 2, Card.due_to_be_postponed.to_sql.scan(/cards\.last_active_at <=/).length
+
+    if ActiveRecord::Base.connection.adapter_name == "SQLite"
+      query_plan = ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{Card.due_to_be_postponed.to_sql}")
+        .map { |row| row.values.join(" ") }
+        .join("\n")
+
+      assert_match(/SEARCH cards USING INDEX #{Regexp.escape(index.name)}/, query_plan)
+      assert_no_match(/SCAN cards/, query_plan)
+    end
+  end
+
   test "postponing soon scope" do
     cards(:logo, :shipping).each(&:published!)
 
