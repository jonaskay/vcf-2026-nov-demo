diff --git a/app/models/card/activity_spike.rb b/app/models/card/activity_spike.rb
new file mode 100644
index 0000000..ac0f5dc
--- /dev/null
+++ b/app/models/card/activity_spike.rb
@@ -0,0 +1,62 @@
+module Card::ActivitySpike
+  extend ActiveSupport::Concern
+
+  included do
+    scope :activity_spiked, -> { where(Card.activity_spike_condition) }
+  end
+
+  class_methods do
+    def activity_spike_condition
+      comment_window_start = connection.date_subtract(
+        "burst_end.created_at",
+        "(COALESCE(burst_board_entropy.auto_postpone_period, burst_account_entropy.auto_postpone_period, #{Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i}) / 3)"
+      )
+
+      condition = <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM events AS burst_events
+          WHERE burst_events.account_id = cards.account_id
+            AND burst_events.eventable_type = 'Card'
+            AND burst_events.eventable_id = cards.id
+            AND burst_events.action IN ('card_assigned', 'card_reopened')
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments AS burst_end
+          INNER JOIN users AS burst_end_creator
+            ON burst_end_creator.id = burst_end.creator_id
+            AND burst_end_creator.role <> 'system'
+          INNER JOIN cards AS burst_card
+            ON burst_card.id = burst_end.card_id
+          INNER JOIN boards AS burst_board
+            ON burst_board.id = burst_card.board_id
+          LEFT JOIN entropies AS burst_board_entropy
+            ON burst_board_entropy.account_id = burst_card.account_id
+            AND burst_board_entropy.container_type = 'Board'
+            AND burst_board_entropy.container_id = burst_board.id
+          LEFT JOIN entropies AS burst_account_entropy
+            ON burst_account_entropy.account_id = burst_card.account_id
+            AND burst_account_entropy.container_type = 'Account'
+            AND burst_account_entropy.container_id = burst_card.account_id
+          INNER JOIN comments AS burst_comment
+            ON burst_comment.card_id = burst_end.card_id
+            AND burst_comment.created_at BETWEEN #{comment_window_start} AND burst_end.created_at
+          INNER JOIN users AS burst_commenter
+            ON burst_commenter.id = burst_comment.creator_id
+            AND burst_commenter.role <> 'system'
+          WHERE burst_end.card_id = cards.id
+          GROUP BY burst_end.id
+          HAVING COUNT(burst_comment.id) >= 3
+            AND COUNT(DISTINCT burst_comment.creator_id) >= 2
+        )
+      SQL
+
+      "(#{condition})"
+    end
+  end
+
+  def activity_spike?
+    self.class.activity_spiked.where(id: id).exists?
+  end
+end
diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..4d60ef1
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,25 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of: Time.current) do
+      where(last_active_at: ..(as_of - STALL_PERIOD)).activity_spiked
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    if last_active_at && last_active_at <= as_of - STALL_PERIOD
+      activity_spike?
+    else
+      false
+    end
+  end
+
+  # Include the time-derived stalled state so fragments expire when the card crosses the two-week threshold.
+  def cache_version
+    version = super
+    "#{version}-#{stalled?}" if version
+  end
+end
