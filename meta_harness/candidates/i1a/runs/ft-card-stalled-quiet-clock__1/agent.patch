diff --git a/test/models/card/activity_spike_test.rb b/test/models/card/activity_spike_test.rb
new file mode 100644
index 0000000..fba6994
--- /dev/null
+++ b/test/models/card/activity_spike_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Card::ActivitySpikeTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "a comment burst requires three comments by two people within a third of the board period" do
+    freeze_time do
+      card = new_card
+      window = card.auto_postpone_period / 3
+
+      comment(card, users(:david), created_at: Time.current - window - 1.second)
+      comment(card, users(:kevin), created_at: Time.current - 1.day)
+      comment(card, users(:david), created_at: Time.current)
+
+      assert_not card.activity_spike?, "comments just outside the window should not count"
+
+      card.comments.last.destroy!
+      comment(card, users(:david), created_at: Time.current - 1.second)
+
+      assert card.activity_spike?, "three comments at the window boundary by two people should count"
+    end
+  end
+
+  test "comment bursts require both three comments and two different people" do
+    freeze_time do
+      card = new_card
+      comment(card, users(:david), created_at: Time.current - 2.hours)
+      comment(card, users(:kevin), created_at: Time.current - 1.hour)
+
+      assert_not card.activity_spike?
+
+      comment(card, users(:david), created_at: Time.current)
+      assert card.activity_spike?
+
+      same_person_card = new_card
+      3.times { comment(same_person_card, users(:david), created_at: Time.current) }
+      assert_not same_person_card.activity_spike?
+    end
+  end
+
+  test "system comments do not count as people in a comment burst" do
+    freeze_time do
+      card = new_card
+      system_user = accounts("37s").system_user
+
+      3.times { comment(card, system_user, created_at: Time.current) }
+
+      assert_not card.activity_spike?
+    end
+  end
+
+  test "the account auto-close period is used when the board has no override" do
+    freeze_time do
+      entropies(:writebook_board).destroy
+      card = new_card
+      window = card.auto_postpone_period / 3
+
+      comment(card, users(:david), created_at: Time.current - window)
+      comment(card, users(:kevin), created_at: Time.current - window / 2)
+      comment(card, users(:david), created_at: Time.current)
+
+      assert card.activity_spike?
+    end
+  end
+
+  test "assigning someone or reopening the card causes a burst" do
+    card = new_card
+
+    card.toggle_assignment(users(:kevin))
+    assert card.activity_spike?
+
+    reopened_card = new_card
+    reopened_card.close
+    reopened_card.reopen
+    assert reopened_card.activity_spike?
+  end
+
+  private
+    def new_card
+      boards(:writebook).cards.create!(title: "A card with recent activity", creator: users(:david), status: :published)
+    end
+
+    def comment(card, creator, created_at:)
+      card.comments.create!(body: "Activity", creator: creator, created_at: created_at)
+    end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..9b0e5bf
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "a card with a burst stalls after two weeks without activity" do
+    freeze_time do
+      card = card_with_comment_burst
+      as_of = Time.current
+
+      card.update_column(:last_active_at, as_of - Card::Stallable::STALL_PERIOD + 1.second)
+      assert_not card.reload.stalled?(as_of: as_of)
+
+      card.update_column(:last_active_at, as_of - Card::Stallable::STALL_PERIOD)
+      card.reload
+
+      assert card.stalled?(as_of: as_of)
+      assert_includes Card.stalled(as_of: as_of), card
+    end
+  end
+
+  test "a burst is not stalled while there is no burst" do
+    freeze_time do
+      card = new_card
+      card.update_column(:last_active_at, 3.weeks.ago)
+
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "any new activity resets a stalled card" do
+    freeze_time do
+      card = card_with_comment_burst
+      card.update_column(:last_active_at, 3.weeks.ago)
+      assert card.reload.stalled?
+
+      comment(card, users(:kevin))
+
+      assert_not card.reload.stalled?
+      assert card.activity_spike?
+
+      travel 2.weeks
+
+      assert card.stalled?, "the reset activity should itself become stale after another two weeks"
+    end
+  end
+
+  test "the cache version changes when the card becomes stalled" do
+    freeze_time do
+      card = card_with_comment_burst
+      card.update_column(:last_active_at, 2.weeks.ago + 1.second)
+      card.reload
+      cache_version = card.cache_version
+
+      travel 1.second
+
+      assert card.stalled?
+      assert_not_equal cache_version, card.cache_version
+    end
+  end
+
+  test "the stalled scope and predicate agree across accounts" do
+    freeze_time do
+      card = card_with_comment_burst
+      other_card = cards(:radio)
+      card.update_column(:last_active_at, 3.weeks.ago)
+      other_card.events.create!(action: "card_assigned", board: other_card.board, creator: users(:mike), account: other_card.account)
+      other_card.update_column(:last_active_at, 3.weeks.ago)
+
+      assert_equal Card.stalled.to_a.to_set, Card.all.select(&:stalled?).to_set
+      assert_includes Card.stalled, other_card
+      assert_includes Card.stalled, card
+    end
+  end
+
+  private
+    def card_with_comment_burst
+      card = new_card
+      comment(card, users(:david))
+      comment(card, users(:kevin))
+      comment(card, users(:david))
+      card
+    end
+
+    def new_card
+      boards(:writebook).cards.create!(title: "A card with recent activity", creator: users(:david), status: :published)
+    end
+
+    def comment(card, creator)
+      card.comments.create!(body: "Activity", creator: creator)
+    end
+end
