   class_methods do
+    def due_to_be_postponed_for_periods(now, relation = all)
+      entropy_periods
+        .map { |period| due_to_be_postponed_for_period(period, now, relation) }
+        .reduce { |due_cards, cards_for_period| due_cards.or(cards_for_period) } || relation.none
+    end
+
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+      system_users = {}
+
+      entropy_periods.each do |period|
+        due_to_be_postponed_for_period(period, now)
+          .preload(:account, :column, :closure, :not_now, :activity_spike, board: :account)
+          .find_each do |card|
+            system_user = system_users[card.account_id] ||= card.account.system_user
+            card.auto_postpone(user: system_user)
+          end
       end
     end
+
+    private
+      def entropy_periods
+        Entropy.distinct.pluck(:auto_postpone_period)
+      end
+
+      def due_to_be_postponed_for_period(period, now, relation = all)
+        cutoff = now - period.seconds
+        board_entropies = Entropy.where(container_type: "Board")
+        board_entropies_for_period = board_entropies.where(auto_postpone_period: period)
+        account_entropies_for_period = Entropy
+          .where(container_type: "Account", auto_postpone_period: period)
+          .where(Entropy.arel_table[:account_id].eq(Entropy.arel_table[:container_id]))
+
+        due_on_board = relation.active
+          .where(board_id: board_entropies_for_period.select(:container_id))
+          .where(account_id: Board.where(id: board_entropies_for_period.select(:container_id)).select(:account_id))
+          .where(last_active_at: ..cutoff)
+
+        due_on_account = relation.active
+          .where(account_id: account_entropies_for_period.select(:container_id))
+          .where.not(board_id: board_entropies.select(:container_id))
+          .where(last_active_at: ..cutoff)
+
+        due_on_board.or(due_on_account)
+      end
   end
 
   def entropy
