diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..7259131 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -79,10 +79,119 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert cards(:radio).reload.postponed?
   end
 
+  test "auto postpone all due respects each configured cutoff at its boundary" do
+    freeze_time
+
+    account = accounts("37s")
+    system_user = account.system_user
+    due_cards = []
+    cards_after_cutoff = []
+
+    default_board = account.boards.create!(name: "Entropy default board", creator: users(:david))
+    assert_not Entropy.exists?(container: default_board)
+    default_cutoff = Time.current - account.entropy.auto_postpone_period
+    due_cards << create_active_card(default_board, last_active_at: default_cutoff - 1.second)
+    due_cards << create_active_card(default_board, last_active_at: default_cutoff)
+    cards_after_cutoff << create_active_card(default_board, last_active_at: default_cutoff + 1.second)
+
+    Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.each do |period|
+      board = account.boards.create!(name: "Entropy #{period} board", creator: users(:david))
+      board.update!(auto_postpone_period: period)
+      cutoff = Time.current - period.seconds
+
+      due_cards << create_active_card(board, last_active_at: cutoff - 1.second)
+      due_cards << create_active_card(board, last_active_at: cutoff)
+      cards_after_cutoff << create_active_card(board, last_active_at: cutoff + 1.second)
+    end
+
+    assert_equal due_cards.to_set, Card.due_to_be_postponed.to_set
+
+    Card.auto_postpone_all_due
+
+    due_cards.each do |card|
+      assert card.reload.postponed?, "#{card.title} should be postponed at the cutoff"
+      assert_equal system_user, card.postponed_by
+      assert_equal system_user, card.comments.last.creator
+    end
+
+    cards_after_cutoff.each do |card|
+      assert_not card.reload.postponed?, "#{card.title} should not be postponed after the cutoff"
+    end
+  end
+
+  test "auto postpone all due honors each account period on boards without overrides" do
+    freeze_time
+
+    account = accounts("37s")
+
+    Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.each do |period|
+      account.entropy.update!(auto_postpone_period: period)
+      board = account.boards.create!(name: "Account entropy #{period} board", creator: users(:david))
+      assert_not Entropy.exists?(container: board)
+      cutoff = Time.current - period.seconds
+
+      due_before_cutoff = create_active_card(board, last_active_at: cutoff - 1.second)
+      due_at_cutoff = create_active_card(board, last_active_at: cutoff)
+      after_cutoff = create_active_card(board, last_active_at: cutoff + 1.second)
+
+      assert_includes Card.due_to_be_postponed, due_before_cutoff
+      assert_includes Card.due_to_be_postponed, due_at_cutoff
+      assert_not_includes Card.due_to_be_postponed, after_cutoff
+
+      Card.auto_postpone_all_due
+
+      assert due_before_cutoff.reload.postponed?
+      assert due_at_cutoff.reload.postponed?
+      assert_not after_cutoff.reload.postponed?
+      after_cutoff.update_columns(last_active_at: Time.current)
+    end
+  end
+
+  test "due cards fall back to the account period after a board override is removed" do
+    freeze_time
+
+    card = cards(:logo)
+    other_card = cards(:radio)
+    card.update_column(:last_active_at, 45.days.ago)
+    other_card.update_column(:last_active_at, 45.days.ago)
+
+    assert_not_includes Card.due_to_be_postponed, card
+    assert_not_includes Card.due_to_be_postponed, other_card
+
+    entropies(:writebook_board).destroy
+    entropies(:miltons_wish_list_board).destroy
+
+    assert_includes Card.due_to_be_postponed, card
+    assert_includes Card.due_to_be_postponed, other_card
+
+    Card.auto_postpone_all_due
+
+    assert card.reload.postponed?
+    assert other_card.reload.postponed?
+  end
+
+  test "due-to-be-postponed query uses the card activity index" do
+    connection = ActiveRecord::Base.connection
+    skip "SQLite-specific query plan assertion" unless connection.adapter_name == "SQLite"
+
+    plan = connection.execute("EXPLAIN QUERY PLAN #{Card.due_to_be_postponed.order(:id).limit(1000).to_sql}")
+    details = plan.map { |row| row.values.join(" ") }
+
+    assert details.any? { |detail| detail.include?("SEARCH cards USING INDEX index_cards_on_account_id_and_last_active_at_and_status") }
+    assert details.none? { |detail| detail.match?(/SCAN cards\b/) }
+  end
+
   test "postponing_soon scope works properly cross-account" do
     cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago + 2.days)
     cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago + 2.days)
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  private
+    def create_active_card(board, last_active_at:)
+      card = board.cards.create!(title: "Entropy boundary card", creator: board.creator)
+      card.update_columns(status: "published", last_active_at: last_active_at)
+      card
+    end
 end
